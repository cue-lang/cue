fail b.cue
force
exit 1

With --force the convertible files are written and the version is bumped
even though one rewrite failed; that file is left as it was, reported,
and the exit status still says something went wrong.

-- cue.mod/module.cue --
module: "mod.test"

language: version: "v0.17.0"

-- a.cue --
package p

X=a: {b: X.c, c: 1}
-- b.cue --
package p

Y=b: {c: Y.d, d: 1}
-- expect/stderr --
b.cue:1:1: injected rewrite failure
mod upgrade: 1 file(s) could not be converted; language version set to v0.18.0 (--force)
-- expect/a.cue --
package p

a~(X): {b: X.c, c: 1}
-- expect/cue.mod/module.cue --
module: "mod.test"
language: version: "v0.18.0"
