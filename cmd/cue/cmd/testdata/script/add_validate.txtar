# cue add must fail and restore the original files
# when the result does not validate.

stdin stdin.cue
! exec cue add x.cue
stderr 'a: conflicting values 2 and 1'
cmp x.cue x.cue-want

-- cue.mod/module.cue --
module: "main.org@v0"
language: version: "v0.16.0"
-- stdin.cue --
a: 2
-- x.cue --
package x

a: 1
-- x.cue-want --
package x

a: 1
