# CUE that we generate lands in the module we generated it for, so it has to
# parse at that module's language version. Below v0.18.0, where
# @experiment(aliasv2) is stable, an alias is spelled in the prefix form; from
# v0.18.0 on it is spelled in the postfix one. Emitting the form the module
# cannot parse leaves it unable to load its own generated files, which is why
# each generated file is vetted here as well as compared.
#
# TestLatest: skip -- the old module deliberately uses the prefix form.

cd old

# "cue def" reads the prefix form and must keep it.
exec cue def ./x
cmp stdout out-def
cp stdout gen/gen.cue
exec cue vet ./gen

# "cue import" needs an alias for a dependency key that is not an identifier,
# so it too has to pick the form the module can parse.
exec cue import -f -p gen -o gen2/schema.cue schema.json
cmp gen2/schema.cue out-import
exec cue vet ./gen2

cd ../new

exec cue def ./x
cmp stdout out-def
cp stdout gen/gen.cue
exec cue vet ./gen

exec cue import -f -p gen -o gen2/schema.cue schema.json
cmp gen2/schema.cue out-import
exec cue vet ./gen2

cd ../exp

# Without a package clause, "cue def" keeps the file attributes as
# declarations of the file's value, so an @experiment attribute applies to its
# output as well, and aliasv2 enables the postfix form there.
exec cue def label.cue
cmp stdout out-def-label
cp stdout gen/label.cue
exec cue eval gen/label.cue
cmp stdout out-eval-label

exec cue def pattern.cue
cmp stdout out-def-pattern
cp stdout gen/pattern.cue
exec cue eval gen/pattern.cue
cmp stdout out-eval-pattern

# A package clause added to the output goes after the file attributes,
# which remain file attributes there.
exec cue def -p label label.cue
cmp stdout out-def-label-p
cp stdout genp/label.cue
exec cue vet ./genp

# The attributes go first in the output, where they are file attributes,
# even when a let clause goes before them in the value.
exec cue def let.cue
cmp stdout out-def-let
cp stdout gen/let.cue
exec cue vet gen/let.cue

# The attributes of a struct stay within it in the output, such as within
# _#def, so they do not enable aliasv2 there.
exec cue def -e '#X' nested.cue
cmp stdout out-def-nested
cp stdout gen/nested.cue
exec cue vet gen/nested.cue

# With a package clause, the file attributes are not part of the output,
# which takes the form of the module's language version.
exec cue def ./x
cmp stdout out-def
cp stdout genpkg/gen.cue
exec cue vet ./genpkg

# Attributes after a package clause and without imports are not file
# attributes, in the source nor in the output.
exec cue def ./y
cmp stdout out-def-y
cp stdout genpkgy/gen.cue
exec cue vet ./genpkgy

-- old/cue.mod/module.cue --
module: "old.example"
language: version: "v0.14.0"

-- old/x/in.cue --
package x

labelAlias: {
	X="a-b": 4
	foo:     X
}
patternLabel: [W=string]: m: W

-- old/schema.json --
{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"working-directory": {"type": "string"},
		"run": {"type": "string"}
	},
	"dependentRequired": {
		"working-directory": ["run"]
	}
}
-- old/gen/.keep --
-- old/gen2/.keep --
-- old/out-def --
package x

labelAlias: {
	X="a-b": 4
	foo:     X
}
patternLabel: [W=string]: m: W
-- old/out-import --
package gen

@jsonschema(schema="https://json-schema.org/draft/2020-12/schema")
"working-directory"?:     string
run?:                     string
_t0="working-directory"?: _
if _t0 != _|_ {
	run!: _
}
{}
...
-- new/cue.mod/module.cue --
module: "new.example"
language: version: "v0.18.0"

-- new/x/in.cue --
package x

labelAlias: {
	"a-b"~X: 4
	foo:     X
}
patternLabel: [string]~(W,_): m: W

-- new/schema.json --
{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"working-directory": {"type": "string"},
		"run": {"type": "string"}
	},
	"dependentRequired": {
		"working-directory": ["run"]
	}
}
-- new/gen/.keep --
-- new/gen2/.keep --
-- new/out-def --
package x

labelAlias: {
	"a-b"~(X): 4
	foo:       X
}
patternLabel: [string]~(W,_): m: W
-- new/out-import --
package gen

@jsonschema(schema="https://json-schema.org/draft/2020-12/schema")
"working-directory"?:       string
run?:                       string
"working-directory"~(_t0)?: _
if _t0 != _|_ {
	run!: _
}
{}
...
-- exp/cue.mod/module.cue --
module: "exp.example"
language: version: "v0.17.0"

-- exp/label.cue --
@experiment(aliasv2)

a~X: {b: 1}
c: X.b
-- exp/pattern.cue --
@experiment(aliasv2)

#x: [string]~(x, _): {
	name: x
}
y: #x & {foo: {}}
-- exp/x/in.cue --
@experiment(aliasv2)

package x

a~X: {b: 1}
c: X.b
-- exp/let.cue --
@experiment(aliasv2)

let L = 1
a~X: {b: L}
c: X.b
-- exp/nested.cue --
#X: {
	@experiment(aliasv2)
	X=a: 1
	b:   X
}
-- exp/y/in.cue --
package y

@experiment(aliasv2)

X=a: {b: 1}
c: X.b
-- exp/gen/.keep --
-- exp/genp/.keep --
-- exp/genpkg/.keep --
-- exp/genpkgy/.keep --
-- exp/out-def-label --
@experiment(aliasv2)

a~(X): b: 1
c: X.b
-- exp/out-def-label-p --
@experiment(aliasv2)

package label

a~(X): b: 1
c: X.b
-- exp/out-eval-label --
a: b: 1
c: 1
-- exp/out-def-pattern --
@experiment(aliasv2)
#x: [string]~(x,_): name: x
y: #x & {foo: {}}
-- exp/out-eval-pattern --
#x: {}
y: foo: name: "foo"
-- exp/out-def --
package x

X=a: b: 1
c: X.b
-- exp/out-def-let --
@experiment(aliasv2)
let L = 1
a~(X): b: L
c: X.b
-- exp/out-def-y --
package y

@experiment(aliasv2)
X=a: b: 1
c: X.b
-- exp/out-def-nested --
_#def
_#def: {
	@experiment(aliasv2)
	X=a: 1
	b:   X
}
