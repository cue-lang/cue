# Issue #3108: tasks generated by a comprehension were given the union of every
# $after target appearing anywhere in the comprehension source, rather than the
# targets of their own iteration, so unrelated tasks looked mutually dependent.
# The two sequential groups from the issue body now run.

cd groups
exec cue cmd test
cmp stdout ../groups-stdout
cd ..

# The diamond from the issue discussion still fails: s2 and s3 each depend only
# on s1, yet the union makes them refer to each other.
# TODO(#3108): all four tasks should run. A golden for that output cannot be a
# plain cmp, as s2 and s3 may then run in either order.
cd diamond
! exec cue cmd test
stderr 'cyclic task dependency'
stderr 'task command\.test\.s2 refers to'
stderr 'task command\.test\.s3 refers to'
cd ..

-- groups-stdout --
a
b
c
x
y
z
-- groups/cue.mod/module.cue --
module: "mod.example/groups"
language: version: "v0.18.0"
-- groups/test_tool.cue --
package main

import "tool/exec"

command: test: [string]: [string]: exec.Run

command: test: {
	group1: {
		let tasks = [
			{cmd: "echo a"},
			{cmd: "echo b"},
			{cmd: "echo c"},
		]
		for i, v in tasks {
			"s\(i+1)": v & {
				if i != 0 {
					$after: command.test.group1["s\(i)"]
				}
			}
		}
	}
	group2: {
		let tasks = [
			{cmd: "echo x"},
			{cmd: "echo y"},
			{cmd: "echo z"},
		]
		for i, v in tasks {
			"s\(i+1)": v & {
				if i == 0 {
					$after: [for v in command.test.group1 {v}]
				}
				if i != 0 {
					$after: command.test.group2["s\(i)"]
				}
			}
		}
	}
}
-- diamond/cue.mod/module.cue --
module: "mod.example/diamond"
language: version: "v0.18.0"
-- diamond/test_tool.cue --
package main

import "tool/exec"

command: test: {
	let deps = {s2: ["s1"], s3: ["s1"], s4: ["s2", "s3"]}
	s1: exec.Run & {cmd: "echo a"}
	for k, d in deps {
		(k): exec.Run & {cmd: "echo \(k)", $after: [for n in d {command.test[n]}]}
	}
}
