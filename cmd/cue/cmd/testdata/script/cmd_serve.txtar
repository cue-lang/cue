{
  "openapi": "3.0.0",
  "info": {
    "title": "Machine for research"
  },
  "paths": {},
  "components": {
    "schemas": {
      "Machine": {
        "type": "object",
        "required": [
          "arch",
          "os"
        ],
        "properties": {
          "access": {
            "type": "object",
