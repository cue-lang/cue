            ]
          },
          "disk": {
            "type": "integer"
          },
          "mem": {
            "type": "integer"
          },
          "os": {
            "type": "string",
            "enum": [
              "Linux",
              "Windows"
            ]
          }
        }
      }
    }
  }
}
