exec cue cmd serve &serve&
waitmatch -stderr serve 'listening on (\S+)$' SERVE_ADDR

curl -X GET http://${SERVE_ADDR}/test
stdout 'ack: using method GET'

curl -X GET http://${SERVE_ADDR}/one/1/two/i/i
stdout 'ack: one/1 two/i/i'

curl -X GET http://${SERVE_ADDR}/authz/alice
stdout 'true'

curl -X GET http://${SERVE_ADDR}/authz/bob
stdout 'false'

curl -w '\n' -X GET http://${SERVE_ADDR}/schema/api/vm?r=research
cmp stdout out/vm-research

curl -L http://${SERVE_ADDR}/api/vm?u=alice -H 'Content-Type: application/json' -d '{"os":"Linux","arch":"x86","mem":10000000000,"disk":20000000000,"access": {"public":true}}'
stdout 'OK'

curl -L http://${SERVE_ADDR}/authz -H 'Content-Type: application/json' -d '{"user":"alice"}'
stdout 'true'

curl -L http://${SERVE_ADDR}/authz -H 'Content-Type: application/json' -d '{"user":"bob"}'
stdout 'false'

# Sibling task pattern - request data flows to another task
curl -L http://${SERVE_ADDR}/echo -H 'Content-Type: text/plain' -d 'hello from sibling task'
stdout 'hello from sibling task'

# A urlencoded form body is available both raw and parsed
# TODO: the raw body is empty, as parsing the form consumes it.
curl http://${SERVE_ADDR}/form?q=query -H 'Content-Type: application/x-www-form-urlencoded' -d 'a=1&b=two'
stdout '^body="" a=1 b=two q=query$'

# Custom status code examples

# Valid request returns 201 Created
curl -w '\n' -L http://${SERVE_ADDR}/api/vm/create?u=alice -H 'Content-Type: application/json' -d '{}'
cmp stdout out/create-201

# Custom error endpoint returns 400 Bad Request
! curl -f -w '\n' -L http://${SERVE_ADDR}/api/error -H 'Content-Type: application/json' -d '{}'
cmp stdout out/create-400

# A response without a body sends no content rather than an error
curl -w '%{http_code}' -X GET http://${SERVE_ADDR}/api/nocontent
stdout '^204$'

# Status codes out of the three-digit HTTP range are rejected by the schema
# rather than crashing the server; see cue-lang/cue#4465
curl -w '\n%{http_code}' -X GET http://${SERVE_ADDR}/api/status?code=201
stdout '^201$'

! curl -f -w '\n%{http_code}' -X GET http://${SERVE_ADDR}/api/status?code=0
stdout 'response\.statusCode: invalid value 0 \(out of bound >=100\)'
stdout '^500$'

! curl -f -w '\n%{http_code}' -X GET http://${SERVE_ADDR}/api/status?code=1000
stdout 'response\.statusCode: invalid value 1000 \(out of bound <=999\)'
stdout '^500$'

# Error cases

# Malformed JSON input
! curl -f -L http://${SERVE_ADDR}/authz -H 'Content-Type: application/json' -d 'not valid json'
cmp stdout out/error-malformed-json

# Research user (bob) trying to create a public VM - violates access: public: false constraint
! curl -f -L http://${SERVE_ADDR}/api/vm?u=bob -H 'Content-Type: application/json' -d '{"os":"Linux","arch":"x86","mem":10000000000,"disk":20000000000,"access":{"public":true}}'
cmp stdout out/error-public-vm

# Invalid OS value
! curl -f -L http://${SERVE_ADDR}/api/vm?u=alice -H 'Content-Type: application/json' -d '{"os":"FreeBSD","arch":"x86","mem":10000000000,"disk":20000000000,"access":{"public":true}}'
cmp stdout out/error-invalid-os

stop

-- authz_tool.cue --
package vm

import "encoding/json"

#Authz: {
	user!: string

	authz: *false | bool

    authz: allow && !deny

    deny: *false | bool // default(false)
    allow: *false | bool  // default(true)

    if user == "alice" {
        allow: true
    }
}

// We have two kinds of authz endpoints: one that takes the user
// as part of the URL path, and one that takes a JSON body.
//
// The main purpose here is to show that requests can be routed based on their
// method type.
//
// This pattern constraint sets up the common aspects for both.
command: serve: [=~"^/authz"]: ServeJSON & {
	request: value: #Authz
	response: value: request.value.authz
}

// authz returns a boolean indicating whether the user is authorized.
// The user is specified as part of the URL path.
command: serve: "/authz/{user}": {
	method: "GET"
	request: value: user: request.pathValues.user
}

// authz returns a boolean indicating whether the user is authorized.
// The user is specified in the JSON body.
command: serve: "/authz": {
	method: "POST"
	request: value: json.Unmarshal(request.body)
}

-- api_tool.cue --
package vm

import (
	"encoding/json"
	"encoding/openapi"
	"strconv"
)

//#Machine describes a virtual machine.
#Machine: {
	os!:     "Windows" | "Linux" | "MacOS"
	arch!:   "x86" | "arm64"
	mem?:    int
	disk?:   int
	access?: {
		public?: bool
	}
}

// MachineByRole defines different machine configurations that are allowed
// based on user role.
MachineByRole: {
	admin: #Machine

	// Interns are only afforded smaller machines.
	intern: #Machine&{
		mem?:  <=4Gi
		disk?: <=100G
	}

	research: #Machine&{
		// The research team cannot launch public-facing machines.
		access?: public?: false
		os?:     "Linux" | "Windows"
	}
	default: null
}

Membership: alice: "admin"
Membership: bob: "research"
Membership: taylor: "intern"

// This API gets the allowed VM configurations for a given user defined as
// OpenAPI. The user is specified as a query parameter.
// If no user is given, a generic OpenAPI schema for Machine is returned.
command: serve: "/schema/api/vm": {
	routing: method: "GET"

	// Define default for user query parameter.
	request: form: r: *[""] | [...string]

	let role = request.form.r[0]
	let X = [// select first
		if MachineByRole[role] != _|_ {
			config: {
				version: "3.0.0"
				info: title: "Machine for \(role)"
			}

			// TODO: note: if this is a disjunction it won't get converted to
			// OpenAPI properly.

			machine: MachineByRole[role]
		},
		{
			config: {
				version: "3.0.0"
				info: title: "Machine"
			}
			machine: #Machine
		}, // default
	][0]

	response: body: json.Indent(
		openapi.MarshalSchema(X.config, {#Machine: X.machine}), "", "  ")
}

// This API simulates creating a new VM for a given user, specified as a query
// parameter. The machine is requested in the JSON body. It is than checked
// that the user can actually use the machine.
command: serve: "/api/vm": {
	routing: method: "POST"

	// Further constrain user permissions.
	request: form: u!: [string]

	let user = request.form.u[0]
	let role = Membership[user]

	// Validate the request to create a new VM against the VM schema.
	X: #Machine
	X: json.Unmarshal(request.body)
	X: MachineByRole[role]

	response: {
		header: "Content-Type": "application/json"

		result: "OK"
		body:   json.Marshal(result)
	}
}

// This API demonstrates returning a custom 201 Created status code.
command: serve: "/api/vm/create": {
	routing: method: "POST"

	request: form: u!: [string, ...string]

	response: {
		header: "Content-Type": "application/json"
		statusCode: 201
		body: json.Marshal({
			status: "created"
			user:   request.form.u[0]
		})
	}
}

// This API demonstrates a response with no body at all.
command: serve: "/api/nocontent": {
	routing: method: "GET"

	response: statusCode: 204
}

// This API demonstrates a status code derived from the request, so that it is
// only validated against the tool/http.Serve schema as a request is handled.
command: serve: "/api/status": {
	routing: method: "GET"

	request: form: code: *["200"] | [...string]

	response: {
		statusCode: strconv.Atoi(request.form.code[0])
		body:       "status"
	}
}

// This API demonstrates returning a custom 400 Bad Request status code.
command: serve: "/api/error": {
	routing: method: "POST"

	response: {
		header: "Content-Type": "application/json"
		statusCode: 400
		body: json.Marshal({
			error: "missing required parameter: u"
		})
	}
}

-- server_tool.cue --
package vm

import (
	"encoding/json"
	"tool/exec" // Uncomment when experimenting with sibling task pattern
	"tool/http"
)

// Test serves as an endpoint for simple testing.
command: serve: "/test": http.Serve & {
	request: _
	response: body: "ack: using method \(request.method)"
}

// This endpoint demonstrates capture of all path parameters.
command: serve: "/one/{one}/{two...}": http.Serve & {
	request: _
	response: body: "ack: one/\(request.pathValues.one) \(request.pathValues.two)"
}

// This endpoint demonstrates a sibling task (defined as a separate command)
// that reads from the request and produces output used in the response.
command: serve: "/echo": http.Serve & {
	routing: method: "POST"
	request: _
	// Reference the sibling command's output
	response: body: command.echo.stdout
}

// The echo task is defined as a sibling command that reads from the serve request.
command: echo: exec.Run & {
	cmd:    ["cat"]
	stdin:  command.serve."/echo".request.body
	stdout: string // Explicitly capture stdout
}

// This endpoint demonstrates a form body, which is parsed into request.form
// alongside the query parameters, and is also available via request.body.
command: serve: "/form": http.Serve & {
	routing: method: "POST"
	request: _
	response: body: "body=\(json.Marshal("\(request.body)")) a=\(request.form.a[0]) b=\(request.form.b[0]) q=\(request.form.q[0])"
}

// ServeJSON is a helper for endpoints that serve JSON.
ServeJSON: {
	response: {
		value!: _
		body:   json.Marshal(value)
	}
}

// All our endpoints serve from the same address.
// We take the convention that the name of the "subcommand" is the path prefix.
command: serve: [string]~(Prefix,_): http.Serve & {
	listenAddr: "localhost:0"
	routing: path: Prefix
}
-- out/create-201 --
{"status":"created","user":"alice"}
