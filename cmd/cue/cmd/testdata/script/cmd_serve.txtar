    ./api_tool.cue:91:5
    json:1:7
command.serve."/api/vm".X.os: conflicting values "MacOS" and "FreeBSD":
    ./api_tool.cue:11:33
    ./api_tool.cue:91:5
    json:1:7
command.serve."/api/vm".X.os: conflicting values "Windows" and "FreeBSD":
    ./api_tool.cue:11:11
    ./api_tool.cue:91:5
    json:1:7

