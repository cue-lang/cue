# Test the INI encoding and its flavor tag in cmd/cue.
# The reference files mirror the ones encoding/ini decodes in its own
# tests, so both surfaces are exercised on the same input.

# The generic flavor transforms nothing beyond trimming, so a value
# holding " ; " or " #" keeps it.
exec cue export svc.ini
cmp stdout svc.json

# The flavor tag on the ini file type names one of the flavors.
exec cue export ini+flavor=git: git.ini
cmp stdout git.json
exec cue export ini+flavor=python: setup.cfg
cmp stdout python.json
exec cue export ini+flavor=systemd: unit.service
cmp stdout systemd.json
exec cue export ini+flavor=windows: app.ini
cmp stdout windows.json

# The .ini extension resolves the encoding by itself, so the flavor tag
# alone is enough, as koala is for xml.
exec cue export flavor=git: git.ini
cmp stdout git.json

# The ini tag reads a file with any name as INI.
exec cue export ini: plain.conf
cmp stdout plain.json

# A flavor tag is accepted wherever a file qualifier is.
exec cue eval ini+flavor=git: git.ini
stdout 'sparsecheckout: true'
exec cue vet schema.cue ini+flavor=git: git.ini
# The imported CUE is the same as encoding/ini decodes the file to under
# GitConfig, so the tag and the constructor cannot drift apart.
exec cue import -o - ini+flavor=git: git.ini
cmp stdout git-import.cue

# A file named alongside a package decodes with the generic flavor.
cd pkg
exec cue export . data.ini
cmp stdout data.json
cd ..

# File-type resolution rejects an unknown flavor, and two different
# flavors at once, before reading the file.
! exec cue export ini+flavor=bogus: git.ini
cmp stderr bogus.stderr
! exec cue export ini+flavor=git+flavor=systemd: git.ini
cmp stderr two-flavors.stderr

# The encoding and the flavor tag are documented, as experimental.
exec cue help filetypes
stdout '\n    ini         \.ini            INI files\.\n'
stdout '\n    flavor=<name>   read or write INI as the named tool does: git\n'
stdout '\nNote that ini is currently experimental: '

# INI output writes the global properties, then one section per struct,
# selected by --out or by the extension or qualifier of an -o file name.
# The output decodes back to the same data, every scalar as a string.
exec cue export --out ini grafana.cue
cmp stdout grafana.ini
exec cue export -o out.ini grafana.cue
cmp out.ini grafana.ini
exec cue export out.ini
cmp stdout grafana.json
exec cue export -o ini:out.conf grafana.cue
cmp out.conf grafana.ini

# The flavor tag selects a flavor for output as it does for input, and
# each flavor's output decodes back under the same flavor.
exec cue export --out ini+flavor=git export-git.cue
cmp stdout export-git.ini
exec cue export ini+flavor=git: export-git.ini
cmp stdout export-git.json
exec cue export -o ini+flavor=git:out.cfg export-git.cue
cmp out.cfg export-git.ini
exec cue export --out ini+flavor=python export-python.cue
cmp stdout export-python.ini
exec cue export ini+flavor=python: export-python.ini
cmp stdout export-python.json
exec cue export --out ini+flavor=systemd export-systemd.cue
cmp stdout export-systemd.ini
exec cue export ini+flavor=systemd: export-systemd.ini
cmp stdout export-systemd.json
exec cue export --out ini+flavor=windows export-windows.cue
cmp stdout export-windows.ini
exec cue export ini+flavor=windows: export-windows.ini
cmp stdout export-windows.json

# A value the flavor cannot write fails naming its path and the option that
# would allow it, and nothing is written: not to standard output, and no
# -o file.
! exec cue export --out ini nested.cue
! stdout .
cmp stderr nested.stderr
! exec cue export -o bad.ini nested.cue
! exists bad.ini
cmp stderr nested.stderr
-- nested.cue --
name: "app"
remote: origin: url: "https://example.com/project.git"
-- nested.stderr --
cannot write section at remote.origin: nested sections need a nesting option; set Config.QuotedSubsections or Config.DottedSections to true to allow it:
    ./nested.cue:2:9
-- export-git.cue --
core: autoCRLF: true
remote: origin: {
	url: "https://example.com/project.git"
	fetch: ["+refs/heads/*:refs/remotes/origin/*", "+refs/tags/*:refs/tags/*"]
}
user: signature: "first line\nsecond line"
-- export-git.ini --
[core]
autoCRLF = true

[remote "origin"]
url = https://example.com/project.git
fetch = +refs/heads/*:refs/remotes/origin/*
fetch = +refs/tags/*:refs/tags/*

[user]
signature = first line\nsecond line
-- export-git.json --
{
    "core": {
        "autocrlf": "true"
    },
    "remote": {
        "origin": {
            "url": "https://example.com/project.git",
            "fetch": [
                "+refs/heads/*:refs/remotes/origin/*",
                "+refs/tags/*:refs/tags/*"
            ]
        }
    },
    "user": {
        "signature": "first line\nsecond line"
    }
}
-- export-python.cue --
metadata: Name: "mypkg"
options: install_requires: "\nrequests\nclick"
-- export-python.ini --
[metadata]
Name = mypkg

[options]
install_requires =
	requests
	click
-- export-python.json --
{
    "metadata": {
        "name": "mypkg"
    },
    "options": {
        "install_requires": "\nrequests\nclick"
    }
}
-- export-systemd.cue --
Service: {
	Environment: ["A=1", "B=2"]
	ExecStart: "/bin/true"
}
-- export-systemd.ini --
[Service]
Environment = A=1
Environment = B=2
ExecStart = /bin/true
-- export-systemd.json --
{
    "Service": {
        "Environment": [
            "A=1",
            "B=2"
        ],
        "ExecStart": "/bin/true"
    }
}
-- export-windows.cue --
Settings: {
	WindowTitle: "  My Application  "
	InstallDir:  "C:\\Program Files\\MyApp"
}
-- export-windows.ini --
[Settings]
WindowTitle = "  My Application  "
InstallDir = C:\Program Files\MyApp
-- export-windows.json --
{
    "Settings": {
        "WindowTitle": "  My Application  ",
        "InstallDir": "C:\\Program Files\\MyApp"
    }
}
-- grafana.cue --
app_mode:      "production"
instance_name: "grafana.example.com"
server: {
	protocol:  "https"
	http_port: 3000
	domain:    "example.com"
}
database: {
	type:          "postgres"
	host:          "db:5432"
	ssl_mode:      "require"
	max_open_conn: 10
}
-- grafana.ini --
app_mode = production
instance_name = grafana.example.com

[server]
protocol = https
http_port = 3000
domain = example.com

[database]
type = postgres
host = db:5432
ssl_mode = require
max_open_conn = 10
-- grafana.json --
{
    "app_mode": "production",
    "instance_name": "grafana.example.com",
    "server": {
        "protocol": "https",
        "http_port": "3000",
        "domain": "example.com"
    },
    "database": {
        "type": "postgres",
        "host": "db:5432",
        "ssl_mode": "require",
        "max_open_conn": "10"
    }
}
-- svc.ini --
[Service]
ExecStart=/bin/echo one ; /bin/echo two
flags = -a #b
-- git.ini --
; Sample git configuration, modelled on a .git/config file read by
; git-config.
[remote "origin"]
	url = https://example.com/project.git
	fetch = +refs/heads/*:refs/remotes/origin/*
	fetch = +refs/tags/*:refs/tags/*
[Core]
	IgnoreCase = true
	sparseCheckout
	excludesFile = ~/.gitignore ; the user-wide ignore list
[alias]
	lg = log --graph \
		--oneline
[user]
	name = "Jane \"JD\" Doe"
	signature = "first line\nsecond line"
[url "https://example.com/"]
	insteadOf = ex:
[alias]
	ci = commit --verbose
-- setup.cfg --
# Sample setup.cfg, modelled on a Python packaging configuration read by
# configparser with its default settings.
[metadata]
Name = mypkg
version = 1.2.3
summary = A sample package
long_description = The first line of the description
    the second line
    the third line
license = Apache-2.0

[options]
python_requires: >=3.9
zip_safe: False
include_package_data: True

[DEFAULT]
verbose = 1
-- unit.service --
# Sample systemd service unit, modelled on a .service file read per
# systemd.syntax(7).
[Unit]
Description=Example service
; Comments may also start with a semicolon.
After=network.target

[Service]
Environment=FIRST=1
Environment=SECOND=2
Environment=THIRD=3
ExecStart=/bin/sh -c 'echo one ; echo two'
ExecReload=/bin/kill -HUP $MAINPID \
# A comment block between the backslash and its continuation is skipped.
; So is this one.
	--timeout 5
Restart=on-failure

[Install]
WantedBy=multi-user.target
-- app.ini --
; Sample Windows profile, modelled on a file read with
; GetPrivateProfileString.
[Settings]
WindowTitle="My Application"
StatusText='Ready'

[Paths]
InstallDir=C:\Program Files\MyApp
DataDir="C:\ProgramData\My App"

[Network]
Timeout=30
; A lookup finds the first occurrence of a key.
Timeout=60
-- plain.conf --
key = value
-- schema.cue --
core: sparsecheckout: bool
-- cue.mod/module.cue --
module: "mod.example"
language: version: "v0.14.0"
-- pkg/x.cue --
package pkg

extra: true
-- pkg/data.ini --
[server]
host = localhost
-- svc.json --
{
    "Service": {
        "ExecStart": "/bin/echo one ; /bin/echo two",
        "flags": "-a #b"
    }
}
-- git.json --
{
    "remote": {
        "origin": {
            "url": "https://example.com/project.git",
            "fetch": [
                "+refs/heads/*:refs/remotes/origin/*",
                "+refs/tags/*:refs/tags/*"
            ]
        }
    },
    "core": {
        "ignorecase": "true",
        "sparsecheckout": true,
        "excludesfile": "~/.gitignore"
    },
    "alias": {
        "lg": "log --graph \t\t--oneline",
        "ci": "commit --verbose"
    },
    "user": {
        "name": "Jane \"JD\" Doe",
        "signature": "first line\nsecond line"
    },
    "url": {
        "https://example.com/": {
            "insteadof": "ex:"
        }
    }
}
-- python.json --
{
    "metadata": {
        "name": "mypkg",
        "version": "1.2.3",
        "summary": "A sample package",
        "long_description": "The first line of the description\nthe second line\nthe third line",
        "license": "Apache-2.0"
    },
    "options": {
        "python_requires": ">=3.9",
        "zip_safe": "False",
        "include_package_data": "True"
    },
    "DEFAULT": {
        "verbose": "1"
    }
}
-- systemd.json --
{
    "Unit": {
        "Description": "Example service",
        "After": "network.target"
    },
    "Service": {
        "Environment": [
            "FIRST=1",
            "SECOND=2",
            "THIRD=3"
        ],
        "ExecStart": "/bin/sh -c 'echo one ; echo two'",
        "ExecReload": "/bin/kill -HUP $MAINPID  \t--timeout 5",
        "Restart": "on-failure"
    },
    "Install": {
        "WantedBy": "multi-user.target"
    }
}
-- windows.json --
{
    "Settings": {
        "WindowTitle": "My Application",
        "StatusText": "Ready"
    },
    "Paths": {
        "InstallDir": "C:\\Program Files\\MyApp",
        "DataDir": "C:\\ProgramData\\My App"
    },
    "Network": {
        "Timeout": "30"
    }
}
-- plain.json --
{
    "key": "value"
}
-- git-import.cue --
remote: origin: {
	url:   "https://example.com/project.git"
	fetch: ["+refs/heads/*:refs/remotes/origin/*", "+refs/tags/*:refs/tags/*"]
}
core: {
	ignorecase:     "true"
	sparsecheckout: true
	excludesfile:   "~/.gitignore"
}
alias: {
	lg: "log --graph \t\t--oneline"
	ci: "commit --verbose"
}
user: {
	name:      "Jane \"JD\" Doe"
	signature: "first line\nsecond line"
}
url: "https://example.com/": insteadof: "ex:"
-- pkg/data.json --
{
    "extra": true,
    "server": {
        "host": "localhost"
    }
}
-- bogus.stderr --
invalid value "bogus" for tag "flavor"; must be one of: git, python, systemd, windows
-- two-flavors.stderr --
conflicting values for tag "flavor": "git" and "systemd"
