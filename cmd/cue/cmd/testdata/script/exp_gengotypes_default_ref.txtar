# A definition whose default the referenced definition subsumes is generated
# as an alias of the referenced type, in both declaration orders.
# See https://cuelang.org/issue/4305
exec cue exp gengotypes ./...
cmp first/cue_types_gen.go first/cue_types_gen.go.want
cmp second/cue_types_gen.go second/cue_types_gen.go.want

-- cue.mod/module.cue --
module: "foo.test/root"
language: version: "v0.13.0"
-- first/first.cue --
package first

#X: *1 | #Y
#Y: int
#S: *{port: 1} | #P
#P: {port: int}
-- second/second.cue --
package second

#Y: int
#X: *1 | #Y
#P: {port: int}
#S: *{port: 1} | #P
-- first/cue_types_gen.go.want --
// Code generated by "cue exp gengotypes"; DO NOT EDIT.

package first

type X Y

type Y int64

type S P

type P struct {
	Port int64 `json:"port"`
}
-- second/cue_types_gen.go.want --
// Code generated by "cue exp gengotypes"; DO NOT EDIT.

package second

type Y int64

type X Y

type P struct {
	Port int64 `json:"port"`
}

type S P
