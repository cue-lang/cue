cd nomod
exec cue exp gengotypes ./...
find-files .
stdout -count=2 '_gen\.go$'
stdout 'pkg1/cue_types_pkg1_gen\.go' # Keep the package name; without a module, there is no import path.
stdout 'pkg2/cue_types_otherpkg_gen\.go'

cd ../withmod
exec cue exp gengotypes ./...
find-files .
stdout -count=2 '_gen\.go$'
stdout 'pkg1/cue_types_gen\.go' # Omit the package name, as it matches the import path.
stdout 'pkg2/cue_types_otherpkg_gen\.go'

# A CUE file with no package clause has no name to give the Go package nor its file.
cd ../nopkg
! exec cue exp gengotypes nopkg.cue
stderr 'cannot generate Go types without a package name'
! exists cue_types_gen.go

# A @go package attribute supplies the Go package name without a CUE package clause.
cd ../gopkgattr
exec cue exp gengotypes gopkgattr.cue
cmp cue_types_gen.go cue_types_gen.go.want
-- nomod/pkg1/pkg1.cue --
package pkg1

#Foo: int
-- nomod/pkg2/pkg2.cue --
package otherpkg

#Foo: int
-- withmod/cue.mod/module.cue --
module: "foo.test/root"
language: version: "v0.13.0"
-- withmod/pkg1/pkg1.cue --
package pkg1

#Foo: int
-- withmod/pkg2/pkg2.cue --
package otherpkg

#Foo: int
-- nopkg/nopkg.cue --
#Foo: int
-- gopkgattr/gopkgattr.cue --
@go(otherpkg)

#Foo: int
-- gopkgattr/cue_types_gen.go.want --
// Code generated by "cue exp gengotypes"; DO NOT EDIT.

package otherpkg

type Foo int64
