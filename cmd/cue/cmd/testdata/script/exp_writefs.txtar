# Test the various features of "cue exp writefs" via "cue cmd".

exists out/to-remove.json
exists out/do-not-remove.md

[!symlink] skip 'symlinks not supported'

exec cue cmd gen
cmp out/foo.yaml expect-yaml
cmp out/foo.json expect-json
cmp out/foo.toml expect-toml
cmp out/foo.txt expect-txt
cmp out/foo-noext expect-txt
cmp out/foo.custom expect-yaml
cmp out/link.yaml expect-yaml
cmp out/sub/dir/foo.yaml expect-nested-yaml

! exists out/to-remove.json
exists out/do-not-remove.md

# Later runs replace whatever is at each path: a symlink with another
# symlink, a regular file with a symlink, and a symlink with a regular
# file, which must not write through the link to its target.
exec cue cmd relink
cmp out/link.yaml expect-txt
exec cue cmd tolink
cmp out/foo.custom expect-txt
exec cue cmd tofile
cmp out/link2.yaml expect-replaced
cmp out/foo.toml expect-toml

-- out/to-remove.json --
-- out/do-not-remove.md --
-- gen_tool.cue --
package p

import (
	"encoding/json"
	"tool/exec"
)

command: gen: exec.Run & {
	cmd: ["cue", "exp", "writefs"]
	stdin: json.Marshal({
		tool: "cue cmd gen"
		remove: ["out/*.json"]
		create: {
			"out/foo.yaml":         {contents: foo: "as yaml"}
			"out/foo.json":         {contents: foo: "as json"}
			"out/foo.toml":         {contents: foo: "as toml"}
			"out/foo.txt":          {contents: "plain text"}
			"out/foo-noext":        {contents: "plain text"}
			"out/foo.custom":       {encoding: "yaml", contents: foo: "as yaml"}
			"out/link.yaml":        {type: "symlink", contents: "foo.yaml"}
			"out/link2.yaml":       {type: "symlink", contents: "foo.toml"}
			"out/sub/dir/foo.yaml": {type: "file", contents: foo: "in nested dir"}
		}
	})
}

_rewrites: {
	relink: "out/link.yaml": {type: "symlink", contents: "foo.txt"}
	tolink: "out/foo.custom": {type: "symlink", contents: "foo.txt"}
	tofile: "out/link2.yaml": {contents: foo: "replaces a link"}
}
for name, files in _rewrites {
	command: (name): exec.Run & {
		cmd: ["cue", "exp", "writefs"]
		stdin: json.Marshal({tool: "cue cmd \(name)", create: files})
	}
}

-- expect-yaml --
# Code generated cue cmd gen; DO NOT EDIT.

foo: as yaml
-- expect-json --
{
    "foo": "as json"
}
-- expect-toml --
# Code generated cue cmd gen; DO NOT EDIT.

foo = 'as toml'
-- expect-txt --
plain text
-- expect-replaced --
# Code generated cue cmd tofile; DO NOT EDIT.

foo: replaces a link
-- expect-nested-yaml --
# Code generated cue cmd gen; DO NOT EDIT.

foo: in nested dir
