cd simple
exec cue export data.cue -e a+c -e d.e.f --out yaml
cmp stdout expect-stdout
cd ..

# Issue 2542 was a regression introduced in CUE v0.6 which was resolved by evalv3.
cd issue2542
exec cue export -e 'obj2.name' input.cue
cmp stdout stdout.golden
cd ..

# Issue 4442: an alias at the top level of an expression
# panicked instead of reporting an error.
cd simple
! exec cue export data.cue -e '[A=0]'
cmp stderr ../issue4442/expect-stderr
cd ..

# Issues 358 and 4297: expressions get the default language experiments of
# their language version, so the aliasv2 'self' identifier, stable as of
# v0.18.0, refers to the top of the instance. Selecting a quoted field such
# as "foo-bar", not addressable as a plain -e identifier, works through it.
cd simple
exec cue export data.cue -e 'self & {e: 5}'
cmp stdout ../issue4297/expect-stdout
cd ..
cd issue358
exec cue export input.cue -e 'self."foo-bar"'
cmp stdout expect-stdout
cd ..

# Expressions are parsed at the language version of the module the command
# runs in, like the module's own files: below v0.18.0, where aliasv2 becomes
# stable, 'self' is not yet available. Outside a module, the current version
# applies, as in the cases above.
cd oldmodule
! exec cue export input.cue -e 'self.x'
cmp stderr expect-stderr
cd ..
cd newmodule
exec cue export input.cue -e 'self.x'
cmp stdout expect-stdout
cd ..

# Issue 4092: an error in an unrelated top-level hidden field must not block
# -e, whether the input is named as a file or resolved as a package. The
# variant where both fields sit inside a struct still fails for both forms.
# TODO(#4092): -e x.a should print 123 for both forms too.
cd issue4092
exec cue export file.cue -e a
cmp stdout expect-stdout
exec cue export -e a
cmp stdout expect-stdout
! exec cue export file.cue -e x.a
stderr 'x\._b: conflicting values int and "foo"'
! exec cue export -e x.a
stderr 'x\._b: conflicting values int and "foo"'
cd ..

-- simple/expect-stdout --
4
---
jam
-- simple/data.cue --
a: 1
c: 3
d: e: f: "jam"
-- issue2542/input.cue --
obj: {
	let this = self
	(#makeName & {enable: this._enable}).out
}

obj: _enable: true

obj2: obj

#makeName: {
	enable: bool
	if enable {
		out: name: "enabled"
	}
	if !enable {
		out: name: "disabled"
	}
}
-- issue2542/stdout.golden --
"enabled"
-- issue4442/expect-stderr --
old-style alias syntax (=) is not allowed with @experiment(aliasv2); use postfix syntax (~X or ~(K,V)):
    --expression:1:3
-- issue4297/expect-stdout --
{
    "a": 1,
    "c": 3,
    "d": {
        "e": {
            "f": "jam"
        }
    },
    "e": 5
}
-- issue358/input.cue --
"foo-bar": two: 2
-- issue358/expect-stdout --
{
    "two": 2
}
-- oldmodule/cue.mod/module.cue --
module: "mod.test/old"
language: version: "v0.17.0"
-- oldmodule/input.cue --
x: 1
-- oldmodule/expect-stderr --
predeclared identifier "self" requires @experiment(aliasv2):
    --expression:1:1
-- newmodule/cue.mod/module.cue --
module: "mod.test/new"
language: version: "v0.18.0"
-- newmodule/input.cue --
x: 1
-- newmodule/expect-stdout --
1
-- issue4092/cue.mod/module.cue --
module: "mod.test/issue4092"
language: version: "v0.18.0"
-- issue4092/file.cue --
package p

a:  123
_b: int & "foo"

x: {
	a:  123
	_b: int & "foo"
}
-- issue4092/expect-stdout --
123
