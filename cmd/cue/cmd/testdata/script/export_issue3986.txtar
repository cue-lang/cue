# An incomplete error in a builtin argument, such as a matchN failure caused
# by an undefined field, is reported as is rather than as a generic
# non-concrete argument error.
# https://cuelang.org/issue/3986

! exec cue export in.cue
cmp stderr stderr.golden

-- in.cue --
import "encoding/yaml"

#OneOf: matchN(1, [#Foo, #Bar])

#Foo: foo: fooField: string
#Bar: bar: barField: string

_templates: #Foo: fooField: "template for foo"

out: yaml.Marshal(#OneOf & {
	foo: _templates.#Foo_typo
})
-- stderr.golden --
out: error in call to encoding/yaml.Marshal: invalid value {foo:_|_(foo: undefined field: #Foo_typo)} (does not satisfy matchN): 0 matched, expected 1:
    ./in.cue:10:6
    ./in.cue:3:9
    ./in.cue:3:16
    ./in.cue:10:19
