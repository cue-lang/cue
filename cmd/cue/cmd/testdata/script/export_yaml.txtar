exec cue export --out yaml ./hello
cmp stdout expect-stdout

# TODO: selecting a field drops the YAML tag from its field attribute,
# unlike a tag from a declaration attribute; want "!Field x".
exec cue export --out yaml -e f tags.cue
cmp stdout expect-tag-field
exec cue export --out yaml -e d tags.cue
cmp stdout expect-tag-decl
-- tags.cue --
f: "x" @yaml(,tag="!Field")
d: {"x", @yaml(,tag="!Decl")}
-- expect-tag-field --
x
-- expect-tag-decl --
!Decl x
-- expect-stdout --
message: Hello World!
test: {}
-- hello/data.cue --
package hello

_who: "World"
-- hello/hello.cue --
package hello

message: "Hello \(_who)!" // who declared in data.cue

test: {
	_foo: string // technically in error, but test anyway.
	if *(len(_foo) > 0) | false {
		command: ["foo", "bar"]
	}
}
-- hello/cue.mod/module.cue --
