# The toml golden for #Pointers allows null, which TOML cannot encode.

# Test default behavior (json,yaml)
exec cue get go --local ./...
cmp ./pkg/pkg_go_gen.cue ./pkg/pkg_go_gen_default.cue.golden

# Test yaml priority
exec cue get go --local --codec=yaml,json ./...
cmp ./pkg/pkg_go_gen.cue ./pkg/pkg_go_gen_yaml.cue.golden

# Test yaml only
exec cue get go --local --codec=yaml ./...
cmp ./pkg/pkg_go_gen.cue ./pkg/pkg_go_gen_yaml_only.cue.golden

# Test toml only
exec cue get go --local --codec=toml ./...
cmp ./pkg/pkg_go_gen.cue ./pkg/pkg_go_gen_toml_only.cue.golden

-- go.mod --
module mod.test

go 1.21
-- cue.mod/module.cue --
module: "mod.test"
language: version: "v0.15.0"
-- pkg/pkg.go --
package pkg

type OnlyJson struct {
	F1 int `json:"f1_json"`
	F2 int
}

type OnlyYaml struct {
	F1 int `yaml:"f1_yaml"`
	F2 int
}

type Overlapping struct {
	F1 int `json:"f1_json" yaml:"f1_yaml"`
	F2 int `json:"f2_json"`
}

type Disjoint struct {
	F1 int `json:"f1_json"`
	F2 int `yaml:"f2_yaml"`
}

// Only the tag which names a field, or the first tag present, decides
// whether the field is optional.
type Optional struct {
	F1 int `json:"f1_json,omitempty"`
	F2 int `json:"f2_json,omitzero"`
	F3 int `yaml:"f3_yaml,omitempty"`
	F4 int `yaml:"f4_yaml,omitzero"`
	F5 int `toml:"f5_toml,omitempty"`
	F6 int `toml:"f6_toml,omitzero"`
	F7 int `json:"f7_json,omitempty" yaml:"f7_yaml"`
	F8 int `json:"f8_json" yaml:"f8_yaml,omitempty"`
	F9 int `json:",omitempty" yaml:"f9_yaml"`
}

// Pointer fields are nullable except under TOML, which has no null.
type Pointers struct {
	F1 *int
	F2 *int `json:"f2_json"`
	F3 *int `toml:"f3_toml"`
}
-- pkg/pkg_go_gen_default.cue.golden --
// Code generated by cue get go. DO NOT EDIT.

//cue:generate cue get go mod.test/pkg

package pkg

#OnlyJson: {
	f1_json: int @go(F1)
	F2:      int
}

#OnlyYaml: {
	f1_yaml: int @go(F1)
	F2:      int
}

#Overlapping: {
	f1_json: int @go(F1)
	f2_json: int @go(F2)
}

#Disjoint: {
	f1_json: int @go(F1)
	f2_yaml: int @go(F2)
}

// Only the tag which names a field, or the first tag present, decides
// whether the field is optional.
#Optional: {
	f1_json?: int @go(F1)
	f2_json?: int @go(F2)
	f3_yaml?: int @go(F3)
	f4_yaml?: int @go(F4)
	F5:       int @toml(f5_toml,omitempty)
	F6:       int @toml(f6_toml,omitzero)
	f7_json?: int @go(F7)
	f8_json:  int @go(F8)
	f9_yaml:  int @go(F9)
}

// Pointer fields are nullable except under TOML, which has no null.
#Pointers: {
	F1?:      null | int @go(,*int)
	f2_json?: null | int @go(F2,*int)
	F3?:      null | int @go(,*int) @toml(f3_toml)
}
