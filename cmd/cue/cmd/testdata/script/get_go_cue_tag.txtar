# Test that cue struct tags add constraints to the generated fields.
# A tag which is not a valid CUE expression should add no constraint,
# but its partial expression is added, making the field bottom.

exec cue get go --local
cmp x_go_gen.cue x_go_gen.cue.golden

-- go.mod --
module mod.test/x

go 1.25
-- x.go --
package x

type T struct {
	Good int `cue:">5"`
	Bad  int `cue:">5 &"`
}
-- x_go_gen.cue.golden --
// Code generated by cue get go. DO NOT EDIT.

//cue:generate cue get go mod.test/x

package x

#T: {
	Good: int & >5
	Bad:  int & >5 & _|_
}
