    ./go_marshal.json:59:10
ObjectShadowed.status: field not allowed:
    ./go_marshal.json:60:10
OmitEmpty.kind: field not allowed:
    ./go_marshal.json:17:10
Pointer.kind: field not allowed:
    ./go_marshal.json:30:10
Shadowed.other: field not allowed:
    ./go_marshal.json:45:10
Unexported.hidden: field not allowed:
    ./go_marshal.json:41:10
Untagged.kind: field not allowed:
    ./go_marshal.json:3:10
