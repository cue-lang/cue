-- decls/p_go_gen.cue.golden --
// Code generated by cue get go. DO NOT EDIT.

//cue:generate cue get go mod.test/decls

package decls

import "mod.test/meta"

#Base: kind: string @go(Kind)

#Other: other: string @go(Other)

#Str: string

_#inner: hidden: string @go(Hidden)

#Untagged: {
	Base: #Base
	x:    int @go(X)
}

#EmptyTag: {
	TypeMeta: meta.#TypeMeta
	x:        int @go(X)
}

#Inline: {
	meta.#TypeMeta
	x: int @go(X)
}

#OmitEmpty: {
	Base?: #Base
	x:     int @go(X)
}

#Named: {
	base: #Base @go(Base)
	x:    int   @go(X)
}

#Ignored: x: int @go(X)

#Pointer: {
	Base?: null | #Base @go(,*Base)
	x:     int          @go(X)
}

#NonStruct: {
	Str: #Str
	x:   int @go(X)
}

#Unexported: x: int @go(X)

// Shadowed hides the kind field of Base.
#Shadowed: {
	Base:  #Base
	Other: #Other
	kind:  int @go(Kind)
}

// Ambiguous drops the kind field, as it is embedded twice at the same depth.
#Ambiguous: {
	Base:     #Base
	TypeMeta: meta.#TypeMeta
}

// ObjectShadowed hides the kind field of meta.Object, whose other fields
// are promoted individually, even when their types are not exported.
#ObjectShadowed: {
	Object: meta.#Object
	kind:   int @go(Kind)
}

// Recursive embeds itself, whose fields are all hidden.
#Recursive: {
	Recursive?: null | #Recursive @go(,*Recursive)
	value:      int               @go(Value)
}

#Mutual1: {
	Mutual2?: null | #Mutual2 @go(,*Mutual2)
	x:        int             @go(X)
}

#Mutual2: {
	Mutual1?: null | #Mutual1 @go(,*Mutual1)
	y:        int             @go(Y)
}

#Root: {
	Untagged:       #Untagged
	EmptyTag:       #EmptyTag
	Inline:         #Inline
	OmitEmpty:      #OmitEmpty
	Named:          #Named
	Ignored:        #Ignored
	Pointer:        #Pointer
	PointerNil:     #Pointer
	NonStruct:      #NonStruct
	Unexported:     #Unexported
	Shadowed:       #Shadowed
	Ambiguous:      #Ambiguous
	Recursive:      #Recursive
	Mutual:         #Mutual1
	ObjectShadowed: #ObjectShadowed
}
