exec cue get go --local --exclude '^X'
cmp blah_go_gen.cue blah.cue.golden
cmp sub/sub_go_gen.cue sub/sub.cue.golden

# References to excluded types and constants are left dangling.
! exec cue vet -c=false ./...
stderr '#Y3.B: reference "#X3" not found'
stderr '#enumY4: reference "#X5" not found'

-- go.mod --
module mod.test/blah

go 1.18
-- cue.mod/module.cue --
module: "mod.test/blah"
language: version: "v0.15.0"
-- blah.go --
package main

import "mod.test/blah/sub"

type X1 string
type Y1 string

const X2 = 3
const Y2 = 4

type X3 struct {
	A string
}

type Y3 struct {
	X3
	B X3
	C *X3
	D sub.XSub
	E sub.YSub
}

type Y4 int

const (
	X5 Y4 = 1
	Y5 Y4 = 2
)
-- sub/sub.go --
package sub

type XSub struct {
	F string
}

type YSub int
-- blah.cue.golden --
// Code generated by cue get go. DO NOT EDIT.

//cue:generate cue get go mod.test/blah --exclude=^X

package main

import "mod.test/blah/sub"

#Y1: string

#Y2: 4

#Y3: {
	#X3
	B:  #X3
	C?: null | #X3 @go(,*X3)
	D:  sub.#XSub
	E:  sub.#YSub
}

#Y4: int // #enumY4

#enumY4:
	#X5 |
		#Y5

#values_Y4: {
	X5: #X5
	Y5: #Y5
}
#Y5: #Y4 & 2
-- sub/sub.cue.golden --
// Code generated by cue get go. DO NOT EDIT.

//cue:generate cue get go mod.test/blah/sub --exclude=^X

package sub

#YSub: int
