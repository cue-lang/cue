# Check that 'cue get go' supports the encoding/json features added in Go 1.27,
# whose v1 API is now implemented on top of encoding/json/v2.
# TODO: once Go 1.27 or later is required, merge these cases into get_go_embed.txtar.
[!go1.27] skip 'requires encoding/json/v2 and jsontext'

exec cue get go --local ./decls
cmp decls/p_go_gen.cue decls/p_go_gen.cue.golden

# Marshal via Go's encoding/json and validate with the generated CUE schema.
exec go run ./marshal
cmp stdout go_marshal.json
exec cue vet -c schema.cue go_marshal.json

-- schema.cue --
package schema

import "mod.test/decls"

decls.#Root

-- go.mod --
module mod.test

go 1.27
-- cue.mod/module.cue --
module: "mod.test"
language: version: "v0.15.0"
-- decls/p.go --
package decls

import "encoding/json/jsontext"

type Base struct {
	Kind string `json:"kind"`
}

// EmbedOption promotes the fields of a named field.
type EmbedOption struct {
	Base Base `json:",embed"`
	X    int  `json:"x"`
}

// MapFallback holds any other object members in a map.
type MapFallback struct {
	X     int            `json:"x"`
	Extra map[string]int `json:",embed"`
}

type Rest struct {
	Rest map[string]int `json:",embed"`
}

// NestedFallback holds any other object members in an embedded struct.
type NestedFallback struct {
	Rest
	Name string `json:"name"`
}

type OtherRest struct {
	OtherRest map[string]string `json:",embed"`
}

// TiedFallbacks drops both fallbacks, as they are at the same depth.
type TiedFallbacks struct {
	Rest
	OtherRest
	Name string `json:"name"`
}

// ShallowFallback hides the fallback at a deeper depth.
type ShallowFallback struct {
	Rest
	Own map[string]bool `json:",embed"`
}

// ValueFallback holds any other object members in a jsontext.Value.
type ValueFallback struct {
	Base
	Rest jsontext.Value `json:",embed"`
}

// MarshalerTo is encoded via its own method.
type MarshalerTo struct {
	X int `json:"x"`
}

func (m MarshalerTo) MarshalJSONTo(enc *jsontext.Encoder) error {
	return enc.WriteToken(jsontext.String("custom"))
}

type Root struct {
	EmbedOption   EmbedOption
	MapFallback   MapFallback
	ValueFallback ValueFallback
	MarshalerTo   MarshalerTo

	NestedFallback  NestedFallback
	TiedFallbacks   TiedFallbacks
	ShallowFallback ShallowFallback
}
-- marshal/main.go --
package main

import (
	"encoding/json"
	"fmt"
	"log"

	"mod.test/decls"
)

func main() {
	r := decls.Root{
		EmbedOption: decls.EmbedOption{Base: decls.Base{Kind: "k"}, X: 1},
		MapFallback: decls.MapFallback{X: 1, Extra: map[string]int{"y": 2}},
		ValueFallback: decls.ValueFallback{
			Base: decls.Base{Kind: "k"},
			Rest: []byte(`{"other":[true]}`),
		},
		MarshalerTo: decls.MarshalerTo{X: 1},

		NestedFallback: decls.NestedFallback{
			Rest: decls.Rest{Rest: map[string]int{"y": 2}},
			Name: "n",
		},
		TiedFallbacks: decls.TiedFallbacks{
			Rest:      decls.Rest{Rest: map[string]int{"y": 2}},
			OtherRest: decls.OtherRest{OtherRest: map[string]string{"z": "s"}},
			Name:      "n",
		},
		ShallowFallback: decls.ShallowFallback{
			Rest: decls.Rest{Rest: map[string]int{"y": 2}},
			Own:  map[string]bool{"z": true},
		},
	}
	// Mimic the formatting of `cue export` to be able to compare bytes.
	data, err := json.MarshalIndent(r, "", "    ")
	if err != nil {
		log.Fatal(err)
	}
	fmt.Printf("%s\n", data)
}
-- go_marshal.json --
{
    "EmbedOption": {
        "kind": "k",
        "x": 1
    },
    "MapFallback": {
        "x": 1,
        "y": 2
    },
    "ValueFallback": {
        "kind": "k",
        "other": [
            true
        ]
    },
    "MarshalerTo": "custom",
    "NestedFallback": {
        "name": "n",
        "y": 2
    },
    "TiedFallbacks": {
        "name": "n"
    },
    "ShallowFallback": {
        "z": true
    }
}
-- decls/p_go_gen.cue.golden --
// Code generated by cue get go. DO NOT EDIT.

//cue:generate cue get go mod.test/decls

package decls

#Base: kind: string @go(Kind)

// EmbedOption promotes the fields of a named field.
#EmbedOption: {
	#Base
	x: int @go(X)
}

// MapFallback holds any other object members in a map.
#MapFallback: {
	x:       int @go(X)
	[!="x"]: int
}

#Rest: [string]: int

// NestedFallback holds any other object members in an embedded struct.
#NestedFallback: {
	[!="name"]: int
	name:       string @go(Name)
}

#OtherRest: [string]: string

// TiedFallbacks drops both fallbacks, as they are at the same depth.
#TiedFallbacks: name: string @go(Name)

// ShallowFallback hides the fallback at a deeper depth.
#ShallowFallback: [string]: bool

// ValueFallback holds any other object members in a jsontext.Value.
#ValueFallback: {
	#Base
	...
}

// MarshalerTo is encoded via its own method.
#MarshalerTo: _

#Root: {
	EmbedOption:     #EmbedOption
	MapFallback:     #MapFallback
	ValueFallback:   #ValueFallback
	MarshalerTo:     #MarshalerTo
	NestedFallback:  #NestedFallback
	TiedFallbacks:   #TiedFallbacks
	ShallowFallback: #ShallowFallback
}
