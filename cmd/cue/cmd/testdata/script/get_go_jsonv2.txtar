# Check that the jsonv2 codec of 'cue get go' follows encoding/json/v2.
# TODO: drop the skip once Go 1.27 or later is required.
[!go1.27] skip 'requires encoding/json/v2'

! exec cue get go --local --codec=json,jsonv2 ./decls
stderr '^codecs json and jsonv2 both read "json" tags$'

# The json codec follows the v1 API of encoding/json instead.
exec cue get go --local ./decls
cmp decls/p_go_gen.cue decls/p_go_gen_json.cue.golden

exec cue get go --local --codec=jsonv2 ./decls
cmp decls/p_go_gen.cue decls/p_go_gen.cue.golden

# Marshal via Go's encoding/json/v2 and validate with the generated CUE schema.
exec go run ./marshal
cmp stdout go_marshal.json
exec cue vet -c schema.cue go_marshal.json

-- schema.cue --
package schema

import "mod.test/decls"

decls.#Root

-- go.mod --
module mod.test

go 1.27
-- cue.mod/module.cue --
module: "mod.test"
language: version: "v0.15.0"
-- decls/p.go --
package decls

import "time"

// OmitEmpty only omits values encoded as empty JSON values.
type OmitEmpty struct {
	Int     int     `json:",omitempty"`
	Bool    bool    `json:",omitempty"`
	String  string  `json:",omitempty"`
	Slice   []int   `json:",omitempty"`
	Pointer *int    `json:",omitempty"`
	Zero    int     `json:",omitzero"`
	Quoted  float64 `json:",omitempty,string"`
}

// Nil slices and maps are encoded as empty arrays and objects.
type Nil struct {
	Slice []int
	Map   map[string]int
}

type Embedded struct {
	Kind string `json:"kind"`
}

// Valid is accepted by encoding/json/v2.
type Valid struct {
	Embedded `json:",inline"`
	Rest     map[string]int `json:",embed"`
}

// Each of the following struct types is rejected by encoding/json/v2.

type Duration struct {
	D time.Duration
}

type StringBool struct {
	B bool `json:",string"`
}

type Unexported struct {
	x int `json:"x"`
}

type Duplicate struct {
	A int `json:"a"`
	B int `json:"a"`
}

type Misspelled struct {
	A int `json:",omitEmpty"`
}

type Format struct {
	T time.Time `json:",format:RFC3339"`
}

type MyInt int

type EmbeddedInt struct {
	MyInt
}

type Root struct {
	OmitEmpty OmitEmpty
	Nil       Nil
	Valid     Valid

	Duration    Duration
	StringBool  StringBool
	Unexported  Unexported
	Duplicate   Duplicate
	Misspelled  Misspelled
	Format      Format
	EmbeddedInt EmbeddedInt
}
-- marshal/main.go --
package main

import (
	"encoding/json/jsontext"
	"encoding/json/v2"
	"fmt"
	"log"

	"mod.test/decls"
)

// ValidRoot holds the fields of [decls.Root] which encoding/json/v2 accepts.
type ValidRoot struct {
	OmitEmpty decls.OmitEmpty
	Nil       decls.Nil
	Valid     decls.Valid
}

func main() {
	r := ValidRoot{
		Valid: decls.Valid{
			Embedded: decls.Embedded{Kind: "k"},
			Rest:     map[string]int{"x": 1},
		},
	}
	// Mimic the formatting of `cue export` to be able to compare bytes.
	data, err := json.Marshal(r, jsontext.WithIndent("    "), json.Deterministic(true))
	if err != nil {
		log.Fatal(err)
	}
	fmt.Printf("%s\n", data)

	// Check that the other types are indeed rejected.
	for _, v := range []any{
		decls.Duration{},
		decls.StringBool{},
		decls.Unexported{},
		decls.Duplicate{},
		decls.Misspelled{},
		decls.Format{},
		decls.EmbeddedInt{},
	} {
		if _, err := json.Marshal(v); err == nil {
			log.Fatalf("%T was not rejected", v)
		}
	}
}
-- go_marshal.json --
{
    "OmitEmpty": {
        "Int": 0,
        "Bool": false,
        "Quoted": "0"
    },
    "Nil": {
        "Slice": [],
        "Map": {}
    },
    "Valid": {
        "kind": "k",
        "x": 1
    }
}
-- decls/p_go_gen.cue.golden --
// Code generated by cue get go. DO NOT EDIT.

//cue:generate cue get go mod.test/decls --codec=jsonv2

package decls

// OmitEmpty only omits values encoded as empty JSON values.
#OmitEmpty: {
	Int:      int
	Bool:     bool
	String?:  string
	Slice?:   [...int]   @go(,[]int)
	Pointer?: null | int @go(,*int)
	Zero?:    int
	Quoted:   string     @go(,float64)
}

// Nil slices and maps are encoded as empty arrays and objects.
#Nil: {
	Slice: [...int]        @go(,[]int)
	Map:   {[string]: int} @go(,map[string]int)
}

#Embedded: kind: string @go(Kind)

// Valid is accepted by encoding/json/v2.
#Valid: {
	#Embedded
	[!="kind"]: int
}

#MyInt: int

#Root: {
	OmitEmpty: #OmitEmpty
	Nil:       #Nil
	Valid:     #Valid
}
-- decls/p_go_gen_json.cue.golden --
