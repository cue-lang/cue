# Test that --omit leaves out the declarations matched by its selectors,
# given by package name or import path, and translates references to top.

exec cue get go --local --omit='*.Internal*' --omit=main.Hidden,mod.test/blah/sub.Sub* ./...
cmp blah_go_gen.cue blah.cue.golden
cmp sub/sub_go_gen.cue sub/sub.cue.golden
exec cue vet -c=false ./...

# The command recorded for a dependency regenerates it as is, keeping
# only the selectors which match in the dependency or its own imports.
exec cue get go --local mod.test/blah/sub --omit=mod.test/blah/sub.Sub*
cmp sub/sub_go_gen.cue sub/sub.cue.golden

# Selectors must be well-formed.
! exec cue get go --local --omit=Hidden .
stderr '^invalid --omit selector "Hidden": must be qualified by a package, such as "\*.Hidden"$'
! exec cue get go --local --omit=main. .
stderr '^invalid --omit selector "main.": must not have empty elements$'
! exec cue get go --local --omit='main.[' .
stderr '^invalid --omit selector "main.\[": syntax error in pattern$'
! exec cue get go --local --omit=a.b.c.Hidden .
stderr '^invalid --omit selector "a.b.c.Hidden": must be pkg.Name or pkg.Name.Method$'
! exec cue get go --local --omit=mod.test/blah .
stderr '^invalid --omit selector "mod.test/blah": must be pkg.Name or pkg.Name.Method$'

# Selectors must be able to match Go identifiers and import paths.
! exec cue get go --local --omit=main.Foo-Bar .
stderr '^invalid --omit selector "main.Foo-Bar": "Foo-Bar" can never match a Go identifier$'
! exec cue get go --local --omit='main.1*' .
stderr '^invalid --omit selector "main.1\*": "1\*" can never match a Go identifier$'
! exec cue get go --local --omit=my-pkg.Hidden .
stderr '^invalid --omit selector "my-pkg.Hidden": "my-pkg" can never match a Go identifier$'
! exec cue get go --local --omit='mod.test/bl@h.Hidden' .
stderr '^invalid --omit selector "mod.test/bl@h.Hidden": "mod.test/bl@h" can never match an import path$'

# Valid selectors must each match a declaration.
! exec cue get go --local --omit=main.Missing .
stderr '^--omit selector "main.Missing" matches nothing$'
! exec cue get go --local --omit=sub.Hidden .
stderr '^--omit selector "sub.Hidden" matches nothing$'

# A package given as an argument is never mistaken for the standard library,
# even when its import path has no dot.
cd dotless
exec cue get go --local --omit=main.Hidden .
cmp dotless_go_gen.cue dotless.cue.golden

-- go.mod --
module mod.test/blah

go 1.18
-- cue.mod/module.cue --
module: "mod.test/blah"
language: version: "v0.15.0"
-- blah.go --
package main

import "mod.test/blah/sub"

type Hidden struct {
	A string
}

type InternalKind int

const (
	InternalOne InternalKind = 1
	Two         Kind         = 2
)

type Kind int

const InternalThree Kind = 3

type T struct {
	Hidden
	B Hidden
	C *Hidden
	D InternalKind
	E sub.SubType
	F sub.Other
}
-- sub/sub.go --
package sub

type SubType struct {
	G string
}

type Other int
-- blah.cue.golden --
// Code generated by cue get go. DO NOT EDIT.

//cue:generate cue get go mod.test/blah --omit=*.Internal*,main.Hidden,mod.test/blah/sub.Sub*

package main

import "mod.test/blah/sub"

#Two: #Kind & 2

#Kind: int // #enumKind

#enumKind:
	#Two

#values_Kind: Two: #Two

#T: {
	A:  string
	B:  _        @go(,Hidden)
	C?: null | _ @go(,*Hidden)
	D:  _        @go(,InternalKind)
	E:  _        @go(,sub.SubType)
	F:  sub.#Other
}
-- sub/sub.cue.golden --
// Code generated by cue get go. DO NOT EDIT.

//cue:generate cue get go mod.test/blah/sub --omit=mod.test/blah/sub.Sub*

package sub

#Other: int
-- dotless/go.mod --
module dotless

go 1.18
-- dotless/cue.mod/module.cue --
module: "dotless.example"
language: version: "v0.15.0"
-- dotless/dotless.go --
package main

type Hidden struct{}

type Shown struct{}
-- dotless/dotless.cue.golden --
// Code generated by cue get go. DO NOT EDIT.

//cue:generate cue get go dotless --omit=main.Hidden

package main

#Shown: {}
