# Test that --omit selectors of the form pkg.Name.Method translate types
# as if they lacked the matched encoding methods, such as when a type only
# implements json.Unmarshaler to validate its input.
# See https://cuelang.org/issue/2466.

# By default, types with encoding methods are translated to top or string.
exec cue get go --local ./...
cmp blah_go_gen.cue default.cue.golden

# The selectors omit all methods, one method which leaves MarshalText,
# a promoted method, the YAML methods of all types, the methods of a type
# referenced via a pointer, and the methods of a type whose import path
# has a dot after its last slash.
exec cue get go --local --omit=main.Validated.*,main.Lenient.UnmarshalJSON,main.Outer.MarshalJSON,*.*.*YAML,main.Unsupported.*,mod.test/blah/sub.v2.Versioned.* ./...
cmp blah_go_gen.cue omit.cue.golden
cmp sub.v2/sub_go_gen.cue sub.v2/omit.cue.golden
exec cue vet -c=false ./...

# The command recorded for a dependency regenerates it as is.
exec cue get go --local mod.test/blah/sub.v2 --omit=mod.test/blah/sub.v2.Versioned.*
cmp sub.v2/sub_go_gen.cue sub.v2/omit.cue.golden

# Method selectors must name encoding methods which the matched types have.
! exec cue get go --local --omit=main.Validated.String .
stderr '^invalid --omit selector "main.Validated.String": method "String" must match one of MarshalJSON, UnmarshalJSON, MarshalYAML, UnmarshalYAML, MarshalText, UnmarshalText, MarshalJSONTo, UnmarshalJSONFrom$'
# A misspelled method is reported as such, even when the selector
# could also be read as a declaration in a package with a dotted path.
! exec cue get go --local --omit=mod.test/blah/sub.v2.Versioned.MarshalJSN .
stderr '^invalid --omit selector "mod.test/blah/sub.v2.Versioned.MarshalJSN": method "MarshalJSN" must match one of .*$'
! exec cue get go --local --omit=main.Validated.MarshalYAML .
stderr '^--omit selector "main.Validated.MarshalYAML" matches nothing$'
! exec cue get go --local --omit=main.Plain.* .
stderr '^--omit selector "main.Plain.\*" matches nothing$'
! exec cue get go --local --omit=main.Odd.MarshalJSON .
stderr '^--omit selector "main.Odd.MarshalJSON" matches nothing$'
! exec cue get go --local --omit=main.LenientAlias.* .
stderr '^--omit selector "main.LenientAlias.\*" matches nothing; LenientAlias is an alias, so select the methods of main.Lenient instead$'
! exec cue get go --local --omit=main.PlainAlias.* .
stderr '^--omit selector "main.PlainAlias.\*" matches nothing$'
! exec cue get go --local --omit=main.Validated. .
stderr '^invalid --omit selector "main.Validated.": must not have empty elements$'

-- go.mod --
module mod.test/blah

go 1.18
-- cue.mod/module.cue --
module: "mod.test/blah"
language: version: "v0.15.0"
-- blah.go --
package main

import (
	"encoding/json"
	"errors"

	"mod.test/blah/sub.v2"
)

// Validated decodes like a plain struct, recording any error.
type Validated struct {
	Name  string `json:"name"`
	Error string `json:"-"`
}

func (v *Validated) UnmarshalJSON(data []byte) error {
	type plain Validated
	if err := json.Unmarshal(data, (*plain)(v)); err != nil {
		v.Error = err.Error()
	}
	return nil
}

// Lenient is a string which also decodes from a JSON number.
type Lenient string

func (l *Lenient) UnmarshalJSON(data []byte) error { return nil }

func (l Lenient) MarshalText() ([]byte, error) { return []byte(l), nil }

type LenientAlias = Lenient

type Inner struct {
	Field string `json:"field"`
}

func (Inner) MarshalJSON() ([]byte, error) { return nil, errors.New("unused") }

// Outer has the promoted method Inner.MarshalJSON.
type Outer struct {
	Inner
	Extra int `json:"extra"`
}

// YAMLOnly is only decoded from YAML with a custom method.
type YAMLOnly struct {
	Count int `json:"count"`
}

func (y *YAMLOnly) UnmarshalYAML(unmarshal func(any) error) error { return nil }

type Plain struct{}

type PlainAlias = Plain

// Odd has a MarshalJSON method which encoding/json does not use.
type Odd struct {
	N int `json:"n"`
}

func (Odd) MarshalJSON() string { return "" }

// Unsupported has no fields which can be encoded.
type Unsupported struct {
	C chan int `json:"c"`
}

func (u *Unsupported) UnmarshalJSON(data []byte) error { return nil }

type T struct {
	V Validated     `json:"v"`
	L Lenient       `json:"l"`
	O Outer         `json:"o"`
	Y YAMLOnly      `json:"y"`
	S sub.Versioned `json:"s"`
	P Plain         `json:"p"`
	U *Unsupported  `json:"u"`
}
-- sub.v2/sub.go --
package sub

type Versioned struct {
	Version int `json:"version"`
}

func (v Versioned) MarshalJSON() ([]byte, error) { return nil, nil }
-- default.cue.golden --
// Code generated by cue get go. DO NOT EDIT.

//cue:generate cue get go mod.test/blah

package main

import "mod.test/blah/sub.v2:sub"

// Validated decodes like a plain struct, recording any error.
#Validated: _

// Lenient is a string which also decodes from a JSON number.
#Lenient: _

#LenientAlias: _

#Inner: _

// Outer has the promoted method Inner.MarshalJSON.
#Outer: _

// YAMLOnly is only decoded from YAML with a custom method.
#YAMLOnly: _

#Plain: {}

#PlainAlias: #Plain

// Odd has a MarshalJSON method which encoding/json does not use.
#Odd: n: int @go(N)

// Unsupported has no fields which can be encoded.
#Unsupported: _

#T: {
	v:  #Validated          @go(V)
	l:  #Lenient            @go(L)
	o:  #Outer              @go(O)
	y:  #YAMLOnly           @go(Y)
	s:  sub.#Versioned      @go(S)
	p:  #Plain              @go(P)
	u?: null | #Unsupported @go(U,*Unsupported)
}
-- omit.cue.golden --
// Code generated by cue get go. DO NOT EDIT.

//cue:generate cue get go mod.test/blah --omit=main.Validated.*,main.Lenient.UnmarshalJSON,main.Outer.MarshalJSON,*.*.*YAML,main.Unsupported.*,mod.test/blah/sub.v2.Versioned.*

package main

import "mod.test/blah/sub.v2:sub"

// Validated decodes like a plain struct, recording any error.
#Validated: name: string @go(Name)

// Lenient is a string which also decodes from a JSON number.
#Lenient: string

#LenientAlias: string

#Inner: _

// Outer has the promoted method Inner.MarshalJSON.
#Outer: {
	field: string @go(Field)
	extra: int    @go(Extra)
}

// YAMLOnly is only decoded from YAML with a custom method.
#YAMLOnly: count: int @go(Count)

#Plain: {}

#PlainAlias: #Plain

// Odd has a MarshalJSON method which encoding/json does not use.
#Odd: n: int @go(N)

#T: {
	v: #Validated     @go(V)
	l: #Lenient       @go(L)
	o: #Outer         @go(O)
	y: #YAMLOnly      @go(Y)
	s: sub.#Versioned @go(S)
	p: #Plain         @go(P)
}
-- sub.v2/omit.cue.golden --
// Code generated by cue get go. DO NOT EDIT.

//cue:generate cue get go mod.test/blah/sub.v2 --omit=mod.test/blah/sub.v2.Versioned.*

package sub

#Versioned: version: int @go(Version)
