Pointer: conflicting values "3" and null (mismatched types string and null):
    ./decls/p_go_gen.cue:15:15
    ./go_marshal.json:7:16
    ./schema.cue:5:1
-- go_marshal.json --
{
    "Int": "1",
    "Float": "1.5",
    "Bool": "true",
    "String": "\"s\"",
    "Named": "2",
    "Pointer": "3",
    "NilPointer": null,
    "Slice": [
        4
    ]
}
-- decls/p_go_gen.cue.golden --
// Code generated by cue get go. DO NOT EDIT.

//cue:generate cue get go mod.test/decls

package decls

#MyInt: int

#T: {
	Int:         int
	Float:       float64
	Bool:        bool
	String:      string
	Named:       #MyInt
	Pointer?:    null | int @go(,*int)
	NilPointer?: null | int @go(,*int)

	// The option does not apply to other types.
	Slice: [...int] @go(,[]int)
}
