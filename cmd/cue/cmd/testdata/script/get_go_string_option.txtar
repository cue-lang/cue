# Check that 'cue get go' follows the "string" option of encoding/json,
# which encodes booleans, numbers, and strings as JSON strings.

exec cue get go --local ./decls
cmp decls/p_go_gen.cue decls/p_go_gen.cue.golden

# Marshal via Go's encoding/json and validate with the generated CUE schema.
# The generated schema ignores the option.
exec go run ./marshal
cmp stdout go_marshal.json
! exec cue vet -c schema.cue go_marshal.json
cmp stderr vet_stderr.golden

-- schema.cue --
package schema

import "mod.test/decls"

decls.#T

-- go.mod --
module mod.test

go 1.21
-- cue.mod/module.cue --
module: "mod.test"
language: version: "v0.15.0"
-- decls/p.go --
package decls

type MyInt int

type T struct {
	Int        int     `json:",string"`
	Float      float64 `json:",string"`
	Bool       bool    `json:",string"`
	String     string  `json:",string"`
	Named      MyInt   `json:",string"`
	Pointer    *int    `json:",string"`
	NilPointer *int    `json:",string"`

	// The option does not apply to other types.
	Slice []int `json:",string"`
}
-- marshal/main.go --
package main

import (
	"encoding/json"
	"fmt"
	"log"

	"mod.test/decls"
)

func main() {
	n := 3
	t := decls.T{
		Int:     1,
		Float:   1.5,
		Bool:    true,
		String:  "s",
		Named:   2,
		Pointer: &n,
		Slice:   []int{4},
	}
	// Mimic the formatting of `cue export` to be able to compare bytes.
	data, err := json.MarshalIndent(t, "", "    ")
	if err != nil {
		log.Fatal(err)
	}
	fmt.Printf("%s\n", data)
}
