# Test that we properly print errors when there are fatal errors
# in loading Go packages, such as a typechecking error.
# Function bodies are not type-checked, as only declarations are extracted,
# so neither the error in F nor its use of the utf8 import is reported.

! exec cue get go --local
! stdout .
cmpenv stderr stderr.golden

-- go.mod --
module mod.test/blah

go 1.14
-- blah.go --
package main

import "unicode/utf8"

var someInt int = "not an int"

type T struct {
	Age int
}

func F() int {
	var s string = 3
	utf8.RuneCountInString(s)
}
-- stderr.golden --
${WORK}${/}blah.go:5:19: cannot use "not an int" (untyped string constant) as int value in variable declaration
