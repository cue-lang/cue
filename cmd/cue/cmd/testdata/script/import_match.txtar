exec cue import -p uni --with-context -l 'path.Ext(filename)' -n '.*uni.yml' ./...
cmp uni.cue out/expect-uni.cue

# -n/--name only filters files found in directories.
! exec cue import -n '.*uni.yml' service.yaml
cmp stderr out/expect-stderr-nodir
-- uni.yml --
hello: world
-- service.yaml --
x: foobie
-- out/expect-uni.cue --
package uni

".yml": hello: "world"
-- out/expect-stderr-nodir --
use of -n/--name flag without a directory
