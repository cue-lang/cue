# YAML plain scalars must resolve numbers per YAML's rules, not CUE's:
# Kubernetes-style quantities such as 1Gi are valid CUE numbers but are
# strings in YAML. Conversely, numbers which YAML resolves but which are
# not lexed as numbers by the YAML parser, such as integers beyond 64 bits,
# keep their numeric interpretation. Note that `cue export` evaluates the
# decoded syntax tree directly, without formatting and re-parsing it, so
# the `number & 123` forms below must be valid CUE expressions.
# YAML 1.1 octals, including signed ones, are converted to CUE octals,
# while floats with a leading zero digit stay decimal.

exec cue export ./in.yaml
cmp stdout expect-export

exec cue import -o - -f ./in.yaml
cmp stdout expect-import

# Disabling the yamlgoccy experiment selects the older yaml.v3 based
# decoder, which decodes integers beyond 64 bits as floats rather than
# as integers.
env CUE_EXPERIMENT=yamlgoccy=0
exec cue export ./in.yaml
cmp stdout expect-export

exec cue import -o - -f ./in.yaml
cmp stdout expect-import-yamlv3

-- in.yaml --
memory: 1Gi
cpu: 100m
frac: 1.5Gi
huge: 18446744073709551616
exp: 123456e1
float: !!float 123
octal: 0123
signedOctal: -0123
floatOctal: !!float 0123
leadingZeroFloat: 01289.5
leadingZeroExp: 012e3
-- expect-export --
{
    "memory": "1Gi",
    "cpu": "100m",
    "frac": "1.5Gi",
    "huge": 18446744073709551616,
    "exp": 1.23456E+6,
    "float": 123,
    "octal": 83,
    "signedOctal": -83,
    "floatOctal": 83,
    "leadingZeroFloat": 1289.5,
    "leadingZeroExp": 1.2E+4
}
-- expect-import --
memory:           "1Gi"
cpu:              "100m"
frac:             "1.5Gi"
huge:             18446744073709551616
exp:              123456e1
float:            number & 123
octal:            0o123
signedOctal:      -0o123
floatOctal:       number & 0o123
leadingZeroFloat: 01289.5
leadingZeroExp:   012e3
-- expect-import-yamlv3 --
memory:           "1Gi"
cpu:              "100m"
frac:             "1.5Gi"
huge:             number & 18446744073709551616
exp:              123456e1
float:            number & 123
octal:            0o123
signedOctal:      -0o123
floatOctal:       number & 0o123
leadingZeroFloat: 01289.5
leadingZeroExp:   012e3
