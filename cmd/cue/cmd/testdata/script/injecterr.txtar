! exec cue eval test.cue -t env=prod

cmp stderr expect-stderr

# TODO: report errors for invalid tags?

-- test.cue --
{
    environment: "prod" | "staging" @tag(env,short=prod|staging)

    // Don't replace in optional
    opt?: string @tag(env)
    bulk: [string]: foo: string @tag(env)
    bulk: x: {}
    ("dyn"): string @tag(env)
    "\(environment)-dyn": string @tag(env)

    // Don't replace in a field whose label is not a plain name.
    'bytes': string @tag(env)

    // Don't replace in lists.
    a: [
        { no_replace: string @tag(env) }
    ]

    // Don't allow in comprehensions
    src: [1, 2]
    for _ in src {
        b: string @tag(prod)
    }
}

-- expect-stderr --
@tag not allowed within optional field:
    ./test.cue:5:18
@tag not allowed within pattern constraint:
    ./test.cue:6:33
@tag not allowed within dynamic field:
    ./test.cue:8:21
@tag not allowed within dynamic field:
    ./test.cue:9:34
@tag not allowed within field with unsupported label:
    ./test.cue:12:21
@tag not allowed within lists:
    ./test.cue:16:30
@tag not allowed within comprehension:
    ./test.cue:22:19
