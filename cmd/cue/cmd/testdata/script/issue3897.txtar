exec cue cmd tc1
stdout 'success!'

! exec cue cmd tc2
stderr 'command\.tc2: invalid interpolation: non-concrete value string \(type string\)'

# A command declaring no tasks at all reports nothing else.
! exec cue cmd noTasks
cmp stderr noTasks.stderr

# The errors of fields and comprehensions which would declare the tasks,
# even incomplete ones, explain why no tasks were found.
! exec cue cmd tc3
cmp stderr tc3.stderr
! exec cue cmd undefinedSource
cmp stderr undefinedSource.stderr
! exec cue cmd nonConcreteSource
cmp stderr nonConcreteSource.stderr
! exec cue cmd undefinedCondition
cmp stderr undefinedCondition.stderr

-- p_tool.cue --
package p

import "tool/cli"

input: string @tag(input)

command: tc1: NESTED: {
	taskName: cli.Print & {text: "success!"}
}
command: tc2: {
	"\(input)": cli.Print & {text: "ok"}
}
command: tc3: NESTED: {
	"\(input)": cli.Print & {text: "ok"}
}

instances: {}
missingInstanceName: string

command: noTasks: {
	data: string
}
command: undefinedSource: task: {
	for _, t in instances["foo"] {
		(t): cli.Print & {text: t}
	}
}
command: nonConcreteSource: task: {
	for _, t in instances[missingInstanceName] {
		(t): cli.Print & {text: t}
	}
}
command: undefinedCondition: task: {
	if instances.enabled {
		print: cli.Print & {text: "ok"}
	}
}
