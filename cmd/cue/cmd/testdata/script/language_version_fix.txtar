# cue fix judges a loose file at the version chosen with --language-version,
# as it would judge the same file in a module declaring that version.
#
# TestLatest: skip -- the inputs are deliberately written for v0.17.0.

# Without the flag, the file is judged at the current version, where the
# experiment is already stable, so the migration is refused.
! exec cue fix --exp=explicitopen z.cue
stderr '^fix: experiment "explicitopen" is already stable as of language version v0.18.0'
cmp z.cue in.cue

# At v0.17.0 the migration applies, and the rewrite is the one a v0.17.0
# module gets. As the file belongs to no module, a @version attribute
# records the version at which the experiment was applied.
exec cue fix --language-version v0.17.0 --exp=explicitopen z.cue
cmp z.cue expect/loose-explicitopen
cp in.cue mod/z.cue
cd mod
exec cue fix --exp=explicitopen z.cue
cmp z.cue expect-explicitopen
cd ..

# --exp=all expands to the experiments that apply at v0.17.0.
cp in.cue z.cue
exec cue fix --language-version v0.17.0 --exp=all z.cue
cmp z.cue expect/loose-explicitopen
cp in.cue mod/z.cue
cd mod
exec cue fix --exp=all z.cue
cmp z.cue expect-explicitopen
cd ..

# A file outside the module root, named from within the module, is judged
# at the module's version without the flag, but belongs to no module, so it
# records that version too.
cp in.cue w.cue
cd mod
exec cue fix --exp=explicitopen ../w.cue
cmp ../w.cue ../expect/loose-explicitopen
cd ..

# A file within cue.mod is fixed and read at the module's version, so it
# needs no @version.
cd mod
exec cue fix --exp=explicitopen cue.mod/gen/g/g.cue
cmp cue.mod/gen/g/g.cue expect-explicitopen
cd ..

# Without the flag, a loose file to which an experiment is added records the
# current version, at which the experiment was applied.
exec cue fix --exp=openlists o.cue
cmp o.cue expect/o

# An experiment that is not yet available at the chosen version is refused.
cp in.cue z.cue
! exec cue fix --language-version v0.16.0 --exp=shortcircuit z.cue
stderr 'experiment "shortcircuit" requires language version v0.17.0 or later'

# An attribute for an experiment that is stable at the chosen version is
# dropped as redundant, as in a module.
exec cue fix --language-version v0.17.0 r.cue
cp r.cue r-loose
cd mod
exec cue fix r.cue
cmp r.cue ../r-loose
cd ..

# Inside a versioned module, the flag is only a fallback that applies to
# nothing, with or without package arguments.
cd mod
cp ../in.cue z.cue
exec cue fix --language-version v0.18.0 --exp=explicitopen .
cmp z.cue expect-explicitopen
cp ../in.cue z.cue
exec cue fix --language-version v0.18.0 --exp=explicitopen
cmp z.cue expect-explicitopen
cd ..

-- mod/cue.mod/gen/g/g.cue --
#A: a: int
#B: b: int

X: {
	#A
	#B
	b: string
}
-- o.cue --
#L: [int, int]
a: #L & [1, 2]
-- expect/o --
@version(v0.18.0)
@experiment(openlists)

#L: #[int, int]
a:  #L & #[1, 2]
-- expect/loose-explicitopen --
@version(v0.17.0)
@experiment(explicitopen)

#A: a: int
#B: b: int

X: __closeAll({
	#A...
	#B...
	b: string
})
-- in.cue --
#A: a: int
#B: b: int

X: {
	#A
	#B
	b: string
}
-- z.cue --
#A: a: int
#B: b: int

X: {
	#A
	#B
	b: string
}
-- r.cue --
@experiment(structcmp)

a: 1
-- mod/cue.mod/module.cue --
module: "mod.test"
language: version: "v0.17.0"
-- mod/r.cue --
@experiment(structcmp)

a: 1
-- mod/expect-explicitopen --
@experiment(explicitopen)

#A: a: int
#B: b: int

X: __closeAll({
	#A...
	#B...
	b: string
})
