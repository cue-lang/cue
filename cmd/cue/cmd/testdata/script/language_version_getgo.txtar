# cue get go targets the version chosen with --language-version outside a
# CUE module: before v0.18.0, an embedded definition needs no opening.
#
# TestLatest: skip -- the output deliberately targets v0.17.0.

exec cue get go --local ./decls
grep '#Base\.\.\.' decls/p_go_gen.cue
exec cue get go --local --language-version v0.17.0 ./decls
! grep '#Base\.\.\.' decls/p_go_gen.cue
grep '^\t#Base$' decls/p_go_gen.cue

# Inside a CUE module declaring a version, the flag is only a fallback: the
# module's v0.17.0 applies, so the embedding is not opened.
rm decls/p_go_gen.cue
cp module.cue.in cue.mod/module.cue
exec cue get go --local --language-version v0.18.0 ./decls
! grep '#Base\.\.\.' decls/p_go_gen.cue
rm decls/p_go_gen.cue

# Without the flag, a @version attribute in a file of the CUE module stops
# generation too.
cp v.cue.in v.cue
! exec cue get go --local ./decls
stderr 'the @version attribute cannot be used in a file of the module whose cue.mod/module.cue declares language version v0.17.0'
! exists decls/p_go_gen.cue

-- v.cue.in --
@version(v0.16.0)

package decls
-- go.mod --
module mod.test

go 1.21
-- module.cue.in --
module: "mod.test"
language: version: "v0.17.0"
-- cue.mod/.keep --
-- decls/p.go --
package decls

type Base struct {
	Name string `json:"name"`
}

type Derived struct {
	Base
	Size int `json:"size"`
}
