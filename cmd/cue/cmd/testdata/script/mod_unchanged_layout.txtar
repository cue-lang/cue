# Commands which rewrite module files reformat one even when its data does
# not change, dropping its comments and layout.

exec cue mod tidy
cmp cue.mod/module.cue want-module
cmp cue.mod/local-module.cue want-local

exec cue mod fix
cmp cue.mod/module.cue want-module

exec cue mod edit
cmp cue.mod/module.cue want-module

exec cue mod edit --replace example.com/dep@v0=./local_dep
cmp cue.mod/module.cue want-module
cmp cue.mod/local-module.cue want-local

exec cue mod get example.com/dep@v0.1.0
cmp cue.mod/module.cue want-module

# A change of content rewrites the file in the current format.
exec cue mod edit --source self
cmp cue.mod/module.cue want-module-source

# An optional field is not module data, so it is rewritten away.
cd stale
exec cue mod edit
cmp cue.mod/module.cue want-module

-- want-module --
module: "main.org@v0"
language: version: "v0.17.0"
deps: "example.com/dep@v0": v: "v0.1.0"
-- want-local --
deps: "example.com/dep@v0": replaceWith: "./local_dep"
-- want-module-source --
module: "main.org@v0"
language: version: "v0.17.0"
source: kind:      "self"
deps: "example.com/dep@v0": v: "v0.1.0"
-- cue.mod/module.cue --
// The main module.
module: "main.org@v0"

language: {
	version: "v0.17.0"
}

deps: {
	// Required for its lib package.
	"example.com/dep@v0": {
		v: "v0.1.0"
	}
}
-- cue.mod/local-module.cue --
// Work on the dependency locally.
deps: {
	"example.com/dep@v0": {
		replaceWith: "./local_dep"
	}
}
-- main.cue --
package main

import "example.com/dep@v0:lib"

out: lib.value
-- local_dep/cue.mod/module.cue --
module: "example.com/dep@v0"
language: version: "v0.9.0"
-- local_dep/lib.cue --
package lib

value: "from local directory"
-- _registry/example.com_dep_v0.1.0/cue.mod/module.cue --
module: "example.com/dep@v0"
language: version: "v0.9.0"
-- _registry/example.com_dep_v0.1.0/lib.cue --
package lib

value: "from registry"
-- stale/want-module --
module: "main.org@v0"
language: version: "v0.17.0"
deps: "example.com/dep@v0": v: "v0.1.0"
-- stale/cue.mod/module.cue --
// The main module.
module: "main.org@v0"
language: version: "v0.17.0"
deps: {
	"example.com/dep@v0": v: "v0.1.0"
	"example.com/stale@v0"?: v: "v0.1.0"
}
