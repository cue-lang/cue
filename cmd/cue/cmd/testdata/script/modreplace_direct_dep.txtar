# The main module replaces foo with bar, and also depends on bar directly,
# importing one of its packages, as does another module it depends on. Only
# imports within the replacement itself are served under foo's path, so the
# main module and the other dependency must still see bar under its own path.

exec cue export .
cmp stdout want-export.txt
exec cue export ./direct
cmp stdout want-direct.txt

-- cue.mod/module.cue --
module: "example.com/main@v0"
language: version: "v0.17.0"

deps: {
	"example.com/dep@v0": v: "v0.1.0"
	"example.com/foo@v0": v: "v0.1.0"
}
-- cue.mod/local-module.cue --
deps: {
	"example.com/dep@v0": v: "v0.1.0"
	"example.com/foo@v0": {
		v:           "v0.1.0"
		replaceWith: "example.com/bar@v0"
	}
	"example.com/bar@v0": v: "v0.1.0"
}
-- main.cue --
package main

import (
	"example.com/dep/x"
	"example.com/foo/y"
)

dep: x.out
foo: y.out
-- direct/direct.cue --
package direct

import "example.com/bar/sub"

direct: sub.s
-- _registry/example.com_dep_v0.1.0/cue.mod/module.cue --
module: "example.com/dep@v0"
language: version: "v0.9.0"
deps: "example.com/bar@v0": v: "v0.1.0"
-- _registry/example.com_dep_v0.1.0/x/x.cue --
package x

import "example.com/bar/sub"

out: sub.s
-- _registry/example.com_foo_v0.1.0/cue.mod/module.cue --
module: "example.com/foo@v0"
language: version: "v0.9.0"
-- _registry/example.com_foo_v0.1.0/y/y.cue --
package y

out: "from foo (should not see this)"
-- _registry/example.com_bar_v0.1.0/cue.mod/module.cue --
module: "example.com/bar@v0"
language: version: "v0.9.0"
-- _registry/example.com_bar_v0.1.0/y/y.cue --
package y

out: "from bar"
-- _registry/example.com_bar_v0.1.0/sub/sub.cue --
package sub

s: "from bar sub"
-- want-export.txt --
{
    "dep": "from bar sub",
    "foo": "from bar"
}
-- want-direct.txt --
{
    "direct": "from bar sub"
}
