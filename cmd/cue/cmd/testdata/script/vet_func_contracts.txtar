# cue vet reports a function implementation that does not declare what the
# signature unified with it requires, at the binding rather than at a call,
# with the positions of both signatures. A callback is checked where it is
# bound to a parameter whose constraint is a signature, whether or not the
# callee calls it: its implementation must cover the parameter's signature,
# and its own signatures must permit every call that signature entitles the
# callee to make. cue eval reports the same errors.

! exec cue vet
cmp stderr expect-stderr

! exec cue eval
cmp stderr expect-stderr

-- cue.mod/module.cue --
module: "mod.test"
language: version: "v0.18.0"
-- in.cue --
@experiment(functions)

package p

f: func(x: number) -> string
f: func(x: int) -> string: "int"

consume: func(g: func(number) -> int) -> int: 7
cb:      func(x: int) -> int: 1
y:       consume(cb)

#Fenced: func(x: int) -> int
fenced:  #Fenced & (func(x: number) -> int: 1)
z:       consume(fenced)
-- expect-stderr --
f: parameter x of function accepts int, but its signature requires number:
    ./in.cue:6:4
    ./in.cue:5:4
g: parameter 1 of function accepts int, but its signature requires number:
    ./in.cue:9:10
    ./in.cue:8:18
z: parameter x of the function supplied for parameter g permits only int, but parameter g permits number:
    ./in.cue:12:10
    ./in.cue:8:18
