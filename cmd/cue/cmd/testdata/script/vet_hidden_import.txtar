# Errors in an imported package are reported even when it is only
# referenced by a hidden field.

! exec cue vet .
cmp stderr vet-stderr

-- cue.mod/module.cue --
module: "test.example"
language: version: "v0.17.0"
-- p.cue --
package p

import "test.example/sub"

_v: sub
-- sub/sub.cue --
package sub

a: 1 & 2
b: 3 & 4
-- vet-stderr --
a: conflicting values 2 and 1:
    ./sub/sub.cue:3:4
    ./sub/sub.cue:3:8
b: conflicting values 4 and 3:
    ./sub/sub.cue:4:4
    ./sub/sub.cue:4:8
