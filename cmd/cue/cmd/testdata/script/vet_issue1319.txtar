# Incomplete errors are reported alongside errors of a greater severity
# in other, independent fields.

! exec cue vet -c errors.cue
cmp stderr vet-stderr

! exec cue export errors.cue
cmp stderr vet-stderr

# Without -c, incomplete errors are not reported.
! exec cue vet errors.cue
cmp stderr vet-nonconcrete-stderr

# https://cuelang.org/issue/4140: comparing lists of structs results in
# an incomplete error, which must be reported alongside other failures.
! exec cue vet -c unique.cue
cmp stderr unique-stderr

# https://cuelang.org/issue/692: the same applies when data files are
# checked against a schema without merging them, for the commands which
# require concrete values.
! exec cue vet -c data.json schema.cue
cmp stderr data-stderr

! exec cue export --merge=false data.json schema.cue
cmp stderr data-stderr

! exec cue eval -c --merge=false data.json schema.cue
cmp stderr data-stderr

! exec cue eval --merge=false data.json schema.cue
cmp stderr data-nonconcrete-stderr

# https://cuelang.org/issue/3358: the same applies to packages given as
# arguments rather than files.
! exec cue vet -c ./pkg
cmp stderr pkg-stderr

! exec cue export ./pkg
cmp stderr pkg-stderr

! exec cue eval -c ./pkg
cmp stderr pkg-stderr

! exec cue vet ./pkg
cmp stderr pkg-nonconcrete-stderr

# With multiple packages, the ones before a failing package are still output.
! exec cue export ./ok ./pkg
cmp stdout ok-stdout
cmp stderr pkg-stderr

-- errors.cue --
s: "hello"
s: "world" // conflicting values

A: foo: "bar"
a: A.goo // undefined field

b: int // incomplete field

m: [1, 2]
v: m[2] // index out of range
-- vet-stderr --
b: incomplete value int:
    ./errors.cue:7:4
s: conflicting values "world" and "hello":
    ./errors.cue:1:4
    ./errors.cue:2:4
a: undefined field: goo:
    ./errors.cue:5:6
    ./errors.cue:4:1
v: index out of range [2] with length 2:
    ./errors.cue:10:6
    ./errors.cue:9:1
-- vet-nonconcrete-stderr --
s: conflicting values "world" and "hello":
    ./errors.cue:1:4
    ./errors.cue:2:4
v: index out of range [2] with length 2:
    ./errors.cue:10:6
    ./errors.cue:9:1
-- unique.cue --
import "list"

[_]: list.UniqueItems

scalars: [1, 2, 1]
structs: [
	{X: 1, O: 2},
	{X: 2, O: 1},
	{X: 1, O: 2},
]
-- unique-stderr --
scalars: invalid value [1,2,1] (does not satisfy list.UniqueItems): equal value (1) at position 0 and 2:
    ./unique.cue:3:6
    ./unique.cue:5:10
structs: invalid value [{X:1,O:2},{X:2,O:1},{X:1,O:2}] (does not satisfy list.UniqueItems): equal values at position 0 and 2:
    ./unique.cue:3:6
    ./unique.cue:6:10
-- schema.cue --
"@id": string
min: *0 | number
max: number & >min
-- data.json --
{"min": "test"}
-- data-stderr --
"@id": incomplete value string:
    ./schema.cue:1:8
min: 2 errors in empty disjunction:
min: conflicting values "test" and 0 (mismatched types string and int):
    ./data.json:1:9
    ./schema.cue:2:7
min: conflicting values "test" and number (mismatched types string and number):
    ./data.json:1:9
    ./schema.cue:2:11
-- data-nonconcrete-stderr --
min: 2 errors in empty disjunction:
min: conflicting values "test" and 0 (mismatched types string and int):
    ./data.json:1:9
    ./schema.cue:2:7
min: conflicting values "test" and number (mismatched types string and number):
    ./data.json:1:9
    ./schema.cue:2:11
-- pkg/pkg.cue --
package pkg

#Rule: {
	required1!: string
	required2!: string
}
rule: #Rule & {
	required1: "value"
	extra:     "value"
}

#S: {
	a?: int
	b?: int
	matchN(1, [{a!: _}, {b!: _}])
}
A: #S & {a: 1, b: 2}
B: #S & {}
-- ok/ok.cue --
package ok

x: 1
-- ok-stdout --
{
    "x": 1
}
-- pkg-stderr --
rule.extra: field not allowed:
    ./pkg/pkg.cue:9:2
rule.required2: field is required but not present:
    ./pkg/pkg.cue:5:2
    ./pkg/pkg.cue:7:15
A: invalid value {a:1,b:2} (does not satisfy matchN): 2 matched, expected 1:
    ./pkg/pkg.cue:15:2
    ./pkg/pkg.cue:15:9
    ./pkg/pkg.cue:17:4
B: invalid value {a?:int,b?:int} (does not satisfy matchN): 0 matched, expected 1:
    ./pkg/pkg.cue:15:2
    ./pkg/pkg.cue:15:9
    ./pkg/pkg.cue:18:4
B.a: field is required but not present:
    ./pkg/pkg.cue:15:2
    ./pkg/pkg.cue:15:14
    ./pkg/pkg.cue:18:9
B.b: field is required but not present:
    ./pkg/pkg.cue:15:2
    ./pkg/pkg.cue:15:23
    ./pkg/pkg.cue:18:9
-- pkg-nonconcrete-stderr --
rule.extra: field not allowed:
    ./pkg/pkg.cue:9:2
A: invalid value {a:1,b:2} (does not satisfy matchN): 2 matched, expected 1:
    ./pkg/pkg.cue:15:2
    ./pkg/pkg.cue:15:9
    ./pkg/pkg.cue:17:4
