# cuelang.org/issues/345

# Without data, ports defaults to the empty list, for which list.Max fails.
! exec cue vet -c=false x.cue
stderr 'empty list'
! exec cue vet x.cue
stderr 'empty list'
! exec cue def x.cue
stderr 'empty list'

stdin foo.json
exec cue vet x.cue json: -

exec cue export foo.json x.cue
cmp stdout out/x.json
-- foo.json --
{
    "ports": [
        2,
        5,
        7,
        2,
        76,
        98,
        3
    ],
    "newPort": 99
}
-- x.cue --
import "list"

ports: [... int]
newPort: list.Max(ports) + 1

-- out/x.json --
{
    "ports": [
        2,
        5,
        7,
        2,
        76,
        98,
        3
    ],
    "newPort": 99
}
