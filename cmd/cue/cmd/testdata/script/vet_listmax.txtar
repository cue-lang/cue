# cuelang.org/issues/345

# Without data, ports is an open list which may still gain elements,
# so newPort should be incomplete rather than an error.
# TODO: list.Max fails on the empty open list.
! exec cue vet -c=false x.cue
stderr 'empty list'
! exec cue vet x.cue
stderr 'empty list'
! exec cue def x.cue
stderr 'empty list'

stdin foo.json
exec cue vet x.cue json: -

exec cue export foo.json x.cue
cmp stdout out/x.json
-- foo.json --
{
    "ports": [
        2,
        5,
        7,
        2,
        76,
        98,
        3
    ],
    "newPort": 99
}
-- x.cue --
import "list"

ports: [... int]
newPort: list.Max(ports) + 1

-- out/x-def.cue --
import "list"

ports:   [...int]
newPort: list.Max(ports) + 1
-- out/x.json --
{
    "ports": [
        2,
        5,
        7,
        2,
        76,
        98,
        3
    ],
    "newPort": 99
}
