# cuelang.org/issues/345

# Without data, ports is an open list which may still gain elements,
# so newPort is incomplete rather than an error.
exec cue vet -c=false x.cue
! exec cue vet x.cue
stderr 'some instances are incomplete'
exec cue def x.cue
cmp stdout out/x-def.cue

stdin foo.json
exec cue vet x.cue json: -

exec cue export foo.json x.cue
cmp stdout out/x.json
-- foo.json --
{
    "ports": [
        2,
        5,
        7,
        2,
        76,
        98,
        3
    ],
    "newPort": 99
}
-- x.cue --
import "list"

ports: [... int]
newPort: list.Max(ports) + 1

-- out/x-def.cue --
import "list"

ports:   [...int]
newPort: list.Max(ports) + 1
-- out/x.json --
{
    "ports": [
        2,
        5,
        7,
        2,
        76,
        98,
        3
    ],
    "newPort": 99
}
