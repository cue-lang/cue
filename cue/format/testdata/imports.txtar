#sort-imports

-- pkgonly.input --
package foo
-- out/format/pkgonly.golden --
package foo
-- attronly.input --
@attr(foo)
-- out/format/attronly.golden --
@attr(foo)
-- importonly.input --
import "foo"
-- out/format/importonly.golden --
import "foo"
-- imports.input --
package foo

import (
    "cuelang.org/go/foo"
    "cuelang.org/go/bar"
    "time"
)

import (
    time1 "time"

    // comment f2
    f2 "cuelang.org/go/foo"
    f1 "cuelang.org/go/foo"
)

import (
    time2 "time"

    same "cuelang.org/go/foo" // comment 1
    same2 "cuelang.org/go/foo" // comment 2
)


a: time.time
b: foo.foo
c: bar.Bar
-- out/format/imports.golden --
package foo

import (
	"cuelang.org/go/foo"
	"cuelang.org/go/bar"
	"time"
)

import (
	time1 "time"

	// comment f2
	f2 "cuelang.org/go/foo"
	f1 "cuelang.org/go/foo"
)

import (
	time2 "time"

	same "cuelang.org/go/foo"  // comment 1
	same2 "cuelang.org/go/foo" // comment 2
)

a: time.time
b: foo.foo
c: bar.Bar
-- lparen-comment.input --
package foo

import ( // c
	"cuelang.org/go/foo"
	"time"
)

a: time.time
b: foo.foo
-- lparen-rparen-comments.input --
package foo

import ( // a
	"time"
) // b

x: time.time
