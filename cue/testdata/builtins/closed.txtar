-- in.cue --
a: close({
	a: b: int
})

b: a & {x: int} @test(err, code=eval, at=x, contains="field not allowed", pos=[0:9]) // err
c: a & {a: c: int} @test(eq, {a: {c: int, b: int}}) // okay (non-recursive close)

inDisjunctions: {
	x: [string]: #Def
	#Def: [string]: {
		a: b: true
		let X = a
		// The embedded disjunction is spread, as either disjunct would
		// otherwise close this struct and deny the a field above.
		(close({uint: a: b: X.b}) | close({string: a: b: true}))...
	}
	x: socket: string: {}
	x: syslog: x.socket
	x: syslog: xxx: {}

	@test(eq, {
		x: {
			socket: string: {
				a: b: true
				uint: a: b: true
			} | {
				a: b: true
				string: a: b: true
			}
			syslog: {
				string: {
					a: b: true
					uint: a: b: true
				} | {
					a: b: true
					string: a: b: true
				}
				xxx: {
					a: b: true
					uint: a: b: true
				} | {
					a: b: true
					string: a: b: true
				}
			}
		}
		#Def: {}
	})
}

// issue642: Tests that close() with merged struct patterns (concrete fields and
// bulk optional) correctly allows subfields. https://cuelang.org/issue/642
issue642: {
	test: close({
		a: _
		b: x: _
	} & {
		[string]: y: _
	}) @test(closed)

	test: a: x: _
	test: b: x: _

	@test(eq, {
		test: {
			[string]: y: _
			a: {
				y: _
				x: _
			}
			b: {
				x: _
				y: _
			}
		}
	})
}

// Issue 642
withSubfields: {
	test: close({
		a: _
		b: x:        _
		[string]: y: _
	})

	test: a: x: _
	test: b: x: _

	@test(eq, {
		test: {
			[string]: y: _
			a: {
				y: _
				x: _
			}
			b: {
				x: _
				y: _
			}
		}
	})
}

// issue3572: Tests that close({...}) allows additional fields when unified
// with an open struct. https://cuelang.org/issue/3572
issue3572: {
  t1: close({...}) & {a: 5} @test(eq, {a: 5}) @test(closed)

  e: close({...}) @test(closed) @test(allows, string)

  t2: e & {a: 5} @test(eq, {a: 5}) @test(closed)
}

// issue3580: Tests that close() does not panic when a field inside the closed
// struct references another field of the same struct. https://cuelang.org/issue/3580
issue3580: {
	x: close({
		a: _
		b: x.a
	}) @test(closed)
}

// The closing applies to each disjunct of a struct which embeds a
// disjunction.
embeddedDisjunction: {
	v: close({({a: 1} | {b: 1})..., c: 2})
	t1: v & {a: 1} @test(eq, {a: 1, c: 2})
	t2: v & {d: 3} @test(err, code=eval, contains="field not allowed", pos=[0:11])
}

// issue3963: close over a disjunction closes each disjunct, so unifying the
// result selects the disjunct which admits the added field, and a field no
// disjunct admits is denied. https://cuelang.org/issue/3963
issue3963: {
	#A: a: string
	#B: b: string

	disjunction: (#A | #B) & {a: "x"} @test(eq, {a: "x"})
	closed:      close(#A | #B) & {a: "x"} @test(eq, {a: "x"})
	denied:      close(#A | #B) & {c: "x"} @test(err, code=eval, contains="field not allowed", pos=[0:33])

	#D: #A | #B
	definition: #D & {a: "x"} @test(eq, {a: "x"})
}

// close over a disjunction closes each disjunct as the value it evaluated
// to: its optional and required fields, pattern constraints, and ellipsis
// carry over along with its regular fields.
disjunctValue: {
	v: close({a?: int} | *{b?: int}) @test(eq, *{b?: int} | {a?: int})
	t1: v & {b: 1} @test(eq, {b: 1})
	t2: v & {a: 1} @test(eq, {a: 1})
	t3: v & {c: 1} @test(err, code=eval, contains="field not allowed", pos=[0:11])

	required: close({a!: int} | {b!: int}) & {b: 1} @test(eq, {b: 1})
	pattern:  close({[string]: int} | *{b: int, [=~"^c"]: string}) & {b: 1, c: "x"} @test(eq, {b: 1, c: "x"})
	ellipsis: close({a: 1, ...} | {b: 1}) & {c: 2} @test(eq, {a: 1, c: 2})
}

// Closing concerns the fields of a struct, so close returns any other value
// unchanged, concrete or not, and a disjunction keeps its scalar disjuncts.
scalar: {
	number:    close(1) @test(eq, 1)
	str:       close("s") @test(eq, "s")
	nothing:   close(null) @test(eq, null)
	kind:      close(int) & 2 @test(eq, 2)
	bound:     close(>1) & 2 @test(eq, 2)
	top:       close(_) & {a: 1} @test(eq, {a: 1}) @test(closed=false)
	reference: close(x) @test(eq, 1)
	x: 1
	embedded:  close({1}) @test(eq, 1)
	list:      close([1]) @test(eq, [1])
	conflict:  close(1) & {a: 1} @test(err, code=eval, contains="mismatched types struct and int")

	disjunct: close(*1 | {a: 2}) @test(eq, *1 | {a: 2})
	struct:   close(1 | {a: 2}) & {a: 2} @test(eq, {a: 2})
	denied:   close(1 | {a: 2}) & {a: 2, b: 3} @test(err, code=eval, suberr=(contains="field not allowed"), suberr=(contains="conflicting values"))
	chosen:   close(1 | {a: 2}) & 1 @test(eq, 1)
	literal:  close({*1 | {a: 2}}) @test(eq, *1 | {a: 2})
}

// A spread opens the value it spreads, so a struct spreading a close()d
// value admits any field and is not closed.
spreadOpen: {
	foo: close({b: {}})
	v: {foo...}
	t1: v @test(closed=false) @test(allows, z)
	t2: v & {z: 1} @test(eq, {b: {}, z: 1})
}

// issue4535: a comprehension at the top level of the closed struct reads a
// field as unified where the call appears, not as the argument evaluates on
// its own, just as the struct does without close.
// https://cuelang.org/issue/4535
issue4535: {
	x: {k: int, if k == 1 {y: 1}}
	#D: x

	literal:    close({k: int, if k == 1 {y: 1}}) & {k: 1} @test(eq, {k: 1, y: 1})
	forClause:  close({k: int, for _, v in [1] if k == v {y: v}}) & {k: 1} @test(eq, {k: 1, y: 1})
	optional:   close({a?: string, if a == "x" {b: 1}}) & {a: "x"} @test(eq, {a: "x", b: 1})
	reference:  close(x) & {k: 1} @test(eq, {k: 1, y: 1})
	definition: close(#D) & {k: 1} @test(eq, {k: 1, y: 1})
	embedded:   close({x}) & {k: 1} @test(eq, {k: 1, y: 1})
	embedding:  {close(x), k: 1} @test(eq, {k: 1, y: 1})
	selected:   (close(x) & {k: 1}).y @test(eq, 1)

	// The guard does not hold, so the field it declares is absent.
	unmet: close(x) & {k: 2} @test(eq, {k: 2}) @test(closed)

	// Closing still applies: the field the comprehension declares is
	// allowed, one added from outside is not.
	denied: close(x) & {k: 1, z: 2} @test(err, at=z, code=eval, contains="field not allowed", pos=[0:28])

	// Without a value for the field the guard reads, the struct stays
	// incomplete, as it does without close.
	alone: close(x) @test(err, code=incomplete, contains="non-concrete value int in operand to ==")

	// A nested close call, or an expression other than a literal or a
	// reference, as the argument.
	nested:     close(close({k: int, if k == 1 {y: 1}})) & {k: 1} @test(err, code=incomplete, contains="non-concrete value int in operand to ==") @test(eq:todo, {k: 1, y: 1})
	expression: close(x & {}) & {k: 1} @test(err, code=incomplete, contains="non-concrete value int in operand to ==") @test(eq:todo, {k: 1, y: 1})
}

// issue4589: a definition closes its value recursively even when it also
// closes it at one level with close, so a nested field is denied through
// every reference to it, whether the reference is evaluated before or after
// the definition. https://cuelang.org/issue/4589
issue4589: {
	before: #F & {a: z: 1} @test(err, at=a.z, code=eval, contains="field not allowed", pos=[0:19])

	#F: close({a: b: 1})

	// References evaluated after the definition.
	after:     #F & {a: z: 1} @test(err, at=a.z, code=eval, contains="field not allowed", pos=[0:22])
	swapped:   {a: z: 1} & #F @test(err, at=a.z, code=eval, contains="field not allowed", pos=[0:17])
	noSharing: #F & {a: z: 1} & __no_sharing @test(err, at=a.z, code=eval, contains="field not allowed", pos=[0:22])
	selected:  #F.a & {z: 1} @test(err, at=z, code=eval, contains="field not allowed", pos=[0:21])

	#G: close({a: b: 1}) & {}
	conjunction: #G & {a: z: 1} @test(err, at=a.z, code=eval, contains="field not allowed", pos=[0:24])

	#H: {close({a: b: 1})}
	embedded: #H & {a: z: 1} @test(err, at=a.z, code=eval, contains="field not allowed", pos=[0:21])

	#N: close(close({a: b: 1}))
	nested: #N & {a: z: 1} @test(err, at=a.z, code=eval, contains="field not allowed", pos=[0:19])

	// The field declared by the definition is still allowed.
	allowed: #F & {a: b: 1} @test(eq, {a: b: 1})

	// The same holds however the definition or the call is reached.
	held:    #F
	viaHeld: held & {a: z: 1} @test(err, at=a.z, code=eval, contains="field not allowed", pos=[0:22])

	#D: x: close({a: b: 1})
	defField: #D.x & {a: z: 1} @test(err, at=a.z, code=eval, contains="field not allowed", pos=[0:23])

	r: close({a: b: 1})
	#R: r
	viaRegular: #R & {a: z: 1} @test(err, at=a.z, code=eval, contains="field not allowed", pos=[0:23])

	// Only a field which the definition declares beside the call is allowed
	// below the top level.
	beside: {
		#J: close({a: b: 1}) & {a: c: 1}
		conjunct:  #J & {} @test(eq, {a: {b: 1, c: 1}})
		noSharing: #J & __no_sharing @test(eq, {a: {b: 1, c: 1}})
		denied:    #J & {a: z: 1} @test(err, at=a.z, code=eval, contains="field not allowed", pos=[0:23])

		#L: close({a: b: 1})
		#L: a: c: 1
		declaration: #L & {} @test(eq, {a: {b: 1, c: 1}})

		before: #O & {a: z: 1} @test(err, at=a.z, code=eval, contains="field not allowed", pos=[0:20])
		#O: close({a: _}) & {a: b: 1}
		after: #O & {a: z: 1} @test(err, at=a.z, code=eval, contains="field not allowed", pos=[0:19])
	}

	// Outside a definition, close closes at one level only.
	outsideDef: {
		nested: x & {a: z: 1} @test(eq, {a: {b: 1, z: 1}})
		top:    x & {z: 1} @test(err, at=z, code=eval, contains="field not allowed", pos=[0:16])
		x: close({a: b: 1})
	}

	// close in a definition applied to data from outside of it closes the
	// top level of that data. Below it, the spec does not settle whether the
	// definition closes such data, and the two ways to extend it disagree,
	// with or without close: a field selected from the unification admits a
	// nested field, while unifying into the definition denies it. The nested
	// cases record the results as they are, not what must hold.
	openData: {
		#Fn: {in: _, out: close(in)}
		before: fn.out & {a: z: 1} @test(eq, {a: {b: 1, z: 1}}, hint="the spec does not settle this; selecting from the unification and unifying into it should agree")
		fn: #Fn & {in: {a: b: 1}}
		after:     fn.out & {a: z: 1} @test(eq, {a: {b: 1, z: 1}}, hint="the spec does not settle this; selecting from the unification and unifying into it should agree")
		noSharing: fn.out & {a: z: 1} & __no_sharing @test(eq, {a: {b: 1, z: 1}}, hint="the spec does not settle this; selecting from the unification and unifying into it should agree")
		inline:    (#Fn & {in: {a: b: 1}}).out & {a: z: 1} @test(eq, {a: {b: 1, z: 1}}, hint="the spec does not settle this; selecting from the unification and unifying into it should agree")
		into:      #Fn & {in: {a: b: 1}, out: a: z: 1} @test(err, at=out.a.z, code=eval, contains="field not allowed", pos=[0:44], hint="the spec does not settle this; selecting from the unification and unifying into it should agree")
		top:       fn.out & {z: 1} @test(err, at=z, code=eval, contains="field not allowed", pos=[0:24])
	}

	// A definition recursively closes a regular struct it passes to close.
	closeRegular: {
		before: #C & {a: z: 1} @test(err, at=a.z, code=eval, contains="field not allowed", pos=[0:20])
		open: {a: b: 1}
		#C: close(open)
		after:     #C & {a: z: 1} @test(err, at=a.z, code=eval, contains="field not allowed", pos=[0:23])
		noSharing: #C & {a: z: 1} & __no_sharing @test(err, at=a.z, code=eval, contains="field not allowed", pos=[0:23])
	}

	// close applied to a definition keeps it closed recursively.
	closeDef: {
		#X: close(#F)
		definition: #X & {a: z: 1} @test(err, at=a.z, code=eval, contains="field not allowed", pos=[0:24])

		x: close(#F)
		reference: x & {a: z: 1} @test(eq, {a: {b: 1, z: 1}}, incorrect) @test(err:todo, at=a.z, code=eval, contains="field not allowed", pos=[0:22])
		inline:    close(#F) & {a: z: 1} @test(eq, {a: {b: 1, z: 1}}, incorrect) @test(err:todo, at=a.z, code=eval, contains="field not allowed", pos=[0:30])
		selected:  x.a & {z: 1} @test(eq, {b: 1, z: 1}, incorrect) @test(err:todo, at=z, code=eval, contains="field not allowed", pos=[0:21])
	}
}
-- embed.cue --
// The old embedding opened the embedded value along the paths the
// enclosing literal declares itself. As cue fix rewrites it, the extended
// label is declared in the nested closed literal, so that foo.allowed stays
// allowed while foo.other and a sibling field stay denied.
nestedEmbedded: base: close({
	{foo?: close({foo?: _, allowed?: _})}
	foo: allowed: 5
}) @test(eq, { foo: { allowed: 5, foo?: _ } })
nestedEmbedded: t1: close({
	{{foo?: close({foo?: _, allowed?: _})}}
	foo: allowed: 5
}) @test(eq, { foo: { allowed: 5, foo?: _ } })
nestedEmbedded: t2: close({
	{{{foo?: close({foo?: _, allowed?: _})}}}
	foo: allowed: 5
}) @test(eq, { foo: { allowed: 5, foo?: _ } })
// The original input, under the strict embedding of v0.18.0: the embedded
// literal closes foo to its own fields, so the field the old semantics
// admitted is denied.
nestedEmbedded: strict: {
	close({ foo?: close({ foo?: _ }) })
	foo: allowed: 5 @test(err, code=eval, contains="field not allowed", pos=[0:7])
}
unified: base: {
	x: close({ foo?: close({ foo?: _ }) })
	x: foo: disallowed: 5 @test(err, code=eval, contains="field not allowed", pos=[0:10])
}
unified: t1: {
	x: { close({ foo?: close({ foo?: _ }) }) }
	x: foo: disallowed: 5 @test(err, code=eval, contains="field not allowed", pos=[0:10])
}
unified: t2: {
	x: {{ close({ foo?: close({ foo?: _ }) }) }}
	x: foo: disallowed: 5 @test(err, code=eval, contains="field not allowed", pos=[0:10])
}
nestedWithSelfReference: t1: {
	_schema: close({
		foo?: _schema
	}) @test(shareID=S)
	// TODO(inline): make work for hidden fields.
	// @test(err, at=_schema.foo, code=structural_cycle)
	// @test(shareID=S, at=x.foo.foo)

	x: {_schema}
	x: foo: disallowed: 5 @test(err, code=eval, contains="field not allowed", pos=[0:10])
}
nestedWithSelfReference: t2: {
	_schema: close({
		foo?: _schema
	})
	// TODO(inline): make work for hidden fields.
	// @test(err, at=foo, code=structural_cycle)
	x: {{_schema}}
	x: foo: disallowed: 5 @test(err, code=eval, contains="field not allowed", pos=[0:10])
}
// issue1206: close() used to resolve an embedded disjunction before the
// enclosing struct was unified with its concrete fields, so the default arm
// was picked too early. https://cuelang.org/issue/1206
issue1206: defaults: {
	parameters: close({
		name: string
		port: int

		{
			name: "custom-port"
		} | *{
			port: 8080
			name: "default-port"
		}
	})

	// The concrete port selects the non-default arm, as it does when
	// parameters is written as a definition instead.
	custom: parameters & {
		port: 9999
	} @test(eq, {name: "custom-port", port: 9999})
}
issue1206: elimination: {
	x: close({
		{
			name: int
		} | {
			name: string
		}
	}) @test(eq, {name: int} | {name: string})

	// Unifying with a concrete name leaves a single disjunct: only x is
	// unresolved, which is what "cue eval -c" reports.
	y: x & {
		name: "Hello"
	} @test(eq, {name: "Hello"})
}

