# The ? marker in an exists argument has its try meaning within a try
# clause: there is no ? path marker specific to exists. See
# exists_compile_errors.txtar for ? outside a try clause.

-- in.cue --
@experiment(predicates)
@experiment(try)

// The clause yields nothing, as a.b does not exist.
tryAbsent: {
	a: b?: c: 1
	try {
		check: exists(a.b?.c)
	}
} @test(eq, {a: {b?: {c: 1}}})

// The clause yields the result of exists, as a.b exists.
tryPresent: {
	a: b: c: 1
	try {
		check: exists(a.b?.c)
	}
} @test(eq, {a: {b: {c: 1}}, check: true})

// The name bound by the assignment form is a binding, not a field: asking
// for its presence is an error, as for a let. The reference it is bound to
// is a regular question.
tryBinding: {
	a: b: 1
	try x = a.b? {
		bare: exists(x)
		ref:  exists(a.b)
	}
	@test(err, at=bare, code=eval, contains="%s: argument must be a field reference, selector, or index expression", args=[exists])
}
-- out/errors.txt --
[eval] tryBinding.bare: exists: argument must be a field reference, selector, or index expression:
    ./in.cue:26:9
