# A default over a builtin result that is read through an embedded scalar used
# to be taken before the builtin's argument was resolved, so c fell back to the
# "bug" default of the interpolation while a and b did not.
# https://cuelang.org/issue/2571

-- in.cue --
import "regexp"

#Example: {
	#parse: string
	#match: regexp.FindNamedSubmatch("^(?P<value>.*)$", #parse)

	"\(*#match.value | "bug")"
}

a: #Example & {#parse: "hello", _} @test(eq, {
	"hello"
	#parse: "hello"
	#match: value: "hello"
})
b: #Example & {#parse: "\(a)", _} @test(eq, {
	"hello"
	#parse: "hello"
	#match: value: "hello"
})

// c passes the struct a itself, rather than a stringification of it.
c: #Example & {#parse: a, _} @test(eq, {
	"hello"
	#parse: {
		"hello"
		#parse: "hello"
		#match: value: "hello"
	}
	#match: value: "hello"
})
-- out/errors.txt --
[incomplete] #Example.#match: error in call to regexp.FindNamedSubmatch: non-concrete value string:
    ./in.cue:5:10
    ./in.cue:4:10
