# Tests for the isValid builtin, including cardinality-over-validity
# compositions with countN (which replaces the former validN).

-- in.cue --
@experiment(predicates)

// isValid with concrete values
validConcrete: {
	a:      1
	checkA: isValid(a)   @test(eq, true)
}

// isValid with non-concrete values (types, constraints)
validNonConcrete: {
	a:      int
	checkA: isValid(a)   @test(eq, true)
	b:      >0
	checkB: isValid(b)   @test(eq, true)
}

// isValid with errors (conflicting unification)
validErrors: {
	a:      1 & 2   @test(err, code=eval, contains="conflicting values %s and %s", args=[2, 1], pos=[0:10, 0:14])
	checkA: isValid(a)   @test(eq, false)

	b: int & string   @test(err, code=eval, contains="conflicting values %s and %s (mismatched types %s and %s)", args=[int, string, int, string], pos=[0:5, 0:11])
	checkB: isValid(b)   @test(eq, false)

	c: {a: 1} & {a: 2}   @test(err, code=eval, path=a, contains="conflicting values %s and %s", args=[2, 1], pos=[0:9, 0:18])
	checkC: isValid(c)   @test(eq, false)

	d: {a: b: c: d: int} & {a: b: c: d: string}   @test(err, code=eval, path=a.b.c.d, contains="conflicting values %s and %s (mismatched types %s and %s)", args=[int, string, int, string], pos=[0:18, 0:38])
	checkD: isValid(d)   @test(eq, false)
}

// Cardinality over validity composes with countN (formerly validN).
countNValid: {
	a: 1   @test(eq, 1)
	b: 2   @test(eq, 2)
	c: 1 & 2   @test(err, code=eval, contains="conflicting values %s and %s", args=[2, 1], pos=[0:5, 0:9])
	countN(2, [isValid(a), isValid(b), isValid(c)])
}

// isValid with literal
validLiteral: {
	checkInt:    isValid(42)        @test(eq, true)
	checkString: isValid("hello")   @test(eq, true)
}

// isValid with computation
validComputation: {
	checkAdd: isValid(1 + 2)   @test(eq, true)
}

// countN with bound constraints over validity. A validator used as a field
// value remains a validator value; isValid converts a passing or failing
// countN into a boolean (the validator-to-boolean adapter).
countNValidBounds: {
	a: 1
	b: 2
	c: 1 & 2   @test(err, code=eval, contains="conflicting values %s and %s", args=[2, 1], pos=[0:5, 0:9])
	t1: isValid(countN(>=1, [isValid(a), isValid(b), isValid(c)])) @test(eq, true)
	t2: isValid(countN(<=2, [isValid(a), isValid(b), isValid(c)])) @test(eq, true)
	t3: isValid(countN(3, [isValid(a), isValid(b), isValid(c)]))   @test(eq, false)
}

// countN failure - requires all 3 valid but only 2 are. countN cannot tell
// whether a false condition may still turn true, so a shortfall is
// incomplete; isValid reports it as false.
countNValidFailure: {
	a: 1
	b: 2
	c: 1 & 2   @test(err, code=eval, contains="conflicting values %s and %s", args=[2, 1], pos=[0:5, 0:9])
	t1: {
		countN(3, [isValid(a), isValid(b), isValid(c)])
		z: 1
		@test(err, code=incomplete, contains="%s: %d matched, expected %v", args=[countN, 2, 3], pos=[1:3, 1:10])
	}
	t2: isValid(countN(3, [isValid(a), isValid(b), isValid(c)])) @test(eq, false)
}

countNValidEmbedFail: {
	a: 1
	b: 2
	c: 1 & 2   @test(err, code=eval, contains="conflicting values %s and %s", args=[2, 1], pos=[0:5, 0:9])
	t1: {
		countN(>=3, [isValid(a), isValid(b), isValid(c)])
		z: 1
		@test(err, code=incomplete, contains="%s: %d matched, expected %v", args=[countN, 2, >=3], pos=[1:3, 1:10])
	}
	t2: isValid(countN(>=3, [isValid(a), isValid(b), isValid(c)])) @test(eq, false)
}

// countN applied as a validator to a scalar, with conditions referencing the
// validated value.
countNValidSelfRef: {
	y:  42
	ok: y & countN(1, [isValid(string & y), isValid(int & y), isValid(bool & y)]) @test(eq, 42)
}

// The satisfiability semantics: an unsatisfiable optional constraint binds no
// instance (true), an unset required field can still be satisfied (true), and
// an unsatisfiable required constraint dooms every instance (false).
isValidSatisfiability: {
	checkOpt:       isValid({a?: 1 & 2})   @test(eq, true)
	checkReq:       isValid({a!: int})     @test(eq, true)
	checkReqBroken: isValid({a!: 1 & 2})   @test(eq, false)
}

// The locus boundary: an incomplete interior is tolerated (the struct is a
// fine partial value), while the same hole as the argument's own denotation
// is false.
isValidLocus: {
	s: {x: y + 1, y: string}
	checkStruct: isValid(s)     @test(eq, true)
	checkField:  isValid(s.x)   @test(eq, false)
}

// isValid on non-existent reference returns false (not error)
// Missing field is an evaluation error, and isValid returns false for any error
isValidMissingRef: {
	a:     b?: c: {}
	check: isValid(a.b.c)   @test(eq, false)
}

// isValid on a missing field unified with a type/value also returns false: the
// missing reference leaves the whole value an (incomplete) error, which cannot
// be made valid. Unifying with a type previously masked the error, wrongly
// yielding true, because the incomplete bottom surfaced wrapped in a vertex
// rather than as a bare bottom.
isValidMissingUnified: {
	a:      {x: 1}
	check0: isValid(a.nonexist)            @test(eq, false)
	check1: isValid(a.nonexist & string)   @test(eq, false)
	check2: isValid(a.nonexist & "hi")     @test(eq, false)
}

// isValid on existing but invalid reference should return false
isValidExistingInvalid: {
	a:     x: 1 & "foo"   @test(err, code=eval, contains="conflicting values %s and %s (mismatched types %s and %s)", args=[1, "foo", int, string], pos=[0:12, 0:16])
	check: isValid(a.x)   @test(eq, false)
}

-- existing.cue --
@experiment(predicates)

import "list"

isValidIncomplete: {
	xc: close({})
	xo: {}
	okc2: {
		if isValid({} & {s: [for y in xc.undefined {}]}) {a: 1}
		@test(eq, {})
	}
	oko2: {
		if isValid({} & {s: [for y in xo.undefined {}]}) {a: 1}
		@test(eq, {a: 1})
	}
	okc3: {
		if isValid({s: [for y in xc.undefined {}]}) {a: 1}
		@test(eq, {})
	}

	oko3: {
		if isValid({s: [for y in xo.undefined {}]}) {a: 1}
		@test(eq, {a: 1})
	}

	// Pass final error back from list argument, though comprehension, and
	// pass up.
	// https://cuelang.org/issue/1969
	viaLet: okc: {
		let X = xc.undefined
		let Y = {} & {s: [for y in list.Range(0, X, 1) {}]}

		if isValid(Y) {Y}
		@test(eq, {})
	}

}
-- cycle.cue --
@experiment(predicates)

// A mutual dependency through isValid is a cycle in either declaration
// order, as with the `== _|_` form it replaces. isValid does not catch the
// cycle error: answering false would make the result depend on which side
// the evaluator happened to break the cycle at.
isValidMutualCycle: {
	ab: {
		b: {
			if !isValid(a.bar) {foo: ""}
			@test(err, code=cycle)
		}
		a: {
			if !isValid(b.foo) {bar: ""}
			@test(err, code=cycle)
		}
	}
	ba: {
		a: {
			if !isValid(b.foo) {bar: ""}
			@test(err, code=cycle)
		}
		b: {
			if !isValid(a.bar) {foo: ""}
			@test(err, code=cycle)
		}
	}
	permuted: {
		@test(permute, count=2)
		b: {
			if !isValid(a.bar) {foo: ""}
			@test(err, code=cycle)
		}
		a: {
			if !isValid(b.foo) {bar: ""}
			@test(err, code=cycle)
		}
	}
}

// The answer feeds back into the value it reads: v.e is read while outer is
// still absent, which makes isValid(v.e) false and thereby adds outer. The
// committed false is order-dependent, so the post-check reports a cycle
// instead of accepting outer: 5 with c2: false.
nonMonotonic: {
	predicate: {
		outer?: int
		v: {e: outer}
		c2: isValid(v.e)
		if !isValid(v.e) {outer: 5}
		@test(err, code=cycle, contains="circular dependency in evaluation of conditionals: v.e changed after evaluation", pos=[4:15])
	}
	comparison: {
		outer?: int
		v: {e: outer}
		c2: v.e != _|_ @test(eq, false)
		if v.e == _|_ {outer: 5}
		@test(eq, {
			outer: 5
			v: {
				e: _|_ @test(err, code=incomplete, contains="nonMonotonic.comparison.v.e: cannot reference optional field: outer", pos=[2:10])
			}
			c2: false
		}, hint="The comparison form freezes the stale v.e and its post-check re-reads it, so it accepts this order-dependent result. isValid re-derives v.e and reports the cycle; see nonMonotonic.predicate.")
	}
}
