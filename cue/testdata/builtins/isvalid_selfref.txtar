# isValid applied, within a definition, to a copy of that definition, where
# a builtin implemented in Go finalizes the definition from within its own
# evaluation.
#
# TODO: this overflows the stack, so it is not run. Once it runs, drop the
# two tags and turn the expected values into @test assertions.
#skip
#inlinetest:exclude skip: overflows the stack.

-- in.cue --
@experiment(predicates)

import "reflect"

// The copy holds the call to isValid as well, and so does the copy that its
// post-check evaluates. Allows finalizes #A, and with it the copy, from
// within the evaluation of #A.
selfReference: {
	// zz is not allowed in #A, so the copy is not valid.
	invalid: {
		#A: {
			b: 1
			c: reflect.Allows(#A, "zz")   // false
			u: isValid(#A & {zz: 1})      // false
		}
	}
	// The copy is valid.
	valid: {
		#A: {
			b: 1
			c: reflect.Allows(#A, "zz")   // false
			u: isValid(#A & {b: 1})       // true
		}
	}
}
