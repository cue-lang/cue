-- in.cue --
import "list"

a: list.Sort([2, 3, 1, 4], {x: _, y: _, less: x < y}) @test(eq, [1, 2, 3, 4])

// The comparator evaluates the elements anew, where the closedness of each
// disjunct must still eliminate the disjunct that does not match.
closeDisjunction: {
	#R: close({p?: int, x?: string}) | close({p?: int, y?: string})
	#D: {
		a: #R
		b: #R
		s: list.Sort([a, b], {x: {}, y: {}, less: x.p < y.p})
	}
	out: (#D & {a: {p: 1, x: "one"}, b: {p: 0, y: "two"}}).s @test(eq, [{p: 0, y: "two"}, {p: 1, x: "one"}])
}
defDisjunction: {
	#A: {p?: int, x?: string}
	#B: {p?: int, y?: string}
	#D: {
		a: #A | #B
		b: #A | #B
		s: list.Sort([a, b], {x: {}, y: {}, less: x.p < y.p})
	}
	out: (#D & {a: {p: 1, x: "one"}, b: {p: 0, y: "two"}}).s @test(eq, [{p: 0, y: "two"}, {p: 1, x: "one"}])
}

// Elements which are open data must stay open.
openInput: {
	#D: {
		in: [string]: _
		s: list.Sort([for v in in {v & {p: *0 | int}}], {x: {}, y: {}, less: x.p < y.p})
	}
	out: (#D & {in: {a: {p: 2, z: "a"}, b: {p: 1, z: "b"}}}).s @test(eq, [{p: 1, z: "b"}, {p: 2, z: "a"}])
}
