-- in.cue --
noClose: {
	foo: a: int
	a: __reclose({
		foo...
	})

	t1: ok: a & {b: 1}
	@test(eq, {
		foo: {a: int}
		a: {a: int}
		t1: {ok: {b: 1, a: int}}
	})
}

recursive: {
	#x: { foo: int}
	// Basic usage of __reclose - makes structs recursively closed
	a: __reclose({
		#x...
		nested: field2: int
	})

	// Test that extra fields are not allowed (should error)
	t1: err: a & {extra: "not allowed"} @test(err, code=eval, path=extra, contains="field not allowed", pos=[0:16])

	t2: ok: a & {nested: field2: 5} @test(eq, {nested: {field2: 5}, foo: int})
	t3: ok: a & {foo: 5}  @test(eq, {foo: 5, nested: {field2: int}})


	// Test that nested extra fields are not allowed (should error)
	t4: err: a & {
		nested: {
			field2: 1
			extra: "not allowed"
		}
	} @test(err, code=eval, path=nested.extra, contains="field not allowed", pos=[3:4])

	// Without a closed spread embedding, __reclose is a no-op and the
	// struct stays open.
	e: __reclose({})
	t5: err: e & {extra: "not allowed"} @test(eq, {extra: "not allowed"})
}


nonRecursive: {
	x: __reclose({
		close({b: int})...
		c: int
		d: e: int
	})
	y: err: x & {f: int}   @test(err, code=eval, path=f, contains="field not allowed", pos=[0:15])
	z: ok: x & {d: f: int} @test(eq, {d: {f: int, e: int}, c: int, b: int})
}

// Test that __reclose detects and restores non-recursive closing from
// an embedded close()-d value that was opened with ....
nonRecursiveDetect: {
	foo: close({b: {}})
	a: __reclose({
		foo...
	})
	// Top-level field not allowed: non-recursive close restored by __reclose.
	t1: err: a & {f: int} @test(err, code=eval, path=f, contains="field not allowed", pos=[0:16])
	// Nested field allowed: close was non-recursive, so b is still open.
	t2: ok: a & {b: c: 1} @test(eq, {b: {c: 1}})
}

// __reclose closes the struct as strongly as any value it embeds: a
// definition closes it recursively even when a value closed by close is
// embedded beside it.
mixedClose: {
	#D: {x: y: int}
	foo: close({b: {}})
	a: __reclose({
		#D...
		foo...
	})
	// Top-level extra field not allowed.
	t1: err: a & {f: int} @test(err, code=eval, path=f, contains="field not allowed", pos=[0:16])
	// The definition closes the struct recursively, so the field added below
	// the one the close()d value declares is denied, as is one below a field
	// the definition declares.
	t2: err: a & {x: y: 5, b: c: 1} @test(err, code=eval, path=b.c, contains="field not allowed", pos=[0:28])
	t3: err: a & {x: z: 1} @test(err, code=eval, path=x.z, contains="field not allowed", pos=[0:19])
	// Allowed fields work.
	t4: ok: a & {x: y: 5} @test(eq, {x: {y: 5}, b: {}})
}

// Test that __reclose can wrap a close() call and conditionally add
// recursive closing on top. This is the pattern generated by cue fix
// when a close() at field-value level wraps a struct with embeddings.
recloseWrapsClose: {
	#def: {a: b: int}
	a: __reclose(close({
		#def...
	}))
	// Top-level extra field not allowed (close provides non-recursive).
	t1: err: a & {f: int} @test(err, code=eval, path=f, contains="field not allowed", pos=[0:16])
	// Nested extra field not allowed (__reclose detects recursive from #def).
	t2: err: a & {a: c: 1} @test(err, code=eval, path=a.c, contains="field not allowed", pos=[0:19])
	// Allowed nested field works.
	t3: ok: a & {a: b: 5} @test(eq, {a: {b: 5}})
}

nonStructLiterals: {
	// Test with non-struct should error
	t1: err: __reclose("not a struct") @test(err, code=eval, contains="error in call to %s", args=[__reclose], pos=[0:11])


	#A: a: int
	t4: err: __reclose(#A) @test(err, code=eval, contains="error in call to %s", args=[__reclose], pos=[0:11])
}

nonStructDefinitions: {
	#Def: 1

	a: __reclose({
		#Def...
	})

	t1: ok: a & 1  @test(eq, 1)

	// errors because of regular field + embedded scalar
	t2: err: a & {b: 1}  @test(err, code=eval,
		contains="conflicting values %s and %s (mismatched types %s and %s)",
		args=[{b:1}, 1, struct, int], pos=[-9:8, 0:11, 0:15])
}

// The vertex spread into a __reclose'd struct may elsewhere be unified
// with a definition that expands to a conjunction (#B: #A & {...}).
// Fields declared in the __reclose literal must remain allowed.
derivedDef: {
	#A: {f: string}
	#B: #A & {f: "ns"}

	n: {
		globals: #A
		s: __reclose({
			globals...
			extra: "x"
		})
	}

	ctx: n & {globals: #B} @test(eq, {globals: {f: "ns"}, s: {f: "ns", extra: "x"}})
}


// A struct which embeds a disjunction has no single value for a wrapper to
// take, so the closing applies to each disjunct: a branch whose operand is
// closed is closed, and a branch whose operand is open stays open.
embeddedDisjunction: {
	#A: {a: 1}
	#C: {z: 1}
	mixed: {
		v: __reclose({(#A | {})..., b: 2})
		t1: v & {c: 3} @test(eq, {b: 2, c: 3})
		t2: v & {a: 1, c: 3} @test(eq, {a: 1, b: 2, c: 3})
	}
	default: {
		v: __reclose({(*#A | {})..., b: 2})
		t1: v & {c: 1} @test(eq, {b: 2, c: 1})
		t2: v @test(eq, *{a: 1, b: 2} | {b: 2})
	}
	conjunction: {
		v: __reclose({((#A | {}) & #C)..., b: 2})
		t1: v & {z: 1} @test(eq, {b: 2, z: 1})
		t2: v & {c: 3} @test(err, code=eval,
			suberr=(at=a, contains="field not allowed", pos=[-15:7]),
			suberr=(at=c, contains="field not allowed", pos=[0:12]),
			suberr=(at=z, contains="field not allowed", pos=[-14:7]))
	}
}

// A value spread into the literal closes it as a definition it names does,
// also when the value is a let or a field bound to the definition, which
// is spread before its own closedness is known.
boundSpread: {
	#A: {a: 1}
	f: #A
	byLet:   __reclose({let l = #A, l..., c: 2})
	byField: __reclose({f..., c: 2})
	t1: byLet & {z: 1}   @test(err, code=eval, path=z, contains="field not allowed", pos=[0:15])
	t2: byLet & {a: 1}   @test(eq, {a: 1, c: 2})
	t3: byField & {z: 1} @test(err, code=eval, path=z, contains="field not allowed", pos=[0:17])
}

// A spread of a close call opens its literal again, but passes the closing
// of the values spread into that literal on to the enclosing __reclose
// literal.
spreadClose: {
	#D: {x: y: int}
	bar: {b: {}}
	h: __reclose({close({#D..., a: 1})..., bar...})
	t1: err: h & {x: z: 1} @test(err, code=eval, path=x.z, contains="field not allowed", pos=[0:19])
	t2: err: h & {q: 1}    @test(err, code=eval, path=q, contains="field not allowed", pos=[0:16])
	t3: ok:  h & {a: 1}    @test(eq, {x: {y: int}, a: 1, b: {}})
}

// close around a __reclose literal keeps the recursive closing a spread
// definition gives the literal, and __reclose around a close call keeps
// its one-level closing when no spread value is closed. The nested call
// instead closes the evaluated result of the inner call at one level, or
// not at all.
closeWrapsReclose: {
	#D: {a: {}}
	t1: err: close(__reclose({#D...})) & {a: z: 1} @test(eq, {a: {z: 1}}) @test(err:todo, at=a.z, code=eval, contains="field not allowed")
	t2: err: __reclose(close({})) & {z: 1} @test(eq, {z: 1}) @test(err:todo, at=z, code=eval, contains="field not allowed")
}

// issue4535: a comprehension at the top level of the closed struct reads a
// field as unified where the call appears, as it does for close, and the
// closing the spread definition gives the struct applies there as well.
// The argument is instead evaluated on its own, so the guard reads a
// non-concrete field. https://cuelang.org/issue/4535
issue4535: {
	#D: {k: int, y?: int}
	s: __reclose({#D..., k: _, if k == 1 {y: 1}})
	t: s & {k: 1} @test(err, code=incomplete, contains="non-concrete value int in operand to ==") @test(eq:todo, {k: 1, y: 1})
	denied: s & {k: 1, z: 2} @test(err, code=incomplete, contains="non-concrete value int in operand to ==") @test(err:todo, at=z, code=eval, contains="field not allowed")
	// A close call wrapping the __reclose call, as the explicitopen rewrite
	// emits for a close at field-value level, is unified the same way.
	wrapped: close(__reclose({#D..., k: _, if k == 1 {y: 1}})) & {k: 1} @test(err, code=incomplete, contains="non-concrete value int in operand to ==") @test(eq:todo, {k: 1, y: 1})
}
