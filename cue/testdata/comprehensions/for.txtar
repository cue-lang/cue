-- in.cue --
b: {for k, v in a {"\(k)": v + 1}} @test(eq, {b: 2, c: 3})
a: {b: 1, c: 2}                    @test(eq, {b: 1, c: 2})

x: {for k, v in y {"\(k)": v}} @test(eq, {})
y: {} // check that empty struct after reference works.

k: {for v in e {v}} @test(err, code=eval, pos=[0:14], contains="cannot range")
e: int @test(eq, int)

comprehensionBinds: {
	@test(eq, {a: a: _, b: a: _})
	a: {for _ in [1] {a: _}}
	b: {for _, _ in [1] {a: _}}
}
-- guard.cue --
import "encoding/json"

// A guard which finalizes the struct being ranged over, dropping its
// pending arc p, must not disturb the loop over the remaining fields.
guardFinalizesSource: {
	out: [for k, _ in src if json.Marshal(src) != "" {k}] @test(eq, ["a", "b"])
	src: {
		a: 1
		if a > 5 {p: 1}
		b: 2
	}
}
