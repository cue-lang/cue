# A comprehension body binds the previous element with a let, tests a
# field of it in an if clause, and embeds the let in that clause's body.
# Embedding prev copies the previous element's struct literal, including
# its let, into the current element. That second instance of the same let
# declaration used to be unified into the existing let arc, which the
# embedding had already taken directly, so the previous iteration's value
# leaked into the current element.
# https://cuelang.org/issue/4474

-- in.cue --
list: [
	{st: "A"},
	for i in [0, 1] {
		let prev = list[i]
		if prev.st == "B" {prev}
		st: "B"
	},
] @test(eq, [{st: "A"}, {st: "B"}, {st: "B"}])

struct: {
	a: {st: "A"}
	for k, p in {a: struct.a, b: struct.ax} {
		("\(k)x"): {
			let prev = p
			if prev.st == "B" {prev}
			st: "B"
		}
	}
	@test(eq, {
		a: {st: "A"}
		ax: {st: "B"}
		bx: {st: "B"}
	})
}

pattern: {
	prevKey: {x: "base", y: "x"}
	chain: {
		base: {st: "A"}
		x: pc.x
		y: pc.y
	}
	pc: {
		x: _
		y: _
		[string]~(K,_): {
			let prev = chain[prevKey[K]]
			if prev.st == "B" {prev}
			st: "B"
		}
	}
	@test(eq, {
		prevKey: {x: "base", y: "x"}
		chain: {
			base: {st: "A"}
			x: {st: "B"}
			y: {st: "B"}
		}
		pc: {
			x: {st: "B"}
			y: {st: "B"}
		}
	})
}

// Any use of prev in the element was affected once prev was also embedded,
// as the embedded instance of the let was unified into the same arc.
combined: [
	{st: "A"},
	for i in [0, 1] {
		let prev = combined[i]
		if prev.st == "B" {p: prev}
		if combined[i].st == "B" {prev}
		st: "B"
	},
] @test(eq, [{st: "A"}, {st: "B"}, {p: {st: "B"}, st: "B"}])

// These variants always worked: the let is not embedded, or the condition
// and the embedding do not both go through the let.
controls: {
	byValue: [
		{st: "A"},
		for i in [0, 1] {
			let prev = byValue[i]
			if prev.st == "B" {p: prev}
			st: "B"
		},
	] @test(eq, [{st: "A"}, {st: "B"}, {p: {st: "B"}, st: "B"}])
	directCond: [
		{st: "A"},
		for i in [0, 1] {
			let prev = directCond[i]
			if directCond[i].st == "B" {prev}
			st: "B"
		},
	] @test(eq, [{st: "A"}, {st: "B"}, {st: "B"}])
	directEmbed: [
		{st: "A"},
		for i in [0, 1] {
			let prev = directEmbed[i]
			if prev.st == "B" {directEmbed[i]}
			st: "B"
		},
	] @test(eq, [{st: "A"}, {st: "B"}, {st: "B"}])
}
