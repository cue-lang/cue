# Each comprehension in a struct pushes down a pending arc, which stays pending
# when the comprehension yields nothing. A list comprehension reading the
# struct, and a guard reading that list in turn, must both see the settled
# field set.
#
# A guard reading a struct with a comprehension nested in another's body must
# likewise see the field the inner comprehension declares. It instead reports
# a cyclic reference to that field. https://cuelang.org/issue/4487
-- in.cue --
empty: {
	q: {
		a: 0
		if false {b: 1}
		if false {c: 2}
	}
	n: [if len(q) > 1 {q}]
	if len(n) == 0 {
		out: "empty"
	}
	@test(eq, {q: {a: 0}, n: [], out: "empty"})
}

populated: {
	q: {
		a: 0
		b: 1
		if false {c: 2}
		if false {d: 3}
	}
	n: [if len(q) > 1 {q}]
	if len(n) != 0 {
		out: n
	}
	@test(eq, {
		q: {a: 0, b: 1}
		n: [{a: 0, b: 1}]
		out: [{a: 0, b: 1}]
	})
}

threeArcs: {
	q: {
		a: 0
		if false {b: 1}
		if false {c: 2}
		if false {d: 3}
	}
	n: [if len(q) > 1 {q}]
	if len(n) == 0 {
		out: "empty"
	}
	@test(eq, {q: {a: 0}, n: [], out: "empty"})
}

forLoops: {
	q: {
		a: 0
		for x in [] {b: x}
		for x in [] {c: x}
	}
	n: [if len(q) > 1 {q}]
	if len(n) == 0 {
		out: "empty"
	}
	@test(eq, {q: {a: 0}, n: [], out: "empty"})
}

guardFirst: {
	spec: {
		if len(n) != 0 {
			out: n
		}
	}
	q: {
		a: 0
		if false {b: 1}
		if false {c: 2}
	}
	n: [if len(q) > 1 {q}]
	@test(eq, {spec: {}, q: {a: 0}, n: []})
}

subField: {
	q: {
		a: 0
		if true {b: c: 1}
		if false {d: 3}
		if false {e: 4}
	}
	n: [if len(q) > 1 {q}]
	if len(n) != 0 {
		out: n
	}
	@test(eq, {
		q: {a: 0, b: c: 1}
		n: [{a: 0, b: c: 1}]
		out: [{a: 0, b: c: 1}]
	})
}

nestedPending: {
	q: {
		a: 0
		if false {b: x: 1}
		if false {b: y: 2}
		if false {c: 2}
	}
	n: [if len(q) > 1 {q}]
	if len(n) == 0 {
		out: "empty"
	}
	@test(eq, {q: {a: 0}, n: [], out: "empty"})
}

inDisjunction: {
	d: {
		kind: "a"
		if false {b: 1}
		if false {c: 2}
	} | {kind: "b", x: 1, y: 2}
	d: kind: "a"
	n: [if len(d) > 1 {d}]
	if len(n) == 0 {
		out: "empty"
	}
	@test(eq, {d: {kind: "a"}, n: [], out: "empty"})
}

nested: {
	q: {
		a: 0
		for x in [1] {
			if x == 1 {c: 2}
		}
		if false {d: 3}
	}
	n: [if len(q) > 1 {q}]
	if len(n) != 0 {
		out: n
	}
	@test(err, code=incomplete, path=q, contains="cyclic reference to field c")
	@test(eq:todo, {
		q: {a: 0, c: 2}
		n: [{a: 0, c: 2}]
		out: [{a: 0, c: 2}]
	})
}

nestedGuard: {
	q: {
		a: 0
		for x in [1] {
			if true {c: 2}
		}
	}
	if len(q) > 1 {
		out: q
	}
	@test(err, code=incomplete, path=q, contains="cyclic reference to field c")
	@test(eq:todo, {q: {a: 0, c: 2}, out: {a: 0, c: 2}})
}

deepNested: {
	q: {
		a: 0
		for x in [1] {
			for y in [1] {
				if x == y {c: 2}
			}
		}
		if false {d: 3}
	}
	n: [if len(q) > 1 {q}]
	if len(n) != 0 {
		out: n
	}
	@test(err, code=incomplete, path=q, contains="cyclic reference to field c")
	@test(eq:todo, {
		q: {a: 0, c: 2}
		n: [{a: 0, c: 2}]
		out: [{a: 0, c: 2}]
	})
}

deepNestedGuard: {
	q: {
		a: 0
		if true {
			if true {
				if true {c: 2}
			}
		}
	}
	if len(q) > 1 {
		out: q
	}
	@test(err, code=incomplete, path=q, contains="cyclic reference to field c")
	@test(eq:todo, {q: {a: 0, c: 2}, out: {a: 0, c: 2}})
}
-- out/errors.txt --
[incomplete] nested.q: cyclic reference to field c:
    ./in.cue:124:14
    ./in.cue:121:2
nested.q.c: cyclic reference to field c:
    ./in.cue:124:14
    ./in.cue:121:2
[incomplete] nestedGuard.q: cyclic reference to field c:
    ./in.cue:144:12
    ./in.cue:141:2
nestedGuard.q.c: cyclic reference to field c:
    ./in.cue:144:12
    ./in.cue:141:2
[incomplete] deepNested.q: cyclic reference to field c:
    ./in.cue:158:17
    ./in.cue:155:2
[incomplete] deepNestedGuard.q: cyclic reference to field c:
    ./in.cue:180:12
    ./in.cue:177:2
deepNestedGuard.q: cyclic reference to field c:
    ./in.cue:185:9
    ./in.cue:177:2
