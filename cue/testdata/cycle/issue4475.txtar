# A recursive disjunction reached through a value-preserving wrapper —
# #T: { A | B } or #T: X & (A | B) rather than #T: A | B — must behave
# exactly like the unwrapped form. Two independent triggers made it
# diverge:
#
#  - The struct wrapper made #T's own value silently drop every disjunct
#    whose inline self-reference cannot resolve yet: the lookup failed as a
#    permanent "undefined field" error rather than an incomplete one, and
#    the disjunct was discarded. A disjunct whose lookup names a field no
#    disjunct declares can never resolve, though, and must still be
#    eliminated rather than kept with an incomplete error (undeclared).
#  - The wrappers, and declaring #T before its first use, reintroduced the
#    cycle-detection blowup of issue 4377: every disjunct re-expanded the
#    whole disjunction at every level of the recursion, so cost grew
#    exponentially in the number of disjuncts. The stats guard against a
#    regression.
#
# https://cuelang.org/issue/4475
#inlinetest:exclude skip — perf regression guarded by out/eval/stats
-- in.cue --
wrapped: {
	out: (#T & {t: "r1"}).out

	#T: {
		{t!: "leaf", out: {}} |
		{t!: "r1", out: next: (#T & {t: "leaf"}).out} |
		{t!: "r2", out: next: (#T & {t: "leaf"}).out} |
		{t!: "r3", out: next: (#T & {t: "leaf"}).out} |
		{t!: "r4", out: next: (#T & {t: "leaf"}).out} |
		{t!: "r5", out: next: (#T & {t: "leaf"}).out}
	}
}

declaredFirst: {
	#T:
		{t!: "leaf", out: {}} |
		{t!: "r1", out: next: (#T & {t: "leaf"}).out} |
		{t!: "r2", out: next: (#T & {t: "leaf"}).out} |
		{t!: "r3", out: next: (#T & {t: "leaf"}).out} |
		{t!: "r4", out: next: (#T & {t: "leaf"}).out} |
		{t!: "r5", out: next: (#T & {t: "leaf"}).out}

	out: (#T & {t: "r1"}).out
}

unified: {
	out: (#T & {t: "r1"}).out

	#T: {x: 1} & (
		{t!: "leaf", out: {}} |
		{t!: "r1", out: next: (#T & {t: "leaf"}).out} |
		{t!: "r2", out: next: (#T & {t: "leaf"}).out} |
		{t!: "r3", out: next: (#T & {t: "leaf"}).out} |
		{t!: "r4", out: next: (#T & {t: "leaf"}).out} |
		{t!: "r5", out: next: (#T & {t: "leaf"}).out})
}

undeclared: {
	#T: {
		{t!: "leaf", out: {}} |
		{t!: "r1", out: next: (#T & {t: "leaf"}).out} |
		{t!: "r2", out: next: (#T & {t: "leaf"}).nope}
	}
	out: (#T & {t: "r1"}).out
}
