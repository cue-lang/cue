-- in.cue --
// Closedness should not be silently swallowed when propagated through
// comprehensions; fields added via comprehensions should still be checked.
// https://cuelang.org/issue/595
issue595: {
	// NOTE: this should eval with an EVAL error, not
	// an incomplete error. See Issue #595.
	#cfgs: [{
		name: "foo"
	}]
	_name: #cfgs[0].name
	for cfg in #cfgs {
		files: cfg.nam
	}
	@test(err, code=eval, at=files, contains="undefined field: nam", pos=[8:14, 3:10])
}
-- guard.cue --
// A comparison with bottom in a guard finalizes the field it tests, which
// computes the closedness requirements of the enclosing struct early.

// The fields a disjunct declares beside the tested field are still checked.
guardBeforeDisjunction: {
	#A: {
		a?: int
		b?: {x: int}
	}
	oneAllowed: #A & {
		b: {x: 1}
		if b != _|_ {
			{a: 1} | {typo: 2}
		}
	} @test(eq, {a: 1, b: {x: 1}})
	noneAllowed: #A & {
		b: {x: 1}
		if b != _|_ {
			{typo1: 1} | {typo2: 2}
		}
	} @test(err, code=eval, suberr=(contains="field not allowed", pos=[3:5]), suberr=(contains="field not allowed", pos=[3:18]))
	// A disjunct of an outer disjunction forks again within the guard.
	nested: #A & ({
		b: {x: 1}
		if b != _|_ {
			{a: 1} | {typo: 2}
		}
	} | {typo: 3}) @test(eq, {a: 1, b: {x: 1}})
	// Without the comparison, no field is finalized before forking.
	noGuard: #A & {
		b: {x: 1}
		if true {
			{a: 1} | {typo: 2}
		}
	} @test(eq, {a: 1, b: {x: 1}})
}
// A definition which the comprehension embeds adds a requirement, which the
// fields of the struct are checked against as well.
guardBeforeRequirement: {
	#B: {
		b?: _
		c?: int
	}
	notAllowed: {
		b: {x: 1}
		if b != _|_ {
			#B
		}
	} & {typo: 1} @test(eq, {b: {x: 1}, c?: int, typo: 1}, incorrect) @test(err:todo, at=typo, code=eval, contains="field not allowed", pos=[5:7],
		hint="the requirements are computed when the guard finalizes b, before #B is embedded")
	allowed: {
		b: {x: 1}
		if b != _|_ {
			#B
		}
	} & {c: 1} @test(eq, {b: {x: 1}, c: 1})
	// The requirement eliminates a disjunct.
	inDisjunct: ({
		b: {x: 1}
		if b != _|_ {
			#B
		}
	} | {zzz: 1}) & {typo: 1} @test(eq, {b: {x: 1}, c?: int, typo: 1} | {zzz: 1, typo: 1}, incorrect) @test(eq:todo, {zzz: 1, typo: 1})
	// Without the comparison, no field is finalized before embedding.
	noGuard: {
		b: {x: 1}
		if true {
			#B
		}
	} & {typo: 1} @test(err, at=typo, code=eval, contains="field not allowed", pos=[5:7])
}
