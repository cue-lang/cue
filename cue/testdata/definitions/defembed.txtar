# Pinned to v0.17.0: the subject is definition embedding with siblings
# before explicitopen is stable.
-- cue.mod/module.cue --
module: "mod.test"
language: version: "v0.17.0"
-- in.cue --
a: {
	#A
}

a: c: 1 @test(err, code=eval, contains="field not allowed", pos=[0:4])

#A: b: 1

b: {
	#A
    leaf: "leaf value"
    interpolation: "more \(leaf_ref)"
    leaf_ref: leaf

    @test(eq, {
		b:             1
		leaf:          "leaf value"
		interpolation: "more leaf value"
		leaf_ref:      "leaf value"
	})
}
-- sibling.cue --
// A struct which embeds a definition is closed by it, recursively, so a field
// added from outside the struct is not allowed, even within a definition which
// the struct declares. Embedding the definition through a disjunction makes no
// difference. The spec does not describe embedding before v0.18.0, so these
// cases follow the rule as the evaluator has it.
sibling: {
	direct: {
		out: {
			#A: {x: 1}
			#B: {y: 2}
			#A
		}
		out: #A: z: 3
		@test(err, code=eval, contains="field not allowed", pos=[6:12])
	}
	other: {
		out: {
			#A: {x: 1}
			#B: {y: 2}
			#B
		}
		out: #A: z: 3
		@test(err, code=eval, contains="field not allowed", pos=[6:12])
	}
	regular: {
		out: {
			a: {x: 1}
			#C
		}
		#C: {}
		out: a: z: 3
		@test(err, code=eval, contains="field not allowed", pos=[6:11])
	}
	disjunction: {
		out: {
			#A: {x: 1}
			#B: {y: 2}
			#A | #B
		}
		out: #A: z: 3
		@test(err, code=eval, contains="field not allowed", pos=[6:12])
	}
	comprehension: {
		out: {
			#A: {x: 1}
			#B: {y: 2}
			#A | #B
		}
		if true {out: #A: z: 3}
		@test(eq, {
			out: {#A: {z: 3, x: 1}, #B: {y: 2}, x: 1, z: 3} | {#A: {z: 3, x: 1}, #B: {y: 2}, y: 2}
		}, incorrect)
		@test(err:todo, p=2, code=eval, contains="field not allowed",
			hint="a field added through a comprehension is not checked against the closed struct")
	}
	reference: {
		out: {
			#A: {x: 1}
			#B: {y: 2}
			#A | #B
		}
		out: extra
		extra: #A: z: 3
		@test(err, code=eval, contains="field not allowed", pos=[7:14])
	}
	pattern: {
		[string]: {#A: z: 1}
		out: {
			#A: {x: int}
			#B: {y: 2}
			#A | #B
		}
		@test(err, code=eval, contains="field not allowed", pos=[1:18])
	}
}
-- out/errors.txt --
