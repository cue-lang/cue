    ./sibling.cue:22:12
[eval] sibling.regular.out.a.z: field not allowed:
    ./sibling.cue:31:11
[eval] sibling.disjunction.out.#A.z: field not allowed:
    ./sibling.cue:40:12
[eval] sibling.reference.out.#A.z: field not allowed:
    ./sibling.cue:63:14
[eval] sibling.pattern.out.#A.z: field not allowed:
    ./sibling.cue:67:18
