# Tests the explicitopen experiment: allows using the spread operator (...) to
# explicitly open closed structs. NewClosed1: {#A} is closed; NewOpen1: {#A...}
# is open. The test covers interactions between old and new style closedness.
-- cue.mod/module.cue --
module: "mod.test"

language: version: "v0.15.0"

-- old.cue --
package foo

@test(shareID=AOpen2, at=#A)
#A: a: 1
Old1: {
	{
		#A
		b: 1
	}
}

#Old2: {
	{
		#A
		b: 1
	}
}

useNewClosed1: {
	t1: err: NewClosed1 & {c: 3} @test(err, code=eval, contains="field not allowed", pos=[0:25])
	t2: ok:  {NewClosed1, c: 3} @test(eq, { a: 1, c: 3 })
}

useNewClosed2: {
	t1: err: #NewClosed2 & {c: 3} @test(err, code=eval, contains="field not allowed", pos=[0:26])
	t2: ok:  {#NewClosed2, c: 3} @test(eq, { a: 1, b: 1, c: 3 })
}

useNewOpen1: {
	t1: ok: NewOpen1 & {c: 3} @test(eq, { a: 1, b: 1, c: 3 })
	t2: ok: {NewOpen1, c: 3} @test(eq, { a: 1, b: 1, c: 3 })
}

useNewOpen2: {
	t1: ok: NewOpen2 & {c: 3} @test(eq, { a: 1, c: 3 })
	t2: ok: {NewOpen2, c: 3} @test(eq, { a: 1, c: 3 })
}

combineold: {
	// all {a: 1}
	a0: ok: #A & NewClosed1 @test(eq, { a: 1 })
	a1: ok: {#A, NewClosed1} @test(eq, { a: 1 })

	a2: ok: NewClosed1 & NewOpen2 @test(eq, { a: 1 })
	a3: ok: {NewClosed1, NewOpen2} @test(eq, { a: 1 })

	// all {a: 1, b: 2}
	b0: ok: Old1 & #NewClosed2 @test(eq, { a: 1, b: 1 })
	b1: ok: #Old2 & #NewClosed2 @test(eq, { a: 1, b: 1 })

	c1: ok: {#NewClosed2,  Old1} @test(eq, { a: 1, b: 1 })
	c2: ok: {#NewClosed2,  #Old2} @test(eq, { a: 1, b: 1 })

	// {a: 1} and {a: 1, b: 2}
	e0: err: #A & Old1 @test(err, code=eval, contains="field not allowed", pos=[-47:3])
	e1: err: #A & #Old2 @test(err, code=eval, contains="field not allowed", pos=[-41:3])
	e2: err: #A & #NewClosed2 @test(err, code=eval, contains="field not allowed", pos=[new.cue:12:2])
	e3: err: #A & NewOpen1 @test(err, code=eval, contains="field not allowed", pos=[new.cue:17:2])

	e4: ok: {#A, Old1} @test(eq, { a: 1, b: 1 })
	e5: ok: {#A, #Old2} @test(eq, { a: 1, b: 1 })
	e6: ok: {#A, #NewClosed2} @test(eq, { a: 1, b: 1 })
	e7: ok: {#A, NewOpen1} @test(eq, { a: 1, b: 1 })

	f0: err: NewClosed1 & Old1 @test(err, code=eval, contains="field not allowed", pos=[-57:3])
	f1: err: NewClosed1 & #Old2 @test(err, code=eval, contains="field not allowed", pos=[-51:3])
	f2: err: NewClosed1 & #NewClosed2 @test(err, code=eval, contains="field not allowed", pos=[new.cue:12:2])
	f3: err: NewClosed1 & NewOpen1 @test(err, code=eval, contains="field not allowed", pos=[new.cue:17:2])

	f4: ok: {NewClosed1, Old1} @test(eq, { a: 1, b: 1 })
	f5: ok: {NewClosed1, #Old2} @test(eq, { a: 1, b: 1 })
	f6: ok: {NewClosed1, NewClosed1} @test(eq, { a: 1 })
	f7: ok: {NewClosed1, #NewClosed2} @test(eq, { a: 1, b: 1 })
	f8: ok: {NewClosed1, NewOpen1} @test(eq, { a: 1, b: 1 })
}

-- new.cue --
@experiment(explicitopen)

package foo

NewClosed1: {
	@test(shareID=NC1)
	#A
}

#NewClosed2: {
	#A...
	b: 1
}

NewOpen1: {
	#A...
	b: 1
}

NewOpen2: #A... @test(shareID=AOpen2)

useOld1: {
	t1: err: Old1 & {c: 3} @test(err, code=eval, contains="field not allowed", pos=[0:19])
	t2: err: {Old1, c: 3} @test(err, code=eval, contains="field not allowed", pos=[0:18]) // TODO
	t3: ok:  {Old1..., c: 3} @test(eq, {a: 1, b: 1, c: 3})
}

useOld2: {
	t1: err: #Old2 & {c: 3} @test(err, code=eval, contains="field not allowed", pos=[0:20])
	t2: err: {#Old2, c: 3} @test(err, code=eval, contains="field not allowed", pos=[0:19])
	t3: ok:  {#Old2..., c: 3} @test(eq, {a: 1, b: 1, c: 3})
}

combinenew: {
	// all {a: 1}
	a0: ok: #A & NewClosed1 @test(eq, {a: 1})
	a1: ok: {#A, NewClosed1} @test(eq, {a: 1})

	a2: ok: NewClosed1 & NewOpen2 @test(eq, {a: 1})
	a3: ok: {NewClosed1, NewOpen2} @test(eq, {a: 1})
	a4: ok: {NewClosed1..., NewOpen2} @test(eq, {a: 1})

	a5: ok: NewOpen2 & NewClosed1 @test(eq, {a: 1})
	a6: ok: {NewOpen2, NewClosed1} @test(eq, {a: 1})
	a7: ok: {NewOpen2..., NewClosed1} @test(eq, {a: 1})

	// all {a: 1, b: 2}
	b0: ok: Old1 & #NewClosed2 @test(eq, {a: 1, b: 1})
	b1: ok: #Old2 & #NewClosed2 @test(eq, {a: 1, b: 1})
	b2: ok: #NewClosed2 & Old1 @test(eq, {a: 1, b: 1})
	b3: ok: #NewClosed2 & #Old2 @test(eq, {a: 1, b: 1})

	c1: ok: {#NewClosed2,  Old1} @test(eq, {a: 1, b: 1})
	c2: ok: {#NewClosed2,  #Old2} @test(eq, {a: 1, b: 1})
	c3: ok: {Old1, #NewClosed2} @test(eq, {a: 1, b: 1})
	c4: ok: {#Old2, #NewClosed2} @test(eq, {a: 1, b: 1})

	d0: ok: {#NewClosed2,  Old1...} @test(eq, {a: 1, b: 1})
	d1: ok: {#NewClosed2,  #Old2...} @test(eq, {a: 1, b: 1})
	d2: ok: {#NewClosed2...,  Old1} @test(eq, {a: 1, b: 1})
	d3: ok: {#NewClosed2...,  #Old2} @test(eq, {a: 1, b: 1})
	d4: ok: {#NewClosed2...,  Old1...} @test(eq, {a: 1, b: 1})
	d5: ok: {#NewClosed2...,  #Old2...} @test(eq, {a: 1, b: 1})

	d6: ok: {Old1..., #NewClosed2} @test(eq, {a: 1, b: 1})
	d7: ok: {#Old2..., #NewClosed2} @test(eq, {a: 1, b: 1})
	d8: ok: {Old1, #NewClosed2...,} @test(eq, {a: 1, b: 1})
	d9: ok: {#Old2, #NewClosed2...,} @test(eq, {a: 1, b: 1})
	d10: ok: {Old1..., #NewClosed2...,} @test(eq, {a: 1, b: 1})
	d11: ok: {#Old2..., #NewClosed2...,} @test(eq, {a: 1, b: 1})

	// {a: 1} and {a: 1, b: 2}
	e0: err: #A & Old1 @test(err, code=eval, contains="field not allowed", pos=[old.cue:8:3])
	e1: err: #A & #Old2 @test(err, code=eval, contains="field not allowed", pos=[old.cue:15:3])
	e2: err: #A & #NewClosed2 @test(err, code=eval, contains="field not allowed", pos=[-63:2])
	e3: err: #A & NewOpen1 @test(err, code=eval, contains="field not allowed", pos=[-59:2])

	e4: err: {#A, Old1} @test(err, code=eval, contains="field not allowed", pos=[old.cue:8:3])
	e5: err: {#A, #Old2} @test(err, code=eval, contains="field not allowed", pos=[old.cue:15:3])
	e6: err: {#A, #NewClosed2} @test(err, code=eval, contains="field not allowed", pos=[-68:2])
	e7: err: {#A, NewOpen1} @test(err, code=eval, contains="field not allowed", pos=[-64:2])

	e8: ok: {#A..., Old1} @test(eq, {a: 1, b: 1})
	e9: ok: {#A..., #Old2} @test(eq, {a: 1, b: 1})
	e10: ok: {#A..., #NewClosed2} @test(eq, {a: 1, b: 1})
	e11: ok: {#A..., NewOpen1} @test(eq, {a: 1, b: 1})

	f0: err: NewClosed1 & Old1 @test(err, code=eval, contains="field not allowed", pos=[old.cue:8:3])
	f1: err: NewClosed1 & #Old2 @test(err, code=eval, contains="field not allowed", pos=[old.cue:15:3])
	f2: err: NewClosed1 & #NewClosed2 @test(err, code=eval, contains="field not allowed", pos=[-78:2])
	f3: err: NewClosed1 & NewOpen1 @test(err, code=eval, contains="field not allowed", pos=[-74:2])
	f4: ok: NewClosed1 & NewClosed1 @test(eq, {a: 1}) @test(shareID=NC1)

	f5: err: {NewClosed1, Old1} @test(err, code=eval, contains="field not allowed", pos=[old.cue:8:3])
	f6: err: {NewClosed1, #Old2} @test(err, code=eval, contains="field not allowed", pos=[old.cue:15:3])
	f7: err: {NewClosed1, #NewClosed2} @test(err, code=eval, contains="field not allowed", pos=[-84:2])
	f8: err: {NewClosed1, NewOpen1} @test(err, code=eval, contains="field not allowed", pos=[-80:2])
	f9: ok: {NewClosed1, NewClosed1} @test(err)

	f9: ok:  {NewClosed1..., Old1} @test(err, code=eval, contains="field not allowed", pos=[old.cue:8:3], hint="see todo")
	f10: ok: {NewClosed1..., #Old2} @test(eq, {a: 1, b: 1})
	f11: ok: {NewClosed1..., NewClosed1} @test(eq, {a: 1})
	f12: ok: {NewClosed1..., #NewClosed2} @test(eq, {a: 1, b: 1})
	f13: ok: {NewClosed1..., NewOpen1} @test(eq, {a: 1, b: 1})

	f14: err: Old1 & NewClosed1 @test(eq, {a: 1, b: 1}, hint="see todo")
	f15: err: #Old2 & NewClosed1 @test(eq, {a: 1, b: 1}, hint="see todo")
	f16: err: #NewClosed2 & NewClosed1 @test(err, code=eval, contains="field not allowed", pos=[-96:2])
	f17: err: NewOpen1 & NewClosed1 @test(err, code=eval, contains="field not allowed", pos=[-92:2])
	f18: ok: NewClosed1 & NewClosed1 @test(eq, {a: 1}) @test(shareID=NC1)
}
-- issues.cue --
@experiment(explicitopen)
// explicitopen experiment: postfix `...` spread cannot directly combine with
// `&`; tests open-struct spread behavior and non-struct operand tolerance.
// https://cuelang.org/issue/4150
issue4150: {
	#Def: a: int

	x: #Def... & {
			a: 42
			b: 42
	} @test(eq, {a: 42, b: 42}) @test(closed)

	foo: {a: int}
	bar: {b: int}
	y: foo... & bar... @test(eq, {a: int, b: int})

	// NOTE: we allow this, even though it doesn't mean anything. The benefit
	// of this is that code doesn't become brittle using the spread operator
	// for references. Consider this example:
	//
	//  #Def: a: int
	//	foo: 1 | #Def
	//	bar: foo...
	//
	// Not allowing ... on any expression would mean #foo... may or may not be
	// erroneous, depending on the value foo is set to.
	z: 1... @test(eq, 1)
}

// A definition re-closes a reference opened with `...`, even when the
// referenced value is itself an instance of that definition and is shared.
reclose: {
	#D: a: int
	x: #D & {a: 1}
	y: x... & #D @test(eq, {a: 1})
	t1: err: y & {b: 2} @test(err, code=eval, contains="field not allowed")
}

// A reference opened with `...` stays open when the only disjunct left of a
// disjunction opened alike shares it.
sharedDisjunct: {
	#A: {x: 1}
	#B: {x: 2}
	D: #A | #B
	c: #B...
	c: D...
	m: c & {y: 3} @test(eq, {x: 2, y: 3})

	// The definition closes a field reading such a reference again, also
	// when read through another field.
	Z: c
	Z: #B
	n: Z & {y: 3} @test(err, code=eval, contains="empty disjunction")
	o: c
	o: Z
	p: o & {y: 3} @test(err, code=eval, contains="empty disjunction")
}

// A field sharing a forward reference to an opened definition stays open
// when unshared after the reference was evaluated.
forwardShared: {
	#A: {x: 1}
	#B: {x: 2}

	direct: {
		c: b @test(eq, {x: 2, y: 3}) @test(kind=struct)
		c: F
		c: G
		F: *#A | {x: 2}
		G: {y: 3}
		b: #B...
	}
	indirect: {
		c: b @test(eq, {x: 2, y: 3}) @test(kind=struct)
		c: F
		c: G
		F: *#A | {x: 2}
		G: {y: 3}
		b: X
		X: #B...
	}
	// A field already sharing a reference to an opened field queues the
	// conjuncts of a closed forward reference instead. Only a is opened
	// here: b closes the field as in recloseSame.field below, even when
	// the reference is evaluated before its conjuncts run.
	queued: {
		c: a @test(err, code=eval, contains="empty disjunction")
		c: b
		c: F
		a: b...
		b: #B
		F: *#A | {x: 2, y: 3}
	}
}

// A definition re-closes a reference to itself opened with `...` in either
// order, also when reached through another field or through the only
// disjunct left of a disjunction. A field holding the definition does the
// same.
recloseSame: {
	#A: {x: 1}
	#B: {x: 2}
	D: #A | #B
	X: #B

	same: {
		c: #B... @test(permute)
		c: #B    @test(permute, count=2)
		m: c & {y: 3} @test(err, code=eval, contains="field not allowed")
	}
	sameField: {
		c: X... @test(permute)
		c: X    @test(permute, count=2)
		m: c & {y: 3} @test(err, code=eval, contains="field not allowed")
	}
	field: {
		c: #B...
		c: X
		m: c & {y: 3} @test(err, code=eval, contains="field not allowed")
	}
	conjunction: {
		c: (#B & #B)...
		c: #B
		m: c & {y: 3} @test(err, code=eval, contains="field not allowed")
	}
	disjunct: {
		c: #B...
		c: D
		m: c & {y: 3} @test(err, code=eval, contains="empty disjunction")
	}
	readDisjunct: {
		v: #B...
		v: D
		c: #B...
		c: v
		m: c & {y: 3} @test(err, code=eval, contains="empty disjunction")
	}

	// A reference stays open when it reaches the opened vertex through
	// fields that share it before it is evaluated.
	forward: {
		Z: w
		w: #B...
		c: #B...
		c: Z
		m: c & {y: 3} @test(eq, {x: 2, y: 3})
	}
	forwardSelf: {
		Z: c
		c: #B...
		c: Z
		m: c & {y: 3} @test(eq, {x: 2, y: 3})
	}
	forwardRead: {
		n: c
		c: #B...
		m: n & {y: 3} @test(eq, {x: 2, y: 3})
	}
	// A reference stays open when the only disjunct left of the field it
	// reads shares the opened vertex.
	readOpenedDisjunct: {
		v: #B...
		v: D...
		c: #B...
		c: v
		m: c & {y: 3} @test(eq, {x: 2, y: 3})
	}

	// Only the definition the opened vertex is unified with closes it again,
	// not the other definitions that vertex is closed by.
	otherDefs: {
		#P: {x?: int}
		#Q: {x?: int, [=~"^z"]: int}
		w: #P & #Q
		c: w...
		c: #Q
		m: c & {z: 1} @test(eq, {x?: int, z: 1})
		n: c & {q: 1} @test(err, code=eval, contains="field not allowed")
	}

	// A reference to a definition closes it, even when the definition shares
	// a vertex through an opened reference, in either order.
	def: {
		#C: #B...
		c: #C
		m: c & {y: 3} @test(err, code=eval, contains="field not allowed")

		w: #B...
		#D: w
		d: #D
		n: d & {y: 3} @test(err, code=eval, contains="field not allowed")

		e: #E
		#E: #B...
		o: e & {y: 3} @test(err, code=eval, contains="field not allowed")

		// Also when the field embeds the opened definition in a struct, or
		// is unified with an opened disjunction, and when a field holding
		// such a definition is reached through another field.
		v: {#B..., z?: int}
		#F: v
		f: #F
		p: f & {y: 3} @test(eq, {x: 2, z?: int, y: 3}, incorrect) @test(err:todo, code=eval, contains="field not allowed")
		f2: f
		r: f2 & {y: 3} @test(eq, {x: 2, z?: int, y: 3}, incorrect) @test(err:todo, code=eval, contains="field not allowed")
		k: s: #F
		h: k.s & {y: 3} @test(eq, {x: 2, z?: int, y: 3}, incorrect) @test(err:todo, code=eval, contains="field not allowed")

		u: #B...
		u: D...
		#G: u
		g: #G
		q: g & {y: 3} @test(eq, {x: 2, y: 3}, incorrect) @test(err:todo, code=eval, contains="empty disjunction")
		g2: g
		t: g2 & {y: 3} @test(eq, {x: 2, y: 3}, incorrect) @test(err:todo, code=eval, contains="empty disjunction")
	}

	// A definition re-closes a field it opens with `...`, so selecting the
	// field closes it however the definition is reached: through a reference
	// naming it, or through a regular field holding it, possibly unified with
	// something else, or opened through a conjunction. An ellipsis in the
	// field keeps it open, as does a spread beside the definition, whose
	// fields the definition does not declare.
	crossing: {
		#D: s: #B...
		m: #D.s & {y: 3} @test(err, code=eval, contains="field not allowed")
		c: #D.s
		n: c & {y: 3} @test(err, code=eval, contains="field not allowed")
		t: c
		o: t & {y: 3} @test(err, code=eval, contains="field not allowed")
		u: v
		v: #D.s
		p: u & {y: 3} @test(err, code=eval, contains="field not allowed")
		d: #D
		q: d.s & {y: 3} @test(err, code=eval, contains="field not allowed")
		w: d.s
		r: w & {y: 3} @test(err, code=eval, contains="field not allowed")
		du: #D & {}
		h: du.s & {y: 3} @test(eq, {x: 2, y: 3}, incorrect) @test(err:todo, code=eval, contains="field not allowed")

		#E: s: (#B & {})...
		e: #E
		x: e.s & {y: 3} @test(err, code=eval, contains="field not allowed")

		#F: s: {#B..., ...}
		f: #F
		g: f.s & {y: 3} @test(eq, {x: 2, y: 3})

		#Open: {...}
		#Extra: s: t: {a: 1}
		dx: #Open & #Extra...
		mx: dx & {s: b: 2} @test(eq, {s: {t: {a: 1}, b: 2}})
		nx: dx.s & {b: 2} @test(eq, {t: {a: 1}, b: 2})
		ox: dx.s.t & {b: 2} @test(eq, {a: 1, b: 2})
		dy: #Open & (#Extra & {})...
		ny: dy.s & {b: 2} @test(eq, {t: {a: 1}, b: 2})

		// The same holds when the selected field does not share the
		// definition's vertex. A spread within the definition is re-closed
		// at every level, also at the definition's own level and when the
		// definition is unified inline.
		#H: s: {x: 1, ...}
		dh: #H & #Extra...
		eh: dh.s & {}
		ph: eh.t & {b: 2} @test(eq, {a: 1, b: 2})
		#Z: {#Extra..., s: {x: 1}}
		dz: #Z & {}
		pz: dz.s.t & {b: 2} @test(eq, {a: 1, b: 2}, incorrect) @test(err:todo, code=eval, contains="field not allowed")
		#Y: {#Extra...}
		dw: #Y & {}
		pw: dw.s & {b: 2} @test(eq, {t: {a: 1}, b: 2}, incorrect) @test(err:todo, code=eval, contains="field not allowed")
		#K: s: {x: 1}
		ik: (#K & #Extra...).s @test(eq, {x: 1, t: {a: 1}}, incorrect) @test(err:todo, code=eval, contains="field not allowed")
	}
}
// A definition re-closes a conjunction it is an operand of, opened with
// `...`, in either order, also when the conjuncts sit on a single field or
// the definition is embedded in a struct.
recloseConjunction: {
	#B: {x: 2}
	#C: {x: 2}
	field: {
		c: (#B & #C)... @test(permute)
		c: #B           @test(permute, count=2)
		m: c & {y: 3} @test(err, code=eval, contains="field not allowed")
	}
	inline:    (#B & {})... & #B & {y: 3} @test(err, code=eval, contains="field not allowed")
	inlineRev: #B & (#B & {})... & {y: 3} @test(err, code=eval, contains="field not allowed")
	embedded: {
		c: (#B & #B)... @test(permute)
		c: {#B}         @test(permute, count=2)
		m: c & {y: 3} @test(err, code=eval, contains="field not allowed")
	}
}
// A spread opens the definition it spreads, so the struct admits any field.
// The API instead reports it as closed and as not allowing the field, even
// though unifying the field succeeds.
spreadDefClosed: {
	#D: {a: {}}
	v: {#D...}
	t1: v @test(closed:todo=false) @test(allows:todo, z)
	t2: v & {z: 1} @test(eq, {a: {}, z: 1})
	// The same holds for a spread of a __reclose literal which a definition
	// closes.
	w: {__reclose({#D...})...}
	t3: w @test(closed:todo=false) @test(allows:todo, z)
	t4: w & {z: 1} @test(eq, {a: {}, z: 1})
}

