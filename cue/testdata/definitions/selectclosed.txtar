# A definition closes recursively, and a regular field holding a definition
# is closed too. Selecting a field from that regular field must keep the
# closedness, exactly as selecting it from the definition does.
#
# Whether the closed value then closes the struct it is embedded in is a
# separate question, and one the explicitopen experiment answers differently.
# The module therefore opts in per file: in.cue is under the experiment, as
# every file is from v0.18.0 on, and old.cue is not.
-- cue.mod/module.cue --
module: "mod.test"

language: version: "v0.15.0"

-- in.cue --
@experiment(explicitopen)

#Meta: meta: {name: "x"}
m: #Meta

// Selecting from the definition keeps its closedness.
direct: #Meta.meta & {extra: 1} @test(err, at=extra, contains="field not allowed")

// The regular field is closed.
whole: m & {meta: extra: 1} @test(err, at=meta.extra, contains="field not allowed")

// Selecting from the regular field must be closed too.
viaField: m.meta & {extra: 1} @test(err, at=extra, contains="field not allowed")

// Deeper selections, and a selection inside a definition.
#Deep: a: b: {c: 1}
d: #Deep
viaDeep: d.a.b & {extra: 1} @test(err, at=extra, contains="field not allowed")
#Use: x: d.a
viaDef: #Use & {x: {b: {extra: 1}}} @test(err, at=x.b.extra, contains="field not allowed")

// Through an intermediate regular field.
inter: {x: m, y: x.meta & {extra: 1}}
viaInter: inter.y @test(err, contains="field not allowed")

// A comprehension body is written at a path, so a selection in one closes
// like one written in the struct around it, be it an if or a for.
viaIf: {
	if true {
		x: m.meta & {extra: 1}
	}
} @test(err, at=x.extra, contains="field not allowed")
viaFor: {
	for k, _ in {one: 1} {
		"\(k)": m.meta & {extra: 1}
	}
} @test(err, at=one.extra, contains="field not allowed")

// Under the experiment an embedded closed value closes the struct it lands
// in, whether it is written there directly or in a comprehension body.
viaEmbed: {
	m.meta
	extra: 1
} @test(err, at=extra, contains="field not allowed")
viaEmbedFor: {
	for k, _ in {one: 1} {
		m.meta
	}
	extra: 1
} @test(err, at=extra, contains="field not allowed")

// A regular field with a struct literal stays open.
open: {meta: {name: "x"}}
viaOpen: open.meta & {extra: 1} @test(eq, {name: "x", extra: 1})

// A regular struct referenced from a definition is evaluated at a path
// within it. A sibling reference in that struct then resolves to an arc
// under the definition without crossing into it, so a plain struct it
// refers to stays open.
#Opt: {a?: int}
plain: {q: {}, s: #Opt & q & {a: 3}}
#Via: {v: plain}
viaSibling: #Via.v.s @test(err, contains="field not allowed", incorrect) @test(eq:todo, {a: 3})

// The same holds however the sibling is reached: through a let, in a
// comprehension body, by selecting a field of it, or from a nested field.
plainLet:    {q: {}, let Q = q, s: #Opt & Q & {a: 3}}
plainFor:    {q: {}, for _, _ in [1] {s: #Opt & q & {a: 3}}}
plainSel:    {q: {t: {}}, s: #Opt & q.t & {a: 3}}
plainNested: {q: {}, s: t: #Opt & q & {a: 3}}
#ViaAll: {l: plainLet, f: plainFor, s: plainSel, n: plainNested}
viaSiblingLet:    #ViaAll.l.s @test(err, contains="field not allowed", incorrect) @test(eq:todo, {a: 3})
viaSiblingFor:    #ViaAll.f.s @test(err, contains="field not allowed", incorrect) @test(eq:todo, {a: 3})
viaSiblingSel:    #ViaAll.s.s @test(err, contains="field not allowed", incorrect) @test(eq:todo, {a: 3})
viaSiblingNested: #ViaAll.n.s.t @test(err, contains="field not allowed", incorrect) @test(eq:todo, {a: 3})

// A reference resolved from outside the definition crosses into it even
// when it is evaluated at a path within the definition, because the struct
// holding the reference is what the definition refers to.
outside: #Out
let Out = {s: {a: 1}, u: outside.s & {b: 2}}
#Out: Out
viaOutside: #Out.u @test(eq, {a: 1, b: 2}, incorrect) @test(err:todo, contains="field not allowed")

// A let bound to such a reference denotes the same value.
outsideLet: #OutLet
let OutLet = {s: {a: 1}, let S = outsideLet.s, u: S & {b: 2}}
#OutLet: OutLet
viaOutsideLet: #OutLet.u @test(eq, {a: 1, b: 2}, incorrect) @test(err:todo, contains="field not allowed")

// Selecting from an inline struct opens definition closedness, see
// eval/openinline.txtar, but only for a reference resolved against the
// inline struct itself. A reference written inside it and resolved outside
// it closes as viaField does.
inlineField: ({in: m, out: in.meta}).out & {extra: 1} @test(eq, {name: "x", extra: 1})
inlineLet:   ({let M = m, out: M.meta}).out & {extra: 1} @test(eq, {name: "x", extra: 1}, incorrect) @test(err:todo, at=extra, contains="field not allowed")
inlineRoot:  ({out: m.meta}).out & {extra: 1} @test(eq, {name: "x", extra: 1}, incorrect) @test(err:todo, at=extra, contains="field not allowed")
-- old.cue --
// A definition is closed either way, so the same selections close without
// the experiment, in a comprehension body as anywhere else.
#Old: meta: {name: "x"}
o:        #Old
oldDirect: #Old.meta & {extra: 1} @test(err, at=extra, contains="field not allowed")
oldField:  o.meta & {extra: 1} @test(err, at=extra, contains="field not allowed")
oldViaIf: {
	if true {
		x: o.meta & {extra: 1}
	}
} @test(err, at=x.extra, contains="field not allowed")
oldViaFor: {
	for k, _ in {one: 1} {
		"\(k)": o.meta & {extra: 1}
	}
} @test(err, at=one.extra, contains="field not allowed")

// A sibling reference in a regular struct that a definition refers to stays
// open without the experiment as well.
#OldOpt: {a?: int}
oldPlain: {q: {}, s: #OldOpt & q & {a: 3}}
#OldVia: {v: oldPlain}
oldViaSibling: #OldVia.v.s @test(err, contains="field not allowed", incorrect) @test(eq:todo, {a: 3})

// Embedding is where the two differ: without the experiment an embedded
// closed value leaves the struct it lands in open. That holds for a value
// selected from a definition, so it must hold for one selected through a
// regular field as well.
oldEmbedDef: {
	#Old.meta
	extra: 1
} @test(eq, {name: "x", extra: 1})
oldEmbed: {
	o.meta
	extra: 1
} @test(eq, {name: "x", extra: 1})
oldEmbedFor: {
	for k, _ in {one: 1} {
		o.meta
	}
	extra: 1
} @test(eq, {name: "x", extra: 1})
