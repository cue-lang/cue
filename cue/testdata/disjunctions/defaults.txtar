-- in.cue --
passToSingleValue: p1: _ | *((_ | *"x") & "y") @test(eq, *"y" | _)
passToSingleValue: p2: _ | *((*"x" | _) & "y") @test(eq, *"y" | _)
passToSingleValue: p3: *((_ | *"x") & "y") | _ @test(eq, *"y" | _)
passToSingleValue: p4: *((*"x" | _) & "y") | _ @test(eq, *"y" | _)

// eval: "incomplete value" regression with defaults involving multiple
// definitions; default values that depend on other fields should resolve.
// https://cuelang.org/issue/3779
issue3779: {
	out: #Foo & {
		fieldFoo: "foo"
	}
	#Foo: #Bar & {
		fieldFoo: string | *"foo-default"
	}
	#Bar: {
		fieldFoo: _
		fieldBar: string | *fieldFoo
	}
	@test(eq, {
		out: {
			fieldFoo: "foo"
			fieldBar: *"foo" | string
		}
		#Foo: {
			fieldFoo: *"foo-default" | string
			fieldBar: *"foo-default" | string
		}
		#Bar: {fieldFoo: _, fieldBar: *_ | string}
	})
}
-- collapse.cue --
// A nested disjunction which collapses to a single disjunct keeps its default,
// just like a nested disjunction with several disjuncts.
collapse: {
	// *1|1 is ⟨1, 1⟩ by rule M1, so rule D2 gives the default 1|2.
	d2:        (*1 | 1) | (1 | *2)         @test(eq, *1 | *2)
	d2Strings: (*"a" | "a") | (*"b" | "a") @test(eq, *"a" | *"b")
	// An example from the spec: (1|*2|3)&2 is ⟨2, 2⟩ by rule U1.
	d2Spec:    (*1 | 2 | 3) | (1 | *2 | 3) & 2 @test(eq, *1 | *2 | 3)
	d2Unified: (*1 | 2) | ((*3 | 4) & 3)       @test(eq, *1 | *3 | 2)

	d1:        (*1 | 1) | 2       @test(eq, *1 | 2)
	d1Unified: ((*1 | 2) & 1) | 2 @test(eq, *1 | 2)
	d1Pattern: {
		env: [string]: bool | number | *string | null
		env: a:        "x"
		// env.a is ⟨"x", "x"⟩ by rule U1.
		b: env.a | "fallback" @test(eq, *"x" | "fallback")
	}

	u2: (*1 | 2) & ((*1 | 1) | (1 | *2)) @test(eq, *1 | 2)

	m1:     *(1 | 1) | 2          @test(eq, *1 | 2)
	m2:     *(*1 | 1) | 2         @test(eq, *1 | 2)
	m3:     (*1 | 1) | *2         @test(eq, *2 | 1)
	m2Both: *(*1 | 1) | *(1 | *2) @test(eq, *1 | *2)

	single:  *1 | 1       @test(eq, 1)
	unified: (*1 | 2) & 1 @test(eq, 1)
}

// Nested disjunctions with several disjuncts.
nested: {
	d2: (*1 | 2 | 3) | (1 | *2 | 3)  @test(eq, *1 | *2 | 3)
	m2: (*1 | 2 | 3) | *(1 | *2 | 3) @test(eq, *2 | 1 | 3)

	// Disjuncts which differ only in pattern constraints are distinct, so
	// neither nested disjunction collapses.
	d2Patterns: ({[string]: int} | *{}) | ({} | *{[string]: int}) @test(eq, *{[string]: int} | *{})

	// The marked "a" is eliminated, so the remaining int is treated as
	// unmarked and the default comes from the nested disjunction alone.
	eliminated: (*"a" | int) & (*(*1 | 2) | "b") @test(eq, *1 | 2)

	// The marked "x" is eliminated, so the nested disjunctions keep their
	// defaults by rule D2. They lose them as they are unmarked in the
	// right-hand side.
	eliminatedNested:    ((*1 | 2) | (*3 | 4) | *"x") & int @test(eq, 1 | 2 | 3 | 4, incorrect) @test(eq:todo, *1 | 2 | *3 | 4)
	eliminatedCollapsed: ((*1 | 1) | (*2 | 2) | *"x") & int @test(eq, 1 | 2, incorrect) @test(eq:todo, *1 | *2)
}
