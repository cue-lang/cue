}
-- optionalerror.cue --
// evalv3 closedness regression with disjunctions and ellipses; a definition
// using _|_ in an optional field inside a disjunction caused spurious errors.
// https://cuelang.org/issue/4022
issue4022: reduced: {
	#NonNamespaced: metadata: namespace?: _|_
	#NullOrNonNamespaced: int | #NonNamespaced
	out: #NullOrNonNamespaced
	out: #NonNamespaced
	out: metadata: {}
	@test(eq, {
		#NonNamespaced: {
			metadata: {
				namespace?: _|_ @test(err, code=user, contains="explicit error (_|_ literal) in source", pos=[1:40])
			}
		}
		#NullOrNonNamespaced: int | {metadata: {
		namespace?: _|_ @test(err, code=user, contains="explicit error (_|_ literal) in source", pos=[1:40])
	}}
		out: {
			metadata: {
				namespace?: _|_ @test(err, code=user, contains="explicit error (_|_ literal) in source", pos=[1:40])
			}
		}
	})
}
issue4022: full: {
	#NonNamespaced: {
		metadata: {
			name!:      string
			namespace?: _|_
			...
		}
		...
	}

	#NullOrNonNamespaced: null | #NonNamespaced

	out: #NullOrNonNamespaced
	out: #NonNamespaced
	out: {
		metadata: name: "foo"
		apiVersion: "v1"
	}
	@test(eq, {
		#NonNamespaced: {
			metadata: {
				name!: string
				namespace?: _|_ @test(err, code=user, contains="explicit error (_|_ literal) in source", pos=[4:16])
			}
		}
		#NullOrNonNamespaced: null | {metadata: {
		name!: string
		namespace?: _|_ @test(err, code=user, contains="explicit error (_|_ literal) in source", pos=[4:16])
	}}
		out: {
			metadata: {
				name: "foo"
				namespace?: _|_ @test(err, code=user, contains="explicit error (_|_ literal) in source", pos=[4:16])
			}
			apiVersion: "v1"
		}
	})
}
-- failedfield.cue --
// Within a disjunct, a field with an error stops the evaluation of the fields
// after it, which thus lack the evidence that they are allowed. Each disjunct
// reports the error of the failed field rather than these other fields.
reportFailedField: {
	def: {
		#A: {a: int}
		#B: #A & {b: 1}
		#C: {c: 1}
		#D: {d: 1}
		#C | #D
		@test(err, code=eval, contains="field not allowed", pos=[2:13])
	}
	hidden: {
		#A: {a: int}
		_B: #A & {b: 1}
		#C: {c: 1}
		#D: {d: 1}
		#C | #D
		@test(err, code=eval, contains="field not allowed", pos=[2:13])
	}
	// The failed field was evaluated, so it is still checked.
	regular: {
		#A: {a: int}
		B: #A & {b: 1}
		#C: {c: 1}
		#D: {d: 1}
		#C | #D
		@test(err, code=eval, contains="field not allowed", pos=[2:3])
	}
	// A field before the failed one may have evaluated a field after it,
	// which then holds an error of its own. The disjunct still reports the
	// error of the failed field.
	evaluatedLater: {
		#A: {a: int}
		#L: {next: #L}
		conflict: {
			early?: later
			B:      5 & 6
			later: c: 1 & 2
		} | {
			d: 3 & 4
		} @test(err, code=eval, contains="2 errors in empty disjunction",
			suberr=(contains="conflicting values 6 and 5", pos=[2:12, 2:16]),
			suberr=(contains="conflicting values 4 and 3", pos=[5:7, 5:11]),
		)
		// Nor does the later error decide what kind of error the disjunct has.
		// The custom error is listed as one of two errors instead of alone.
		userError: {
			early?: later
			B:      error("custom")
			later: c: 1 & 2
		} | {
			d: 3 & 4
		} @test(err, code=eval, contains="2 errors in empty disjunction", incorrect) @test(err:todo, code=eval, contains="custom")
		// An eval error is reported instead of the structural cycle.
		structuralCycle: {
			early?: later
			B:      #L
			later: c: 1 & 2
		} | {
			d: 3 & 4
		} @test(err, code=eval, contains="2 errors in empty disjunction", incorrect) @test(err:todo, code=structural_cycle, contains="2 errors in empty disjunction")
		// All custom errors of a failed disjunction are to be reported, which
		// includes those of the fields after the failed one.
		userErrorSkipped: {
			B: #A & {b: 1}
			later: c: error("custom")
		} | {
			d: 3 & 4
		} @test(err, code=eval, contains="2 errors in empty disjunction", incorrect) @test(err:todo, code=eval, contains="custom")
		// It is reported if the later field was evaluated already.
		userErrorLater: {
			early?: later
			B:      #A & {b: 1}
			later: c: error("custom")
		} | {
			d: 3 & 4
		} @test(err, code=eval, contains="custom")
		// With a closedness error, the error of field later is reported instead.
		closed: {
			early?: later
			B:      #A & {b: 1}
			later: c: 1 & 2
		} | {
			d: 3 & 4
		} @test(err, code=eval, contains="2 errors in empty disjunction", incorrect,
			suberr=(contains="conflicting values 2 and 1", pos=[3:14, 3:18]),
			suberr=(contains="conflicting values 4 and 3", pos=[5:7, 5:11]),
		) @test(err:todo, code=eval, contains="2 errors in empty disjunction",
			suberr=(contains="field not allowed", pos=[2:18]),
			suberr=(contains="conflicting values 4 and 3", pos=[5:7, 5:11]),
		)
	}
}
