	{ a?:  1&2 } | { a:  string, b?: 1&2 }
	{  } | {  }
	@test(eq, {a?: _|_ @test(err, code=eval, contains="conflicting values", args=[2, 1], pos=[1:9, 1:11])} | {a: string, b?: _|_ @test(err, code=eval, contains="conflicting values", args=[2, 1], pos=[1:35, 1:37])})
}
