-- in.cue --
// cmd/cue: misleading "field not allowed" error when a type clash occurs inside
// a disjunction; the actual conflict should be reported instead.
// https://cuelang.org/issue/570
issue570: {
	results: #DecodeOutput
	results: result: "hello"

	#Output: {
		result: _
	} | {
		error: string
	}

	#DecodeOutput: #Output & {
		result?: [... string]
		...
	}
	@test(err, code=eval, at=results.result, contains="conflicting values", args=["hello", [...string]], pos=[1:11, 2:19, 11:12])
}

// Clarify when an error resulted from a failed disjunction; error messages
// should indicate which disjunct failed rather than showing a generic error.
// https://cuelang.org/issue/516
issue516: {
	#Def: {
		match: metrics: string: {}
	} | {}

	x: #Def
	x: match: metrics: "foo": {}
	@test(err, code=eval, at=x, contains="2 errors in empty disjunction", pos=[])
}

// issue #465
explicitDefaultError: {
	a: string | *_|_

	if a != "" {
	}
	@test(err, code=incomplete, contains="non-concrete value string in operand to !=", pos=[3:5, 1:5])
}

// evaluator: export as YAML vs JSON emits different templated data when
// pattern constraints with defaults produce different disjunction results.
// https://cuelang.org/issue/2916
issue2916: {
	b: _
	[_]: c:      uint | *1
	[string]: c: >=3 | *3
	@test(eq, {b: {c: *3 | >=3 & int}})
}
// evaluator: inconsistent export output for different formats based on which
// default is selected when multiple defaults are unified.
// https://cuelang.org/issue/3157
issue3157: {
	foo: *42 | _
	foo: *43 | bool
	@test(eq, {foo: *43 | bool})
}

// cmd/cue: every error in an empty disjunction should be reported, not just
// the first. Both disjuncts of `1 | 2` fail against the bound `>10`, and both
// "invalid value" errors are now reported even though they share the same
// primary position (the bound's location).
// https://cuelang.org/issue/4043
issue4043: {
	B: >10
	B: 1 | 2 @test(err, code=eval, contains="2 errors in empty disjunction",
		suberr=(code=eval, contains="invalid value 1 (out of bound >10)", pos=[-1:5, 0:5]),
		suberr=(code=eval, contains="invalid value 2 (out of bound >10)", pos=[-1:5, 0:9]),
	)
}

// Disjuncts which share every position, here the results of one
// expression, must each report their error: a selection which kept only
// errors contributing a position not seen yet dropped the fourth.
// https://cuelang.org/issue/4477
issue4477: {
	x: 0
	x: or([for i in [1, 2, 3, 4] {i * 1}]) @test(err, code=eval, contains="4 errors in empty disjunction",
		suberr=(contains="conflicting values 1 and 0", pos=[-1:5, 0:32]),
		suberr=(contains="conflicting values 2 and 0", pos=[-1:5, 0:32]),
		suberr=(contains="conflicting values 3 and 0", pos=[-1:5, 0:32]),
		suberr=(contains="conflicting values 4 and 0", pos=[-1:5, 0:32]),
	)
}

// Each failed disjunct reports all of its erroneous fields, not only the
// first.
structFields: {
	x: {a: 1 & 2, b: 3 & 4} | {a: 5 & 6, b: 7 & 8} @test(err, code=eval, contains="2 errors in empty disjunction",
		suberr=(contains="conflicting values 2 and 1", pos=[0:9, 0:13]),
		suberr=(contains="conflicting values 6 and 5", pos=[0:32, 0:36]),
	) // The errors of field b are missing.
}

// As above, where the disjuncts fail at the same positions.
generatedFields: {
	x: {a: 0, b: 0}
	x: or([for i in [1, 2, 3, 4] {a: i * 1, b: i * 1}]) @test(err, code=eval, contains="4 errors in empty disjunction",
		suberr=(path=generatedFields.x.a, contains="conflicting values 1 and 0", pos=[-1:9, 0:35]),
		suberr=(path=generatedFields.x.a, contains="conflicting values 2 and 0", pos=[-1:9, 0:35]),
		suberr=(path=generatedFields.x.a, contains="conflicting values 3 and 0", pos=[-1:9, 0:35]),
		suberr=(path=generatedFields.x.a, contains="conflicting values 4 and 0", pos=[-1:9, 0:35]),
	) // The errors of field b are missing.
}

// As above, with erroneous fields in a nested struct.
nestedFields: {
	x: {a: {p: 1 & 2, q: 3 & 4}, b: 5 & 6} | {a: {p: 7 & 8}} @test(err, code=eval, contains="2 errors in empty disjunction",
		suberr=(path=nestedFields.x.a.p, contains="conflicting values 2 and 1", pos=[0:13, 0:17]),
		suberr=(path=nestedFields.x.a.p, contains="conflicting values 8 and 7", pos=[0:51, 0:55]),
	) // The errors of fields a.q and b are missing.
}
-- issue3581.cue --
// evalv3: tools/flow unexpected error when a flow task result field is used as
// a list item; string interpolation in a list element caused a spurious error.
// https://cuelang.org/issue/3581
issue3581: reduced: {
	list: [...] | *[]
	list: ["\(c)" ] @test(err, code=incomplete, contains="2 errors in empty disjunction",
		suberr=(code=incomplete, contains="incompatible list lengths", args=[0, 1], pos=[-1:17]),
		suberr=(code=incomplete, contains="invalid interpolation: non-concrete value", pos=[0:9]),
	)
	c: _
	@test(eq, {list: _|_, c: _})
}
-- issue3576.cue --
// evalv3: disjunct of definitions with identical optional fields results in
// incomplete evaluation; the resolved disjunct should be fully evaluated.
// https://cuelang.org/issue/3576
issue3576: reduced: {
	#A: a!: string
	#B: {
		if false {
			dummy: {}
		}
	}
	foo: #B | #A
	foo: a: "1"
	@test(eq, {
		#A: {a!: string}
		#B: {}
		foo: {a: "1"}
	})
}
issue3576: full: {
	#Run: {
		run!: string
		options?: #Option | [#Option, ...]
		if options != _|_ {
			optionsValue: options
		}
	}

	#Copy: {
		copy!: string
		options?: #Option | [#Option, ...]
		if options != _|_ {
			optionsValue: options
		}
	}
	
	#Option: {}
	
	foo: #Run | #Copy
	foo: run: "make"
	@test(eq, {
		#Run: {run!: string, options?: {} | [{}]}
		#Copy: {copy!: string, options?: {} | [{}]}
		#Option: {}
		foo: {run: "make", options?: {} | [{}]}
	})
}
-- issue3599.cue --
// evalv3: "explicit error in source" regression when using bottom (_|_) in
// repeating disjunctions; errors in optional/let fields should be ignored.
// https://cuelang.org/issue/3599
// Ignore errors for irrelevant fields like let and optional fields.
issue3599: full: {
	#Action: {
		action: {
			read!:  string
			write?: _|_
		} | {
			write!: string
			read?:  _|_
		}
	}
	
	#Minio: {
		container: #Action & {
			action: {
				read!:  string
				write?: _|_
			} | {
				write!: string
				read?:  _|_
			}
		}
		doWrite: bool | *true
		container: action: defaultAction
		defaultAction: {
			if doWrite { write: "somefile.txt" }
			if !doWrite { read: "somefile.txt" }
		}
	}
	@test(eq, {
		#Action: {
			action: {read!: string, write?: _|_ @test(err, code=user, contains="explicit error (_|_ literal) in source", pos=[4:12])} | {write!: string, read?: _|_ @test(err, code=user, contains="explicit error (_|_ literal) in source", pos=[7:12])}
		}
		#Minio: {
			container: {
				action: {
					write: "somefile.txt"
					read?: _|_ @test(err, code=user, contains="explicit error (_|_ literal) in source (and 1 more errors)", pos=[18:13])
				}
			}
			doWrite: *true | bool
			defaultAction: {write: "somefile.txt"}
		}
	})
}
