// Issue #852
-- in.cue --
#E: {
	c: int
}
#A: {
	b: int
	q: {
		#E
		d: int
	}
}
a: #A & {
	b: 3
	q: {
		c: 2
		e: 43
	}
} @test(err, code=eval, contains="field not allowed", pos=[4:3])

// A constraint validation error fails to trigger when a field violating a
// regex pattern constraint is duplicated via a for-loop comprehension.
// https://cuelang.org/issue/852
// `a` is evaluated through the comprehension first. Ensure that
// this does not bypass closedness checks.
issue852: {
	#A: {
		[=~"^a-z$"]: string
	}

	a: #A

	a: Foo: "foo"

	for k, v in a {
		b: "\(k)": v
	}
} @test(err, code=eval, contains="field not allowed", pos=[7:5])

dynamic: {
	#D: {
		key:   "foo"
		(key): int
	}
	d: #D & {foo: 3}
	@test(eq, {
		#D: {key: "foo", foo: int}
		d: {foo: 3, key: "foo"}
	})
}

// Closedness appeared to be lost when using a comprehension: CUE incorrectly
// produced "incomplete value" errors for disjunctions inside if/for blocks.
// https://cuelang.org/issue/4180
// The `if true` comprehension would lead to ambiguity in out.iter.FooOrBar,
// even though {foo: "is foo"} does not unify with `#Bar & {...}`.
issue4180: {
	out: {
	    if true {
			iter: #Schema & {
				FooOrBar: foo: "is foo"
			}
		}
	}

	#Foo: foo: string
	#Bar: bar: string
	#Schema: {
		FooOrBar: {...}
		FooOrBar: #Foo | #Bar
	}
	@test(eq, {
		out: {iter: {FooOrBar: {foo: "is foo"}}}
		#Foo: {foo: string}
		#Bar: {bar: string}
		#Schema: {
			FooOrBar: {foo: string} | {bar: string}
		}
	})
}
-- embed.cue --
// evalv3: ordering of embedded structs affects template definition evaluation,
// causing validation errors that shouldn't occur when structs are reordered.
// https://cuelang.org/issue/3325
issue3325: ok: {
	#Items: [string]~(Name,_): {
		name: Name
	}

	#Base: {
		name: "base"
		type: string

		items: #Items
	}

	#Extended: #Base & {
		type: "extended"
		items: "my-item": {}
	}

	broken: {
		#Base
		#Extended
	}

	works: {
		#Extended
		#Base
	}
	@test(eq, {
		#Items: {}
		#Base: {name: "base", type: string, items: {}}
		#Extended: {
			type: "extended"
			items: {"my-item": {name: "my-item"}}
			name: "base"
		}
		broken: {
			name: "base"
			type: "extended"
			items: {"my-item": {name: "my-item"}}
		}
		works: {
			type: "extended"
			items: {"my-item": {name: "my-item"}}
			name: "base"
		}
	})
}
-- ellipsis.cue --
// evalv3 regression: unification with {...} allowed extra fields where evalv2
// correctly rejected them as "field not allowed".
// https://cuelang.org/issue/3778
issue3778: full: {
	#x: a?: string
	#y: #x & { ... }
	z: #y & {
		a: "ok"
		b: "something"
	}
	@test(err, code=eval, path=z.b, contains="field not allowed", pos=[5:3])
}
issue3778: {
	keepOpen: {
		#x: { a?: string, ... }
		#y: #x & { ... }
		z: #y & {
			a: "ok"
			b: "something"
		}
		@test(eq, {
			#x: {a?: string}
			#y: {a?: string}
			z: {a: "ok", b: "something"}
		})
	}
}

// Unification of a closed struct in a subfield does not close it: the evaluator
// incorrectly allows adding fields to a closed struct unified with ellipsis.
// https://cuelang.org/issue/1867
// All three reproducers below should fail with "field not allowed".
issue1867: one: {
	#T: close({})
	#T: {...}
	x: #T
	x: foo: "foo"
	@test(err, code=eval, path=x.foo, contains="field not allowed", pos=[4:5])
}
issue1867: two: {
	#S: {}
	#T: s: #S
	#T: s: {...}
	x: #T.s
	x: foo: "foo"
	@test(err, code=eval, path=x.foo, contains="field not allowed", pos=[5:5])
}
// This third version used to not fail as expected on evalv2.
issue1867: three: {
	#T: s: close({})
	#T: s: {...}
	x: #T.s
	x: foo: "foo"
	@test(err, code=eval, contains="field not allowed", pos=[4:5])
}
// evalv3 regression in detecting closedness: "field not allowed" errors were
// incorrectly suppressed when validating nested structures with closedness constraints.
// https://cuelang.org/issue/3924
issue3924: one: {
	#Schema: {
		...
		{[string]: #SchemaInner}
	}
	#SchemaInner: allowed?: string

	out: #Schema & {foo: disallowed: "foo"} // should fail
	@test(err, code=eval, path=out.foo.disallowed, contains="field not allowed", pos=[7:23])
}
issue3924: two: {
	#Schema: {
		{[string]: #job}

		#job: matchN(1, [{
			other?: string
			...
		}]) & close({
			allowed?: string
		})
	}
	out: #Schema & {foo: disallowed: "bar"} // should fail
	@test(err, code=eval, path=out.foo.disallowed, contains="field not allowed", pos=[4:9, 11:23])
}
issue3924: three: t1: {
	{foo: #job & {disallowed: "bar"}}
	#job: { other?: string }
	#job: #def
	#def: allowed?: string
	@test(err, code=eval, path=foo.disallowed, contains="field not allowed", pos=[1:16])
}
issue3924: three: t2: {
	{foo: #job & {disallowed: "bar"}}
	#job: { other?: string, ... }
	#job: #def
	#def: allowed?: string
	@test(err, code=eval, path=foo.disallowed, contains="field not allowed", pos=[1:16])
}
issue3924: three: t3: {
	#job: { ... }
	#job: #def
	#def: {}
	foo: #job & {disallowed: "bar"}
	@test(err, code=eval, path=foo.disallowed, contains="field not allowed", pos=[4:15])
}
issue3924: four: {
	A: { {foo: #B} }
	#B: allowed?: string
	out: A & {foo: disallowed: "foo"} // should fail
	@test(err, code=eval, contains="field not allowed", pos=[3:17])
}
-- reroot.cue --
import "list"

// evalv3 panic "unexpected uninitialized node" while processing certain
// config files using list.Concat with definitions.
// https://cuelang.org/issue/3330
issue3330: {
	let: ok: {
		#struct: {
			let empty = {}

			field: null | { n: int }
			field: empty & { n: 3 }
		}

		out: list.Concat([[#struct]])
		@test(eq, {
			#struct: {field: {n: 3}}
			out: [{
				field: n: 3
			}]
		})
	}
	matthew: ok1: {
		#struct: {
			field: { n: 3 } & g
			g: {}
		}

		out: #struct & {}
		@test(eq, {
			#struct: {field: {n: 3}, g: {}}
			out: {field: {n: 3}, g: {}}
		})
	}
	matthew: ok2: {
		#struct: {
			field: { n: 3 } & g
			g: {}
		}

		out: #struct
		out2: out & {}
		@test(eq, {
			#struct: {field: {n: 3}, g: {}}
			out: {field: {n: 3}, g: {}}
			out2: {field: {n: 3}, g: {}}
		})
	}
}
// evalv3 "field not allowed" regression: a valid struct with a let binding and
// field unification incorrectly produces "field not allowed".
// https://cuelang.org/issue/3331
issue3331: {
	original: ok: {
		#A: {
			let b = {}
			c: b & {
				d: 1
			}
		}
		list.Concat([[#A]])
		@test(eq, {
			#A: {c: {d: 1}}
			[{c: {d: 1}}]
		})
	}
	variant1: ok: {
		#A: {
			let b = {}
			c: b & {
				d: 1
			}
		}
		[[#A]]
		@test(eq, {
			#A: {c: {d: 1}}
			[[{c: {d: 1}}]]
		})
	}
	@test(eq, {
		original: {ok: {
			#A: {c: {d: 1}}
			[{c: {d: 1}}]
		}}
		variant1: {ok: {
			#A: {c: {d: 1}}
			[[{c: {d: 1}}]]
		}}
	})
}

// nested.a
nested: ok1: {
	#A: {
	b: {}

	#B: {
		c: b & {
			d: 1
			}
		}
	}
	x: #A
	@test(eq, {
		#A: {b: {}, #B: {c: {d: 1}}}
		x: {b: {}, #B: {c: {d: 1}}}
	})
}
nested: embed: ok: {
	x: #A
	#A: {
		k
	}
	k: {
		d: b & {e: int}
		b: {}
	}
	@test(eq, {
		x:  {d: {e: int}, b: {}}
		#A: {d: {e: int}, b: {}}
		k:  {d: {e: int}, b: {}}
	})
}
// nested.b tests insertion of a field (b) that has a conjunct rooted within
// the tree it is referred in as well as a conjunct outside of it that refers
// to a definition.
nested: err1: {
	x: #A
	#A: {
		b: f: 1
		v: #V
		#V: {
			c: b & { // Fails as #B is not compatible.
				d: 1
			}
		}
	}
	x: b: #B
	#B: g: 1
	@test(err, at=x.#V.c.d, code=eval, contains="field not allowed", pos=[7:5])
}

nested: err2: {
	#A: {
		b: {} // error only reported here.
		c: b & {
			// error (g not allowed) not reported here, as it would be okay if b
			// were valid. Instead, it is reported at b only. This is conform
			// the spec.
			d: 1
		}
	}
	x: #A
	x: b: g: 1
	@test(err, at=x.b.g, code=eval, contains="field not allowed", pos=[11:8])
}

inline: {
	#x: y: z?: name: string

	// TODO: not an error!?
	err1: (#x & {y: z: _}).y.z & {
		name: "a"
		age1: 5 // not allowed
	} @test(err:todo, code=eval, contains="field not allowed")
	err2: (#x.y & {z: _}).z & {
		name: "a"
		age2: 5 // not allowed
	} @test(err:todo, code=eval, contains="field not allowed")
	@test(eq, {
		#x: {y: {z?: {name: string}}}
		err1: {name: "a", age1: 5}
		err2: {name: "a", age2: 5}
	})
}

// minInDef defines examples where a definition is mixed into an open struct,
// where then this struct refers to a field that is closed by the definition.
mixInDef: {
	refInside: {
		#x: b: c: {d: {}, e: f: {} }
		a: #x
		a: b: c: d: {}
		a: b: c: e: c.d
		@test(eq, {
			#x: {b: {c: {d: {}, e: {f: {}}}}}
			a: {b: {c: {d: {}, e: {f: {}}}}}
		})
	}
	refEdge: {
		#x: c: {d: {}, e: f: {} }
		a: #x
		a: c: d: {}
		a: c: e: c.d
		@test(eq, {
			#x: {c: {d: {}, e: {f: {}}}}
			a: {c: {d: {}, e: {f: {}}}}
		})
	}
	refOutside: {
		#x: c: {d: {}, e: f: {} }
		a: #x
		a: c: d: {}
		a: c: e: a.c.d // crosses definition
		@test(eq, {
			#x: {c: {d: {}, e: {f: {}}}}
			a: {c: {d: {}, e: {f: {}}}}
		})
	}
}

// evalv3 "field not allowed" regression: out.foo.final.version incorrectly
// rejected when embedding a definition's output through a transformed struct.
// https://cuelang.org/issue/3601
issue3601: original: {
	out: {
		#Transform.output
	}
	#Transform: output: (#Patch & {}).output
	#Patch: {
		target: {}
		output: foo: {
			final: target
			final: version: "v1"
		}
	}
	@test(eq, {
		out: {foo: {final: {version: "v1"}}}
		#Transform: {
			output: {foo: {final: {version: "v1"}}}
		}
		#Patch: {
			target: {}
			output: {foo: {final: {version: "v1"}}}
		}
	})
}
issue3601: originalNoShare: {
	// Like the original, but with explicit no sharing.
	out: {
		#Transform.output
	}
	#Transform: output: (#Patch & __no_sharing).output
	#Patch: {
		target: {}
		output: foo: {
			final: target
			final: version: "v1"
		}
	}
	@test(eq, {
		out: {foo: {final: {version: "v1"}}}
		#Transform: {
			output: {foo: {final: {version: "v1"}}}
		}
		#Patch: {
			target: {}
			output: {foo: {final: {version: "v1"}}}
		}
	})
}
issue3601: reduced: {
	#X: {
		a: b: c: "v1"
		a: b: empty
		empty: {}
	}

	original: {
		Y: (#X & __no_sharing).a
		out: Y & __no_sharing
	}
	moreInlining: {
		out: (#X & {}).a & {}
	}
	noInline: {
		Y: #X & __no_sharing
		Z: Y & __no_sharing
		out: Z.a & __no_sharing
	}
	moreNesting: {
		#X: {
			a: b: c: d: "v1"
			a: b: c: empty
			empty: {}
		}
		Y: (#X.a & __no_sharing).b
		Z: Y & __no_sharing
	}
	@test(eq, {
		#X: {a: {b: {c: "v1"}}, empty: {}}
		original: {Y: {b: {c: "v1"}}, out: {b: {c: "v1"}}}
		moreInlining: {out: {b: {c: "v1"}}}
		noInline: {
			Y: {a: {b: {c: "v1"}}, empty: {}}
			Z: {a: {b: {c: "v1"}}, empty: {}}
			out: {b: {c: "v1"}}
		}
		moreNesting: {
			#X: {a: {b: {c: {d: "v1"}}}, empty: {}}
			Y: {c: {d: "v1"}}
			Z: {c: {d: "v1"}}
		}
	})
}

-- validation.cue --
import "list"

// evalv3: struct with only list.MinItems does not allow a valid list field to
// exist, reporting "field not allowed" instead of accepting it.
// https://cuelang.org/issue/3332
issue3332: {
	#def: field: list.MinItems(1)
	use: #def & {
	  field: ["value"]
	}
	@test(eq, {
		#def: {field: list.MinItems(1)}
		use: {field: ["value"]}
	})
}

