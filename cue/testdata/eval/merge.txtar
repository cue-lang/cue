# TODO: image field is not pre-evaluated (not a huge deal)
-- in.cue --
key: "app01" @test(eq, "app01")
manifests: [
	{
		deployment: #map: [string]: {name: string, image: string, desc: string}
		deployment: #map: "\(key)": name: "app01"
	},
	{
		deployment: #map: app01: image: "image01"
		// A dynamic label only the pattern constraint covers.
		deployment: #map: "\("app03")": image: "image01"
	},
]
// unify
results: _ @test(eq, {deployment: #map: {
	app01: {image: "image01", name: "app01", desc: string}
	app03: {image: "image01", name: string, desc: string}
}})
for _, manifest in manifests {
	results: manifest
}
