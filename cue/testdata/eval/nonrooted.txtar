# Tests non-rooted inline expressions and let bindings where the inline
# expression conflicts with a definition constraint. The evaluation should
# use the local context (overriding the definition's value), even when
# that creates a conflict detectable from the root.
# https://cuelang.org/issue/3977
-- in.cue --
import "strings"

issue3977: inlineExpr: {
	#NetworkID: 1
	#fn: {
		x:   #NetworkID
		out: x + 1
	}

	err: (#fn & {x: 2}).out @test(err, code=eval,
		contains="conflicting values", args=[1, 2])
}
issue3977: inlineDisj1: {
	#NetworkID: "2" | "3" | "4"
	#fn: {
		x:   #NetworkID
		out: "value=\(x)"
	}

	err: (#fn & {x: "invalid"}).out @test(err, code=eval,
		suberr=(code=eval, path=x, contains="conflicting values %s and %s", args=["2", "invalid"], pos=[-6:14, -4:8, 0:8, 0:18]),
		suberr=(code=eval, path=x, contains="conflicting values %s and %s", args=["3", "invalid"], pos=[-6:20, -4:8, 0:8, 0:18]),
		suberr=(code=eval, path=x, contains="conflicting values %s and %s", args=["4", "invalid"], pos=[-6:26, -4:8, 0:8, 0:18]),
	)
}
issue3977: inlineDisj2: {
	#NetworkID: 1
	#fn: {
		x:   #NetworkID
		out: x + 10
	}

	err: (#fn & {x: *2 | 4}).out @test(err, code=eval,
		suberr=(contains="conflicting values", args=[1, 2]),
		suberr=(contains="conflicting values", args=[4, 1]))
}
issue3977: inlineDisj3: {
	#NetworkID: 1
	#fn: {
		x:   #NetworkID
		out: x + 10
	}

	ok: (#fn & {x: *2 | int}).out @test(eq, 11)
}
issue3977: inlineLet: {
	#NetworkID: 1
	let p = {
		x:   #NetworkID
		out: x + 10
	} & {
		x: 2
	}

	err: p.out @test(eq, 12, incorrect) @test(err:todo, p=1, code=eval, contains="conflicting values", args=[1, 2])
}

// A scalar of an inline struct, struct literal, or let that is read through an
// interpolation is checked against all its validators, not only its bounds.
// https://cuelang.org/issue/4510
issue4510: inline: {
	#C: {
		id:  string & !="storage"
		out: "k/\(id)"
	}
	ok:  (#C & {id: "other"}).out   @test(eq, "k/other")
	err: (#C & {id: "storage"}).out @test(eq, "k/storage", incorrect) @test(err:todo, p=1, code=eval, contains="out of bound")
}
issue4510: literal: {
	err: {
		id:  string & !="storage"
		id:  "storage"
		out: "k/\(id)"
	}.out @test(eq, "k/storage", incorrect) @test(err:todo, p=1, code=eval, contains="out of bound")
}
issue4510: let: {
	#C: {
		id:  string & !="storage"
		out: "k/\(id)"
	}
	let L = #C & {id: "storage"}
	err: L.out @test(eq, "k/storage", incorrect) @test(err:todo, p=1, code=eval, contains="out of bound")
}
issue4510: regexp: {
	#C: {
		id:  =~"^a"
		out: "k/\(id)"
	}
	err: (#C & {id: "b"}).out @test(eq, "k/b", incorrect) @test(err:todo, p=1, code=eval, contains="out of bound")
}
issue4510: builtin: {
	#C: {
		id:  strings.MaxRunes(2)
		out: "k/\(id)"
	}
	err: (#C & {id: "abc"}).out @test(eq, "k/abc", incorrect) @test(err:todo, p=1, code=eval, contains="does not satisfy strings.MaxRunes(2)")
}
// A validator of the read scalar may refer to the reading field: it is checked
// once that field has its value, as it would be for a regular field.
issue4510: selfRef: {
	ok1: ({x: 1 & !=ok1, out: x + 1}).out @test(eq, 2)
	let L = {x: 1 & !=ok2, out: x + 1}
	ok2: L.out                            @test(eq, 2)
	err: ({x: 1 & !=err, out: x + 0}).out @test(eq, 1, incorrect) @test(err:todo, p=1, code=eval, contains="out of bound")
}
// The reading field may be a disjunction, in which case each disjunct checks
// the read scalar on its own.
issue4510: disjunct: {
	#C: {
		id:  string & !="storage"
		out: "k/\(id)"
	}
	ok:  (#C & {id: "other"}).out & (string | int)   @test(eq, "k/other")
	err: (#C & {id: "storage"}).out & (string | int) @test(eq, "k/storage", incorrect) @test(err:todo, p=1, code=eval, suberr=(contains="out of bound"), suberr=(contains="empty disjunction"), suberr=(contains="mismatched types"))

	let L = #C & {id: "storage"}
	errLet: L.out & (*"k/storage" | string) @test(eq, "k/storage", incorrect) @test(err:todo, p=1, code=eval, contains="out of bound")

	#N: 1
	#fn: {
		x:   #N
		out: x + 10
	}
	okConflict:  (#fn & {x: 1}).out & (int | string) @test(eq, 11)
	errConflict: (#fn & {x: 2}).out & (int | string) @test(err, code=eval, suberr=(contains="conflicting values 1 and 2"), suberr=(contains="empty disjunction"), suberr=(contains="mismatched types"))
}
// The reading task may belong to a nested internal node, as when the read
// value feeds an expression. The rooted field completes the read node then too.
issue4510: binop: {
	#C: {
		id:  string & !="storage"
		out: "k/\(id)"
	}
	err: (#C & {id: "storage"}).out + "y" @test(eq, "k/storagey", incorrect) @test(err:todo, p=1, code=eval, contains="out of bound")

	let L = #C & {id: "storage"}
	errLet: L.out + "y" @test(eq, "k/storagey", incorrect) @test(err:todo, p=1, code=eval, contains="out of bound")

	#N: 1
	#fn: {
		x:   #N
		out: x + 10
	}
	errConflict: (#fn & {x: 2}).out + 1 @test(err, code=eval, contains="conflicting values", args=[1, 2])
}
// The read scalar may be consumed by a builtin call, whose argument is read
// with its tasks already finished, or be a default that is then eliminated.
issue4510: consumers: {
	#C: {
		id:  string & !="storage"
		out: "k/\(id)"
	}
	errBuiltin: strings.ToUpper((#C & {id: "storage"}).out) @test(eq, "K/STORAGE", incorrect) @test(err:todo, p=1, code=eval, contains="out of bound")

	errLen: len((#C & {id: "storage"}).out) @test(eq, 9, incorrect) @test(err:todo, p=1, code=eval, contains="out of bound")

	errArith: ({x: 1 & !=1, out: x + 1}).out @test(eq, 2, incorrect) @test(err:todo, p=1, code=eval, contains="out of bound")

	fallback: *(#C & {id: "storage"}).out | "fallback" @test(eq, *"k/storage" | "fallback", incorrect) @test(eq:todo, p=1, "fallback")
}
// A disjunct that fails on its own value must not complete the deferred nodes,
// which it shares with the other disjuncts: a validator among them that refers
// to the reading field would fail against the conflicting value, in any order
// of the disjuncts.
issue4510: disjunctOrder: {
	ok1: ({x: 1 & !=ok1, out: x + 1}).out & (string | int) @test(eq, 2)
	ok2: ({x: 1 & !=ok2, out: x + 1}).out & (int | string) @test(eq, 2)

	let L1 = {x: 1 & !=ok3, out: x + 1}
	ok3: L1.out & (string | int) @test(eq, 2)

	let L2 = {x: 1 & !=ok4, out: x + 1}
	ok4: L2.out & (int | string) @test(eq, 2)
}
// A comprehension's let clause has no path of its own: its validators run
// where its value is used, so the error reports that path. A clause only read
// by an expression is not checked at all.
issue4510: compLet: {
	l: [1, 2]
	errList: [for v in l let y = v & !=2 if y > 0 {y}] @test(err, at=1, code=eval, contains="out of bound")
	errField: {for v in l let y = v & !=2 if y > 0 {"k\(v)": y}} @test(err, at=k2, code=eval, contains="out of bound")
	expr: [for v in l let y = v & !=2 {y + 0}] @test(eq, [1, 2], incorrect) @test(err:todo, p=2, code=eval, contains="out of bound")
}
// A let inside a definition is reached only through an instance of it. Its
// field conflicts with the default of a disjunction, and the referrer reads a
// list in which that field sits several levels down, in an interpolation. The
// error is reported on the definition as well, whose lets are evaluated like
// those of any other struct.
issue4510: letInDefinition: {
	#Resources: {
		scaling: limits: memory: float | *1.0
		block: limits: memory: "\(2 * scaling.limits.memory)Mi"
		patch: [{value: block}]
	}
	#Config: {
		let r = #Resources & {scaling: limits: memory: 2}
		patches: r.patch
	}
	err: #Config @test(eq, {patches: [{value: {limits: {memory: "4Mi"}}}]}, incorrect) @test(err:todo, p=1, at=patches[0].value.limits.memory, code=eval, suberr=(contains="conflicting values 2 and 1.0"), suberr=(contains="conflicting values 2 and float"))
}
