-- in.cue --
self: t1: {
	a?: int
	@test(eq, {a?: int})
}

self: t2: {
	a!: int
	a!: int
	@test(eq, {a!: int})
}

unify: t1: {
	@test(permute, count=2)
	a!: int
	a: int
	@test(eq, {a: int})
}

unify: t2: {
	@test(permute)
	a!: int
	a?: int
	@test(eq, {a!: int})
}

#Def: t1: {
	a!: int
	@test(eq, {a!: int})
}

// A required field makes a value a struct, so it conflicts with an embedded
// scalar even though the field is not present.
embedScalar: t1: {
	1
	a!: int
} @test(err, code=eval, contains="cannot combine regular field %q with %v", args=[a, 1], pos=[2:6, 1:2])
// The struct, rather than the embedded scalar, is reported as conflicting
// with the field.
embedScalar: t2: {
	int
	a!: int
} @test(err, code=eval, contains="with {a!:int}", pos=[2:6, 0:18])
// `!=0` admits any struct, as a struct never equals 0, so the field is allowed.
embedScalar: t3: {
	!=0
	a!: int
} @test(err, code=eval, contains="with {a!:int}", pos=[2:6, 0:18], incorrect, hint="`!=0` should admit the struct, leaving the required field unset")
// A comprehension which may add a field marks the value as a struct, so the
// embedded scalar is lost.
// https://cuelang.org/issue/4577
embedScalar: t4: {
	int
	if false {a!: int}
} @test(eq, {}, incorrect) @test(eq:todo, int)
embedScalar: t5: {
	!=0
	if false {a!: int}
} @test(eq, {}, incorrect) @test(eq:todo, !=0)

// No struct satisfies an ordered bound such as `<0`, so a required field next
// to an embedded one is a conflict.
embedBound: {
	lessThan: {
		<0
		a!: int
	} @test(err, code=eval, contains="mismatched types struct and number", pos=[0:12, 1:3])
	viaReference: {
		B: <0
		x: {
			B
			a!: int
		} @test(err, code=eval, contains="mismatched types struct and number", pos=[-1:6, 0:6])
	}
	// https://cuelang.org/issue/4570
	selfReference: {
		A
		A!: >0 & <10
	} @test(err, code=eval, contains="mismatched types struct and number", pos=[0:17, 2:7])
	twoSided: {
		>0 & <10
		a!: int
	} @test(err, code=eval, contains="mismatched types struct and number", pos=[0:12, 1:3])
	dependsOnSelf: {
		<len(dependsOnSelf)
		a!: int
	} @test(err, code=eval, contains="mismatched types struct and number", pos=[0:17, 1:3])
	dependsOnSelfTwoSided: {
		>len(dependsOnSelfTwoSided) & <10
		a!: int
	} @test(err, code=eval, contains="mismatched types struct and number", pos=[0:25, 1:33])
	// As in embedScalar.t3, for a `!=` bound which depends on the struct.
	dependsOnSelfNotEqual: {
		!=len(dependsOnSelfNotEqual)
		a!: int
	} @test(err, code=eval, contains="with {a!:int}", pos=[2:7, 0:25], incorrect, hint="`!=0` should admit the struct, leaving the required field unset")

	// As in embedScalar.t4, the comprehension makes the value a struct, which
	// the bound rejects.
	comprehension: {
		<0
		if false {a!: int}
	} @test(err, code=eval, contains="mismatched types struct and number", pos=[0:17, 1:3], incorrect) @test(eq:todo, <0)
	comprehensionDependsOnSelf: {
		<len(comprehensionDependsOnSelf)
		if false {a!: int}
	} @test(err, code=eval, contains="mismatched types struct and number", pos=[0:30, 1:3], incorrect, hint="the bound should be left unresolved, as it is without the comprehension")

	// As in embedScalar.t4, so a bound which depends on the struct is computed
	// against the empty struct, although the reference cycle could resolve to
	// `_` instead.
	comprehensionNotEqual: {
		!=len(comprehensionNotEqual)
		if false {a: int}
	} @test(eq, {})

	// A regular field conflicts with the bound as a mismatched type, and an
	// optional field leaves the bound as the value.
	regularField: {
		<0
		a: int
	} @test(err, code=eval, contains="mismatched types", pos=[0:16, 1:3])
	optionalField: {
		<0
		a?: int
	} @test(eq, <0)
}

// A struct whose only declaration is a comprehension is a struct even when no
// field is added, so it conflicts with a scalar that it is unified with.
comprehensionOnly: {
	validator: {
		x: {if false {a!: int}}
		x: =~"a" @test(err, code=eval, contains="cannot use {} (type struct) as type string", pos=[0:6, -1:6])
	}
	basicType: {
		x: {if false {a!: int}}
		x: string @test(eq, {}, incorrect, hint="the struct should conflict with the string; see https://cuelang.org/issue/4577") @test(err:todo, code=eval)
	}
	bound: {
		x: {if false {a!: int}}
		x: <5 @test(err, code=eval, contains="mismatched types struct and number", pos=[-1:6, 0:6])
	}
	boundDependsOnSelf: {
		x: {if false {a!: int}}
		x: <len(x) @test(err, code=eval, contains="mismatched types struct and number", pos=[-1:6, 0:6])
	}
	disjunction: {
		#S: spec: {...} | string
		x: #S & {spec: {if false {a!: int}}} @test(eq, {spec: {}})
	}
}

// Required fields do not cause vet to fail with definitions: a required field
// in one definition should block a disallowed field from another definition.
// https://cuelang.org/issue/2306
allowed: {
	issue2306: {
		#A: a!: int
		#A: #B @test(err, code=eval, path=a, contains="field not allowed", pos=[-1:7])

		#B: b!: int
	}
}

reference: {
	toWithinDefinition: {
		@test(permute, count=2)
		#Foo: a!: int
		b: #Foo.a @test(err, code=incomplete, contains="required field missing: %s", args=[a], pos=[0:11])
	}
	toFieldFromDefinition: {
		@test(permute, count=6)
		#Foo: a!: int
		b: #Foo
		c: b.a @test(err, code=incomplete, contains="required field missing: %s", args=[a], pos=[0:8])
	}
	toNonDefinition: {
		@test(permute, count=2)
		x: y!: _
		b: x.y @test(err, code=incomplete, contains="required field missing: %s", args=[y], pos=[0:8])
	}
	toConcrete: {
		@test(permute, count=2)
		a!: 1
		b: a + 1 @test(err, code=incomplete, contains="required field missing: %s", args=[a], pos=[0:6])
	}
	// A reference to a required-but-missing field reports "required field
	// missing", not "cannot reference optional field".
	// https://cuelang.org/issue/2937
	issue2937: {
		min!: number
		max!: number & >min @test(err, code=incomplete, contains="required field missing: %s", args=[min], pos=[0:19])
		max:  10
	}
	// Calling a required-but-missing field reports the missing field, rather
	// than complaining that an error is not a function.
	// https://cuelang.org/issue/4330
	issue4330: {
		#Foo: fn!: _
		b: #Foo.fn("foo") @test(err, code=incomplete, contains="required field missing: %s", args=[fn], pos=[0:11])
	}
}
-- issue3918.cue --
import "strings"

// Required fields do not work on the function pattern: a required field used
// as an input to a definition-based function was not satisfied at the call site.
// https://cuelang.org/issue/3918
issue3918: {
	reduced: {
		#disjuncts: {
			in!: [...string]
			out: strings.Join(in, "|") @test(err, code=incomplete, contains="required field missing: %s", args=[in], pos=[0:22])
		}

		x: (#disjuncts & {
			in: ["foo", "bar"]
		}).out
		@test(eq, {
			#disjuncts: {
				in!: []
				out: _|_
			}
			x: "foo|bar"
		})
	}
	noFunction: {
		#disjuncts: {
			in!: [...string]
			out: in @test(err, code=incomplete, contains="required field missing: %s", args=[in], pos=[0:9])
		}
		_foo: #disjuncts & {} @test(err, at=out, code=incomplete, contains="required field missing: %s", args=[in], pos=[-2:9])
		x: _foo.out @test(err, code=incomplete, path=issue3918.noFunction._foo.out, contains="required field missing: %s", args=[in], pos=[-3:9])
		@test(eq, {
			#disjuncts: {
				in!: []
				out: _|_
			}
			_foo: {
				in!: []
				out: _|_
			}
			x: _|_
		})
	}
}
// A required field error is incomplete error. Ensure that setting a vertex
// to this error does not escalate it to an evaluation error.
doNotEscalateError: {
	a: {
		in:  _
		out: in.self @test(err, code=incomplete, contains="%s undefined as %s is incomplete (type %s)", args=[in.self, in, _], pos=[0:8])
	}
	b: {
		required!: _
		pass:    (a & {in: required}).out @test(err, code=incomplete, contains="undefined field: %s", args=[self], pos=[-4:11, -5:3, 0:18])
	}
}
