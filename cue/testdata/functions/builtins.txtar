# Tests that builtins satisfy function types: unifying a builtin with a
# compatible function type succeeds and yields the builtin, with the type's
# parameter and result constraints additionally enforced on every ordinary
# full call. The legacy validator-constructor form remains a separate path.
# A builtin binds its raw arguments by position. Positional type parameters
# align with those raw slots by ordinal; a plain name supplies a contract label
# only when the slot does not already have a different one. A required or
# optional parameter of a type is the builtin parameter with its label, as
# named by the builtin's signatures; an optional one that matches nothing
# contributes no slot or label. Defaults declared by the signatures fill
# omitted arguments and must agree with the builtin's own defaults.
# Statically checked at unification time are parameter matching, arity, and
# declared compatibility: the builtin's parameter kinds must admit every value
# a type parameter admits, and its result kind must be within the type's
# result; the type's constraints then restrict every call.
-- in.cue --
@experiment(functions)

import (
	"list"
	"path"
	"strings"
)

tighten: {
	T:  func(string, ...) -> string
	up: T & strings.ToUpper
	x:  up("hi") @test(eq, "HI")

	// Order of unification does not matter.
	upRev: strings.ToUpper & T
	xRev:  upRev("hi") @test(eq, "HI")

	// An open type with no parameters is satisfied by any builtin.
	O:  func(...) -> string
	o:  O & strings.ToUpper
	ox: o("hi") @test(eq, "HI")

	// The generated signature names this raw positional slot s; the same
	// contract label may be repeated by a compatible type.
	named: (func(s: string) -> string) & strings.ToUpper
	nx:    named("hi") @test(eq, "HI")
	nxLabel: named(s: "bye") @test(eq, "BYE")
}

static: {
	// Arity is checked statically in both directions: the type must not
	// declare more positional parameters than the builtin accepts, and a
	// closed type must cover every defaultless parameter of the builtin.
	tooMany: (func(string, string, ...) -> string) & strings.ToUpper @test(err, code=eval, contains="function type has more positional parameters than builtin strings.ToUpper")
	tooFew:  (func() -> string) & strings.ToUpper @test(err, code=eval, contains="builtin strings.ToUpper has more parameters than closed function type")

	// Kind-level conflicts that are decidable from the compiled signature
	// (the constraint is literally a basic type) are rejected statically.
	badParam:  (func(int, ...) -> string) & strings.ToUpper @test(err, code=eval, contains="parameter 1 of function type has kind int, conflicting with kind string of builtin strings.ToUpper")
	badResult: (func(string, ...) -> int) & strings.ToUpper @test(err, code=eval, contains="result of function type has kind int, conflicting with result kind string of builtin strings.ToUpper")

	// A builtin never unifies with a proper function value.
	f:        func(a: string) -> string: a
	conflict: f & strings.ToUpper @test(err, code=eval, contains="conflicting values")
}

// Constraints that are not decidable from the signatures alone are enforced
// dynamically, on every ordinary full call through the tightened builtin.
dynamic: {
	// The type narrows the parameter to a bound.
	P:  func(<="m", ...) -> string
	up: P & strings.ToUpper

	ok:  up("hi") @test(eq, "HI")
	oob: up("zz") @test(err, code=eval, contains="out of bound")

	// The type cannot require a result the builtin does not declare: a
	// builtin returning any string does not satisfy a signature requiring
	// one particular string.
	R:   func(string, ...) -> "HI"
	up2: R & strings.ToUpper @test(err, code=eval, contains="builtin strings.ToUpper returns string, but its signature requires \"HI\"")

	// Narrowing stacks across a chain of tightenings.
	A:   func(string, ...) -> string
	B:   func(<="m", ...) -> _
	up3: A & B & strings.ToUpper

	mid: up3("hi") @test(eq, "HI")
	hi:  up3("zz") @test(err, code=eval, contains="out of bound")
}

// An extra parameter is admitted against a closed signature iff it is
// optional. An unmatched optional name-only parameter contributes no slot or
// label, but no call needs it either. A builtin parameter that a closed type
// does not cover is admitted only if the builtin has a default for it.
optionalExtra: {
	O:  func(string, sep?: string) -> string
	up: O & strings.ToUpper
	x:  up("hi") @test(eq, "HI")

	// An unmatched optional name-only constraint contributes no raw slot.
	OnlyExtra: func(extra?: int, ...) -> string
	upExtra:   OnlyExtra & strings.ToUpper
	y:         upExtra("hi") @test(eq, "HI")

	// A required parameter must name a parameter of the builtin.
	bad: (func(string, sep!: string) -> string) & strings.ToUpper @test(err, code=eval, contains="parameter sep of function type not allowed by builtin strings.ToUpper")
}

// A required or optional parameter of a type and the builtin parameter with
// the same label are the same parameter, so the type covers it.
labelMatch: {
	opt:     strings.Repeat & (func(string, count?: int & <3) -> string)
	optOK:   opt("x", 2) @test(eq, "xx")
	optBad:  opt("x", 5) @test(err, code=eval, contains="out of bound")
	req:     strings.Repeat & (func(string, count!: int) -> string)
	reqOK:   req("x", count: 2) @test(eq, "xx")
	// A label that names no builtin parameter is rejected.
	unknown: strings.Repeat & (func(string, times!: int) -> string) @test(err, code=eval, contains="parameter times of function type not allowed by builtin strings.Repeat")

	// The builtin's labels are known however its uses are unified, also
	// when a type labeling another parameter is unified first.
	split: strings.Repeat
	split: func(s: string, count!: int) -> string
	splitOK: split("a", count: 3) @test(eq, "aaa")
}

// Tightened builtins are equal when derived from the same builtin with the
// same type constraints: disjunction deduplication collapses them to a
// single callable value.
disjunction: {
	T:    func(string, ...) -> string
	t1:   T & strings.ToUpper
	t2:   T & strings.ToUpper
	pick: t1 | t2
	x:    pick("hi") @test(eq, "HI")
}

// Partial application of builtins is not supported: a call with a trailing
// "..." reports a clear error instead of silently dropping the "..." (len)
// or morphing into a validator (strings.Contains).
partial: {
	contains: strings.Contains("abcd", ...) @test(err, code=eval, contains="partial application of builtin")
	length:   len([1, 2], ...) @test(err, code=eval, contains="partial application of builtin")
}

// len is polymorphic over strings, bytes, lists, and structs; its kind-level
// signature is compatible with a type over any of these. A type over every
// value requires a builtin accepting every value, which len is not.
polymorphic: {
	L: func(string | bytes | [...] | {...}, ...) -> int
	l: L & len

	str:  l("foo") @test(eq, 3)
	list: l([1, 2]) @test(eq, 2)
	any:  (func(_, ...) -> int) & len @test(err, code=eval, contains="parameter 1 of builtin len accepts")

	// The type may narrow the accepted arguments to a subset of the kinds
	// the builtin accepts; the narrowing applies per call.
	S:    func(string, ...) -> int
	ls:   S & len
	sOk:  ls("foo") @test(eq, 3)
	sBad: ls([1, 2]) @test(err, code=eval, contains="conflicting values")

	// A statically incompatible result kind is rejected.
	bad: (func(_, ...) -> string) & len @test(err, code=eval, contains="result of function type has kind string, conflicting with result kind int of builtin len")
}

// A builtin declares its result at the level of kinds, which admits a
// structural result constraint of a fitting kind, written out or referred
// to, and rejects one of another kind.
aliases: {
	#L:   [...]
	S:    func(s: string, sep: string) -> #L
	sp:   S & strings.Split
	spX:  sp("a,b", ",") @test(eq, ["a", "b"])
	#Strs: [...string]
	S2:   func(s: string, sep: string) -> #Strs
	sp2:  S2 & strings.Split
	sp2X: sp2("a,b", ",") @test(eq, ["a", "b"])
	S3:   func(s: string, sep: string) -> {...}
	sp3:  S3 & strings.Split @test(err, code=eval, contains="builtin strings.Split returns list, but its signature requires")
	// A string bound may admit every string.
	GeUp: func(s: string) -> >=""
	geUp: (GeUp & strings.ToUpper)("a") @test(eq, "A")
}

// Admission is repeated as signatures arrive, so the outcome does not depend
// on the order in which a name-only parameter gains its label.
labelOrder: {
	A:  func(x?: string | int, ...) -> int
	B:  func(x: string, ...) -> int
	ab: (len & A) & B @test(err, code=eval, contains="parameter x of builtin len accepts")
	ba: (len & B) & A @test(err, code=eval, contains="parameter x of builtin len accepts")
}

// A labeled argument binds through the contract labels of the builtin's
// declared signature; the call proceeds with the arguments in positional
// order. Generated, signature-bearing standard-library functions ordinarily
// carry attached labels which are callable.
labeled: {
	import1: {
		named:   list.Drop(x: [1, 2, 3], n: 1) @test(eq, [2, 3])
		swapped: list.Drop(n: 1, x: [1, 2, 3]) @test(eq, [2, 3])
		mixed:   strings.Repeat("ab", count: 2) @test(eq, "abab")
	}

	errors: {
		// A label no attached signature declares does not bind.
		unknown: list.Drop(lst: [1], n: 0) @test(err, code=eval, contains="unknown argument lst in call to list.Drop")

		// A parameter cannot be given both positionally and by label.
		dup: strings.Repeat("ab", s: "x") @test(err, code=eval, contains="argument s provided by position and label in call to strings.Repeat")

		// Labels cannot leave a hole before a bound position.
		hole: list.Slice([1, 2, 3], j: 2) @test(err, code=eval, contains="missing argument 2 in call to list.Slice")
	}

	// An anonymous user type remains compatible with the builtin's named
	// declaration. The declaration's contract label stays callable.
	user: {
		T: func(s: string, sep: string) -> [...string]
		f: T & strings.SplitN @test(err, code=eval, contains="builtin strings.SplitN has more parameters than closed function type")

		U:  func(string, ...) -> string
		up: U & strings.ToUpper
		x:  up(s: "hi") @test(eq, "HI")

		// A second contract name for the already named slot conflicts.
		badName: (func(text: string, ...) -> string) & strings.ToUpper @test(err, code=eval, contains="conflicting parameter labels")
	}
}
// Defaults are part of CUE signatures, for builtins as for function
// literals: a default declared by a function type unified with a builtin
// fills an omitted argument, and it must agree with the builtin's own
// default.
typeDefaults: {
	Rep:     func(s: string, count: int = 2) -> string
	rep:     Rep & strings.Repeat
	repX:    rep("ab", 3) @test(eq, "ababab")
	repOmit: rep("ab") @test(eq, "abab")

	// Two types attached to the builtin must still agree on their defaults,
	// as they would without it: ignoring a default when completing the
	// builtin's arguments does not make conflicting declarations compatible.
	Rep3:       func(s: string, count: int = 3) -> string
	repTypes:   Rep & Rep3 @test(err, code=eval, contains="conflicting defaults for parameter count")
	repBoth:    strings.Repeat & Rep & Rep3 @test(err, code=eval, contains="conflicting defaults for parameter count")
	repBothRev: Rep3 & strings.Repeat & Rep @test(err, code=eval, contains="conflicting defaults for parameter count")
	repSame:    (Rep & strings.Repeat & Rep)("ab", 3) @test(eq, "ababab")

	// A declared default must agree with the builtin's own default; the
	// parameter type must stay within the values the builtin accepts.
	Join:    func(elem: [...string], os: "unix" | "windows" = "windows") -> string
	join:    Join & path.Join @test(err, code=eval, contains="conflicting defaults for parameter os")
	JoinAny: func(elem: [...string], os: string = "unix") -> string
	joinAny: JoinAny & path.Join @test(err, code=eval, contains="parameter os of builtin path.Join accepts")
	// A type may leave the default out: the builtin's own default then
	// fills the omitted argument.
	JoinND:  func(elem: [...string], os: "unix" | "windows") -> string
	joinND:  (JoinND & path.Join)(["a", "b"]) @test(eq, "a/b")
	joinNDW: (JoinND & path.Join)(["a", "b"], "windows") @test(eq, "a\\b")
	// A differing default preference in the type is no obligation on the
	// values the builtin must accept.
	#OS:    *"windows" | "unix"
	JoinOS: func(elem: [...string], os: #OS) -> string
	joinOS: (JoinOS & path.Join)(["a", "b"], "unix") @test(eq, "a/b")

	// A default declared on a type fills an omitted argument of a builtin
	// as it would for a function value.
	_rep: strings.Repeat
	_rep: func(s: string, count: int = 3) -> string
	split: _rep("a") @test(eq, "aaa")
	Unix:   func(elem: [...string], os: "unix" | "windows" = "unix") -> string
	unix:   Unix & path.Join
	unixX:  unix(["a", "b"]) @test(eq, "a/b")
	unixOS: unix(["a", "b"], "windows") @test(eq, "a\\b")
}
