(struct){
  #F: (func){ func(a: 〈0;#F〉, b: 〈0;#F〉, c: 〈0;#F〉) -> 〈0;#F〉 }
  #G: (func){ func(a: 〈0;#G〉, b: 〈0;#G〉, c: 〈0;#G〉) -> 〈0;#G〉 }
  admitted: (func){ func(a: 〈0;#G〉, b: 〈0;#G〉, c: 〈0;#G〉) -> 〈0;#G〉: 〈0;a〉 & func(a: 〈0;#F〉, b: 〈0;#F〉, c: 〈0;#F〉) -> 〈0;#F〉 }
  cb: (func){ func(a: 〈0;#G〉, b: 〈0;#G〉, c: 〈0;#G〉) -> 〈0;#G〉: 〈0;a〉 & func(a: 〈0;#G〉, b: 〈0;#G〉, c: 〈0;#G〉) -> 〈0;#G〉 }
  use: (func){ func(g: 〈0;#F〉) -> int: 1 }
  bound: (int){ 1 }
  #H: (#struct){
    n: (int){ int }
    m: (_|_){
      // [incomplete] #H.m: non-concrete value int in operand to +:
      //     ./in.cue:12:17
      //     ./in.cue:12:9
    }
    t: (func){ func(p1: (〈1;#H〉 & {
        n: 〈1;m〉
      }).t, p2: (〈1;#H〉 & {
        n: 〈1;m〉
      }).t, p3: (〈1;#H〉 & {
        n: 〈1;m〉
      }).t) -> int }
  }
  #K: (#struct){
    n: (int){ int }
    m: (_|_){
      // [incomplete] #K.m: non-concrete value int in operand to +:
      //     ./in.cue:13:17
      //     ./in.cue:13:9
    }
    t: (func){ func(p1: (〈1;#K〉 & {
        n: 〈1;m〉
      }).t, p2: (〈1;#K〉 & {
        n: 〈1;m〉
      }).t, p3: (〈1;#K〉 & {
        n: 〈1;m〉
      }).t) -> int }
  }
  instances: (func){ func(f: 〈0;#K〉.t) -> int: 1 & func(f: 〈0;#H〉.t) -> int }
}
