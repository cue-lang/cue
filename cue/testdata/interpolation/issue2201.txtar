# Errors in unified values used in an interpolation must not be dropped.
# https://cuelang.org/issue/2201
# https://cuelang.org/issue/2323
-- in.cue --
issue2201: {
	#f: {
		#input: _
		"""
			\(#input)
			"""
	}

	x:   string
	res: #f & {#input: x, _} @test(err, code=incomplete, contains="non-concrete value string")

	y1: """
		# Hello

		\(res)
		""" @test(err, code=incomplete, contains="non-concrete value string")

	y2: """
		# Hello

		\(#f & {#input: x, _})
		""" @test(eq, "# Hello\n\n", incorrect) @test(err:todo, code=incomplete, contains="non-concrete value string")
}
issue2323: {
	x: {}

	y1: "\(x.blah)"          @test(err, code=incomplete, contains="undefined field: blah")
	y2: "\(x.blah & {})"     @test(eq, "", incorrect) @test(err:todo, code=incomplete, contains="undefined field: blah")
	y3: "\(x.blah & 1)"      @test(eq, "", incorrect) @test(err:todo, code=incomplete, contains="undefined field: blah")
	y4: "\(x.blah & string)" @test(eq, "", incorrect) @test(err:todo, code=incomplete, contains="undefined field: blah")
	y5: '\(x.blah & {})'     @test(eq, '', incorrect) @test(err:todo, code=incomplete, contains="undefined field: blah")
}
nonConcrete: {
	x:  string
	y1: "\(x & string)" @test(err, code=incomplete, contains="non-concrete value string")
	y2: '\(x & string)' @test(err, code=incomplete, contains="non-concrete value string")
}
conflict: {
	y1: "\({a: 1} & {a: 2})"     @test(err, code=eval, contains="cannot use {a:1 & 2} (type struct)")
	y2: "\(({a: 1} & {a: 2}).a)" @test(err, code=eval, contains="conflicting values")
}
