# A trailing ..._|_ closes a list literal: the literal limits the length of
# the list, one level deep, as a list literal without an ellipsis does,
# rather than adding a pattern that further elements fail. The two read the
# same for unification; they differ for observers such as indexing.
-- in.cue --
length: {
	x: [1, ..._|_]
	x: [_, 2] @test(err, contains="incompatible list lengths")
}

empty: {
	x: [..._|_] & [1] @test(err, contains="incompatible list lengths")
}

// The literal closes one level: its elements keep their own closedness.
oneLevel: {
	x: [{a: 1}, ..._|_] & [{a: 1, b: 2}] @test(eq, [{a: 1, b: 2}])
}

// The literal stays a list literal: it can refer to its own elements and
// keeps the closedness a definition gives its elements.
selfRef: {
	l: [1, l[0] + 1, ..._|_] @test(eq, [1, 2])
}

defElems: {
	#D: [{a: int}, ..._|_]
	err: #D & [{a: 1, b: 2}] @test(err, contains="field not allowed")
}

// An index past the end of the list is an error, not incomplete.
index: {
	x: [1, ..._|_][3] @test(err, code=eval, contains="index out of range")
}

open: {
	x: [1, ..._|_] & [...int] @test(eq, [1])
	n: len(x)                 @test(eq, 1)
}
-- out/errors.txt --
[eval] length.x: incompatible list lengths (1 and 2):
    ./in.cue:3:5
[eval] empty.x: incompatible list lengths (0 and 1):
    ./in.cue:7:16
[eval] defElems.err.0.b: field not allowed:
    ./in.cue:23:20
[eval] index.x: index out of range [3] with length 1:
    ./in.cue:28:17
    ./in.cue:28:5
