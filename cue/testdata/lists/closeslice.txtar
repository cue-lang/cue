# close applies to the result of a slice as it does to a list literal or a
# builtin result: the sliced elements are its own, and further elements are
# rejected. A slice of a list built by a comprehension behaves the same.
-- in.cue --
x: [1, 2, 3]
y: close(x[0:1])
ok:  y & [1]    @test(eq, [1])
err: y & [1, 2] @test(err, contains="incompatible list lengths")

d: close([for i in [1, 2, 3] {i}][0:1])
dOk:  d & [1]    @test(eq, [1])
dErr: d & [1, 2] @test(err, contains="incompatible list lengths")

// Slicing a list of structs keeps the elements.
s: [{a: 1}, {a: 2}]
t: close(s[1:]) & [{b: 2}] @test(eq, [{a: 2, b: 2}])
-- out/errors.txt --
[eval] err: incompatible list lengths (1 and 2)
[eval] dErr: incompatible list lengths (1 and 2)
-- out/eval/stats --
Leaks:  0
Freed:  73
Reused: 51
Allocs: 22
Retain: 0

Unifications: 64
Conjuncts:    106
Disjuncts:    0

NumCloseIDs: 26
