-- references.cue --
missingField: {
	a: {}
	r: a.b @test(err, code=incomplete, contains="undefined field: b", pos=[0:7, -1:2])
}

missingFieldClosed: {
	#a: {}
	r: #a.b @test(err, code=eval, contains="undefined field: b", pos=[0:8, -1:2])
}

missingFieldNested: {
	a: {}
	// Must refer to `b` in error
	r: a.b.c @test(err, code=incomplete, contains="undefined field: b", pos=[0:7, -2:2])
}

missingFieldNestedClosed: {
	#a: {}

	// Must refer to `d` in error
	r: #a.d.c @test(err, code=eval, contains="undefined field: d", pos=[0:8, -3:2])
}

missingFieldNestedInInterpolation: {
	a: {}
	// Must refer to `b` in error
	r1: "\(a.b.c)" @test(err, code=incomplete, contains="invalid interpolation: undefined field: b", pos=[0:6, -2:2, 0:11])
	// Must refer to `d` in error: in case only one error is shown for a
	// a location, ensure it doesn't alphabetically sort and pick `c` instead.
	r2: "\(a.d.c)" @test(err, code=incomplete, contains="invalid interpolation: undefined field: d", pos=[0:6, -5:2, 0:11])
}
-- out/errors.txt --
