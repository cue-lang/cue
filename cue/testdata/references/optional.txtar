-- in.cue --
t1: a: {
	foo?: int

	b: foo @test(err, code=incomplete)
}
t2: a: {
	b: foo @test(err, code=incomplete)

	foo?: int
}

// Selecting through optional fields of an inline struct, whose arcs are
// never unified as part of the tree, still finds them to be optional.
inline: {
	opt:      {x: y?: z?: int}.x.y.z       @test(err, code=incomplete, contains="optional field: y")
	optReg:   {x: y?: z: int}.x.y.z        @test(err, code=incomplete, contains="optional field: y")
	required: {x: y!: z?: int}.x.y.z       @test(err, code=incomplete, contains="required field missing: y")
	deeper:   {x: y?: z?: w?: int}.x.y.z.w @test(err, code=incomplete, contains="optional field: y")
	ref:      {x: y?: c}.x.y.z             @test(err, code=incomplete, contains="optional field: y")
	c: z: 1
	comprehension: {x: {if true {y?: z?: int}}}.x.y.z      @test(err, code=incomplete, contains="optional field: y")
	disjunction:   {x: y?: {z?: int} | {z?: string}}.x.y.z @test(err, code=incomplete, contains="optional field: y")
	builtinArg:    matchIf({#C: y?: z?: #C}.#C.y.z, _, _)  @test(err, code=incomplete, contains="optional field: y")
	listElem:      [{y?: z?: int}][0].y.z                  @test(err, code=incomplete, contains="optional field: y")
	pattern:       {x: [string]: z: 1, x: y?: _}.x.y.z     @test(err, code=incomplete, contains="optional field: y")
	selfRef:       {x: y?: z?: selfRef}.x.y.z              @test(err, code=incomplete, contains="optional field: y")
	requiredLeaf:  {x: y?: z!: int}.x.y.z                  @test(err, code=incomplete, contains="optional field: y")

	// The field may itself hold a comprehension.
	ifIn:           {y?: {if true {z: 4}}}.y.z          @test(err, code=incomplete, contains="optional field: y")
	ifInRequired:   {y!: {if true {z: 4}}}.y.z          @test(err, code=incomplete, contains="required field missing: y")
	forIn:          {y?: {for v in [1] {z: v}}}.y.z     @test(err, code=incomplete, contains="optional field: y")
	ifInEmpty:      {y?: {z?: 1, if true {}}}.y.z       @test(err, code=incomplete, contains="optional field: y")
	ifInDef:        {#x: {y?: {if true {z: 4}}}}.#x.y.z @test(err, code=incomplete, contains="optional field: y")
	ifInIncomplete: {y?: {if cond {z: 4}}}.y.z          @test(err, code=incomplete, contains="optional field: y")

	// A sibling conjunct or comprehension can make an optional field of an
	// inline struct regular.
	conjunct: {x: y?: z?: int, x: y: z: 2}.x.y.z                       @test(eq, 2)
	forComp:  {x: y?: z?: int, x: {for k, v in src {(k): z: v}}}.x.y.z @test(eq, 3)
	src: y: 3
	ifComp:       {x: y?: z?: int, x: {if true {y: z: 4}}}.x.y.z @test(eq, 4)
	ifInConjunct: {y?: {if true {z: 4}}, y: {}}.y.z              @test(eq, 4)
	ifIncomplete: {x: y?: z?: int, x: {if cond {y: z: 5}}}.x.y.z @test(err, code=incomplete)
	cond:         bool
}
