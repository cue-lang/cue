Sharing a reference with a definition it already includes must preserve errors,
closedness, disjunction selection, lexical scope, and later constraints.
-- in.cue --
#T: {cmd: string, extra?: int}

valid: {
	a: #T & {cmd: "ok"}
	left:  a & #T @test(eq, {cmd: "ok", extra?: int})
	right: #T & a @test(eq, {cmd: "ok", extra?: int})
}

unconstrained: {
	a: {cmd: 1}
	out: a & #T @test(err, at=cmd, code=eval, contains="conflicting values")
}

invalidSource: {
	a: #T & {cmd: 1} @test(err, at=cmd, code=eval, contains="conflicting values")
	out: a & #T @test(err, at=cmd, code=eval, contains="conflicting values")
}

invalidClosedSource: {
	a: #T & {cmd: "ok", unexpected: true} @test(err, at=unexpected, code=eval, contains="field not allowed")
	out: a & #T @test(err, at=unexpected, code=eval, contains="field not allowed")
}

stricter: {
	#U: {cmd: "other", extra?: int}
	a: #T & {cmd: "ok"}
	out: a & #T & #U @test(err, at=cmd, code=eval, contains="conflicting values")
}

closed: {
	a: #T & {cmd: "ok"}
	out: a & #T & {unexpected: true} @test(err, at=unexpected, code=eval, contains="field not allowed")
}

opened: {
	a: {#T..., cmd: "ok", unexpected: true}
	out: a & #T @test(err, at=unexpected, code=eval, contains="field not allowed")
}

openedConjunction: {
	a: {(#T & {})..., cmd: "ok", unexpected: true}
	out: a & #T @test(err, at=unexpected, code=eval, contains="field not allowed")
}

alternatives: {
	a: (#T & {cmd: "ok"}) | {script: "x"}
	out: a & #T @test(eq, {cmd: "ok", extra?: int})
}

defaults: {
	a: #T & {cmd: *"default" | "other"}
	out: a & #T @test(eq, {cmd: *"default" | "other", extra?: int})
	selected: out & {cmd: "other"} @test(eq, {cmd: "other", extra?: int})
}

scopes: {
	#Wrapper: {
		tag: string
		#Local: {cmd: tag}
		a: #Local & {cmd: tag}
		out: a & #Local
	}
	x: #Wrapper & {tag: "x"} @test(eq, "x", at=out.cmd)
	y: #Wrapper & {tag: "y"} @test(eq, "y", at=out.cmd)
}

late: {
	a: #T & {cmd: "ok"}
	out: a & #T
	if out.cmd == "ok" {
		out: extra: "bad"
	}
	@test(err, at=out.extra, code=eval, contains="conflicting values")
}

choice: {
	#Choice: {
		cmd?: string
		script?: string
		({cmd!: string, script?: _|_} | {script!: string, cmd?: _|_})
	}
	a: #Choice & {cmd: "ok"}
	out: a & #Choice @test(eq, {cmd: "ok"})
	bad: out & {script: "bad"} @test(err, code=user, contains="empty disjunction")
}
