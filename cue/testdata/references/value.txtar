-- in.cue --
structShorthand: {let X = self, b: 3, c: X.b} @test(eq, {b: 3, c: 3})

// Note that X and Y are subtly different, as they have different bindings:
// one binds to the field, the other to the value. In this case, that does not
// make a difference.
fieldAndValue: foo~(X): {let Y = self, 3, #sum: X + Y} @test(eq, {3, #sum: 6})

// A value alias on a scalar has no postfix form: the "let X = self" that
// replaces it needs a struct to live in. The struct literal has no value of
// its own, so the reference is a cycle, as it was for the value alias.
valueCycle: b: {let X = self, 3 + X} @test(err, code=cycle, contains="cycle with field: X", pos=[0:35])

// Issue #1003
listValueAlias: {let X = self, [1, 2, X[0]]} @test(eq, [1, 2, 1])

-- err.cue --
@experiment(structcmp)

cycleErr: {
	let X = self
	err3: ==(X + 1)
	err3: 4
	@test(err, code=eval, contains="invalid operands", pos=[2:11, 0:11, 2:15])
}
-- out/errors.txt --
[eval] cycleErr.err3: invalid operands {let X#1=_|_(cycleErr.X: structural cycle),err3:_|_} and 1 to '+' (type struct and int):
    ./err.cue:5:11
    ./err.cue:3:11
    ./err.cue:5:15
[cycle] valueCycle.b: cycle with field: X:
    ./in.cue:11:35
-- out/todo.txt --
v2 does not include cycleErr (no @experiment(structcmp) support).
v2 cycle error message: "[cycle] cycle error" vs v3 "cycle with field: X".
