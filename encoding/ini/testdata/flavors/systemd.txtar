#flavor: systemd
-- in.ini --
# Sample systemd service unit, modelled on a .service file read per
# systemd.syntax(7).
[Unit]
Description=Example service
; Comments may also start with a semicolon.
After=network.target

[Service]
Environment=FIRST=1
Environment=SECOND=2
Environment=THIRD=3
ExecStart=/bin/sh -c 'echo one ; echo two'
ExecReload=/bin/kill -HUP $MAINPID \
# A comment block between the backslash and its continuation is skipped.
; So is this one.
	--timeout 5
Restart=on-failure

[Install]
WantedBy=multi-user.target
-- in.cue --
// A service unit as one would write it in CUE for systemd.
Unit: {
	Description: "Example service"
	After:       "network.target"
}
Service: {
	Environment: ["FIRST=1", "SECOND=2"]
	ExecStart:   "/bin/sh -c 'echo one ; echo two'"
	Restart:     "on-failure"
}
Install: WantedBy: "multi-user.target"
-- out/decode/default --
duplicate key: Environment:
    in.ini:10:1
-- out/decode/flavor --
Unit: {
	Description: "Example service"
	After:       "network.target"
}
Service: {
	Environment: ["FIRST=1", "SECOND=2", "THIRD=3"]
	ExecStart:   "/bin/sh -c 'echo one ; echo two'"
	ExecReload:  "/bin/kill -HUP $MAINPID  \t--timeout 5"
	Restart:     "on-failure"
}
Install: WantedBy: "multi-user.target"
-- out/encode/default --
cannot write list at Service.Environment: lists are repeated keys; set Config.DuplicateKeys to DuplicatesList to allow it:
    in.cue:7:2
-- out/encode/flavor --
[Unit]
Description = Example service
After = network.target

[Service]
Environment = FIRST=1
Environment = SECOND=2
ExecStart = /bin/sh -c 'echo one ; echo two'
Restart = on-failure

[Install]
WantedBy = multi-user.target
