# Tests for closedness-related issues in JSON Schema generation.
#
# Issue 4352: closedness lost in disjunctions.
-- test.cue --
package test

#Disj: int | {
	a?: int
}

#Simple: {
	a?: int
	b?: string
}

#NestedDisj: {
	x?: string | {
		y?: int
	}
}

#TwoStructDisj: {a?: int} | {b?: string}

t01?: #Disj
t02?: #Simple
t03?: #NestedDisj
t04?: #TwoStructDisj
t05?: _#Hidden
t06?: #RefsHidden
t07?: _#WrapsRegular

_#Hidden: {
	a?: int
}

#RefsHidden: h?: _#Hidden

_#WrapsRegular: _regular

_regular: {
	b?: int
}

-- datatest/testdata.cue --
package datatest
disjInt: {
	data: {t01: 42}
}
disjStruct: {
	data: {t01: {a: 1}}
}
disjStructExtra: {
	data: {t01: {a: 1, extra: true}}
	error: true
}
simple: {
	data: {t02: {a: 1, b: "hello"}}
}
simpleExtra: {
	data: {t02: {a: 1, extra: true}}
	error: true
}
nestedDisjStructExtra: {
	data: {t03: {x: {y: 1, extra: true}}}
	error: true
}
twoStructDisjExtra: {
	data: {t04: {a: 1, extra: true}}
	error: true
}
hiddenValid: {
	data: {t05: {a: 1}, t06: {h: {a: 2}}, t07: {b: 3}}
}
// BUG: this incorrectly allows extra fields.
hiddenExtra: {
	data: {t05: {a: 1, extra: true}}
}
// BUG: this incorrectly allows extra fields.
refsHiddenExtra: {
	data: {t06: {h: {a: 1, extra: true}}}
}
// BUG: this incorrectly allows extra fields.
wrapsRegularExtra: {
	data: {t07: {b: 1, extra: true}}
}
-- out/generate-v3/schema --
{
	$schema: "https://json-schema.org/draft/2020-12/schema"
	$defs: {
		Disj: anyOf: [{
			type: "integer"
		}, {
			type:                 "object"
			additionalProperties: false
			properties: a: type: "integer"
		}]
		Hidden: {
			type: "object"
			properties: a: type: "integer"
		}
		NestedDisj: {
			type:                 "object"
			additionalProperties: false
			properties: x: anyOf: [{
				type: "string"
			}, {
				type:                 "object"
				additionalProperties: false
				properties: y: type: "integer"
			}]
		}
		RefsHidden: {
			type:                 "object"
			additionalProperties: false
			properties: h: $ref: "#/$defs/Hidden"
		}
		Simple: {
			type:                 "object"
			additionalProperties: false
			properties: {
				a: type: "integer"
				b: type: "string"
			}
		}
		TwoStructDisj: anyOf: [{
			type:                 "object"
			additionalProperties: false
			properties: a: type: "integer"
		}, {
			type:                 "object"
			additionalProperties: false
			properties: b: type: "string"
		}]
		WrapsRegular: $ref: "#/$defs/_regular"
		"_regular": {
			type: "object"
			properties: b: type: "integer"
		}
	}
	type: "object"
	properties: {
		t01: $ref: "#/$defs/Disj"
		t02: $ref: "#/$defs/Simple"
		t03: $ref: "#/$defs/NestedDisj"
		t04: $ref: "#/$defs/TwoStructDisj"
		t05: $ref: "#/$defs/Hidden"
		t06: $ref: "#/$defs/RefsHidden"
		t07: $ref: "#/$defs/WrapsRegular"
	}
}
