# Tests for closedness with the spread operator.
# Since v0.18.0, spread (#T...) opens a definition,
# while plain embedding (#T) keeps it closed.
# A definition closes again what a spread opens within it,
# wherever the definition is embedded or unified.
-- test.cue --
package test

#WithSpread: {
	#Inner...
	y?: string
}

#Inner: {
	x?: int
}

#MixedRef: {
	#Inner...
	child?: #Inner
	z?: string
}
_foo: {
	#Inner...
	y?: int
}
_bar: {
	#Inner
	y?: int
}
_spread: #Inner...
#Holder: d?: #Inner...
_embedHolder: {#Holder}
_unifyHolder: #Holder & {}

t01?: #WithSpread
t02?: #Inner
t03?: #MixedRef
t04?: _foo
t05?: _bar
t06?: _spread
t07?: _embedHolder
t08?: _unifyHolder

-- datatest/testdata.cue --
package datatest
spreadValid: {
	data: {t01: {x: 1, y: "hello"}}
}
spreadExtra: {
	data: {t01: {x: 1, y: "hello", extra: true}}
	error: true
}
innerValid: {
	data: {t02: {x: 1}}
}
innerExtra: {
	data: {t02: {x: 1, extra: true}}
	error: true
}
mixedValid: {
	data: {t03: {x: 1, child: {x: 2}, z: "hi"}}
}
mixedChildExtra: {
	data: {t03: {x: 1, child: {x: 2, extra: true}, z: "hi"}}
	error: true
}
spreadSharedExtra: {
	data: {t06: {x: 1, extra: true}}
}
embedHolderExtra: {
	data: {t07: {d: {x: 1, extra: true}}}
	error: true
}
unifyHolderExtra: {
	data: {t08: {d: {x: 1, extra: true}}}
	error: true
}
-- out/generate-v3/schema --
{
	$schema: "https://json-schema.org/draft/2020-12/schema"
	$defs: {
		Holder: {
			type:                 "object"
			additionalProperties: false
			properties: d: {
				type:                 "object"
				additionalProperties: false
				properties: x: type: "integer"
			}
		}
		Inner: {
			type:                 "object"
			additionalProperties: false
			properties: x: type: "integer"
		}
		MixedRef: {
			type:                 "object"
			additionalProperties: false
			properties: {
				child: $ref: "#/$defs/Inner"
				x: type:     "integer"
				z: type:     "string"
			}
		}
		WithSpread: {
			type:                 "object"
			additionalProperties: false
			properties: {
				x: type: "integer"
				y: type: "string"
			}
		}
		"_bar": {
			type: "object"
			properties: y: type: "integer"
			$ref: "#/$defs/Inner"
		}
		"_embedHolder": {
			type:                 "object"
			additionalProperties: false
			properties: d: {
				type:                 "object"
				additionalProperties: false
				properties: x: type: "integer"
			}
		}
		"_foo": {
			type: "object"
			properties: {
				x: type: "integer"
				y: type: "integer"
			}
		}
		"_spread": {
			type: "object"
			properties: x: type: "integer"
		}
		"_unifyHolder": {
			type: "object"
			$ref: "#/$defs/Holder"
		}
	}
	type: "object"
	properties: {
		t01: $ref: "#/$defs/WithSpread"
		t02: $ref: "#/$defs/Inner"
		t03: $ref: "#/$defs/MixedRef"
		t04: $ref: "#/$defs/_foo"
		t05: $ref: "#/$defs/_bar"
		t06: $ref: "#/$defs/_spread"
		t07: $ref: "#/$defs/_embedHolder"
		t08: $ref: "#/$defs/_unifyHolder"
	}
}
-- out/generate-v3/spreadValid --
-- out/generate-v3/spreadExtra --
spreadExtra.data.t01.extra: field not allowed:
    ./datatest/testdata.cue:6:33
-- out/generate-v3/innerValid --
-- out/generate-v3/innerExtra --
innerExtra.data.t02.extra: field not allowed:
    ./datatest/testdata.cue:13:21
-- out/generate-v3/mixedValid --
-- out/generate-v3/mixedChildExtra --
mixedChildExtra.data.t03.child.extra: field not allowed:
    ./datatest/testdata.cue:20:35
-- out/generate-v3/embedHolderExtra --
embedHolderExtra.data.t07.d.extra: field not allowed:
    ./datatest/testdata.cue:27:25
-- out/generate-v3/spreadSharedExtra --
-- out/generate-v3/unifyHolderExtra --
unifyHolderExtra.data.t08.d.extra: field not allowed:
    ./datatest/testdata.cue:31:25
