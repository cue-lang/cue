# A reference to a comprehension's let variable is generated in place.
# See https://cuelang.org/issue/4586
-- test.cue --
package test

byLet?: {
	for k in ["a", "b"] let z = "x-\(k)" {
		(k)?: z
	}
}
-- datatest/tests.cue --
package datatest

ok1: data: byLet: {
	a: "x-a"
	b: "x-b"
}
fail1: {
	data: byLet: a: "x-b"
	error: true
}
-- out/generate-v3/schema --
{
	$schema: "https://json-schema.org/draft/2020-12/schema"
	type:    "object"
	properties: byLet: {
		type: "object"
		properties: {
			a: const: "x-a"
			b: const: "x-b"
		}
	}
}
-- out/generate-v3/fail1 --
fail1.data.byLet.a: conflicting values "x-a" and "x-b":
    ./datatest/tests.cue:8:18
    1:133
-- out/generate-v3/ok1 --
