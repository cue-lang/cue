#version: draft7

Without minContains, a contains requires a match, so it cannot express a
list which needs none.

-- test.cue --
package test

import "list"

atLeastNone?: list.MatchN(>=0, >3)
atMostOne?: list.MatchN(>=0 & <=1, >3)
atLeastOne?: list.MatchN(>=1, >3)
negated?: matchN(0, [list.MatchN(>=0, >3)])

-- datatest/tests.cue --
package datatest

atLeastNone: {
	data: atLeastNone: [1]
	error: false
}

atMostOne: {
	data: atMostOne: []
	error: false
}

ok: data: negated: "a"

badAtLeastOne: {
	data: atLeastOne: [1]
	error: true
}
-- out/generate-v3/schema --
{
	$schema: "http://json-schema.org/draft-07/schema#"
	type:    "object"
	properties: {
		atLeastNone: type: "array"
		atLeastOne: {
			type: "array"
			contains: {
				type:             "number"
				exclusiveMinimum: 3
			}
		}
		atMostOne: type: "array"
		negated: {}
	}
}
-- out/generate-v3/atLeastNone --
-- out/generate-v3/atMostOne --
-- out/generate-v3/badAtLeastOne --
badAtLeastOne.data.atLeastOne: invalid value [1] (does not satisfy list.MatchN): >3 matches 0 list items, want >=1:
    1:144
    ./datatest/tests.cue:16:20
    1:172
-- out/generate-v3/ok --
