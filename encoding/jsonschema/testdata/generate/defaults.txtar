# A default value is not part of a generated JSON Schema, but the constraints
# it is disjoined with are. When the other arms subsume the default arm,
# cue.Value.Expr drops it and reports the value as a NoOp wrapping the single
# remaining arm, whose constraints must still be generated.
#
# bounded and trailingDefault have their default subsumed by the other arm,
# which is all that remains; disjoint keeps both arms because the default is
# not subsumed; noDefault is there to compare bounded against.
# See https://cuelang.org/issue/4305
#
# TODO bounded and trailingDefault lose their bounds, unlike noDefault, so
# the schemas below accept values that CUE rejects.
-- test.cue --
package test

bounded?:         *20 | int & >=1 & <=100
trailingDefault?: int & >=1 | *5
disjoint?:        *20 | string
noDefault?:       int & >=1 & <=100
-- datatest/tests.cue --
package datatest

ok: data: {
	bounded:         50
	trailingDefault: 3
	disjoint:        "x"
	noDefault:       50
}

// The default itself remains a valid value, being within the bounds.
okDefault: data: bounded: 20

// TODO the dropped bounds make boundedTooLarge and trailingDefaultTooSmall
// validate; both should be errors.
boundedTooLarge: {
	data: bounded: 500
}

boundedNotInt: {
	data: bounded: 50.5
	error: true
}

trailingDefaultTooSmall: {
	data: trailingDefault: 0
}

disjointBadKind: {
	data: disjoint: true
	error: true
}
-- out/generate-v3/schema --
{
	$schema: "https://json-schema.org/draft/2020-12/schema"
	type:    "object"
	properties: {
		bounded: type:   "integer"
		disjoint: anyOf: [{const: 20}, {type: "string"}]
		noDefault: allOf: [{
			type: "number"
		}, {
			type:    "integer"
			maximum: 100
			minimum: 1
		}]
		trailingDefault: type: "integer"
	}
}
-- out/generate-v3/boundedNotInt --
boundedNotInt.data.bounded: conflicting values 50.5 and int (mismatched types float and int):
    ./datatest/tests.cue:20:17
    1:100
-- out/generate-v3/boundedTooLarge --
-- out/generate-v3/disjointBadKind --
disjointBadKind.data.disjoint: conflicting values true and 20 (mismatched types bool and int):
    ./datatest/tests.cue:29:18
    1:140
disjointBadKind.data.disjoint: conflicting values true and string (mismatched types bool and string):
    ./datatest/tests.cue:29:18
disjointBadKind.data.disjoint: invalid value true (does not satisfy matchN): 0 matched, expected >=1:
    1:130
    ./datatest/tests.cue:29:18
-- out/generate-v3/ok --
-- out/generate-v3/okDefault --
-- out/generate-v3/trailingDefaultTooSmall --
