# A reference to a value within a let field is generated in place.
# See https://cuelang.org/issue/4586
-- test.cue --
package test

let X = {a: {c: string, d: c}}

viaLet: X.a
-- datatest/tests.cue --
package datatest

ok1: data: viaLet: {
	c: "x"
	d: "x"
}
fail1: {
	data: viaLet: {
		c: "x"
		d: 1
	}
	error: true
}
-- out/generate-v3/schema --
{
	$schema: "https://json-schema.org/draft/2020-12/schema"
	type:    "object"
	properties: viaLet: {
		type: "object"
		properties: {
			c: type: "string"
			d: type: "string"
		}
		required: ["c", "d"]
	}
	required: ["viaLet"]
}
-- out/generate-v3/fail1 --
fail1.data.viaLet.d: conflicting values 1 and string (mismatched types int and string):
    ./datatest/tests.cue:10:6
-- out/generate-v3/ok1 --
