{
	$schema: "https://json-schema.org/draft/2020-12/schema"
	type:    "object"
	properties: {
		boundedPartialTuple: {
			type:        "array"
			description: "Partial tuple with a bounded length"
			prefixItems: [{type: "string"}, {type: "integer"}]
			maxItems:    2
		}
		boundedRequiredPrefix: {
			type:        "array"
			description: "Guaranteed prefix with a bounded length"
			prefixItems: [{type: "string"}, {type: "integer"}]
			maxItems:    2
			minItems:    1
		}
		emptyList: {
			description: "Empty list"
			const:       []
		}
		emptyOpenList: {
			type:        "array"
			description: "Empty open list"
		}
		gappyTuple: {
			type:        "array"
			description: "Only the elements from index 2 onwards are constrained"
			items: type: "integer"
			prefixItems: [true, true]
		}
		intIndexed: {
			type:        "array"
			description: "An index pattern that matches every index is just an element type"
			items: type: "integer"
		}
		mixedTuple: {
			type:        "array"
			description: "Mixed tuple with concrete values"
			prefixItems: [{type: "string"}, {const: 2}, {type: "boolean"}]
			maxItems:    3
			minItems:    3
		}
		numberList: {
			type:        "array"
			description: "Open list with number elements"
			items: type: "number"
		}
		partialTuple: {
			type:        "array"
			description: "Tuple whose elements need not all be present"
			prefixItems: [{type: "string"}, {type: "integer"}]
		}
		partialTupleTail: {
			type:        "array"
			description: "Partial tuple with a constrained tail"
			items: type: "integer"
			prefixItems: [{type: "string"}]
		}
		requiredPrefix: {
			type:        "array"
			description: "Only the first element is guaranteed to be present"
			items: type: "boolean"
			prefixItems: [{type: "string"}, {type: "integer"}]
			minItems:    1
		}
		stringList: {
			type:        "array"
			description: "Open list with element type"
			items: type: "string"
		}
		tuple: {
			type:        "array"
			description: "Closed list (tuple)"
			prefixItems: [{type: "string"}, {type: "integer"}]
			maxItems:    2
			minItems:    2
		}
		uintIndexed: {
			type: "array"
			items: type: "integer"
		}
	}
}
