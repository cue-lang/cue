-- test.cue --
package test

import "list"

// Open list with element type
stringList?: [...string]

// Open list with number elements
numberList?: [...number]

// Closed list (tuple)
tuple?: [string, int]

// Mixed tuple with concrete values
mixedTuple?: [string, 2, bool]

// Empty list
emptyList?: []

// Empty open list
emptyOpenList?: [...]

// Tuple whose elements need not all be present
partialTuple?: {
	[...]
	[0]: string
	[1]: int
}

// Partial tuple with a constrained tail
partialTupleTail?: {
	[...]
	[0]:   string
	[>=1]: int
}

// Only the elements from index 2 onwards are constrained
gappyTuple?: {
	[...]
	[>1]: int
}

// An index pattern that matches every index is just an element type
intIndexed?: {
	[...]
	[int]: int
}

uintIndexed?: {
	[...]
	[uint]: int
}

// Only the first element is guaranteed to be present
requiredPrefix?: {
	[string, ...]
	[1]:   int
	[>=2]: bool
}

// Guaranteed prefix with a bounded length
boundedRequiredPrefix?: {
	[string, ...]
	[1]: int
} & list.MaxItems(2)

// Partial tuple with a bounded length
boundedPartialTuple?: {
	[...]
	[0]: string
	[1]: int
} & list.MaxItems(2)

-- datatest/tests.cue --
package datatest

ok1: data: {
	stringList: ["a", "b", "c"]
	numberList: [1, 2.5, 3]
	tuple: ["foo", 42]
	mixedTuple: ["bar", 2, true]
	emptyList: []
}

ok2: data: {}

ok3: data: {
	intIndexed: [1, 2]
	uintIndexed: []
	gappyTuple: ["anything", true]
	partialTuple: []
	partialTupleTail: ["a"]
	boundedPartialTuple: ["a"]
	requiredPrefix: ["a"]
	boundedRequiredPrefix: ["a"]
}

ok4: data: {
	intIndexed: []
	uintIndexed: [3]
	gappyTuple: ["anything", true, 1, 2]
	partialTuple: ["a", 1]
	partialTupleTail: ["a", 1, 2]
	boundedPartialTuple: ["a", 1]
	requiredPrefix: ["a", 1, true, false]
	boundedRequiredPrefix: ["a", 1]
}

badIntIndexed: {
	data: intIndexed: [1, "x"]
	error: true
}

badGappyTuple: {
	data: gappyTuple: ["anything", true, "c"]
	error: true
}

badPartialTuple: {
	data: partialTuple: ["a", "b"]
	error: true
}

badPartialTupleTail: {
	data: partialTupleTail: ["a", "b"]
	error: true
}

badBoundedPartialTuple: {
	data: boundedPartialTuple: ["a", 1, 2]
	error: true
}

badRequiredPrefixTooShort: {
	data: requiredPrefix: []
	error: true
}

badRequiredPrefixTail: {
	data: requiredPrefix: ["a", 1, 2]
	error: true
}

badBoundedRequiredPrefix: {
	data: boundedRequiredPrefix: ["a", 1, 2]
	error: true
}

badStringList: {
	data: stringList: [1, 2, 3]
	error: true
}

badTupleLength: {
	data: tuple: ["foo"]
	error: true
}

badTupleType: {
	data: tuple: [1, "bar"]
	error: true
}
