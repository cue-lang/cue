A schema spells out every position up to the index of a pattern, so a
pattern on too large an index is dropped, as one it cannot express.
A schema without the pattern admits more, so it cannot be negated.

-- test.cue --
package test

exact?: {
	[...]
	[4611686018427387904]: int
}

from?: {
	[...]
	[>=4611686018427387904]: int
}

notExact?: matchN(0, [{
	[...]
	[4611686018427387904]: int
}])

-- out/generate-v3/schema --
{
	$schema: "https://json-schema.org/draft/2020-12/schema"
	type:    "object"
	properties: {
		exact: type: "array"
		from: type:  "array"
		notExact: {}
	}
}
