#version: openapi

OpenAPI 3.0 has no tuples, so the schema of every element allows what any
position does. If a list may go on beyond its positions, where it may be
anything, then so may every element.

-- test.cue --
package test

import "list"

open?: [int, ...]
openPattern?: {
	[...]
	[0]: int
}
openTop?: {
	[...]
	[0]:   int
	[>=0]: _
}
closed?: [int, string]
bounded?: {
	[...]
	[0]: int
} & list.MaxItems(1)
constrainedRest?: {
	[...]
	[0]:   string
	[>=1]: int
}
negated?: matchN(0, [{
	[...]
	[0]: int
}])

-- datatest/tests.cue --
package datatest

open: {
	data: open: [1, "s"]
	error: false
}

openPattern: {
	data: openPattern: [1, "s"]
	error: false
}

ok: data: {
	negated: ["s"]
	openTop: [1, "s"]
}

badClosed: {
	data: closed: [true, "s"]
	error: true
}

badBounded: {
	data: bounded: ["s"]
	error: true
}

badConstrainedRest: {
	data: constrainedRest: [true]
	error: true
}
-- out/generate-v3/schema --
{
	type: "object"
	properties: {
		bounded: {
			type: "array"
			items: type: "integer"
			maxItems: 1
		}
		closed: {
			type: "array"
			items: anyOf: [{type: "integer"}, {type: "string"}]
			maxItems: 2
			minItems: 2
		}
		constrainedRest: {
			type: "array"
			items: anyOf: [{type: "string"}, {type: "integer"}]
		}
		negated: {}
		open: {
			type:     "array"
			items:    {}
			minItems: 1
		}
		openPattern: {
			type:  "array"
			items: {}
		}
		openTop: {
			type:  "array"
			items: {}
		}
	}
}
