A schema which only approximates a value admits more than it does. It
cannot be negated, be one of several of which exactly one must match, be
the condition of an if, or be counted up to a maximum, without rejecting
valid data.

-- test.cue --
package test

import (
	"list"
	"net"
	"strings"
	"time"
)

#P: strings.HasPrefix("a")

notCall?: matchN(0, [strings.HasPrefix("a")])
notReference?: matchN(0, [#P])
notValidator?: matchN(0, [net.IPv4])
notStringBound?: matchN(0, [<"b"])
notFloat?: matchN(0, [float])
notLayout?: matchN(0, [time.Format("15h")])
notNotNull?: matchN(0, [!=null])
notTop?: matchN(0, [_])
oneOfCall?: matchN(1, [strings.HasPrefix("a"), "b"])
ifCall?: matchIf(strings.HasPrefix("a"), "ab", _)
notList?: matchN(0, [{
	[...]
	[1]:   matchN(1, [>3])
	[>=1]: <5
}])
maxContainsCall?: list.MatchN(>=0 & <=1, strings.HasPrefix("a"))

notBytes?: matchN(0, [bytes])
notNotEqualReference?: matchN(0, [!=_s])
notBoundReference?: matchN(0, [<_s])
notCount?: matchN(0, [matchN(2, [int, number, string])])
notCycle?: matchN(0, [_lists[0]])
notRecursive?: matchN(0, [#WrapsGrowing])
notPattern?: matchN(0, [{[<"b"]: int}])
notListRest?: matchN(0, [[...<_s]])
notListTopDisjunction?: matchN(0, [[int, ...(_ | string)]])

_s: string
_lists: [[..._lists[0]]]
_growing: {
	value?: int
	next?: _growing & {extra?: int}
}
#WrapsGrowing: _growing

-- datatest/tests.cue --
package datatest

notCall: {
	data: notCall: "b"
	error: false
}

notReference: {
	data: notReference: "b"
	error: false
}

notValidator: {
	data: notValidator: "b"
	error: false
}

notStringBound: {
	data: notStringBound: "c"
	error: false
}

notFloat: {
	data: notFloat: 1
	error: false
}

notLayout: {
	data: notLayout: "b"
	error: false
}

oneOfCall: {
	data: oneOfCall: "b"
	error: false
}

ifCall: {
	data: ifCall: "b"
	error: false
}

notList: {
	data: notList: [0, 2]
	error: false
}

maxContainsCall: {
	data: maxContainsCall: ["b", "c"]
	error: false
}

notBytes: {
	data: notBytes: "a"
	error: false
}

notCount: {
	data: notCount: "a"
	error: false
}

notCycle: {
	data: notCycle: [[1]]
	error: false
}

notRecursive: {
	data: notRecursive: {next: {next: {other: 1}}}
	error: false
}

notPattern: {
	data: notPattern: {a: "x"}
	error: false
}

badNotListTopDisjunction: {
	data: notListTopDisjunction: [1, "a"]
	error: true
}

badNotNotNull: {
	data: notNotNull: "a"
	error: true
}

badNotTop: {
	data: notTop: 1
	error: true
}
-- out/generate-v3/schema --
{
	$schema: "https://json-schema.org/draft/2020-12/schema"
	$defs: {
		IPv4: true
		P:    true
		WrapsGrowing: {
			type:                 "object"
			additionalProperties: false
			properties: {
				next: {
					type:                 "object"
					additionalProperties: false
					properties: {
						extra: type: "integer"
						next: {
							type: "object"
							properties: extra: type: "integer"
							$ref: "#/$defs/_growing"
						}
						value: type: "integer"
					}
				}
				value: type: "integer"
			}
		}
		"_growing": {
			type: "object"
			properties: {
				next: {
					type: "object"
					properties: extra: type: "integer"
					$ref: "#/$defs/_growing"
				}
				value: type: "integer"
			}
		}
	}
	type: "object"
	properties: {
		ifCall: {}
		maxContainsCall: {
			type:        "array"
			contains:    true
			minContains: 0
		}
		notBoundReference: {}
		notBytes:          {}
		notCall:           {}
		notCount:          {}
		notCycle:          {}
		notFloat:          {}
		notLayout:         {}
		notList:           {}
		notListRest:       {}
		notListTopDisjunction: not: {
			type: "array"
			items: anyOf: [true, {type: "string"}]
			prefixItems: [{type: "integer"}]
			minItems:    1
		}
		notNotEqualReference: {}
		notNotNull: not: not: const: null
		notPattern:     {}
		notRecursive:   {}
		notReference:   {}
		notStringBound: {}
		notTop: not: true
		notValidator: {}
		oneOfCall: anyOf: [true, {const: "b"}]
	}
}
