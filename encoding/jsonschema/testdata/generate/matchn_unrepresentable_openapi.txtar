#version: openapi

A constraint which the dialect leaves out also makes the schema an
approximation, which cannot be negated. Patterns which the schema can
only describe as admitting any value keep a definition open, also when
several of them join.

-- test.cue --
package test

import (
	"list"
	"strings"
)

notPatternProperties?: matchN(0, [{[=~"^a"]: int}])
notContains?: matchN(0, [[...int] & list.MatchN(>=1, int)])
notIf?: matchN(0, [matchIf(int, >0, _)])

#F: float
oneOfNull?: matchN(1, [#F, null])
oneOfUnionNull?: matchN(1, [float | string, null])

#Joined: {
	a?: string
	[string]: strings.HasPrefix("a")
	[=~""]:   strings.HasSuffix("z")
}
joined?: #Joined

-- datatest/tests.cue --
package datatest

joined: {
	data: joined: {b: "az"}
	error: false
}

// The schemas negate approximations, so they reject the data.
notPatternProperties: {
	data: notPatternProperties: {a: "x"}
	error: true
}

notContains: {
	data: notContains: []
	error: true
}

notIf: {
	data: notIf: -1
	error: true
}
-- out/generate-v3/schema --
{
	components: schemas: {
		F: type: "number"
		Joined: {
			type:                 "object"
			additionalProperties: true
			properties: a: type: "string"
		}
	}
	type: "object"
	properties: {
		joined: $ref: "#/components/schemas/Joined"
		notContains: not: {
			type: "array"
			items: type: "integer"
		}
		notIf: not: {}
		notPatternProperties: not: type: "object"
		oneOfNull: oneOf:      [{$ref: "#/components/schemas/F"}, {enum: [null]}]
		oneOfUnionNull: oneOf: [{anyOf: [{type: "number"}, {type: "string"}]}, {enum: [null]}]
	}
}
-- out/generate-v3/notPatternProperties --
notPatternProperties.data.notPatternProperties: invalid value {a:"x"} (does not satisfy matchN): 1 matched, expected 0:
    1:330
    ./datatest/tests.cue:10:30
-- out/generate-v3/joined --
-- out/generate-v3/notContains --
notContains.data.notContains: invalid value [] (does not satisfy matchN): 1 matched, expected 0:
    1:236
    ./datatest/tests.cue:15:21
-- out/generate-v3/notIf --
notIf.data.notIf: invalid value -1 (does not satisfy matchN): 1 matched, expected 0:
    1:296
    ./datatest/tests.cue:20:15
