#version: openapi

A constraint which the dialect leaves out also makes the schema an
approximation, which cannot be negated. A constraint which cannot be
expressed is an empty schema, as the dialect has no boolean ones. Patterns
which the schema can only describe as admitting any value keep a definition
open, also when several of them join.

-- test.cue --
package test

import (
	"list"
	"strings"
)

call?: strings.HasPrefix("a")
notPatternProperties?: matchN(0, [{[=~"^a"]: int}])
notContains?: matchN(0, [[...int] & list.MatchN(>=1, int)])
notIf?: matchN(0, [matchIf(int, >0, _)])

#F: float
oneOfNull?: matchN(1, [#F, null])
oneOfUnionNull?: matchN(1, [float | string, null])

#Joined: {
	a?: string
	[string]: strings.HasPrefix("a")
	[=~""]:   strings.HasSuffix("z")
}
joined?: #Joined

-- datatest/tests.cue --
package datatest

joined: {
	data: joined: {b: "az"}
	error: false
}

notPatternProperties: {
	data: notPatternProperties: {a: "x"}
	error: false
}

notContains: {
	data: notContains: []
	error: false
}

notIf: {
	data: notIf: -1
	error: false
}
-- out/generate-v3/schema --
{
	components: schemas: {
		F: type: "number"
		Joined: {
			type:                 "object"
			additionalProperties: {}
			properties: a: type: "string"
		}
	}
	type: "object"
	properties: {
		call: {}
		joined: $ref: "#/components/schemas/Joined"
		notContains:          {}
		notIf:                {}
		notPatternProperties: {}
		oneOfNull: anyOf:      [{$ref: "#/components/schemas/F"}, {enum: [null]}]
		oneOfUnionNull: anyOf: [{anyOf: [{type: "number"}, {type: "string"}]}, {enum: [null]}]
	}
}
-- out/generate-v3/notPatternProperties --
-- out/generate-v3/joined --
-- out/generate-v3/notContains --
-- out/generate-v3/notIf --
