-- test.cue --
package test

t01?: =~"^foo"
t02?: !~"bar"
t03?: ==1
t04?: !=1
t05?: >5
t06?: >=5
t07?: <10
t08?: <=10
t09?: >"foo" // Not supported
t10?: <"bar" // Not supported
t11?: int64
t12?: uint64
t13?: <1.00000000000000000001
-- datatest/tests.cue --
package datatest

ok1: data: {
	t01: "foobar"
	t02: "bam"
	t03: 1
	t04: 2
	t05: 5.1
	t06: 5
	t07: 9.9
	t08: 10
	t09: "foob"
	t10: "bap"
}

ok2: data: {}

