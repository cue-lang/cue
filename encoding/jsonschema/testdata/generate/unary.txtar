	// because `{not: {const: 1}}` translates to `matchN(0, [1])`
	// but 1 does not unify with 1.0 in CUE.
	// See https://cuelang.org/issue/4121
	//error: true
}
errorEqual2: {
	data: t04: 1
	error: true
}
errorNotGreater: {
	data: t05: 5
	error: true
}
errorNotGreaterEqual: {
	data: t06: 4.99
	error: true
}
errorNotLess: {
	data: t07: 10
	error: true
}
errorNotLessEqual: {
	data: t08: 10.001
	error: true
}

// Bounds are kept exact rather than rounded to a float64.
okExactBounds: data: {
	t11: 9223372036854775807
	t12: 18446744073709551615
}
okExactDecimalBound: data: t13: 1
errorAboveInt64: {
	data: t11: 9223372036854775808
	error: true
}
errorBelowInt64: {
	data: t11: -9223372036854775809
	error: true
}
errorAboveUint64: {
	data: t12: 18446744073709551616
	error: true
}

