An allOf member which only restricts the type adds no subschema to the
matchN validator, so it should not count towards the number of
subschemas which must match. It does, so no value is valid.

-- schema.json --
{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "allOf": [
        {"type": "string"},
        {"minLength": 1},
        {"maxLength": 5}
    ]
}
-- test/err-valid.json --
"abc"
-- test/err-empty.json --
""
-- test/err-number.json --
5
-- out/decode/extract --
import "strings"

@jsonschema(schema="https://json-schema.org/draft/2020-12/schema")

matchN(3, [strings.MinRunes(1), strings.MaxRunes(5)])
-- out/decode/testerr/err-empty --
invalid value "" (does not satisfy matchN): 1 matched, expected 3:
    generated.cue:5:1
    generated.cue:1:1
    generated.cue:5:8
    test/err-empty.json:1:1
invalid value "" (does not satisfy strings.MinRunes(1)):
    generated.cue:5:12
    generated.cue:1:1
    generated.cue:5:1
    generated.cue:5:29
    test/err-empty.json:1:1
-- out/decode/testerr/err-number --
conflicting values 5 and strings.MaxRunes(5) (mismatched types int and string):
    generated.cue:5:1
    generated.cue:5:33
    test/err-number.json:1:1
conflicting values 5 and strings.MinRunes(1) (mismatched types int and string):
    generated.cue:5:1
    generated.cue:5:12
    test/err-number.json:1:1
invalid value 5 (does not satisfy matchN): 0 matched, expected 3:
    generated.cue:5:1
    generated.cue:1:1
    generated.cue:5:8
    test/err-number.json:1:1
-- out/decode/testerr/err-valid --
invalid value "abc" (does not satisfy matchN): 2 matched, expected 3:
    generated.cue:5:1
    generated.cue:1:1
    generated.cue:5:8
    test/err-valid.json:1:1
