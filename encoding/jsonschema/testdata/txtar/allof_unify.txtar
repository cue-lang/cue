# Each subschema of "allOf" is a separate validator, so the fields and
# documentation of the subschemas are only reachable through it.

-- schema.json --
{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "a": {
            "type": "object",
            "properties": {
                "x": {
                    "type": "string",
                    "description": "The x field."
                }
            }
        },
        "b": {
            "type": "object",
            "properties": {
                "y": {
                    "type": "string",
                    "description": "The y field."
                }
            }
        },
        "withDefault": {
            "type": "object",
            "properties": {
                "d": {
                    "type": "integer",
                    "default": 1
                }
            }
        },
        "closed": {
            "type": "object",
            "properties": {
                "c": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "bundled": {
            "$id": "https://example.com/bundled",
            "type": "object",
            "properties": {
                "z": {
                    "type": "boolean"
                }
            }
        }
    },
    "type": "object",
    "allOf": [
        {
            "$ref": "#/$defs/a"
        },
        {
            "$ref": "#/$defs/b"
        }
    ],
    "properties": {
        "defaults": {
            "allOf": [
                {
                    "$ref": "#/$defs/a"
                },
                {
                    "$ref": "#/$defs/withDefault"
                }
            ]
        },
        "closed": {
            "allOf": [
                {
                    "$ref": "#/$defs/a"
                },
                {
                    "$ref": "#/$defs/closed"
                }
            ]
        },
        "bundled": {
            "allOf": [
                {
                    "$ref": "#/$defs/a"
                },
                {
                    "$ref": "https://example.com/bundled"
                }
            ]
        },
        "closedAnyOf": {
            "allOf": [
                {
                    "$ref": "#/$defs/a"
                },
                {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/closed"
                        }
                    ]
                }
            ]
        },
        "closedHolder": {
            "allOf": [
                {
                    "$ref": "#/$defs/a"
                },
                {
                    "$ref": "#/$defs/b"
                }
            ],
            "properties": {
                "own": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        }
    },
    "unevaluatedProperties": false
}
-- test/ok.json --
{
    "x": "a",
    "y": "b",
    "defaults": {
        "x": "a",
        "d": 2
    },
    "closed": {
        "c": "s"
    },
    "bundled": {
        "x": "a",
        "z": true
    },
    "closedAnyOf": {
        "c": "s"
    },
    "closedHolder": {
        "own": "s"
    }
}
-- test/err-x.json --
{
    "x": 5
}
-- test/err-unevaluated.json --
{
    "z": 1
}
-- test/err-default.json --
{
    "defaults": {
        "d": "s"
    }
}
-- test/err-closed.json --
{
    "closed": {
        "x": "a"
    }
}
-- test/err-closed-anyof.json --
{
    "closedAnyOf": {
        "x": "a"
    }
}
-- test/err-closed-holder.json --
{
    "closedHolder": {
        "x": "a"
    }
}
-- test/err-bundled.json --
{
    "bundled": {
        "z": 1
    }
}
-- out/decode/extract --
@jsonschema(schema="https://json-schema.org/draft/2020-12/schema")

matchN(2, [#a, #b]) & close({
	defaults?:     matchN(2, [#a, #withDefault])
	closed?:       matchN(2, [#a, #closed])
	bundled?:      matchN(2, [#a, #bundled & {...}])
	closedAnyOf?:  matchN(2, [#a, #closed & {...}])
	closedHolder?: matchN(2, [#a, #b]) & close({own?: string})
	x?:            _
	y?:            _
})

#a: {
	// The x field.
	x?: string
	...
}

#b: {
	// The y field.
	y?: string
	...
}

#bundled: {
	@jsonschema(id="https://example.com/bundled")
	z?: bool
	...
}

#closed: close({c?: string})

#withDefault: {
	d?: int
	...
}
