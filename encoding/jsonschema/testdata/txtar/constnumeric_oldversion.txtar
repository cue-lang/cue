# Extracting into a module below language version v0.15.0 must spell the
# numeric equality as a pair of bounds, as unary == does not parse there.
# Compare constnumeric.txtar, which targets the current version.

#targetLanguageVersion: v0.14.0

-- schema.json --
{
    "type": "object",
    "properties": {
        "i": {"const": 1},
        "f": {"const": -2.0},
        "l": {"enum": [[1]]}
    }
}

-- out/decode/extract --
i?: >=1 & <=1
f?: >=-2.0 & <=-2.0
l?: [>=1 & <=1]
...
-- out/decode/testerr/err-value --
i: invalid value 2 (out of bound <=1):
    generated.cue:1:11
    test/err-value.json:1:7
-- test/exact.json --
{"i": 1, "f": -2.0, "l": [1]}
-- test/crossed.json --
{"i": 1.0, "f": -2, "l": [1.0]}
-- test/err-value.json --
{"i": 2}
