# Extracting into a module below language version v0.15.0, where unary ==
# does not parse. Compare constnumeric.txtar, which targets the current
# version.

# TODO the numbers should compare by value here too; the extracted schema
# uses the const value directly, so err-crossed cannot be named crossed.

#targetLanguageVersion: v0.14.0

-- schema.json --
{
    "type": "object",
    "properties": {
        "i": {"const": 1},
        "f": {"const": -2.0},
        "l": {"enum": [[1]]}
    }
}

-- out/decode/extract --
i?: 1
f?: -2.0
l?: [1]
...
-- out/decode/testerr/err-crossed --
i: conflicting values 1 and 1.0 (mismatched types int and float):
    generated.cue:1:5
    test/err-crossed.json:1:7
-- out/decode/testerr/err-value --
i: conflicting values 2 and 1:
    generated.cue:1:5
    test/err-value.json:1:7
-- test/exact.json --
{"i": 1, "f": -2.0, "l": [1]}
-- test/err-crossed.json --
{"i": 1.0, "f": -2, "l": [1.0]}
-- test/err-value.json --
{"i": 2}
