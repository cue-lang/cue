# Extracting into a module below language version v0.14.0 must write a schema
# which nothing satisfies as bottom, as the error builtin does not exist there.
# Compare boolschema.txtar, which targets the current version.

#targetLanguageVersion: v0.13.0

-- schema.json --
{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"never": false,
		"either": {"anyOf": [{"type": "string"}, false]},
		"tuple": {
			"type": "array",
			"items": [{"type": "string"}],
			"additionalItems": false
		}
	}
}
-- test/ok.json --
{"either": "a", "tuple": ["a"]}
-- test/err-never.json --
{"never": 1}
-- test/err-either.json --
{"either": 1}
-- test/err-tuple.json --
{"tuple": ["a", "b"]}
-- out/decode-v3/extract --
import "list"

@jsonschema(schema="http://json-schema.org/draft-07/schema#")
never?:  _|_
either?: matchN(>=1, [string, _|_])
tuple?: {
	[...]
	[0]: string
} & list.MaxItems(1)
...
