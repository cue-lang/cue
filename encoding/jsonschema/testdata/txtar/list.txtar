-- schema.yaml --
$schema: http://json-schema.org/draft-07/schema#
type: object

properties:
  foo:
    type: array
    items:
      type: string

  tuple:
    type: array
    items:
      - type: string
      - type: integer
      - const: 2

  has:
    type: array
    contains:
      const: 3

  too:
    type: array
    contains:
      type: string

  size:
    type: array
    minItems: 3
    maxItems: 9
    uniqueItems: true

  additional:
    type: array
    items:
      - type: integer
      - type: integer
    additionalItems:
      type: string

  # The instance may be shorter than the tuple, so the positional
  # schemas cannot be expressed as a CUE list literal.
  closedTuple:
    type: array
    items:
      - type: integer
      - type: integer
    additionalItems: false

  # All the tuple elements are guaranteed to be present, so a
  # regular CUE list literal will do.
  requiredTuple:
    type: array
    minItems: 2
    items:
      - type: integer
      - type: integer

  # More elements are required than the tuple holds.
  overRequiredTuple:
    type: array
    minItems: 3
    items:
      - type: integer
      - type: integer

  # Only some of the tuple elements are guaranteed to be present.
  partialTuple:
    type: array
    minItems: 1
    items:
      - type: integer
      - type: integer
      - type: integer

  # The elements beyond the guaranteed ones are constrained too.
  partialTupleTail:
    type: array
    minItems: 1
    items:
      - type: integer
      - type: integer
    additionalItems:
      type: string

  # The tuple is closed, but only its first element is guaranteed.
  closedPartialTuple:
    type: array
    minItems: 1
    items:
      - type: integer
      - type: integer
    additionalItems: false

  # A large minItems must not expand into a list of that many elements.
  bigMinItems:
    type: array
    minItems: 10000

additionalProperties: false

-- out/decode/extract --
import "list"

@jsonschema(schema="http://json-schema.org/draft-07/schema#")

close({
	foo?: [...string]
	tuple?: {
		[...]
		[0]: string
		[1]: int
		[2]: ==2
	}
	has?:  list.MatchN(>=1, ==3)
	too?:  list.MatchN(>=1, string)
	size?: list.MinItems(3) & list.MaxItems(9) & list.UniqueItems()
	additional?: {
		[...]
		[0]:   int
		[1]:   int
		[>=2]: string
	}
	closedTuple?: {
		[...]
		[0]: int
		[1]: int
	} & list.MaxItems(2)
	requiredTuple?:     [int, int, ...]
	overRequiredTuple?: list.MinItems(3) & [int, int, ...]
	partialTuple?: {
		[int, ...]
		[1]: int
		[2]: int
	}
	partialTupleTail?: {
		[int, ...]
		[1]:   int
		[>=2]: string
	}
	closedPartialTuple?: {
		[int, ...]
		[1]: int
	} & list.MaxItems(2)
	bigMinItems?: list.MinItems(10000)
})
