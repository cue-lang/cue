OpenAPI's "nullable" allows null only when it is true.

#version: openapi

-- schema.yaml --
components:
  schemas:
    NotNullable:
      type: string
      nullable: false
    Nullable:
      type: string
      nullable: true
-- test/ok-not-nullable.json --
#schema #NotNullable
"foo"
-- test/err-not-nullable-null.json --
#schema #NotNullable
null
-- test/ok-nullable-null.json --
#schema #Nullable
null
-- out/decode/extract --
#NotNullable: string

#Nullable: null | string
-- out/decode/testerr/err-not-nullable-null --
#NotNullable: conflicting values string and null (mismatched types string and null):
    generated.cue:1:15
    test/err-not-nullable-null.json:2:1
