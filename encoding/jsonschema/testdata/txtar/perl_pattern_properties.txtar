# A "patternProperties" regexp which cannot be expressed is dropped
# without #strictFeatures, leaving no way to tell its properties from
# the rest. Neither "additionalProperties" nor "unevaluatedProperties"
# may then constrain the rest, or valid instances would be rejected.

-- schema.json --
{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "additional": {
            "type": "object",
            "patternProperties": {
                "^(?!x)": {}
            },
            "additionalProperties": false
        },
        "additionalSchema": {
            "type": "object",
            "patternProperties": {
                "^(?!x)": {}
            },
            "additionalProperties": {
                "$id": "https://example.com/value",
                "type": "string"
            }
        },
        "value": {
            "$ref": "https://example.com/value"
        },
        "unevaluated": {
            "type": "object",
            "allOf": [
                {
                    "properties": {
                        "a": {
                            "type": "string"
                        }
                    }
                }
            ],
            "patternProperties": {
                "^(?!x)": {}
            },
            "unevaluatedProperties": false
        }
    }
}
-- test/lookahead.json --
{
    "additional": {
        "foo": 1
    },
    "additionalSchema": {
        "foo": 1
    },
    "value": "foo",
    "unevaluated": {
        "foo": 1
    }
}
-- out/decode/extract --
@jsonschema(schema="https://json-schema.org/draft/2020-12/schema")
additional?:       {...}
additionalSchema?: {...}
value?:            _#defs."/properties/additionalSchema/additionalProperties"
unevaluated?: {
	a?: string
	...
} & {...}

_#defs: "/properties/additionalSchema/additionalProperties": {
	@jsonschema(id="https://example.com/value")
	string
}
...
