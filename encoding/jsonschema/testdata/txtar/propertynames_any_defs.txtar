# An unconstrained propertyNames schema is extracted
# as a trailing `...`, placed after the definitions.

-- schema.json --
{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "propertyNames": {"type": "string"},
    "$defs": {
        "a": {
            "type": "integer"
        }
    }
}
-- out/decode/extract --
@jsonschema(schema="https://json-schema.org/draft/2020-12/schema")

#a: int
...
