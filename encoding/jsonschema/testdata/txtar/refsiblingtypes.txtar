// A "$ref" restricts the types allowed by the schema containing it,
// just like the subschema it refers to would when written inline.
// Object keywords next to such a reference therefore add no disjunction
// over the other types.
//
// The output is wrong: unlike allOfInline, the object keywords next to
// each reference allow every other type, which adds a disjunct for each
// of them to the errors for allOfRefs.

-- schema.json --
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "allOfRef": {
      "allOf": [{"$ref": "#/$defs/a"}],
      "properties": {"y": {"type": "string"}}
    },
    "allOfInline": {
      "allOf": [{"type": "object", "properties": {"x": {"type": "string"}}}],
      "properties": {"y": {"type": "string"}}
    },
    "directRef": {
      "$ref": "#/$defs/a",
      "properties": {"y": {"type": "string"}}
    },
    "allOfRefs": {
      "allOf": [{"$ref": "#/$defs/a"}, {"$ref": "#/$defs/b"}],
      "properties": {"y": {"type": "string"}}
    },
    "aliasRef": {
      "allOf": [{"$ref": "#/$defs/alias"}],
      "properties": {"y": {"type": "string"}}
    }
  },
  "$defs": {
    "a": {"type": "object", "properties": {"x": {"type": "string"}}},
    "b": {"type": "object", "properties": {"z": {"type": "integer"}}},
    "alias": {"$ref": "#/$defs/a"}
  }
}
-- test/ok.json --
{
  "allOfRef": {"x": "a", "y": "b"},
  "allOfInline": {"x": "a", "y": "b"},
  "directRef": {"x": "a", "y": "b"},
  "allOfRefs": {"x": "a", "y": "b", "z": 1},
  "aliasRef": {"x": "a", "y": "b"}
}
-- test/err-allofref.json --
{"allOfRef": "foo"}
-- test/err-allofrefs.json --
{"allOfRefs": {"y": 1}}
-- test/err-directref.json --
{"directRef": 1}
-- out/decode/extract --
@jsonschema(schema="https://json-schema.org/draft/2020-12/schema")
allOfRef?: #a &
(null | bool | number | string | [...] | {
	y?: string
	...
})
allOfInline?: {
	x?: string
	...
} & {
	y?: string
	...
}
directRef?: #a &
(null | bool | number | string | [...] | {
	y?: string
	...
})
allOfRefs?: matchN(2, [#a, #b]) &
(null | bool | number | string | [...] | {
	y?: string
	...
})
aliasRef?: #alias &
(null | bool | number | string | [...] | {
	y?: string
	...
})

#a: {
	x?: string
	...
}

#alias: #a

#b: {
	z?: int
	...
}
...
