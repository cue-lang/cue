Like refsiblingtypes, but with OpenAPI's "nullable", which allows null
only when it is true.

The object keywords next to each reference only allow null as well when
the referenced schema is nullable.

#version: openapi

-- schema.yaml --
components:
  schemas:
    NotNullable:
      type: object
      nullable: false
      properties:
        x:
          type: string
    Nullable:
      type: object
      nullable: true
      properties:
        x:
          type: string
    RefNotNullable:
      allOf:
      - $ref: "#/components/schemas/NotNullable"
      properties:
        y:
          type: string
    RefNullable:
      allOf:
      - $ref: "#/components/schemas/Nullable"
      properties:
        y:
          type: string
-- out/decode/extract --
#NotNullable: {
	x?: string
	...
}

#Nullable: null | {
	x?: string
	...
}

#RefNotNullable: #NotNullable & {
	y?: string
	...
}

#RefNullable: #Nullable &
(null | {
	y?: string
	...
})
