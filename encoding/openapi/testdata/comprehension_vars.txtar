# References to a comprehension's loop variables are generated in place.
# See https://cuelang.org/issue/4586
-- in.cue --
#B: {
	for k, v in {a: "x"} {
		(k): v
	}
}
-- out/TestGenerateOpenAPI/out.json --
{
   "openapi": "3.0.0",
   "info": {
      "title": "Generated by cue.",
      "version": "no version"
   },
   "paths": {},
   "components": {
      "schemas": {
         "B": {
            "type": "object",
            "required": [
               "a"
            ],
            "properties": {
               "a": {
                  "type": "string",
                  "enum": [
                     "x"
                  ]
               }
            }
         }
      }
   }
}
