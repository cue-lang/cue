# The old encoder with expanded references, as reported in the issue.
# See https://cuelang.org/issue/4305
#ExpandReferences
-- in.cue --
#Bounded:         *20 | int & >=1 & <=100
#TrailingDefault: int & >=1 | *5
-- out/TestGenerateOpenAPI-v3/out.json --
{
   "openapi": "3.0.0",
   "info": {
      "title": "Generated by cue.",
      "version": "no version"
   },
   "paths": {},
   "components": {
      "schemas": {
         "Bounded": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
         },
         "TrailingDefault": {
            "type": "integer",
            "minimum": 1,
            "default": 5
         }
      }
   }
}
