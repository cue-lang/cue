# A default subsumed by a referenced definition leaves a reference to that
# definition, which the old encoder emits as a $ref.
# See https://cuelang.org/issue/4305
-- in.cue --
#Port:    {port: int}
#Default: *{port: 1} | #Port
-- out/TestGenerateOpenAPI-v3/out.json --
{
   "openapi": "3.0.0",
   "info": {
      "title": "Generated by cue.",
      "version": "no version"
   },
   "paths": {},
   "components": {
      "schemas": {
         "Default": {
            "$ref": "#/components/schemas/Port"
         },
         "Port": {
            "type": "object",
            "required": [
               "port"
            ],
            "properties": {
               "port": {
                  "type": "integer"
               }
            }
         }
      }
   }
}
