# A default subsumed by a definition imported from another package: the old
# encoder emits a $ref and generates the imported definition as a component.
# See https://cuelang.org/issue/4305
-- cue.mod/module.cue --
module: "mod.test"
language: version: "v0.14.0"
-- lib/lib.cue --
package lib

#Port: {port: int}
-- in.cue --
package p

import "mod.test/lib"

#Default: *{port: 1} | lib.#Port
-- out/TestGenerateOpenAPI-v3/out.json --
{
   "openapi": "3.0.0",
   "info": {
      "title": "Generated by cue.",
      "version": "no version"
   },
   "paths": {},
   "components": {
      "schemas": {
         "Default": {
            "$ref": "#/components/schemas/Port"
         },
         "Port": {
            "type": "object",
            "required": [
               "port"
            ],
            "properties": {
               "port": {
                  "type": "integer"
               }
            }
         }
      }
   }
}
-- out/TestGenerateOpenAPI-v3-noshare/out.json --
{
   "openapi": "3.0.0",
   "info": {
      "title": "Generated by cue.",
      "version": "no version"
   },
   "paths": {},
   "components": {
      "schemas": {
         "Default": {
            "$ref": "#/components/schemas/Port"
         },
         "Port": {
            "type": "object",
            "required": [
               "port"
            ],
            "properties": {
               "port": {
                  "type": "integer"
               }
            }
         }
      }
   }
}
