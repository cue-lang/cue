# A default subsumed by a referenced definition whose name NameFunc
# suppresses: the old encoder inlines the referenced definition.
# See https://cuelang.org/issue/4305
#NameFunc: excludeExcluded
-- in.cue --
#ExcludedPort: {port: int}
#Default:      *{port: 1} | #ExcludedPort
-- out/TestGenerateOpenAPI-v3/out.json --
{
   "openapi": "3.0.0",
   "info": {
      "title": "Generated by cue.",
      "version": "no version"
   },
   "paths": {},
   "components": {
      "schemas": {
         "Default": {
            "type": "object",
            "required": [
               "port"
            ],
            "properties": {
               "port": {
                  "type": "integer"
               }
            },
            "default": {
               "port": 1
            }
         }
      }
   }
}
