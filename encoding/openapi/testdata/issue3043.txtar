{
   "openapi": "3.0.0",
   "info": {
      "title": "Generated by cue.",
      "version": "no version"
   },
   "paths": {},
   "components": {
      "schemas": {
         "a": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1,
            "default": ","
         },
         "def": {
            "type": "object",
            "required": [
               "a",
               "b"
            ],
            "properties": {
               "a": {
                  "type": "integer",
                  "minimum": -9223372036854775808,
                  "maximum": 9223372036854775807,
                  "default": 100
               },
               "b": {
                  "type": "integer",
                  "format": "int64"
               }
            }
         }
      }
   }
}
