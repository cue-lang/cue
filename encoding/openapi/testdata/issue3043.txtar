# Conjunctions behind a default, with the old encoder expanding references.
# Note that a default drops the int64 format in favor of explicit bounds.
# See https://cuelang.org/issue/3043 and https://cuelang.org/issue/4169
#ExpandReferences
-- in.cue --
import "strings"

#a: strings.MinRunes(1) & strings.MaxRunes(1) | *","

#def: {
	a: *100 | int64
	b: int64
}
