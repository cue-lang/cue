# A default list value whose element type is a definition must not turn the
# field into a oneOf. The default is subsumed by the other disjunct, so it is
# reported as "default" alongside a single schema.
# Issue: https://cuelang.org/issue/4156
-- in.cue --
#Vehicle: "car" | "bike" | "bus"

#Owner: {
	vehicles: [...#Vehicle] | *["car"]
}
-- out/TestGenerateOpenAPI/out.json --
{
   "openapi": "3.0.0",
   "info": {
      "title": "Generated by cue.",
      "version": "no version"
   },
   "paths": {},
   "components": {
      "schemas": {
         "Owner": {
            "type": "object",
            "required": [
               "vehicles"
            ],
            "properties": {
               "vehicles": {
                  "type": "array",
                  "items": {
                     "$ref": "#/components/schemas/Vehicle"
                  },
                  "default": [
                     "car"
                  ]
               }
            }
         },
         "Vehicle": {
            "type": "string",
            "enum": [
               "car",
               "bike",
               "bus"
            ]
         }
      }
   }
}
