# A default list value whose element type is a definition must not turn the
# field into a oneOf. The default is subsumed by the other disjunct, so it is
# reported as "default" alongside a single schema.
# Issue: https://cuelang.org/issue/4156
#
# The golden output below is wrong: the field is exported as a oneOf of the
# two disjuncts, with the non-default one excluding the default. The result is
# not valid OpenAPI, so extracting it back fails.
#ExpectExtractError: .*the value of "items" must be an object or a boolean.*
-- in.cue --
#Vehicle: "car" | "bike" | "bus"

#Owner: {
	vehicles: [...#Vehicle] | *["car"]
}
-- out/TestGenerateOpenAPI/out.json --
{
   "openapi": "3.0.0",
   "info": {
      "title": "Generated by cue.",
      "version": "no version"
   },
   "paths": {},
   "components": {
      "schemas": {
         "Owner": {
            "type": "object",
            "required": [
               "vehicles"
            ],
            "properties": {
               "vehicles": {
                  "type": "array",
                  "default": [
                     "car"
                  ],
                  "oneOf": [
                     {
                        "items": [
                           {
                              "type": "string",
                              "enum": [
                                 "car"
                              ]
                           }
                        ]
                     },
                     {
                        "allOf": [
                           {
                              "items": {
                                 "$ref": "#/components/schemas/Vehicle"
                              }
                           },
                           {
                              "not": {
                                 "anyOf": [
                                    {
                                       "items": [
                                          {
                                             "type": "string",
                                             "enum": [
                                                "car"
                                             ]
                                          }
                                       ]
                                    }
                                 ]
                              }
                           }
                        ]
                     }
                  ]
               }
            }
         },
         "Vehicle": {
            "type": "string",
            "enum": [
               "car",
               "bike",
               "bus"
            ]
         }
      }
   }
}
