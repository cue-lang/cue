# Tests that bare schemas generate an OpenAPI 3.1 document when the version is
# configured.
#v2
#Version: 3.1
-- in.cue --
#N: {v: string | null}
-- out/TestGenerateOpenAPI-v3/out.json --
{
   "openapi": "3.1.0",
   "info": {
      "title": "Generated by cue.",
      "version": "no version"
   },
   "paths": {},
   "components": {
      "schemas": {
         "N": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
               "v": {
                  "anyOf": [
                     {
                        "type": "string"
                     },
                     {
                        "type": "null"
                     }
                  ]
               }
            },
            "required": [
               "v"
            ]
         }
      }
   }
}
-- out/TestGenerateOpenAPI-v3-noshare/out.json --
{
   "openapi": "3.1.0",
   "info": {
      "title": "Generated by cue.",
      "version": "no version"
   },
   "paths": {},
   "components": {
      "schemas": {
         "N": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
               "v": {
                  "anyOf": [
                     {
                        "type": "string"
                     },
                     {
                        "type": "null"
                     }
                  ]
               }
            },
            "required": [
               "v"
            ]
         }
      }
   }
}
