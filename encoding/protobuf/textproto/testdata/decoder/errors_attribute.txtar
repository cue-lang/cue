# A protobuf attribute without a type fails the first Parse, but a second
# Parse with the same Decoder silently drops field b. The message fields
# come first, so their mappings are built before the error.
-- errors.cue --
list?: [...#Pair] @protobuf(1,Pair)
map?: {[string]: #Pair} @protobuf(2,map[string]Pair)
a?: int @protobuf(3,int32)
b?: int @protobuf(4)

#Pair: {
	key?:   string @protobuf(1,string)
	value?: string @protobuf(2,string)
}
-- input.textproto --
list: {key: "k1" value: "v1"}
a: 1
b: 2
-- out/decode --
textproto: field does not exist
-- out/decode/reparse --
list: [{
	key:   "k1"
	value: "v1"
}]
a: 1
