# A map whose values have no protobuf type, where the value has a comment.
# The decoder panics rather than reporting an error.
-- errors.cue --
m?: {[string]: string | int} @protobuf(1,map[string]string)
-- input.textproto --
m: {key: "x" value: 1 # foo
}
-- out/decode --
panic: runtime error: invalid memory address or nil pointer dereference
