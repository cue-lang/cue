# Test that the cue plugin serves modules from a _registry directory via
# CUE_REGISTRY, so that the user's own cue (run with exec) can resolve a
# module dependency from it.
plugin cue

exec cue export .
cmp stdout want.txt

-- cue.mod/module.cue --
module: "example.com/main@v0"
language: version: "v0.17.0"
deps: {
	"example.com/dep@v0": {
		v: "v0.1.0"
	}
}
-- main.cue --
package main

import "example.com/dep@v0:dep"

out: dep.value
-- _registry/example.com_dep_v0.1.0/cue.mod/module.cue --
module: "example.com/dep@v0"
language: version: "v0.9.0"
-- _registry/example.com_dep_v0.1.0/dep.cue --
package dep

value: "hello from dep"
-- want.txt --
{
    "out": "hello from dep"
}
