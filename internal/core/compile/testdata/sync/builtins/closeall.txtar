-- in.cue --
// Basic usage of __closeAll - makes structs recursively closed
a: __closeAll({
	field1: 1
	nested: {
		field2: "hello"
	}
})

// Test that extra fields are not allowed (should error)
b: {
	err: a & {extra: "not allowed"}
}

// Test that nested extra fields are not allowed (should error)
c: {
	err: a & {
		field1: 1
		nested: {
			field2: "hello"
			extra: "not allowed"
		}
	}
}

// Test with non-struct should error
d: {
	err: __closeAll("not a struct")
}

// Test with empty struct
e: __closeAll({})
f: {
	err: e & {extra: "not allowed"}  // should error
}


#A: a: int
g: {
	err: __closeAll(#A)
}

// The closing applies to each disjunct of a struct which embeds a
// disjunction.
embeddedDisjunction: {
	#A: {a: 1}
	#B: {b: 1}
	v: __closeAll({(#A | #B)..., c: 2})
	t1: v & {a: 1}
	t2: v & {d: 3}
}

// The recursive closing applies to the fields a spread brings in, whether
// the spread value is open or closed by close.
spreadClosed: {
	foo: close({b: {}})
	bar: {b: {}}
	closed: __closeAll({foo...})
	open:   __closeAll({bar...})
	t1: closed & {b: c: 1}
	t2: open & {b: c: 1}
}

// close around a __closeAll literal, as the explicitopen rewrite emits for
// a close call around a struct embedding a definition, keeps the recursive
// closing, and a comprehension in the literal reads the fields unified
// with the call. The nested call instead closes the evaluated result of
// the inner call at one level only, and evaluates the literal on its own.
closeWrapsCloseAll: {
	#D: {x: y: int}
	foo: close({b: {}})
	a: close(__closeAll({#D..., foo...}))
	t1: err: a & {x: z: 1}
	t2: err: a & {b: c: 1}
	t3: ok:  a & {x: y: 5}
	guard: close(__closeAll({#D..., k: int, if k == 1 {y: 1}})) & {k: 1}
}

// issue4535: a comprehension at the top level of the closed struct reads a
// field as unified where the call appears, as it does for close. The
// argument is instead evaluated on its own, so the guard reads a
// non-concrete field. https://cuelang.org/issue/4535
issue4535: {
	#D: {k: int, y?: int}
	s: __closeAll({#D, k: _, if k == 1 {y: 1}})
	t: s & {k: 1}
	denied: s & {k: 1, z: 2}
}
-- out/compile --
--- in.cue
{
  a: __closeAll({
    field1: 1
    nested: {
      field2: "hello"
    }
  })
  b: {
    err: (〈1;a〉 & {
      extra: "not allowed"
    })
  }
  c: {
    err: (〈1;a〉 & {
      field1: 1
      nested: {
        field2: "hello"
        extra: "not allowed"
      }
    })
  }
  d: {
    err: __closeAll("not a struct")
  }
  e: __closeAll({})
  f: {
    err: (〈1;e〉 & {
      extra: "not allowed"
    })
  }
  #A: {
    a: int
  }
  g: {
    err: __closeAll(〈1;#A〉)
  }
  embeddedDisjunction: {
    #A: {
      a: 1
    }
    #B: {
      b: 1
    }
    v: __closeAll({
      (〈1;#A〉|〈1;#B〉)...
      c: 2
    })
    t1: (〈0;v〉 & {
      a: 1
    })
    t2: (〈0;v〉 & {
      d: 3
    })
  }
  spreadClosed: {
    foo: close({
      b: {}
    })
    bar: {
      b: {}
    }
    closed: __closeAll({
      〈1;foo〉...
    })
    open: __closeAll({
      〈1;bar〉...
    })
    t1: (〈0;closed〉 & {
      b: {
        c: 1
      }
    })
    t2: (〈0;open〉 & {
      b: {
        c: 1
      }
    })
  }
  closeWrapsCloseAll: {
    #D: {
      x: {
        y: int
      }
    }
    foo: close({
      b: {}
    })
    a: close(__closeAll({
      〈1;#D〉...
      〈1;foo〉...
    }))
    t1: {
      err: (〈1;a〉 & {
        x: {
          z: 1
        }
      })
    }
    t2: {
      err: (〈1;a〉 & {
        b: {
          c: 1
        }
      })
    }
    t3: {
      ok: (〈1;a〉 & {
        x: {
          y: 5
        }
      })
    }
    guard: (close(__closeAll({
      〈1;#D〉...
      k: int
      if (〈0;k〉 == 1) {
        y: 1
      }
    })) & {
      k: 1
    })
  }
  issue4535: {
    #D: {
      k: int
      y?: int
    }
    s: __closeAll({
      〈1;#D〉
      k: _
      if (〈0;k〉 == 1) {
        y: 1
      }
    })
    t: (〈0;s〉 & {
      k: 1
    })
    denied: (〈0;s〉 & {
      k: 1
      z: 2
    })
  }
}
