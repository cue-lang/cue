            foo?: close({
              foo?: _
              allowed?: _
            })
          }
        }
      }
      foo: {
        allowed: 5
      }
    })
  }
  nestedEmbedded: {
    strict: {
      close({
        foo?: close({
          foo?: _
        })
      })
      foo: {
        allowed: 5
      }
    }
  }
  unified: {
    base: {
      x: close({
        foo?: close({
          foo?: _
        })
      })
      x: {
        foo: {
          disallowed: 5
        }
      }
    }
  }
  unified: {
    t1: {
      x: {
        close({
          foo?: close({
            foo?: _
          })
        })
      }
      x: {
        foo: {
          disallowed: 5
        }
      }
    }
  }
  unified: {
    t2: {
      x: {
        {
          close({
            foo?: close({
              foo?: _
            })
          })
        }
      }
      x: {
        foo: {
          disallowed: 5
        }
      }
    }
  }
  nestedWithSelfReference: {
    t1: {
      _schema: close({
        foo?: 〈1;_schema〉
      })
      x: {
        〈1;_schema〉
      }
      x: {
        foo: {
          disallowed: 5
        }
      }
    }
  }
  nestedWithSelfReference: {
    t2: {
      _schema: close({
        foo?: 〈1;_schema〉
      })
      x: {
        {
          〈2;_schema〉
        }
      }
      x: {
        foo: {
          disallowed: 5
        }
      }
    }
  }
  issue1206: {
    defaults: {
      parameters: close({
        name: string
        port: int
        ({
          name: "custom-port"
        }|*{
          port: 8080
          name: "default-port"
        })
      })
      custom: (〈0;parameters〉 & {
        port: 9999
      })
    }
  }
  issue1206: {
    elimination: {
      x: close({
        ({
          name: int
        }|{
          name: string
        })
      })
      y: (〈0;x〉 & {
        name: "Hello"
      })
    }
  }
}
