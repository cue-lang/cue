# isValid applied, within a definition, to a copy of that definition, where
# a builtin implemented in Go finalizes the definition from within its own
# evaluation.

-- in.cue --
@experiment(predicates)

import "reflect"

// The copy holds the call to isValid as well, and so does the copy that its
// post-check evaluates. The check is replayed in the cycle context of the
// call, which recognizes this as a cycle. Allows finalizes #A, and with it
// the copy, from within the evaluation of #A.
selfReference: {
	// zz is not allowed in #A, so the copy is not valid. That is not how the
	// answer comes about, though: a copy of #A within #A reads as a
	// structural cycle, whatever it is unified with.
	invalid: {
		#A: {
			b: 1
			c: reflect.Allows(#A, "zz")
			u: isValid(#A & {zz: 1})
		}
	}
	// So a copy that is valid is not reported as such, and the post-check
	// then finds that the answer changed.
	//
	// TODO: u should be true.
	valid: {
		#A: {
			b: 1
			c: reflect.Allows(#A, "zz")
			u: isValid(#A & {b: 1})
		}
	}
}
-- out/compile --
--- in.cue
{
  selfReference: {
    invalid: {
      #A: {
        b: 1
        c: 〈import;reflect〉.Allows(〈1;#A〉, "zz")
        u: isValid((〈1;#A〉 & {
          zz: 1
        }))
      }
    }
    valid: {
      #A: {
        b: 1
        c: 〈import;reflect〉.Allows(〈1;#A〉, "zz")
        u: isValid((〈1;#A〉 & {
          b: 1
        }))
      }
    }
  }
}
