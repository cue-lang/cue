# The postfix ... operator at the current language version, where
# explicitopen is stable. The @experiment attribute below is redundant from
# v0.18.0 on; it is kept on purpose, as a file may still carry it and it must
# be accepted and have no effect. postfixexpr.txtar covers the same operator
# on a module which opts in below v0.18.0.
-- in.cue --
@experiment(explicitopen)

#Base: {
	x: int
}

// The operator opens the embedded definition, so y is admitted.
a: #Base... & {y: int}

// Without it, the embedding closes the struct.
b: {#Base, y: int}

// Applying it to a value which is neither a struct nor a list is a no-op.
c: 1...
d: s...
s: "foo"
-- operand.cue --
// The operator applied to an operand rather than embedded or unified. The
// value it opens can be selected from, indexed, compared, interpolated, or
// passed to a call, giving the same results as the definition itself, except
// that what is reached through it stays open. The spec describes the operator
// only as an embedding; as an operand, it is read as the value with its
// closedness removed.

#Op: {
	a: 1
	b: c: 1
}

select: (#Op...).b & {d: 1}
selectClosed: #Op.b & {d: 1}
selectScalar: (#Op...).a

index: (#Op...)["b"] & {d: 1}

call: len(#Op...)

compare: (#Op...) == {a: 1, b: c: 1}
interpolate: "a=\((#Op...).a)"
-- out/compile --
--- in.cue
{
  #Base: {
    x: int
  }
  a: (〈0;#Base〉... & {
    y: int
  })
  b: {
    〈1;#Base〉
    y: int
  }
  c: 1...
  d: 〈0;s〉...
  s: "foo"
}
--- operand.cue
{
  #Op: {
    a: 1
    b: {
      c: 1
    }
  }
  select: (〈0;#Op〉....b & {
    d: 1
  })
  selectClosed: (〈0;#Op〉.b & {
    d: 1
  })
  selectScalar: 〈0;#Op〉....a
  index: (〈0;#Op〉...["b"] & {
    d: 1
  })
  call: len(〈0;#Op〉...)
  compare: (〈0;#Op〉... == {
    a: 1
    b: {
      c: 1
    }
  })
  interpolate: "a=\(〈0;#Op〉....a)"
}
