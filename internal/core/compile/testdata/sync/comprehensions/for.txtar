-- in.cue --
b: {for k, v in a {"\(k)": v + 1}}
a: {b: 1, c: 2}

x: {for k, v in y {"\(k)": v}}
y: {} // check that empty struct after reference works.

k: {for v in e {v}}
e: int

comprehensionBinds: {
	a: {for _ in [1] {a: _}}
	b: {for _, _ in [1] {a: _}}
}
-- guard.cue --
import "encoding/json"

// A guard which finalizes the struct being ranged over, dropping its
// pending arc p, must not disturb the loop over the remaining fields.
guardFinalizesSource: {
	out: [for k, _ in src if json.Marshal(src) != "" {k}]
	src: {
		a: 1
		if a > 5 {p: 1}
		b: 2
	}
}
-- out/compile --
--- guard.cue
{
  guardFinalizesSource: {
    out: [
      for k, _ in 〈1;src〉 if (〈import;"encoding/json"〉.Marshal(〈2;src〉) != "") {
        〈1;k〉
      },
    ]
    src: {
      a: 1
      if (〈0;a〉 > 5) {
        p: 1
      }
      b: 2
    }
  }
}
--- in.cue
{
  b: {
    for k, v in 〈1;a〉 {
      "\(〈1;k〉)": (〈1;v〉 + 1)
    }
  }
  a: {
    b: 1
    c: 2
  }
  x: {
    for k, v in 〈1;y〉 {
      "\(〈1;k〉)": 〈1;v〉
    }
  }
  y: {}
  k: {
    for _, v in 〈1;e〉 {
      〈1;v〉
    }
  }
  e: int
  comprehensionBinds: {
    a: {
      for _, _ in [
        1,
      ] {
        a: _
      }
    }
    b: {
      for _, _ in [
        1,
      ] {
        a: _
      }
    }
  }
}
