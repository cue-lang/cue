# An inline struct that is re-instantiated by the same expression with the
# same arguments, while the earlier instantiation is still being evaluated,
# is a structural cycle, however fresh its vertices. This is how a fixed-point
# combinator recurses when functions are written as structs: a call f(a) is
# (f & {param: a}).out. These cases must report a structural cycle.
#
# Recursion that binds a different value at each level — bounded by data, or
# guarded by a comprehension — must keep evaluating, as must nested,
# non-recursive use of one template.
# https://cuelang.org/issue/4495
-- in.cue --
// g(g), where g returns a struct that applies x(x) again.
selfApply: {
	g: {
		x: _
		let X = x
		out: {n: _, out: (X & {x: X}).out}
	}
	out: (g & {x: g}).out
}

// The same, with the result wrapped in a struct.
wrapped: {
	g: {x: _, let X = x, out: {r: (X & {x: X}).out}}
	out: (g & {x: g}).out
}

// omega: w(w) with w = func(x): x(x).
omega: {
	w: {x: _, let X = x, out: (X & {x: X}).out}
	out: (w & {x: w}).out
}

// The Z combinator: fix(f) = g(g), with g = func(x): f(func(n): x(x)(n)).
fix: {
	fix: {
		f: _
		g: {
			x: _
			let X = x
			out: (f & {self: {n: _, let N = n, out: ((X & {x: X}).out & {n: N}).out}}).out
		}
		out: (g & {x: g}).out
	}
	fact: {
		self: _
		let S = self
		out: {
			n: int
			let N = n
			out: [
				if N == 0 {1},
				if N > 0 {N * (S & {n: N - 1}).out},
			][0]
		}
	}
	out: ((fix & {f: fact}).out & {n: 5}).out
}

// Direct recursion that selects into its own nested result, with the
// instantiation declared before the template so that nothing else reports
// it first.
directSelect: {
	out: (f & {n: 1}).out
	f: {n: _, let N = n, out: {r: (f & {n: N}).out.r}}
}

// A self-reference: the inner #type is the literal's own field, so the
// recursion binds ["list", _] at every level, under a disjunction.
selfRef: {
	#T: {
		#type!: "string" | "number"
		out: type: #type
	} | {
		#type!: ["list", _]
		out: {
			type:  "array"
			items: (#T & {#type: #type[1]}).out
		}
	}
	out: (#T & {#type: ["list", ["list", "string"]]}).out
}

// Recursion bounded by data, through a disjunction, without a comprehension.
dataBounded: {
	#T: {
		#type!: "string" | "number"
		out: type: #type
	} | {
		#type!: ["list", _]
		out: {
			type: "array"
			let value = #type[1]
			items: (#T & {#type: value}).out
		}
	}
	out: (#T & {#type: ["list", ["list", "string"]]}).out
}

// Recursion guarded by a comprehension, binding a smaller value each level.
guarded: {
	f: {
		n: _
		let N = n
		out: {
			if N > 0 {
				r: (f & {n: N - 1}).out
			}
		}
	}
	out: (f & {n: 3}).out
}

// Recursion over finite data terminates, at any depth.
data: {
	#Copy: {
		param: {...}
		result: {
			for k, v in param {
				(k): (#Copy & {param: v}).result
			}
		}
	} | {
		param: [...]
		result: [
			for v in param {
				(#Copy & {param: v}).result
			},
		]
	} | {
		param:  number
		result: param
	}

	foo: #Copy
	foo: param: a: [{b: [{c: [{d: 134}]}]}]
	out: foo.result
}

// An argument passed through a field of the template rather than written
// at the instantiation: shrinking each level, it terminates. The constant
// variant below preserves an existing cycle diagnostic while evaluating f;
// it does not assert detection of a call evaluated before the template.
viaField: {
	f: {
		n: int
		let N = n
		args: {n: N - 1}
		out: {
			if N > 0 {
				r: (f & args).out
			}
		}
	}
	out: (f & {n: 3}).out
}
viaFieldSame: {
	f: {
		n: int
		let N = n
		args: {n: N}
		out: {r: (f & args).out}
	}
	out: (f & {n: 3}).out
}

// Nested use of one template is not recursion.
nesting: {
	inc: {x: _, out: x + 1}
	h: {in: _, let I = in, out: (inc & {x: I}).out}
	out: (h & {in: (h & {in: (h & {in: 1}).out}).out}).out

}

// The template named by a selector rather than a reference.
selectorTemplate: {
	fns: g: {x: _, let X = x, out: {n: _, out: (fns.g & {x: X}).out}}
	out: (fns.g & {x: fns.g}).out
}

// The template embedded in the literal that supplies its arguments.
embedTemplate: {
	f: {n: _, let N = n, out: {r: {f, n: N}.out}}
	out: {f, n: 1}.out
}
-- review.cue --
// Equal results of sequential applications do not imply recursion.
sequential: {
	h: {in: _, out: {if in.ok {({x: in}).x}}}
	c: ok: true
	mid: (h & {in: c}).out
	out: (h & {in: mid}).out
}

// A field's lexical environment need not contain its parent vertex.
viaSub: {
	S: {m: int, args: {n: m}}
	f: {
		n: int
		let N = n
		sub: S & {m: N - 1}
		out: {
			if N > 0 {r: (f & sub.args).out}
		}
	}
	out: (f & {n: 4}).out
}

// A let in a comprehension binds a different value in each iteration.
multiLet: {
	f: {
		n: _
		let N = n
		out: {
			for k, x in N {
				let Y = x
				(k): (f & {n: Y}).out
			}
		}
	}
	out: (f & {n: {a: {p: {}}, b: {a: {p: {}}, c: {q: {}}}}}).out
	out: _
}

// Re-entry while evaluating a scalar is a value cycle, not a structural one.
valueCycle: {
	g: {x: _, let X = x, out: {r: (X & {x: X}).out.r + 1}}
	y: (g & {x: g}).out
	y: r: _
}
-- out/compile --
--- in.cue
