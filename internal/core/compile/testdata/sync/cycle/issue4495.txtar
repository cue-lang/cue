        let N#7 = 〈0;n〉
        out: [
          if (〈1;let N#7〉 == 0) {
            1
          },
          if (〈1;let N#7〉 > 0) {
            (〈2;let N#7〉 * (〈3;let S#6〉 & {
              n: (〈3;let N#7〉 - 1)
            }).out)
