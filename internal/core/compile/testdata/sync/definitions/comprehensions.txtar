-- in.cue --
// Closedness should not be silently swallowed when propagated through
// comprehensions; fields added via comprehensions should still be checked.
// https://cuelang.org/issue/595
issue595: {
	// NOTE: this should eval with an EVAL error, not
	// an incomplete error. See Issue #595.
	#cfgs: [{
		name: "foo"
	}]
	_name: #cfgs[0].name
	for cfg in #cfgs {
		files: cfg.nam
	}
}
-- guard.cue --
@experiment(predicates)

// A guard which calls isValid finalizes the field it tests, which computes
// the closedness requirements of the enclosing struct early.

// The fields a disjunct declares beside the tested field are still checked.
guardBeforeDisjunction: {
	#A: {
		a?: int
		b?: {x: int}
	}
	oneAllowed: #A & {
		b: {x: 1}
		if isValid(b) {
			{a: 1} | {typo: 2}
		}
	}
	noneAllowed: #A & {
		b: {x: 1}
		if isValid(b) {
			{typo1: 1} | {typo2: 2}
		}
	}
	// A disjunct of an outer disjunction forks again within the guard.
	nested: #A & ({
		b: {x: 1}
		if isValid(b) {
			{a: 1} | {typo: 2}
		}
	} | {typo: 3})
	// Without the call, no field is finalized before forking.
	noGuard: #A & {
		b: {x: 1}
		if true {
			{a: 1} | {typo: 2}
		}
	}
}
// A definition which the comprehension embeds adds a requirement, which the
// fields of the struct are checked against as well.
guardBeforeRequirement: {
	#B: {
		b?: _
		c?: int
	}
	notAllowed: {
		b: {x: 1}
		if isValid(b) {
			#B
		}
	} & {typo: 1}
	allowed: {
		b: {x: 1}
		if isValid(b) {
			#B
		}
	} & {c: 1}
	// The requirement eliminates a disjunct.
	inDisjunct: ({
		b: {x: 1}
		if isValid(b) {
			#B
		}
	} | {zzz: 1}) & {typo: 1}
	// Without the call, no field is finalized before embedding.
	noGuard: {
		b: {x: 1}
		if true {
			#B
		}
	} & {typo: 1}
}
-- out/compile --
--- guard.cue
{
  guardBeforeDisjunction: {
    #A: {
      a?: int
      b?: {
        x: int
      }
    }
    oneAllowed: (〈0;#A〉 & {
      b: {
        x: 1
      }
      if isValid(〈0;b〉) {
        ({
          a: 1
        }|{
          typo: 2
        })
      }
    })
    noneAllowed: (〈0;#A〉 & {
      b: {
        x: 1
      }
      if isValid(〈0;b〉) {
        ({
          typo1: 1
        }|{
          typo2: 2
        })
      }
    })
    nested: (〈0;#A〉 & ({
      b: {
        x: 1
      }
      if isValid(〈0;b〉) {
        ({
          a: 1
        }|{
          typo: 2
        })
      }
    }|{
      typo: 3
    }))
    noGuard: (〈0;#A〉 & {
      b: {
        x: 1
      }
      if true {
        ({
          a: 1
        }|{
          typo: 2
        })
      }
    })
  }
  guardBeforeRequirement: {
    #B: {
      b?: _
      c?: int
    }
    notAllowed: ({
      b: {
        x: 1
      }
      if isValid(〈0;b〉) {
        〈2;#B〉
      }
    } & {
      typo: 1
    })
    allowed: ({
      b: {
        x: 1
      }
      if isValid(〈0;b〉) {
        〈2;#B〉
      }
    } & {
      c: 1
    })
    inDisjunct: (({
      b: {
        x: 1
      }
      if isValid(〈0;b〉) {
        〈2;#B〉
      }
    }|{
      zzz: 1
    }) & {
      typo: 1
    })
    noGuard: ({
      b: {
        x: 1
      }
      if true {
        〈2;#B〉
      }
    } & {
      typo: 1
    })
  }
}
--- in.cue
{
  issue595: {
    #cfgs: [
      {
        name: "foo"
      },
    ]
    _name: 〈0;#cfgs〉[0].name
    for _, cfg in 〈0;#cfgs〉 {
      files: 〈1;cfg〉.nam
    }
  }
}
