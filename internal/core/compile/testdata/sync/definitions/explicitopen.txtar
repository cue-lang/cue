# Tests the explicitopen experiment: allows using the spread operator (...) to
# explicitly open closed structs. NewClosed1: {#A} is closed; NewOpen1: {#A...}
# is open. The test covers interactions between old and new style closedness.
-- cue.mod/module.cue --
module: "mod.test"

language: version: "v0.15.0"

-- old.cue --
package foo

#A: a: 1
Old1: {
	{
		#A
		b: 1
	}
}

#Old2: {
	{
		#A
		b: 1
	}
}

useNewClosed1: {
	t1: err: NewClosed1 & {c: 3}
	t2: ok:  {NewClosed1, c: 3}
}

useNewClosed2: {
	t1: err: #NewClosed2 & {c: 3}
	t2: ok:  {#NewClosed2, c: 3}
}

useNewOpen1: {
	t1: ok: NewOpen1 & {c: 3}
	t2: ok: {NewOpen1, c: 3}
}

useNewOpen2: {
	t1: ok: NewOpen2 & {c: 3}
	t2: ok: {NewOpen2, c: 3}
}

combineold: {
	// all {a: 1}
	a0: ok: #A & NewClosed1
	a1: ok: {#A, NewClosed1}

	a2: ok: NewClosed1 & NewOpen2
	a3: ok: {NewClosed1, NewOpen2}

	// all {a: 1, b: 2}
	b0: ok: Old1 & #NewClosed2
	b1: ok: #Old2 & #NewClosed2

	c1: ok: {#NewClosed2,  Old1}
	c2: ok: {#NewClosed2,  #Old2}

	// {a: 1} and {a: 1, b: 2}
	e0: err: #A & Old1
	e1: err: #A & #Old2
	e2: err: #A & #NewClosed2
	e3: err: #A & NewOpen1

	e4: ok: {#A, Old1}
	e5: ok: {#A, #Old2}
	e6: ok: {#A, #NewClosed2}
	e7: ok: {#A, NewOpen1}

	f0: err: NewClosed1 & Old1
	f1: err: NewClosed1 & #Old2
	f2: err: NewClosed1 & #NewClosed2
	f3: err: NewClosed1 & NewOpen1

	f4: ok: {NewClosed1, Old1}
	f5: ok: {NewClosed1, #Old2}
	f6: ok: {NewClosed1, NewClosed1}
	f7: ok: {NewClosed1, #NewClosed2}
	f8: ok: {NewClosed1, NewOpen1}
}

-- new.cue --
@experiment(explicitopen)

package foo

NewClosed1: {
	#A
}

#NewClosed2: {
	#A...
	b: 1
}

NewOpen1: {
	#A...
	b: 1
}

NewOpen2: #A...

useOld1: {
	t1: err: Old1 & {c: 3}
	t2: err: {Old1, c: 3} // TODO
	t3: ok:  {Old1..., c: 3}
}

useOld2: {
	t1: err: #Old2 & {c: 3}
	t2: err: {#Old2, c: 3}
	t3: ok:  {#Old2..., c: 3}
}

combinenew: {
	// all {a: 1}
	a0: ok: #A & NewClosed1
	a1: ok: {#A, NewClosed1}

	a2: ok: NewClosed1 & NewOpen2
	a3: ok: {NewClosed1, NewOpen2}
	a4: ok: {NewClosed1..., NewOpen2}

	a5: ok: NewOpen2 & NewClosed1
	a6: ok: {NewOpen2, NewClosed1}
	a7: ok: {NewOpen2..., NewClosed1}

	// all {a: 1, b: 2}
	b0: ok: Old1 & #NewClosed2
	b1: ok: #Old2 & #NewClosed2
	b2: ok: #NewClosed2 & Old1
	b3: ok: #NewClosed2 & #Old2

	c1: ok: {#NewClosed2,  Old1}
	c2: ok: {#NewClosed2,  #Old2}
	c3: ok: {Old1, #NewClosed2}
	c4: ok: {#Old2, #NewClosed2}

	d0: ok: {#NewClosed2,  Old1...}
	d1: ok: {#NewClosed2,  #Old2...}
	d2: ok: {#NewClosed2...,  Old1}
	d3: ok: {#NewClosed2...,  #Old2}
	d4: ok: {#NewClosed2...,  Old1...}
	d5: ok: {#NewClosed2...,  #Old2...}

	d6: ok: {Old1..., #NewClosed2}
	d7: ok: {#Old2..., #NewClosed2}
	d8: ok: {Old1, #NewClosed2...,}
	d9: ok: {#Old2, #NewClosed2...,}
	d10: ok: {Old1..., #NewClosed2...,}
	d11: ok: {#Old2..., #NewClosed2...,}

	// {a: 1} and {a: 1, b: 2}
	e0: err: #A & Old1
	e1: err: #A & #Old2
	e2: err: #A & #NewClosed2
	e3: err: #A & NewOpen1

	e4: err: {#A, Old1}
	e5: err: {#A, #Old2}
	e6: err: {#A, #NewClosed2}
	e7: err: {#A, NewOpen1}

	e8: ok: {#A..., Old1}
	e9: ok: {#A..., #Old2}
	e10: ok: {#A..., #NewClosed2}
	e11: ok: {#A..., NewOpen1}

	f0: err: NewClosed1 & Old1
	f1: err: NewClosed1 & #Old2
	f2: err: NewClosed1 & #NewClosed2
	f3: err: NewClosed1 & NewOpen1
	f4: ok: NewClosed1 & NewClosed1

	f5: err: {NewClosed1, Old1}
	f6: err: {NewClosed1, #Old2}
	f7: err: {NewClosed1, #NewClosed2}
	f8: err: {NewClosed1, NewOpen1}
	f9: ok: {NewClosed1, NewClosed1}

	f9: ok:  {NewClosed1..., Old1}
	f10: ok: {NewClosed1..., #Old2}
	f11: ok: {NewClosed1..., NewClosed1}
	f12: ok: {NewClosed1..., #NewClosed2}
	f13: ok: {NewClosed1..., NewOpen1}

	f14: err: Old1 & NewClosed1
	f15: err: #Old2 & NewClosed1
	f16: err: #NewClosed2 & NewClosed1
	f17: err: NewOpen1 & NewClosed1
	f18: ok: NewClosed1 & NewClosed1
}
-- issues.cue --
@experiment(explicitopen)
// explicitopen experiment: postfix `...` spread cannot directly combine with
// `&`; tests open-struct spread behavior and non-struct operand tolerance.
// https://cuelang.org/issue/4150
issue4150: {
	#Def: a: int

	x: #Def... & {
			a: 42
			b: 42
	}

	foo: {a: int}
	bar: {b: int}
	y: foo... & bar...

	// NOTE: we allow this, even though it doesn't mean anything. The benefit
	// of this is that code doesn't become brittle using the spread operator
	// for references. Consider this example:
	//
	//  #Def: a: int
	//	foo: 1 | #Def
	//	bar: foo...
	//
	// Not allowing ... on any expression would mean #foo... may or may not be
	// erroneous, depending on the value foo is set to.
	z: 1...
}

// A definition re-closes a reference opened with `...`, even when the
// referenced value is itself an instance of that definition and is shared.
reclose: {
	#D: a: int
	x: #D & {a: 1}
	y: x... & #D
	t1: err: y & {b: 2}
}

// A reference opened with `...` stays open when the only disjunct left of a
// disjunction opened alike shares it.
sharedDisjunct: {
	#A: {x: 1}
	#B: {x: 2}
	D: #A | #B
	c: #B...
	c: D...
	m: c & {y: 3}

	// The definition closes a field reading such a reference again, also
	// when read through another field.
	Z: c
	Z: #B
	n: Z & {y: 3}
	o: c
	o: Z
	p: o & {y: 3}
}

// A field sharing a forward reference to an opened definition stays open
// when unshared after the reference was evaluated.
forwardShared: {
	#A: {x: 1}
	#B: {x: 2}

	direct: {
		c: b
		c: F
		c: G
		F: *#A | {x: 2}
		G: {y: 3}
		b: #B...
	}
	indirect: {
		c: b
		c: F
		c: G
		F: *#A | {x: 2}
		G: {y: 3}
		b: X
		X: #B...
	}
	// A field already sharing a reference to an opened field queues the
	// conjuncts of a closed forward reference instead. Only a is opened
	// here: b closes the field as in recloseSame.field below, even when
	// the reference is evaluated before its conjuncts run.
	queued: {
		c: a
		c: b
		c: F
		a: b...
		b: #B
		F: *#A | {x: 2, y: 3}
	}
}

// A definition re-closes a reference to itself opened with `...` in either
// order, also when reached through another field or through the only
// disjunct left of a disjunction. A field holding the definition does the
// same.
recloseSame: {
	#A: {x: 1}
	#B: {x: 2}
	D: #A | #B
	X: #B

	same: {
		c: #B...
		c: #B
		m: c & {y: 3}
	}
	sameField: {
		c: X...
		c: X
		m: c & {y: 3}
	}
	field: {
		c: #B...
		c: X
		m: c & {y: 3}
	}
	conjunction: {
		c: (#B & #B)...
		c: #B
		m: c & {y: 3}
	}
	disjunct: {
		c: #B...
		c: D
		m: c & {y: 3}
	}
	readDisjunct: {
		v: #B...
		v: D
		c: #B...
		c: v
		m: c & {y: 3}
	}

	// A reference stays open when it reaches the opened vertex through
	// fields that share it before it is evaluated.
	forward: {
		Z: w
		w: #B...
		c: #B...
		c: Z
		m: c & {y: 3}
	}
	forwardSelf: {
		Z: c
		c: #B...
		c: Z
		m: c & {y: 3}
	}
	forwardRead: {
		n: c
		c: #B...
		m: n & {y: 3}
	}
	// A reference stays open when the only disjunct left of the field it
	// reads shares the opened vertex.
	readOpenedDisjunct: {
		v: #B...
		v: D...
		c: #B...
		c: v
		m: c & {y: 3}
	}

	// Only the definition the opened vertex is unified with closes it again,
	// not the other definitions that vertex is closed by.
	otherDefs: {
		#P: {x?: int}
		#Q: {x?: int, [=~"^z"]: int}
		w: #P & #Q
		c: w...
		c: #Q
		m: c & {z: 1}
		n: c & {q: 1}
	}

	// A reference to a definition closes it, even when the definition shares
	// a vertex through an opened reference, in either order.
	def: {
		#C: #B...
		c: #C
		m: c & {y: 3}

		w: #B...
		#D: w
		d: #D
		n: d & {y: 3}

		e: #E
		#E: #B...
		o: e & {y: 3}

		// Also when the field embeds the opened definition in a struct, or
		// is unified with an opened disjunction, and when a field holding
		// such a definition is reached through another field.
		v: {#B..., z?: int}
		#F: v
		f: #F
		p: f & {y: 3}
		f2: f
		r: f2 & {y: 3}
		k: s: #F
		h: k.s & {y: 3}

		u: #B...
		u: D...
		#G: u
		g: #G
		q: g & {y: 3}
		g2: g
		t: g2 & {y: 3}
	}

	// A definition re-closes a field it opens with `...`, so selecting the
	// field closes it however the definition is reached: through a reference
	// naming it, or through a regular field holding it, possibly unified with
	// something else, or opened through a conjunction. An ellipsis in the
	// field keeps it open, as does a spread beside the definition, whose
	// fields the definition does not declare.
	crossing: {
		#D: s: #B...
		m: #D.s & {y: 3}
		c: #D.s
		n: c & {y: 3}
		t: c
		o: t & {y: 3}
		u: v
		v: #D.s
		p: u & {y: 3}
		d: #D
		q: d.s & {y: 3}
		w: d.s
		r: w & {y: 3}
		du: #D & {}
		h: du.s & {y: 3}

		#E: s: (#B & {})...
		e: #E
		x: e.s & {y: 3}

		#F: s: {#B..., ...}
		f: #F
		g: f.s & {y: 3}

		#Open: {...}
		#Extra: s: t: {a: 1}
		dx: #Open & #Extra...
		mx: dx & {s: b: 2}
		nx: dx.s & {b: 2}
		ox: dx.s.t & {b: 2}
		dy: #Open & (#Extra & {})...
		ny: dy.s & {b: 2}

		// The same holds when the selected field does not share the
		// definition's vertex. A spread within the definition is re-closed
		// at every level, also at the definition's own level and when the
		// definition is unified inline.
		#H: s: {x: 1, ...}
		dh: #H & #Extra...
		eh: dh.s & {}
		ph: eh.t & {b: 2}
		#Z: {#Extra..., s: {x: 1}}
		dz: #Z & {}
		pz: dz.s.t & {b: 2}
		#Y: {#Extra...}
		dw: #Y & {}
		pw: dw.s & {b: 2}
		#K: s: {x: 1}
		ik: (#K & #Extra...).s
	}
}
// A definition re-closes a conjunction it is an operand of, opened with
// `...`, in either order, also when the conjuncts sit on a single field or
// the definition is embedded in a struct.
recloseConjunction: {
	#B: {x: 2}
	#C: {x: 2}
	field: {
		c: (#B & #C)...
		c: #B
		m: c & {y: 3}
	}
	inline:    (#B & {})... & #B & {y: 3}
	inlineRev: #B & (#B & {})... & {y: 3}
	embedded: {
		c: (#B & #B)...
		c: {#B}
		m: c & {y: 3}
	}
}
-- out/compile --
