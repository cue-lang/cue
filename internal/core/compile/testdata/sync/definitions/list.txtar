-- in.cue --
c: #R & {
	w: [{}, {b: int}]
}
#R: {
	w: [{}, ...]
}

// issue3487: a list of a definition closes its elements when it is embedded,
// just as it does when it is unified in. https://cuelang.org/issue/3487
issue3487: {
	#Schema: known: string

	unify: [...#Schema] & [{known: "foo", unknown: "bar"}]

	embed: {
		[...#Schema]
		[{known: "foo", unknown: "bar"}]
	}
}
-- out/compile --
--- in.cue
{
  c: (〈0;#R〉 & {
    w: [
      {},
      {
        b: int
      },
    ]
  })
  #R: {
    w: [
      {},
      ...,
    ]
  }
  issue3487: {
    #Schema: {
      known: string
    }
    unify: ([
      ...〈1;#Schema〉,
    ] & [
      {
        known: "foo"
        unknown: "bar"
      },
    ])
    embed: {
      [
        ...〈2;#Schema〉,
      ]
      [
        {
          known: "foo"
          unknown: "bar"
        },
      ]
    }
  }
}
