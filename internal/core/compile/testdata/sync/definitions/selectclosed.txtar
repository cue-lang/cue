# A definition closes recursively, and a regular field holding a definition
# is closed too. Selecting a field from that regular field must keep the
# closedness, exactly as selecting it from the definition does.
#
# Whether the closed value then closes the struct it is embedded in is a
# separate question, and one the explicitopen experiment answers differently.
# The module therefore opts in per file: in.cue is under the experiment, as
# every file is from v0.18.0 on, and old.cue is not.
-- cue.mod/module.cue --
module: "mod.test"

language: version: "v0.15.0"

-- in.cue --
@experiment(explicitopen)

#Meta: meta: {name: "x"}
m: #Meta

// Selecting from the definition keeps its closedness.
direct: #Meta.meta & {extra: 1}

// The regular field is closed.
whole: m & {meta: extra: 1}

// Selecting from the regular field must be closed too.
viaField: m.meta & {extra: 1}

// The regular field holds the same closed value however it is built, but a
// selection from it is closed only through a bare reference, which shares
// the definition's vertex. https://cuelang.org/issue/4501
mu: #Meta & {}
viaUnified: mu.meta & {extra: 1}
mi: {#Meta}
viaEmbedded: mi.meta & {extra: 1}
#Fn: {in!: int, out: {v: in}}
viaOut: (#Fn & {in: 1}).out & {extra: 1}

// Deeper selections, and a selection inside a definition.
#Deep: a: b: {c: 1}
d: #Deep
viaDeep: d.a.b & {extra: 1}
#Use: x: d.a
viaDef: #Use & {x: {b: {extra: 1}}}

// Through an intermediate regular field.
inter: {x: m, y: x.meta & {extra: 1}}
viaInter: inter.y

// A comprehension body is written at a path, so a selection in one closes
// like one written in the struct around it, be it an if or a for.
viaIf: {
	if true {
		x: m.meta & {extra: 1}
	}
}
viaFor: {
	for k, _ in {one: 1} {
		"\(k)": m.meta & {extra: 1}
	}
}

// Under the experiment an embedded closed value closes the struct it lands
// in, whether it is written there directly or in a comprehension body.
viaEmbed: {
	m.meta
	extra: 1
}
viaEmbedFor: {
	for k, _ in {one: 1} {
		m.meta
	}
	extra: 1
}

// A regular field with a struct literal stays open.
open: {meta: {name: "x"}}
viaOpen: open.meta & {extra: 1}

// A regular struct referenced from a definition is evaluated at a path
// within it. A sibling reference in that struct then resolves to an arc
// under the definition without crossing into it, so a plain struct it
// refers to stays open.
#Opt: {a?: int}
plain: {q: {}, s: #Opt & q & {a: 3}}
#Via: {v: plain}
viaSibling: #Via.v.s

// The same holds however the sibling is reached: through a let, in a
// comprehension body, by selecting a field of it, or from a nested field.
plainLet:    {q: {}, let Q = q, s: #Opt & Q & {a: 3}}
plainFor:    {q: {}, for _, _ in [1] {s: #Opt & q & {a: 3}}}
plainSel:    {q: {t: {}}, s: #Opt & q.t & {a: 3}}
plainNested: {q: {}, s: t: #Opt & q & {a: 3}}
#ViaAll: {l: plainLet, f: plainFor, s: plainSel, n: plainNested}
viaSiblingLet:    #ViaAll.l.s
viaSiblingFor:    #ViaAll.f.s
viaSiblingSel:    #ViaAll.s.s
viaSiblingNested: #ViaAll.n.s.t

// A reference written inside a definition to a sibling outside it does not
// close that sibling, while the definition's own field stays closed.
sib: {x: {}, #D: b: x}
viaOutsideSibling:     sib.#D.b & {c: 1}
viaOutsideSiblingOpen: sib.x & {c: 1}

// A reference resolved from outside the definition crosses into it even
// when it is evaluated at a path within the definition, because the struct
// holding the reference is what the definition refers to.
outside: #Out
let Out = {s: {a: 1}, u: outside.s & {b: 2}}
#Out: Out
viaOutside: #Out.u

// A let bound to such a reference denotes the same value.
outsideLet: #OutLet
let OutLet = {s: {a: 1}, let S = outsideLet.s, u: S & {b: 2}}
#OutLet: OutLet
viaOutsideLet: #OutLet.u

// Selecting from an inline struct opens definition closedness, see
// eval/openinline.txtar, but only for a reference resolved against the
// inline struct itself. A reference written inside it and resolved outside
// it closes as viaField does.
// TODO: the spec closes the first case too; https://cuelang.org/issue/4502
// proposes to retire the opening.
inlineField: ({in: m, out: in.meta}).out & {extra: 1}
inlineLet:   ({let M = m, out: M.meta}).out & {extra: 1}
inlineRoot:  ({out: m.meta}).out & {extra: 1}
-- old.cue --
// A definition is closed either way, so the same selections close without
// the experiment, in a comprehension body as anywhere else.
#Old: meta: {name: "x"}
o:        #Old
oldDirect: #Old.meta & {extra: 1}
oldField:  o.meta & {extra: 1}
oldViaIf: {
	if true {
		x: o.meta & {extra: 1}
	}
}
oldViaFor: {
	for k, _ in {one: 1} {
		"\(k)": o.meta & {extra: 1}
	}
}

// A sibling reference in a regular struct that a definition refers to stays
// open without the experiment as well.
#OldOpt: {a?: int}
oldPlain: {q: {}, s: #OldOpt & q & {a: 3}}
#OldVia: {v: oldPlain}
oldViaSibling: #OldVia.v.s

// Embedding is where the two differ: without the experiment an embedded
// closed value leaves the struct it lands in open. That holds for a value
// selected from a definition, so it must hold for one selected through a
// regular field as well.
oldEmbedDef: {
	#Old.meta
	extra: 1
}
oldEmbed: {
	o.meta
	extra: 1
}
oldEmbedFor: {
	for k, _ in {one: 1} {
		o.meta
	}
	extra: 1
}
-- out/compile --
--- in.cue
{
  #Meta: {
    meta: {
      name: "x"
    }
  }
  m: 〈0;#Meta〉
  direct: (〈0;#Meta〉.meta & {
    extra: 1
  })
  whole: (〈0;m〉 & {
    meta: {
      extra: 1
    }
  })
  viaField: (〈0;m〉.meta & {
    extra: 1
  })
  mu: (〈0;#Meta〉 & {})
  viaUnified: (〈0;mu〉.meta & {
    extra: 1
  })
  mi: {
    〈1;#Meta〉
  }
  viaEmbedded: (〈0;mi〉.meta & {
    extra: 1
  })
  #Fn: {
    in!: int
    out: {
      v: 〈1;in〉
    }
  }
  viaOut: ((〈0;#Fn〉 & {
    in: 1
  }).out & {
    extra: 1
  })
  #Deep: {
    a: {
      b: {
        c: 1
      }
    }
  }
  d: 〈0;#Deep〉
  viaDeep: (〈0;d〉.a.b & {
    extra: 1
  })
  #Use: {
    x: 〈1;d〉.a
  }
  viaDef: (〈0;#Use〉 & {
    x: {
      b: {
        extra: 1
      }
    }
  })
  inter: {
    x: 〈1;m〉
    y: (〈0;x〉.meta & {
      extra: 1
    })
  }
  viaInter: 〈0;inter〉.y
  viaIf: {
    if true {
      x: (〈2;m〉.meta & {
        extra: 1
      })
    }
  }
  viaFor: {
    for k, _ in {
      one: 1
    } {
      "\(〈1;k〉)": (〈3;m〉.meta & {
        extra: 1
      })
    }
  }
  viaEmbed: {
    〈1;m〉.meta
    extra: 1
  }
  viaEmbedFor: {
    for k, _ in {
      one: 1
    } {
      〈3;m〉.meta
    }
    extra: 1
  }
  open: {
    meta: {
      name: "x"
    }
  }
  viaOpen: (〈0;open〉.meta & {
    extra: 1
  })
  #Opt: {
    a?: int
  }
  plain: {
    q: {}
    s: ((〈1;#Opt〉 & 〈0;q〉) & {
      a: 3
    })
  }
  #Via: {
    v: 〈1;plain〉
  }
  viaSibling: 〈0;#Via〉.v.s
  plainLet: {
    q: {}
    let Q#3 = 〈0;q〉
    s: ((〈1;#Opt〉 & 〈0;let Q#3〉) & {
      a: 3
    })
  }
  plainFor: {
    q: {}
    for _, _ in [
      1,
    ] {
      s: ((〈3;#Opt〉 & 〈2;q〉) & {
        a: 3
      })
    }
  }
  plainSel: {
    q: {
      t: {}
    }
    s: ((〈1;#Opt〉 & 〈0;q〉.t) & {
      a: 3
    })
  }
  plainNested: {
    q: {}
    s: {
      t: ((〈2;#Opt〉 & 〈1;q〉) & {
        a: 3
      })
    }
  }
  #ViaAll: {
    l: 〈1;plainLet〉
    f: 〈1;plainFor〉
    s: 〈1;plainSel〉
    n: 〈1;plainNested〉
  }
  viaSiblingLet: 〈0;#ViaAll〉.l.s
  viaSiblingFor: 〈0;#ViaAll〉.f.s
  viaSiblingSel: 〈0;#ViaAll〉.s.s
  viaSiblingNested: 〈0;#ViaAll〉.n.s.t
  sib: {
    x: {}
    #D: {
      b: 〈1;x〉
    }
  }
  viaOutsideSibling: (〈0;sib〉.#D.b & {
    c: 1
  })
  viaOutsideSiblingOpen: (〈0;sib〉.x & {
    c: 1
  })
  outside: 〈0;#Out〉
  let Out#1 = {
    s: {
      a: 1
    }
    u: (〈1;outside〉.s & {
      b: 2
    })
  }
  #Out: 〈0;let Out#1〉
  viaOutside: 〈0;#Out〉.u
  outsideLet: 〈0;#OutLet〉
  let OutLet#2 = {
    s: {
      a: 1
    }
    let S#4 = 〈1;outsideLet〉.s
    u: (〈0;let S#4〉 & {
      b: 2
    })
  }
  #OutLet: 〈0;let OutLet#2〉
  viaOutsideLet: 〈0;#OutLet〉.u
  inlineField: ({
    in: 〈1;m〉
    out: 〈0;in〉.meta
  }.out & {
    extra: 1
  })
  inlineLet: ({
    let M#6 = 〈1;m〉
    out: 〈0;let M#6〉.meta
  }.out & {
    extra: 1
  })
  inlineRoot: ({
    out: 〈1;m〉.meta
  }.out & {
    extra: 1
  })
}
--- old.cue
{
  #Old: {
    meta: {
      name: "x"
    }
  }
  o: 〈0;#Old〉
  oldDirect: (〈0;#Old〉.meta & {
    extra: 1
  })
  oldField: (〈0;o〉.meta & {
    extra: 1
  })
  oldViaIf: {
    if true {
      x: (〈2;o〉.meta & {
        extra: 1
      })
    }
  }
  oldViaFor: {
    for k, _ in {
      one: 1
    } {
      "\(〈1;k〉)": (〈3;o〉.meta & {
        extra: 1
      })
    }
  }
  #OldOpt: {
    a?: int
  }
  oldPlain: {
    q: {}
    s: ((〈1;#OldOpt〉 & 〈0;q〉) & {
      a: 3
    })
  }
  #OldVia: {
    v: 〈1;oldPlain〉
  }
  oldViaSibling: 〈0;#OldVia〉.v.s
  oldEmbedDef: {
    〈1;#Old〉.meta
    extra: 1
  }
  oldEmbed: {
    〈1;o〉.meta
    extra: 1
  }
  oldEmbedFor: {
    for k, _ in {
      one: 1
    } {
      〈3;o〉.meta
    }
    extra: 1
  }
}
