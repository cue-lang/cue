# Issue #4526: a field sharing a vertex that is not evaluated yet is read
# through a comprehension before the sharing is set up, so the lookup of the
# shared vertex's field is what first evaluates it. The field is found and the
# default applies, as it does when the field is read after the vertex.

-- cue.mod/module.cue --
module: "test.com"
language: version: "v0.17.0"
-- in.cue --
// The reported case: cfg shares input.a, a reference to the same definition.
reported: {
	early: out.a.items

	#Flags: flags: enabled: bool | *false

	input: a: #Flags

	#Inner: {
		cfg: _
		items: {
			if cfg.flags.enabled {x: 1}
		}
	}

	#Outer: O={
		cfg:   #Flags
		inner: #Inner & {cfg: O.cfg}
		items: {for k, v in O.inner.items {(k): v}}
	}

	out: a: #Outer & {cfg: input.a}
	late: out.a.inner.cfg.flags.enabled
}

// Without a definition on the sharing field: a field of a definition shares a
// regular field declared later.
forward: {
	early: out.a.inner.items

	#Flags: flags: enabled: bool | *false

	input: a: #Flags

	out: a: #Outer
	#Outer: {
		inner: {
			cfg: out.a.cfg
			items: {
				if cfg.flags.enabled {x: 1}
			}
		}
		cfg: input.a
	}
	late: out.a.inner.cfg.flags.enabled
}
// The shared chain read as the source of a for comprehension. The lookup of
// the source does not wait for the shared vertex and reports it incomplete.
forSource: {
	early: [for k, _ in out.a.inner.cfg.flags {k}]

	#Flags: flags: enabled: bool | *false

	input: a: #Flags

	out: a: #Outer
	#Outer: {
		cfg: input.a
		inner: cfg: out.a.cfg
	}
}

// The shared chain within the default disjunct of the field read early.
disjunct: {
	early: {if out.a.inner.cfg.flags.enabled.deep {x: 1}}

	#Flags: flags: enabled: deep: bool | *false

	input: a: #Flags

	out: a: *#Outer | #Other
	#Other: other: int
	#Outer: {
		cfg: input.a
		inner: cfg: out.a.cfg
	}
}
-- out/compile --
--- in.cue
{
  reported: {
    early: 〈0;out〉.a.items
    #Flags: {
      flags: {
        enabled: (bool|*false)
      }
    }
    input: {
      a: 〈1;#Flags〉
    }
    #Inner: {
      cfg: _
      items: {
        if 〈1;cfg〉.flags.enabled {
          x: 1
        }
      }
    }
    #Outer: {
      cfg: 〈1;#Flags〉
      inner: (〈1;#Inner〉 & {
        cfg: 〈2〉.cfg
      })
      items: {
        for k, v in 〈2〉.inner.items {
          〈1;k〉: 〈1;v〉
        }
      }
    }
    out: {
      a: (〈1;#Outer〉 & {
        cfg: 〈2;input〉.a
      })
    }
    late: 〈0;out〉.a.inner.cfg.flags.enabled
  }
  forward: {
    early: 〈0;out〉.a.inner.items
    #Flags: {
      flags: {
        enabled: (bool|*false)
      }
    }
    input: {
      a: 〈1;#Flags〉
    }
    out: {
      a: 〈1;#Outer〉
    }
    #Outer: {
      inner: {
        cfg: 〈2;out〉.a.cfg
        items: {
          if 〈1;cfg〉.flags.enabled {
            x: 1
          }
        }
      }
      cfg: 〈1;input〉.a
    }
    late: 〈0;out〉.a.inner.cfg.flags.enabled
  }
  forSource: {
    early: [
      for k, _ in 〈1;out〉.a.inner.cfg.flags {
        〈1;k〉
      },
    ]
    #Flags: {
      flags: {
        enabled: (bool|*false)
      }
    }
    input: {
      a: 〈1;#Flags〉
    }
    out: {
      a: 〈1;#Outer〉
    }
    #Outer: {
      cfg: 〈1;input〉.a
      inner: {
        cfg: 〈2;out〉.a.cfg
      }
    }
  }
  disjunct: {
    early: {
      if 〈1;out〉.a.inner.cfg.flags.enabled.deep {
        x: 1
      }
    }
    #Flags: {
      flags: {
        enabled: {
          deep: (bool|*false)
        }
      }
    }
    input: {
      a: 〈1;#Flags〉
    }
    out: {
      a: (*〈1;#Outer〉|〈1;#Other〉)
    }
    #Other: {
      other: int
    }
    #Outer: {
      cfg: 〈1;input〉.a
      inner: {
        cfg: 〈2;out〉.a.cfg
      }
    }
  }
}
