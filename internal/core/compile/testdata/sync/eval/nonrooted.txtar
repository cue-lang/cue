# Tests non-rooted inline expressions and let bindings where the inline
# expression conflicts with a definition constraint. The evaluation should
# use the local context (overriding the definition's value), even when
# that creates a conflict detectable from the root.
# https://cuelang.org/issue/3977
-- in.cue --
import "strings"

issue3977: inlineExpr: {
	#NetworkID: 1
	#fn: {
		x:   #NetworkID
		out: x + 1
	}

	err: (#fn & {x: 2}).out
}
issue3977: inlineDisj1: {
	#NetworkID: "2" | "3" | "4"
	#fn: {
		x:   #NetworkID
		out: "value=\(x)"
	}

	err: (#fn & {x: "invalid"}).out
}
issue3977: inlineDisj2: {
	#NetworkID: 1
	#fn: {
		x:   #NetworkID
		out: x + 10
	}

	err: (#fn & {x: *2 | 4}).out
}
issue3977: inlineDisj3: {
	#NetworkID: 1
	#fn: {
		x:   #NetworkID
		out: x + 10
	}

	ok: (#fn & {x: *2 | int}).out
}
issue3977: inlineLet: {
	#NetworkID: 1
	let p = {
		x:   #NetworkID
		out: x + 10
	} & {
		x: 2
	}

	err: p.out
}

// A scalar of an inline struct, struct literal, or let that is read through an
// interpolation is checked against all its validators, not only its bounds.
// https://cuelang.org/issue/4510
issue4510: inline: {
	#C: {
		id:  string & !="storage"
		out: "k/\(id)"
	}
	ok:  (#C & {id: "other"}).out
	err: (#C & {id: "storage"}).out
}
issue4510: literal: {
	err: {
		id:  string & !="storage"
		id:  "storage"
		out: "k/\(id)"
	}.out
}
issue4510: let: {
	#C: {
		id:  string & !="storage"
		out: "k/\(id)"
	}
	let L = #C & {id: "storage"}
	err: L.out
}
issue4510: regexp: {
	#C: {
		id:  =~"^a"
		out: "k/\(id)"
	}
	err: (#C & {id: "b"}).out
}
issue4510: builtin: {
	#C: {
		id:  strings.MaxRunes(2)
		out: "k/\(id)"
	}
	err: (#C & {id: "abc"}).out
}
// A validator of the read scalar may refer to the reading field: it is checked
// once that field has its value, as it would be for a regular field.
issue4510: selfRef: {
	ok1: ({x: 1 & !=ok1, out: x + 1}).out
	let L = {x: 1 & !=ok2, out: x + 1}
	ok2: L.out
	err: ({x: 1 & !=err, out: x + 0}).out
}
// The reading field may be a disjunction, in which case each disjunct checks
// the read scalar on its own.
issue4510: disjunct: {
	#C: {
		id:  string & !="storage"
		out: "k/\(id)"
	}
	ok:  (#C & {id: "other"}).out & (string | int)
	err: (#C & {id: "storage"}).out & (string | int)

	let L = #C & {id: "storage"}
	errLet: L.out & (*"k/storage" | string)

	#N: 1
	#fn: {
		x:   #N
		out: x + 10
	}
	okConflict:  (#fn & {x: 1}).out & (int | string)
	errConflict: (#fn & {x: 2}).out & (int | string)
}
// The reading task may belong to a nested internal node, as when the read
// value feeds an expression. The rooted field completes the read node then too.
issue4510: binop: {
	#C: {
		id:  string & !="storage"
		out: "k/\(id)"
	}
	err: (#C & {id: "storage"}).out + "y"

	let L = #C & {id: "storage"}
	errLet: L.out + "y"

	#N: 1
	#fn: {
		x:   #N
		out: x + 10
	}
	errConflict: (#fn & {x: 2}).out + 1
}
// The read scalar may be consumed by a builtin call, whose argument is read
// with its tasks already finished, or be a default that is then eliminated.
issue4510: consumers: {
	#C: {
		id:  string & !="storage"
		out: "k/\(id)"
	}
	errBuiltin: strings.ToUpper((#C & {id: "storage"}).out)

	errLen: len((#C & {id: "storage"}).out)

	errArith: ({x: 1 & !=1, out: x + 1}).out

	fallback: *(#C & {id: "storage"}).out | "fallback"
}
// A disjunct that fails on its own value must not complete the deferred nodes,
// which it shares with the other disjuncts: a validator among them that refers
// to the reading field would fail against the conflicting value, in any order
// of the disjuncts.
issue4510: disjunctOrder: {
	ok1: ({x: 1 & !=ok1, out: x + 1}).out & (string | int)
	ok2: ({x: 1 & !=ok2, out: x + 1}).out & (int | string)

	let L1 = {x: 1 & !=ok3, out: x + 1}
	ok3: L1.out & (string | int)

	let L2 = {x: 1 & !=ok4, out: x + 1}
	ok4: L2.out & (int | string)
}
// A comprehension's let clause has no path of its own: its validators run
// where its value is used, so the error reports that path. A clause only read
// by an expression is not checked at all.
issue4510: compLet: {
	l: [1, 2]
	errList: [for v in l let y = v & !=2 if y > 0 {y}]
	errField: {for v in l let y = v & !=2 if y > 0 {"k\(v)": y}}
	expr: [for v in l let y = v & !=2 {y + 0}]
}
// A let inside a definition is reached only through an instance of it. Its
// field conflicts with the default of a disjunction, and the referrer reads a
// list in which that field sits several levels down, in an interpolation. The
// error is reported on the definition as well, whose lets are evaluated like
// those of any other struct.
issue4510: letInDefinition: {
	#Resources: {
		scaling: limits: memory: float | *1.0
		block: limits: memory: "\(2 * scaling.limits.memory)Mi"
		patch: [{value: block}]
	}
	#Config: {
		let r = #Resources & {scaling: limits: memory: 2}
		patches: r.patch
	}
	err: #Config
}
// A let of an inline struct is read by a guard of a comprehension in another
// let, which yields nothing. The let is still a struct, and an error in what
// the guard read is absorbed by the guard, as when the definition is used
// directly. The completion of what the guard read is left on the let reading
// the other let, where it never runs, so the empty struct is never marked as
// one.
issue4532: {
	#S: {
		let r = {role: "b" | "c"} & {role: "b"}
		let names = {for k, v in r if v != "" {(k): v}}
		let picked = {for k, _ in {other: 1} if names[k] != _|_ {(k): true}}
		out: [for k, _ in picked {k}]
		n: len(picked)
	}
	ok:    (#S & {}).out
	okLen: (#S & {}).n

	#E: {
		let r = {role: "b" & !="b"}
		let names = {for k, v in r if v != "" {(k): v}}
		let picked = {for k, _ in {other: 1} if names[k] != _|_ {(k): true}}
		let withZ = {z: 1, for k, _ in {other: 1} if names[k] != _|_ {(k): true}}
		let matched = {for k, _ in {role: 1} if names[k] != _|_ {(k): true}}
		out: [for k, _ in picked {k}]
		n: len(picked)
		z: withZ.z
		m: len(matched)
	}
	guarded:      (#E & {}).out
	guardedLen:   (#E & {}).n
	guardedField: (#E & {}).z
	guardedMatch: (#E & {}).m
	direct:       #E
}
-- out/compile --
--- in.cue
