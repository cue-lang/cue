-- in.cue --
self: t1: {
	a?: int
}

self: t2: {
	a!: int
	a!: int
}

unify: t1: {
	a!: int
	a: int
}

unify: t2: {
	a!: int
	a?: int
}

#Def: t1: {
	a!: int
}

// A required field makes a value a struct, so it conflicts with an embedded
// scalar even though the field is not present.
embedScalar: t1: {
	1
	a!: int
}
// The struct, rather than the embedded scalar, is reported as conflicting
// with the field.
embedScalar: t2: {
	int
	a!: int
}
// `!=0` admits any struct, as a struct never equals 0, so the field is allowed.
embedScalar: t3: {
	!=0
	a!: int
}
// A comprehension which may add a field marks the value as a struct, so the
// embedded scalar is lost.
// https://cuelang.org/issue/4577
embedScalar: t4: {
	int
	if false {a!: int}
}
embedScalar: t5: {
	!=0
	if false {a!: int}
}

// No struct satisfies an ordered bound such as `<0`, so a required field next
// to an embedded one is a conflict.
embedBound: {
	lessThan: {
		<0
		a!: int
	}
	viaReference: {
		B: <0
		x: {
			B
			a!: int
		}
	}
	// https://cuelang.org/issue/4570
	selfReference: {
		A
		A!: >0 & <10
	}
	twoSided: {
		>0 & <10
		a!: int
	}
	dependsOnSelf: {
		<len(dependsOnSelf)
		a!: int
	}
	dependsOnSelfTwoSided: {
		>len(dependsOnSelfTwoSided) & <10
		a!: int
	}
	// As in embedScalar.t3, for a `!=` bound which depends on the struct.
	dependsOnSelfNotEqual: {
		!=len(dependsOnSelfNotEqual)
		a!: int
	}

	// As in embedScalar.t4, the comprehension makes the value a struct, which
	// the bound rejects.
	comprehension: {
		<0
		if false {a!: int}
	}
	comprehensionDependsOnSelf: {
		<len(comprehensionDependsOnSelf)
		if false {a!: int}
	}

	// As in embedScalar.t4, so a bound which depends on the struct is computed
	// against the empty struct, although the reference cycle could resolve to
	// `_` instead.
	comprehensionNotEqual: {
		!=len(comprehensionNotEqual)
		if false {a: int}
	}

	// A regular field conflicts with the bound as a mismatched type, and an
	// optional field leaves the bound as the value.
	regularField: {
		<0
		a: int
	}
	optionalField: {
		<0
		a?: int
	}
}

// A struct whose only declaration is a comprehension is a struct even when no
// field is added, so it conflicts with a scalar that it is unified with.
comprehensionOnly: {
	validator: {
		x: {if false {a!: int}}
		x: =~"a"
	}
	basicType: {
		x: {if false {a!: int}}
		x: string
	}
	bound: {
		x: {if false {a!: int}}
		x: <5
	}
	boundDependsOnSelf: {
		x: {if false {a!: int}}
		x: <len(x)
	}
	disjunction: {
		#S: spec: {...} | string
		x: #S & {spec: {if false {a!: int}}}
	}
}

// Required fields do not cause vet to fail with definitions: a required field
// in one definition should block a disallowed field from another definition.
// https://cuelang.org/issue/2306
allowed: {
	issue2306: {
		#A: a!: int
		#A: #B

		#B: b!: int
	}
}

reference: {
	toWithinDefinition: {
		#Foo: a!: int
		b: #Foo.a
	}
	toFieldFromDefinition: {
		#Foo: a!: int
		b: #Foo
		c: b.a
	}
	toNonDefinition: {
		x: y!: _
		b: x.y
	}
	toConcrete: {
		a!: 1
		b: a + 1
	}
	// A reference to a required-but-missing field reports "required field
	// missing", not "cannot reference optional field".
	// https://cuelang.org/issue/2937
	issue2937: {
		min!: number
		max!: number & >min
		max:  10
	}
	// Calling a required-but-missing field reports the missing field, rather
	// than complaining that an error is not a function.
	// https://cuelang.org/issue/4330
	issue4330: {
		#Foo: fn!: _
		b: #Foo.fn("foo")
	}
}
-- issue3918.cue --
import "strings"

// Required fields do not work on the function pattern: a required field used
// as an input to a definition-based function was not satisfied at the call site.
// https://cuelang.org/issue/3918
issue3918: {
	reduced: {
		#disjuncts: {
			in!: [...string]
			out: strings.Join(in, "|")
		}

		x: (#disjuncts & {
			in: ["foo", "bar"]
		}).out
	}
	noFunction: {
		#disjuncts: {
			in!: [...string]
			out: in
		}
		_foo: #disjuncts & {}
		x: _foo.out
	}
}
// A required field error is incomplete error. Ensure that setting a vertex
// to this error does not escalate it to an evaluation error.
doNotEscalateError: {
	a: {
		in:  _
		out: in.self
	}
	b: {
		required!: _
		pass:    (a & {in: required}).out
	}
}
-- out/compile --
