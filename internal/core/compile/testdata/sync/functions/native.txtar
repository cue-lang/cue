-- in.cue --
@experiment(functions)

import "strings"

arguments: {
	sum: {
		fn: func(a: int, b: int) -> int: a + b

		positional: fn(1, 2)
		labeled:    fn(a: 1, b: 2)
		mixed:      fn(1, b: 2)

		tooMany:        fn(1, 2, 3)
		unknownLabeled: fn(a: 1, b: 2, c: 3)
		duplicateArg:   fn(1, a: 2)
		duplicateLabeled: fn(a: 1, a: 2)
	}

	alias: {
		add1:     func(_~x: int) -> int: x + 1
		addNamed: func(_~x: int, a: int) -> int: x + a

		positional: add1(1)
		beforeNamed: addNamed(1, 2)
		mixed:       addNamed(1, a: 2)
	}

	keyword: {
		fn: func(a!: int, b?: int) -> int: a

		nameOnly:   fn(a: 4)
		positional: fn(4)
	}

	order: {
		fn:       func(int, a: int) -> int: a
		required: func(int, a!: int) -> int: a

		positionalThenNamed: fn(1, a: 2)
		allPositional:       fn(1, 2)
		requiredNamed:       required(1, a: 2)
	}

	missing: {
		positional: (func(int) -> int: 1)()
		named:      (func(a: int) -> int: a)()
	}

	builtin: {
		labeled: len(x: "foo")
	}
}

// A parameter default is declared with = and applies only when the caller
// leaves the parameter unbound; a supplied argument makes it irrelevant. A
// default reached through a reference is an ordinary part of the constraint
// and does not make the parameter omittable.
defaults: {
	value:   int | *6
	pick:    func(a: int = 5) -> int: a
	pickRef: func(a: value) -> int: a
	pickAmbiguous: func(a: int = 1 | 2) -> int: a
	pickRecursive: func(a: int = pickRecursive()) -> int: a
	pickMutualA:   func(a: int = pickMutualB()) -> int: a
	pickMutualB:   func(a: int = pickMutualA()) -> int: a

	literal:   pick()
	supplied:  pick(3)
	reference: pickRef()
	referenceSupplied: pickRef(1)
	ambiguous: pickAmbiguous()

	// A default that calls its own function is a cycle when it fires, and
	// nothing else: the literal is not an error, and a call that supplies
	// the argument never evaluates the default.
	recursive:         pickRecursive()
	recursiveSupplied: pickRecursive(3)
	mutualRecursive:   pickMutualA()
	mutualSupplied:    pickMutualA(4)

	// The same holds when the self-reference is nested inside a
	// disjunction, a struct, or a list in the default: the declaration
	// check must not taint the function for callers that supply the
	// argument.
	compound: {
		f:    func(n: int = 1 | f()) -> int: n
		out:  f(3)
		g:    func(n: {x: int} = {x: g({x: 1})}) -> int: n.x
		outg: g({x: 4})
		h:    func(n: [...int] = [h([1])]) -> int: n[0]
		outh: h([5])
	}
}

// The declared-default scenarios and the argument-kind × binding-mode matrix:
// a supplied argument of any kind displaces the default.
declaredDefaults: {
	add: func(a: int, b: int = 10) -> int: a + b
	// id returns the parameter itself, so the value the parameter took is
	// observable even when it is not concrete.
	id:  func(a: int, b: int = 10) -> int: b
	x:   int | *5
	ref: 7

	omitted:    add(1)
	positional: add(1, 2)
	labeled:    add(1, b: 2)
	reordered:  add(b: 2, a: 1)

	// An argument carrying its own disjunction default keeps it: the
	// parameter is the argument unified with the constraint, and no conflict
	// with the parameter default is reported.
	defaultedArg: id(1, x)
	defaultedArgSelected: {
		out: add(1, x)
	}
	// A non-concrete argument does not fire the default: the parameter is
	// the argument, and arithmetic on it is incomplete rather than 11.
	topArg:     id(1, _)
	topArgSum:  add(1, _)

	// {literal, reference, defaulted disjunction, top} × {positional,
	// labeled, via partial application}.
	matrix: {
		posLit:  add(1, 2)
		posRef:  add(1, ref)
		posDef:  id(1, x)
		posTop:  id(1, _)
		labLit:  add(1, b: 2)
		labRef:  add(1, b: ref)
		labDef:  id(1, b: x)
		labTop:  id(1, b: _)
		partLit: add(1, 2, ...)()
		partRef: add(1, ref, ...)()
		partDef: id(1, x, ...)()
		partTop: id(1, _, ...)()
	}

	// The default resolves in the signature's scope, not the caller's.
	scope: {
		base: 7
		f:    func(a: int = base) -> int: a
		caller: {
			base: 9
			out:  f()
		}
	}

	// A required parameter is the name-only counterpart of a plain one: a
	// default makes it omittable the same way, and it takes the default
	// when omitted.
	required: {
		f:        func(a!: int = 1, b?: int) -> int: a
		omitted:  f()
		supplied: f(a: 4)
		labeled:  f(b: 2, a: 3)
		noDefault: {
			g:   func(a!: int, b!: int = 2) -> int: a + b
			out: g(a: 1)
			err: g(b: 1)
		}
	}

	// An omitted optional parameter is absent in the body, as an absent
	// optional field is: a reference to it is the same error, and the call
	// is incomplete. Supplying it binds it like any other argument.
	optional: {
		g:       func(b?: int) -> _: b
		absent:  g()
		present: g(b: 3)
		unused:  (func(a: int, b?: int) -> int: a)(1)
	}

	// A positional-only parameter with a default is omitted by supplying
	// fewer positional arguments; later parameters are then bound by label.
	positionalOnly: {
		f:        func(_~x: int = 1, y: int) -> int: x + y
		byLabel:  f(y: 2)
		both:     f(5, 2)
		missingY: f(5)
	}

	// A default reached through a reference does not make the parameter
	// omittable, but flows into the parameter like any other value.
	viaReference: {
		#Port:    int | *80
		f:        func(p: #Port) -> int: p
		omitted:  f()
		supplied: f(8080)
		open:     f(int)
	}

	// Partial application: a bound parameter loses its default; the rest keep
	// theirs until completion.
	partial: {
		add3: func(a: int, b: int = 10, c: int = 100) -> int: a + b + c
		f:    add3(1, ...)
		all:  f()
		one:  f(2)
		lab:  f(c: 3)
	}
}

// A default is checked against its parameter's constraint once the struct
// declaring the literal has completed, whether or not the function is called;
// the function value is then the error. A default that cannot be evaluated
// yet leaves the check undone: the omitting call is incomplete.
declarationCheck: {
	uncalled: {
		f: func(a: int = "x") -> int: 1
	}
	// A supplied argument never meets the default, so a call made while the
	// struct is still evaluating succeeds; the literal is still reported.
	called: {
		f:   func(a: int = "x") -> int: 1
		out: f(1)
	}
	// A default that is itself an error is reported as an invalid default.
	erroneous: {
		f: func(a: int = (1 & "x")) -> int: a
	}
	incomplete: {
		pending: int
		f:       func(a: int = pending) -> int: a
		out:     f()
	}
	// The check is per closure: a literal that closes over a call's
	// parameter is checked against the value it received.
	closure: {
		make:   func(v: _) -> _: func(a: int = v) -> int: a
		ok:     make(2)()
		alone:  make("x")(1)
		nested: make(make("x")(1))()
	}
}

scoping: {
	capture: {
		base: 10
		fn:   func(a: int) -> int: a + base

		sameScope: fn(2)
		callerArg: {
			local: 3
			out:   fn(local)
		}
	}

	parameter: {
		// A parameter constraint resolves in the scope enclosing the function,
		// so it may refer to an outer field (but not to another parameter; see
		// TestFunctionParameterScope). A default reached through such a
		// reference flows into the parameter but does not make it omittable.
		base:    int | *7
		fn:      func(a: string, b: base) -> int: b
		out:     fn("shadow", 1)
		omitted: fn("shadow")
		open:    fn("shadow", int)
		selected: {
			out: fn("shadow", int)
		}
	}

	returnType: {
		// The return type also resolves in the enclosing scope and is enforced
		// on the result of a call.
		bound: <10
		fn:    func(a: int) -> bound: a
		ok:    fn(5)
		bad:   fn(50)
	}

	returnConstraint: (func() -> string: 1)()

	// The reserved-parameter rule applies one signature at a time: a function
	// literal nested within another function's signature or body resolves its
	// own parameters in its own body as usual.
	nested: {
		// A function-typed result: the body closes over the outer parameter
		// (currying).
		curry: {
			adder: func(x: int) -> (func(y: int) -> int): func(y: int) -> int: x + y
			add3:  adder(3)
			out:   add3(4)
		}

		// A function literal with a body in a parameter default refers to its
		// own parameter.
		paramDefault: {
			f:       func(g: _ = (func(a: int) -> int: a + 1)) -> int: 1
			out:     f(2)
			omitted: f()
		}

		// The same, in a return-type disjunction.
		returnDisjunct: {
			f:   func(x: int) -> (int | (func(a: int) -> int: a)): x
			out: f(3)
		}

		// A function nested in the outer function's body may refer to the
		// outer parameter from its own signature: it is not one of its own
		// parameters.
		outerParam: {
			f: func(x: int) -> int: {
				g:   func(y: x) -> int: y
				out: g(x)
			}.out
			out: f(5)
		}
	}
}

cycles: {
	direct: {
		fn:  func(n: int) -> int: fn(n)
		out: fn(1)
	}

	mutual: {
		a:   func(n: int) -> int: b(n)
		b:   func(n: int) -> int: a(n)
		out: a(1)
	}

	fibonacci: {
		fib: func(n: int) -> int: fib(n-1) + fib(n-2)
		out: fib(5)
	}

	ackermann: {
		fn:  func(m: int, n: int) -> int: fn(m-1, fn(m, n-1))
		out: fn(2, 2)
	}

	// A recursive call in a disjunct of the function body is a structural
	// cycle and is eliminated from the disjunction, like any other erroring
	// disjunct. It must not be absorbed and survive as the function's
	// return type (this used to yield 1 | int).
	disjunct: {
		f:   func(n: int) -> int: n | f(n)
		out: f(1)

		// If every disjunct recurses, the call fails as a structural cycle.
		g:   func(n: int) -> int: g(n+1) | g(n)
		bad: g(1)

		// A non-recursive call in a disjunct evaluates normally: the
		// disjunction of both branches survives.
		inc:  func(n: int) -> int: n + 1
		h:    func(n: int) -> int: n | inc(n)
		both: h(1)

		// Mutual recursion through a disjunct is eliminated as well.
		ma:   func(n: int) -> int: mb(n)
		mb:   func(n: int) -> int: n | ma(n)
		out2: mb(1)
	}

	// Non-recursive nesting of calls to the same function must NOT be flagged
	// as a cycle. This guards against collapsing all calls to one identity.
	nesting: {
		sum:   func(a: int, b: int) -> int: a + b
		twice: func(n: int) -> int: sum(n, n)
		out:   twice(twice(2))

		// Deeper nesting: the argument of each call is itself a call whose
		// body re-enters the same call site (sum inside twice). The
		// argument's evaluation must keep the caller's cycle-reference
		// context rather than adopt the enclosing body's chain, or the
		// sum call site falsely re-appears in one chain at depth >= 3.
		deep: twice(twice(twice(2)))
		d4:   twice(twice(twice(twice(2))))

		// A helper whose body merely forwards to another function: nesting
		// the helper re-enters the twice call site inside h's body through
		// the lazily evaluated arguments.
		h:     func(n: int) -> int: twice(n)
		alias: h(h(h(1)))

		// A cycle must not be misattributed to an unrelated intermediate
		// field consumed as an argument.
		mid:   twice(2)
		outer: twice(twice(mid))

		// An identity body returns its parameter: the result structure-shares
		// the argument, which in a nested call is again a call to the same
		// function.
		f:     func(v: int) -> int: v
		ident: f(f(f(3)))
	}
}

// Calling a disjunction is only possible once it has resolved to a single
// callee: an unresolved disjunction is ambiguous, and, since further
// unification may still resolve it, calling one is an incomplete error
// rather than a permanent one. This guards against the crash class where
// the callee evaluates to no single value at all.
disjunction: {
	f: func(a: int) -> int: a
	g: func(a: int) -> int: a + 1

	// It is unknown which disjunct to call.
	ambiguous: {
		h:   f | g
		out: h(1)
	}

	// A disjunction with a single default of function kind resolves to
	// its default and the call proceeds.
	defaulted: {
		h:   *f | g
		out: h(1)
	}

	// Disjuncts that dedup to a single value remain callable.
	dedup: {
		h:   f | f
		out: h(1)
	}

	// The same crash class applies to other callee kinds: builtins and
	// disjunctions mixing a function with a non-function.
	builtins: {
		h:   strings.ToUpper | strings.ToLower
		out: h("Hello")
	}
	mixed: {
		h:   f | 1
		out: h(1)
	}

	// Callees that are themselves errors or incomplete fail gracefully.
	callee: {
		bottom: (1 & 2)(1)
		incomplete: {
			x:   _
			out: x(1)
		}
	}
}

// Memoized call results must be matched on the callee, not just on the call
// site: overlay cloning shares environment pointers across disjunct branches,
// so the same call site may be dispatched to different callees per branch.
memoization: {
	f: func(a: int) -> int: a + 1
	g: func(a: int) -> int: a + 2

	x: {h: _, out: h(10)}
	x: {h: f} | {h: g}

	// Unifying with out: 12 eliminates the f branch and keeps the g branch.
	// A memoized result leaking from the f branch would empty the
	// disjunction instead.
	y: x & {out: 12}
	check: y.out

	// The callee identity includes the arguments bound by partial
	// application.
	partialArgs: {
		add: func(a: int, b: int) -> int: a + b

		x: {h: _, out: h(10)}
		x: {h: add(1, ...)} | {h: add(2, ...)}

		y: x & {out: 12}
		check: y.out
	}
}

// An argument that is not yet defined makes the call incomplete, exactly like
// len(y.q): the result may still become known when more information arrives,
// and until then the result must not be used, let alone be memoized.
incompleteArgs: {
	f: func(a: int) -> string: "ok"
	y: {}
	x: f(y.q)

	// The equivalent builtin call behaves the same way.
	z: len(y.q)

	// A later conjunct may still supply the field, in which case the call
	// completes.
	resolved: {
		w: {}
		out: f(w.q)
		w: q: 1
	}
}

// A parameter may share its name with the synthetic label under which a call
// selects its result. This guards against the result arc colliding with a
// parameter arc in the call instance.
paramNamedOut: {
	f: func(out: int) -> int: out + 1
	x: f(3)

	g: func(_~out: int) -> int: out * 2
	y: g(5)
}

// Parameter lists are a restricted form of struct declarations. Parameters
// may carry field-style attributes, which do not affect evaluation. A
// trailing "..." marks a bodyless signature as open (a partial signature).
declarations: {
	attrs: {
		f:   func(a: int @tag(x), b: int @foo() @bar()) -> int: a + b
		out: f(1, 2)
	}

	open: {
		// An open signature admits further parameters supplied by the closed
		// implementation with which it is unified.
		T:   func(a: int, ...) -> number
		f:   T & (func(a: int, b: int) -> int: a + b)
		out: f(3, 4)

		// A bodyless signature remains a type and cannot be called directly.
		bad: T(1)
	}
}

// A call written with a trailing "..." is a partial application: it binds the
// given arguments and yields a function over the remaining parameters, rather
// than evaluating the body.
partial: {
	add: func(a: int, b: int, c: int) -> int: a + b + c

	// Bind by label or by position; the result is a function of the rest.
	byLabel:    add(a: 1, ...)
	byPosition: add(1, ...)
	labelOut:   byLabel(2, 3)
	posOut:     byPosition(2, 3)

	// Binding no arguments yields an equivalent function.
	none: add(...)
	noneOut: none(1, 2, 3)

	// Binding every argument still yields a function; call it with no
	// arguments to evaluate the body.
	all:    add(1, 2, 3, ...)
	allOut: all()

	// Partial applications chain, accumulating bound arguments.
	step1:   add(1, ...)
	step2:   step1(2, ...)
	chainOut: step2(3)

	// Completing a partial application by label binds the remaining
	// parameter.
	half:     add(1, 2, ...)
	halfOut:  half(c: 3)

	// A parameter left unbound after a non-partial call is still required.
	missing: byPosition(2)

	// Parameter constraints are enforced across a partial application.
	bounded: func(a: int, b: <10) -> int: a + b
	pinned:  bounded(1, ...)
	oob:     pinned(50)

	// A surplus argument to a partial application is rejected, as for a
	// complete call.
	tooMany: add(1, 2, 3, 4, ...)

	// Recursion through a partial application is still bounded by the
	// structural cycle detector.
	rec:    func(n: int) -> int: rec(n)
	recP:   rec(...)
	recOut: recP(1)

	// Two partial applications are equal only when they bound the same
	// arguments: different bindings conflict, as bound arguments cannot be
	// carried over to another implementation, and must not silently merge
	// into one of the two.
	conflictArgs: add(1, ...) & add(2, ...)

	// A plain function and a partial application of itself differ the same
	// way.
	conflictPlain: add & add(1, ...)

	// A partial application does unify with itself.
	same:    step1 & step1
	sameOut: same(2, 3)
}
-- out/compile --
--- in.cue
{
  arguments: {
    sum: {
      fn: func(a: int, b: int) -> int: (〈0;a〉 + 〈0;b〉)
      positional: 〈0;fn〉(1, 2)
      labeled: 〈0;fn〉(a: 1, b: 2)
      mixed: 〈0;fn〉(1, b: 2)
      tooMany: 〈0;fn〉(1, 2, 3)
      unknownLabeled: 〈0;fn〉(a: 1, b: 2, c: 3)
      duplicateArg: 〈0;fn〉(1, a: 2)
      duplicateLabeled: 〈0;fn〉(a: 1, a: 2)
    }
    alias: {
      add1: func(int) -> int: (〈0;x〉 + 1)
      addNamed: func(int, a: int) -> int: (〈0;x〉 + 〈0;a〉)
      positional: 〈0;add1〉(1)
      beforeNamed: 〈0;addNamed〉(1, 2)
      mixed: 〈0;addNamed〉(1, a: 2)
    }
    keyword: {
      fn: func(a!: int, b?: int) -> int: 〈0;a〉
      nameOnly: 〈0;fn〉(a: 4)
      positional: 〈0;fn〉(4)
    }
    order: {
      fn: func(int, a: int) -> int: 〈0;a〉
      required: func(int, a!: int) -> int: 〈0;a〉
      positionalThenNamed: 〈0;fn〉(1, a: 2)
      allPositional: 〈0;fn〉(1, 2)
      requiredNamed: 〈0;required〉(1, a: 2)
    }
    missing: {
      positional: func(int) -> int: 1()
      named: func(a: int) -> int: 〈0;a〉()
    }
    builtin: {
      labeled: len(x: "foo")
    }
  }
  defaults: {
    value: (int|*6)
    pick: func(a: int = 5) -> int: 〈0;a〉
    pickRef: func(a: 〈0;value〉) -> int: 〈0;a〉
    pickAmbiguous: func(a: int = (1|2)) -> int: 〈0;a〉
    pickRecursive: func(a: int = 〈0;pickRecursive〉()) -> int: 〈0;a〉
    pickMutualA: func(a: int = 〈0;pickMutualB〉()) -> int: 〈0;a〉
    pickMutualB: func(a: int = 〈0;pickMutualA〉()) -> int: 〈0;a〉
    literal: 〈0;pick〉()
    supplied: 〈0;pick〉(3)
    reference: 〈0;pickRef〉()
    referenceSupplied: 〈0;pickRef〉(1)
    ambiguous: 〈0;pickAmbiguous〉()
    recursive: 〈0;pickRecursive〉()
    recursiveSupplied: 〈0;pickRecursive〉(3)
    mutualRecursive: 〈0;pickMutualA〉()
    mutualSupplied: 〈0;pickMutualA〉(4)
    compound: {
      f: func(n: int = (1|〈0;f〉())) -> int: 〈0;n〉
      out: 〈0;f〉(3)
      g: func(n: {
        x: int
      } = {
        x: 〈1;g〉({
          x: 1
        })
      }) -> int: 〈0;n〉.x
      outg: 〈0;g〉({
        x: 4
      })
      h: func(n: [
        ...int,
      ] = [
        〈1;h〉([
          1,
        ]),
      ]) -> int: 〈0;n〉[0]
      outh: 〈0;h〉([
        5,
      ])
    }
  }
  declaredDefaults: {
    add: func(a: int, b: int = 10) -> int: (〈0;a〉 + 〈0;b〉)
    id: func(a: int, b: int = 10) -> int: 〈0;b〉
    x: (int|*5)
    ref: 7
    omitted: 〈0;add〉(1)
    positional: 〈0;add〉(1, 2)
    labeled: 〈0;add〉(1, b: 2)
    reordered: 〈0;add〉(b: 2, a: 1)
    defaultedArg: 〈0;id〉(1, 〈0;x〉)
    defaultedArgSelected: {
      out: 〈1;add〉(1, 〈1;x〉)
    }
    topArg: 〈0;id〉(1, _)
    topArgSum: 〈0;add〉(1, _)
    matrix: {
      posLit: 〈1;add〉(1, 2)
      posRef: 〈1;add〉(1, 〈1;ref〉)
      posDef: 〈1;id〉(1, 〈1;x〉)
      posTop: 〈1;id〉(1, _)
      labLit: 〈1;add〉(1, b: 2)
      labRef: 〈1;add〉(1, b: 〈1;ref〉)
