# Two distinct but structurally equal recursive function types must compare
# each pair of types once, not once for every path through their parameters,
# which grows exponentially with the depth bound. Admission compares them when
# the implementation meets the signature, and entitlement when a callback is
# bound. Types whose parameters are fresh instances of their definitions are
# compared once per pair of literals, which no pair of instances repeats.
# Three parameters make the difference plain in out/eval/stats without making
# the regression test expensive.
#inlinetest:exclude skip — performance regression guarded by out/eval/stats
-- in.cue --
@experiment(functions)

#F: func(a: #F, b: #F, c: #F) -> #F
#G: func(a: #G, b: #G, c: #G) -> #G

admitted: #F & (func(a: #G, b: #G, c: #G) -> #G: a)

cb:    #G & (func(a: #G, b: #G, c: #G) -> #G: a)
use:   func(g: #F) -> int: 1
bound: use(cb)

#H: {n: int, m: n + 1, t: func(p1: (#H & {n: m}).t, p2: (#H & {n: m}).t, p3: (#H & {n: m}).t) -> int}
#K: {n: int, m: n + 1, t: func(p1: (#K & {n: m}).t, p2: (#K & {n: m}).t, p3: (#K & {n: m}).t) -> int}
instances: (func(f: #H.t) -> int) & (func(f: #K.t) -> int: 1)
-- out/compile --
--- in.cue
{
  #F: func(a: 〈0;#F〉, b: 〈0;#F〉, c: 〈0;#F〉) -> 〈0;#F〉
  #G: func(a: 〈0;#G〉, b: 〈0;#G〉, c: 〈0;#G〉) -> 〈0;#G〉
  admitted: (〈0;#F〉 & func(a: 〈0;#G〉, b: 〈0;#G〉, c: 〈0;#G〉) -> 〈0;#G〉: 〈0;a〉)
  cb: (〈0;#G〉 & func(a: 〈0;#G〉, b: 〈0;#G〉, c: 〈0;#G〉) -> 〈0;#G〉: 〈0;a〉)
  use: func(g: 〈0;#F〉) -> int: 1
  bound: 〈0;use〉(〈0;cb〉)
  #H: {
    n: int
    m: (〈0;n〉 + 1)
    t: func(p1: (〈1;#H〉 & {
      n: 〈1;m〉
    }).t, p2: (〈1;#H〉 & {
      n: 〈1;m〉
    }).t, p3: (〈1;#H〉 & {
      n: 〈1;m〉
    }).t) -> int
  }
  #K: {
    n: int
    m: (〈0;n〉 + 1)
    t: func(p1: (〈1;#K〉 & {
      n: 〈1;m〉
    }).t, p2: (〈1;#K〉 & {
      n: 〈1;m〉
    }).t, p3: (〈1;#K〉 & {
      n: 〈1;m〉
    }).t) -> int
  }
  instances: (func(f: 〈0;#H〉.t) -> int & func(f: 〈0;#K〉.t) -> int: 1)
}
