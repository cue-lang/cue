# Two struct definitions that share their parts must compare each pair of
# parts once, not once for every path through them, which grows exponentially
# with the depth. The leaves differ in form but not in the values they admit,
# so that comparing a pair of leaves tries witnesses. Two closures capturing
# such definitions compare them as data, once per pair of parts as well. Six
# levels make the difference plain in out/eval/stats without making the
# regression test expensive.
#inlinetest:exclude skip — performance regression guarded by out/eval/stats
-- in.cue --
@experiment(functions)

#A0: {v: int & >0}
#B0: {v: int & >=1}
#A1: {a: #A0, b: #A0, c: #A0, d: #A0}
#B1: {a: #B0, b: #B0, c: #B0, d: #B0}
#A2: {a: #A1, b: #A1, c: #A1, d: #A1}
#B2: {a: #B1, b: #B1, c: #B1, d: #B1}
#A3: {a: #A2, b: #A2, c: #A2, d: #A2}
#B3: {a: #B2, b: #B2, c: #B2, d: #B2}
#A4: {a: #A3, b: #A3, c: #A3, d: #A3}
#B4: {a: #B3, b: #B3, c: #B3, d: #B3}
#A5: {a: #A4, b: #A4, c: #A4, d: #A4}
#B5: {a: #B4, b: #B4, c: #B4, d: #B4}
#A6: {a: #A5, b: #A5, c: #A5, d: #A5}
#B6: {a: #B5, b: #B5, c: #B5, d: #B5}

admitted: (func(p: #A6) -> int) & (func(p: #B6) -> int: 1)

#C0: {v: 1}
#D0: {v: 1}
#C1: {a: #C0, b: #C0, c: #C0, d: #C0}
#D1: {a: #D0, b: #D0, c: #D0, d: #D0}
#C2: {a: #C1, b: #C1, c: #C1, d: #C1}
#D2: {a: #D1, b: #D1, c: #D1, d: #D1}
#C3: {a: #C2, b: #C2, c: #C2, d: #C2}
#D3: {a: #D2, b: #D2, c: #D2, d: #D2}
#C4: {a: #C3, b: #C3, c: #C3, d: #C3}
#D4: {a: #D3, b: #D3, c: #D3, d: #D3}
#C5: {a: #C4, b: #C4, c: #C4, d: #C4}
#D5: {a: #D4, b: #D4, c: #D4, d: #D4}
#C6: {a: #C5, b: #C5, c: #C5, d: #C5}
#D6: {a: #D5, b: #D5, c: #D5, d: #D5}
mk: func(x: _) -> _: func() -> _: x
captured: mk(#C6) & mk(#D6)
-- out/compile --
--- in.cue
{
  #A0: {
    v: (int & >0)
  }
  #B0: {
    v: (int & >=1)
  }
  #A1: {
    a: 〈1;#A0〉
    b: 〈1;#A0〉
    c: 〈1;#A0〉
    d: 〈1;#A0〉
  }
