    T1: func(a: int) -> int
    T2: func(a?: int) -> int
    vA: func(a: int) -> int: 〈0;a〉
    orderL: ((〈0;T1〉 & 〈0;T2〉) & 〈0;vA〉)(1)
    orderR: (〈0;T1〉 & (〈0;T2〉 & 〈0;vA〉))(1)
    orderV: ((〈0;T2〉 & 〈0;vA〉) & 〈0;T1〉)(1)
