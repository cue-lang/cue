# Tests unification of CUE function values with function types (bodyless
# signatures, possibly partial/open) and of function types with each other.
# Static checks at unification time cover what is decidable from the
# compiled signatures: parameter names, positions, closedness, whether a
# parameter declares a default, and declared compatibility: the value must
# accept, for each parameter, every value the type admits, and must declare
# a result the type's result admits. Requiredness combines as for struct
# fields and is enforced when a call omits a parameter. The type's
# constraints restrict every call regardless of what the value accepts;
# missing arguments surface when the function is called; two declared
# defaults for the same parameter are unified when the signatures are.
-- in.cue --
@experiment(functions)

import "strings"

tighten: {
	T: func(a: int, ...) -> number

	// The value declares an extra parameter b; T's signature is open, so
	// the extra parameter is allowed and kept.
	f: T & (func(a: int, b: int) -> int: a + b)
	x: f(1, 2)
	y: f(1)

	// Order of unification does not matter.
	fRev: (func(a: int, b: int) -> int: a + b) & T
	xRev: fRev(1, 2)

	// The type's result constraint is enforced on calls through the
	// tightened value, and the value must declare a result the type admits.
	r: (T & (func(a: int) -> int: a))(3)
	retConflict: (func(a: int, ...) -> string) & (func(a: int) -> int: a)
	// A declared result wider than the signature's is rejected too, whatever
	// the body returns.
	retWide: (func(a: int, ...) -> int) & (func(a: int) -> number: 7)

	// The value must accept every value the type admits for a parameter: a
	// string-only value does not satisfy an int signature, whether or not
	// it is ever called.
	s: T & (func(a: string) -> int: 1)
}

closed: {
	U: func(a: int) -> number

	// Matching parameters and a narrower result are admitted: the
	// implementation's int result is within the signature's number.
	g:  U & (func(a: int) -> int: a)
	gx: g(1)

	// A named type may add its contract label to an otherwise unnamed
	// positional implementation slot.
	gN:       U & (func(_~v: int) -> int: v)
	gNx:      gN(1)
	gNByName: gN(a: 2)

	// Two different contract labels for the same positional slot conflict.
	badName: U & (func(b: int) -> int: b)

	// The value requires an extra parameter b, which callers going through
	// the closed type U can never provide.
	bad2: U & (func(a: int, b: int) -> int: a+b)

	// An extra optional parameter is allowed even for a closed type.
	ok3:  U & (func(a: int, b?: int) -> int: a)
	ok3x: ok3(1)
}

anonymous: {
	// An anonymous type parameter matches the value's positional parameter
	// in the same position, and its constraint applies to calls.
	A:  func(int, ...) -> int
	h:  A & (func(n: int) -> int: n + 1)
	hx: h(1)
	he: h("x")

	// A named type parameter is positional too, so it is satisfied by an
	// anonymous value parameter in the same position.
	B:   func(m: int) -> int
	bOk: B & (func(int) -> int: 1)
	bx:  bOk(1)

	// A named positional parameter of the value may be covered by an
	// anonymous parameter of a closed type in the same position.
	C:   func(int) -> int
	cOk: C & (func(n: int) -> int: n)
	cx:  cOk(5)

	// A type constraint matched to an anonymous positional parameter of
	// the value is enforced per call: the argument is bound to a synthetic
	// parameter slot even though the body cannot reference it.
	D:    func(int & <10, ...) -> int
	d:    D & (func(int) -> int: 1)
	dOk:  d(5)
	dOob: d(15)
	// The other way around is not admitted: an implementation accepting
	// only integers below 10 does not cover a signature over every integer.
	dNarrow: (func(int) -> int) & (func(int & <10) -> int: 1)

	// The value's own constraint on an anonymous parameter is enforced on
	// its argument as well.
	f:    func(int) -> int: 1
	fOk:  f(1)
	fBad: f("x")

	// Arity errors take precedence: missing and surplus arguments for
	// anonymous parameters are still reported as such.
	few:  f()
	many: f(1, 2)
}

contractLabels: {
	// An attached signature supplies the contract label of the
	// implementation's otherwise unnamed positional slot. The implementation
	// may keep a separate body-local name.
	add1: func(_~x: int) -> int: x + 1
	add1: func(x: int) -> int
	byLabel: add1(x: 2)
	byPosition: add1(2)

	// Another compatible signature may repeat the same contract label.
	add1: func(x: int & <10) -> int
	byRepeatedName: add1(x: 3)

	// Named and unnamed bodyless signatures compose in either order. Once a
	// concrete implementation is attached, the single contract label names
	// their shared slot.
	Named:       func(x: int) -> int
	Unnamed:     func(int) -> int
	identity:    func(_~v: int) -> int: v
	namedFirst:  Named & Unnamed & identity
	unnamedFirst: Unnamed & Named & identity
	namedCall:   namedFirst(x: 6)
	reverseCall: unnamedFirst(x: 7)

	// A constraint from a named signature attached to an unnamed slot follows
	// the same positional match as its contract label.
	limited: func(_~n: int) -> int: n
	limited: func(input: int & <10) -> int
	limitedOK: limited(input: 5)

	// A contributed contract label also binds partial applications.
	sum: func(_~a: int, _~b: int) -> int: a + b
	sum: func(x: int, y: int) -> int
	addLeft: sum(x: 1, ...)
	partial: addLeft(y: 2)
}

meet: {
	// The meet of two open types carries both signatures; the result is
	// open only in the sense that both constituents are open.
	n: (func(a: number, ...) -> number) & (func(a: int, ...) -> int)

	// Calling a type, met or not, remains an error.
	nc: n(1)

	// A value unified with the meet must satisfy both signatures: the number
	// signature requires a value accepting every number, which an int-only
	// value does not.
	v:  n & (func(a: int) -> int: a)
	// A value accepting every number is admitted; calls stay limited to
	// integers by the int signature.
	vn: n & (func(a: number) -> int: 1)
	vx: vn(3)

	// Both types' parameter constraints apply on calls: a string conflicts
	// with both, a float only with the int signature, although the value
	// accepts any number. The value must also declare a result the
	// signatures admit.
	w:   n & (func(a: _) -> int: 1)
	wx:  w("x")
	wx2: w(0.5)
	wr:  n & (func(a: _) -> _: a)

	// Positional parameters align by ordinal, but two different contract
	// labels for the same slot are incompatible.
	badName: (func(a: int) -> int) & (func(b: int) -> int)
	badNameRev: (func(b: int) -> int) & (func(a: int) -> int)

	// A required or optional parameter and a positional parameter with the
	// same label are the same parameter, in either signature. Requiredness
	// combines as for struct fields: a plain parameter is stricter than a
	// required one, which is stricter than an optional one.
	reqNamed:     (func(a!: int) -> int) & (func(a: int, ...) -> int)
	reqNamedV:    (reqNamed & (func(a: int) -> int: a))(2)
	optNamed:     (func(a: int) -> int) & (func(a?: int) -> int)
	optNamedV:    (optNamed & (func(a: int) -> int: a))(a: 3)
	optNamedOmit: (optNamed & (func(a: int) -> int: a))()
	optReq:       (func(a?: int) -> int) & (func(a!: int) -> int)
	optReqV:      (optReq & (func(a?: int) -> int: [if a != _|_ {a}, 0][0]))(a: 4)
	optReqOmit:   (optReq & (func(a?: int) -> int: [if a != _|_ {a}, 0][0]))()

	// The result does not depend on the order of unification.
	T1:     func(a: int) -> int
	T2:     func(a?: int) -> int
	vA:     func(a: int) -> int: a
	orderL: ((T1 & T2) & vA)(1)
	orderR: (T1 & (T2 & vA))(1)
	orderV: ((T2 & vA) & T1)(1)

	// A positional parameter of a type still needs a positional parameter of
	// the value, which decides how the function can be called.
	posNameOnly: (func(a: int) -> int) & (func(a?: int) -> int: 1)

	// A parameter present in only one signature is allowed if the other
	// signature is open.
	wider:  (func(a: int, ...) -> int) & (func(a: int, b: int, ...) -> int)
	widerV: wider & (func(a: int, b: int, c?: int) -> int: a + b)
	widerX: widerV(1, 2)
}

// An extra parameter is admitted against a closed signature iff it is
// optional (?): while unmatched it contributes no parameter, but no call
// needs it either. A sibling positional signature may expose the same label
// and carry its constraint to a slot. One rule governs function tightening
// (both directions), function type meets, and subsumption (see
// internal/core/subsume); see builtins.txtar for builtins.
optionalExtra: {
	// Tightening: an extra optional parameter of the value against a
	// closed type (also covered by closed.ok3).
	V:   func(a: int) -> number
	v1:  V & (func(a: int, b?: int) -> int: a)
	v1x: v1(1)

	// Tightening: an extra optional parameter of the type against a
	// closed value signature.
	W:   func(a: int, b?: int) -> number
	w1:  W & (func(a: int) -> int: a)
	w1x: w1(1)

	// Tightening: an extra plain parameter remains rejected in both
	// directions (see closed.bad2), as does a required one.
	badT: (func(a: int, b: int) -> number) & (func(a: int) -> int: a)
	badV: (func(a: int) -> number) & (func(a: int, b: int) -> int: a)
	badR: (func(a: int) -> number) & (func(a: int, b!: int) -> int: a)

	// Meet: an extra optional parameter of one closed signature is
	// admitted by the other; an extra plain parameter is not.
	m1:   (func(a: int) -> number) & (func(a: int, b?: int) -> int)
	m2:   (func(a: int, b?: int) -> int) & (func(a: int) -> number)
	mBad: (func(a: int) -> number) & (func(a: int, b: int) -> int)

	// A value unified with the meet is checked against, and calls are
	// constrained by, both signatures, regardless of the meet's order.
	m1v:  m1 & (func(a: int) -> int: a)
	m1vx: m1v(1)
	m2v:  m2 & (func(a: int) -> int: a)
	m2vx: m2v(1)

	// Against an open signature, any extra parameter is admitted.
	o1:  (func(a: int, ...) -> number) & (func(a: int, b: int, ...) -> int)
	o1v: o1 & (func(a: int, b: int, c?: int) -> int: a + b)
	o1x: o1v(1, 2)
	o2:  (func(a: int, ...) -> number) & (func(a: int, b?: int) -> int: a)
	o2x: o2(1)
}

values: {
	f: func(a: int) -> int: a
	g: func(a: int) -> int: a

	// Distinct function values compose (see compose below).
	composed:  f & g
	composedX: composed(1)

	// A function value unifies with itself.
	same:  f & f
	sameX: same(1)

	// Values tightened by the same type are equal and unify; the type
	// constraint is recorded once.
	T:     func(a: int, ...) -> number
	t1:    T & f
	t2:    T & f
	both:  t1 & t2
	bothX: both(1)

	// Equality of tightened values also holds for disjunction
	// deduplication: t1 | t2 collapses to a single callable value.
	pick:  t1 | t2
	pickX: pick(1)

	// The order in which types tighten a value does not matter: the
	// recorded type constraints compare as a set, so both orders unify
	// and deduplicate in a disjunction.
	U:      func(a: int & >=0, ...) -> number
	o1:     T & U & f
	o2:     U & T & f
	both2:  o1 & o2
	both2X: both2(1)
	pick2:  o1 | o2
	pick2X: pick2(1)
}

// Tightening must preserve all structural cycle semantics: the cycle
// anchor and call-site identity remain those of the function value being
// called.
// Distinct function values with compatible signatures compose: a call
// evaluates every implementation and unifies the results.
compose: {
	f: func(a: int) -> {...}: {in: a}
	g: func(a~x: int) -> {...}: {out: x + 1}

	fg:     f & g
	fgX:    fg(1)
	fgL:    fg(a: 2)
	gf:     g & f
	gfX:    gf(1)
	three:  f & g & (func(_~v: int) -> _: {w: v})
	threeX: three(3)

	// Composing a function again, in any order, does not add it twice.
	again:  fg & gf & f
	againX: again(1)
	pick:   fg | gf
	pickX:  pick(1)

	// Two evaluations of the same literal in different environments are
	// different values that compose: both give the same result.
	_x: h: func(a: int) -> int: a + 1
	envs:  _x.h & {_x}.h
	envsX: envs(1)

	// Results that do not unify make the call fail, not the composition.
	inc:     func(a: int) -> int: a + 1
	id:      func(a: int) -> int: a
	clash:   inc & id
	clashX:  clash(1)

	// All constraints apply to every implementation.
	lt:  func(a: <10) -> _: {lt: a}
	ltf: lt & f
	ltX: ltf(3)
	ltE: ltf(30)

	// A defaulted parameter of one function cannot be bound, as the other
	// does not declare it: its default applies.
	d:    func(a: int, b: int = 3, c?: int) -> _: {sum: a + b}
	df:   d & f
	dfX:  df(1)
	dfB:  df(1, 2)
	dfC:  df(1, c: 2)
	fd:   f & d
	fdX:  fd(1)
	fdB:  fd(1, 2)
	fdC:  fd(1, c: 2)

	// Requiredness combines as for types.
	req:    func(n!: int) -> _: {n1: n}
	opt:    func(n?: int) -> _: {n2: n}
	ro:     req & opt
	roX:    ro(n: 4)
	roOmit: ro()

	// A type tightens all implementations. Each declares a struct result,
	// which the type's result constrains at every call, filling in what
	// neither promises.
	T:     func(a: int) -> {...}
	tfg:   T & fg
	tfgX:  tfg(1)
	Tin:  func(a: int) -> {in: int, ...}
	tin:  Tin & fg
	tinX: tin(1)

	// Signatures must be compatible.
	labels: f & (func(b: int) -> int: b)
	arity:  f & (func(a: int, b: int) -> int: a)
	// Calls bind positional arguments through either function, so a
	// positional parameter must match a positional one.
	named:  f & (func(a!: int) -> int: a)

	// Builtins do not compose with function values.
	builtin: (func(x: number) -> number: x) & len
}

cycles: {
	T: func(n: int, ...) -> number

	recursive: {
		fn:  T & (func(n: int) -> int: fn(n))
		out: fn(1)
	}

	nesting: {
		sum:   func(a: int, b: int) -> int: a + b
		twice: T & (func(n: int) -> int: sum(n, n))
		out:   twice(twice(2))
		deep:  twice(twice(twice(2)))
	}
}

// Tightening narrows the values a call accepts and returns, beyond mere
// kind checks: bounds and struct restrictions of the type apply to every
// call of the tightened value. The value must still accept the whole domain
// the type declares, and declare a result within the type's result.
narrow: {
	// The type narrows the parameter to a bound, resolved in the type's
	// own scope.
	lim: 10
	T:   func(n: <lim, ...) -> number
	f:   T & (func(n: number) -> number: n + 1)

	ok:  f(5)
	oob: f(15)

	// The type narrows the result: the value's result must satisfy it per
	// call.
	R:  func(n: int, ...) -> <100
	sq: R & (func(n: int) -> int & <100: n * n)

	small: sq(5)
	big:   sq(20)

	// The type restricts a struct parameter: a required field with a
	// narrower type than the value itself demands.
	S:    func(cfg: {name: string, port: >0 & <65536}, ...) -> string
	srv:  S & (func(cfg: {...}) -> string: cfg.name)

	good: srv({name: "db", port: 5432})
	badField: srv({name: 42, port: 80})
	badPort:  srv({name: "db", port: 0})

	// Narrowing stacks across a chain of tightenings.
	N:  func(n: >=0, ...) -> number
	M:  func(n: <10, ...) -> number
	g:  N & M & (func(n: number) -> number: n)

	mid: g(5)
	neg: g(-1)
	hi:  g(11)
}

// Declared compatibility: a value unified with a bodyless signature must
// accept every value the signature admits for each parameter and declare a
// result the signature's result admits. Each value is checked against each
// signature on its own, in any grouping; another value or the constraints
// enforced per call cannot make up for a declaration that falls short, and
// the signatures keep restricting calls regardless.
admission: {
	// A wider value satisfies an int signature, whose int constraint still
	// fences calls.
	#f: func(x: int) -> int
	#f: func(x: number) -> int: 2
	fOK:  #f(1)
	fBad: #f(1.5)

	// Two signatures require int and number coverage while calls remain
	// limited to int. An int-only value fails the number requirement in
	// every grouping; a number-capable one passes.
	I: func(x: int) -> string
	N: func(x: number) -> string
	b: func(x: int) -> string: "int"
	w: func(x: number) -> string: "number"
	bad1: I & (N & b)
	bad2: (I & N) & b
	bad3: (b & I) & N
	ok1:  (I & (N & w))(1)
	ok2:  ((I & N) & w)(1)
	okF:  ((I & N) & w)(1.5)

	// A value declaring a wider result than required fails, even beside a
	// conforming value and even though both would return 1; a call-side
	// result constraint does not stand in for the declaration.
	R:   func(x: int) -> int
	W:   func(x: int) -> number: 1
	C:   func(x: int) -> int: 1
	rw:  R & W
	rwc: R & W & C
	wcr: W & (C & R)
	rc:  (R & C)(1)
	rwx: (R & W)(1)

	// An int-only callback does not satisfy a consumer entitled to call it
	// with any number, whether or not the consumer does so.
	apply:  func(f: func(number) -> int, x: number) -> int: f(x)
	cbInt:  func(x: int) -> int: 1
	cbNum:  func(x: number) -> int: 1
	hofBad: apply(cbInt, 1)
	hofOK:  apply(cbNum, 1.5)

	// Distinct recursive signatures compare approximately for admission.
	// Avoid structural descent through their signatures. These calls do not
	// execute the callbacks.
	#RecA: func(f: #RecA) -> int
	#RecB: func(f: #RecB) -> int
	recDistinct: (func(f: #RecA) -> int) & (func(f: #RecB) -> int: 1)
	recDistinctX: recDistinct(#RecA)
	#RetA: func() -> #RetA
	#RetB: func() -> #RetB
	recResult: (func(f: #RetA) -> int) & (func(f: #RetB) -> int: 1)
	recResultX: recResult(#RetA)
	#OpenA: func(f: #OpenA, ...) -> int
	#OpenB: func(f: #OpenB, ...) -> int
	recOpen: (func(f: #OpenA) -> int) & (func(f: #OpenB) -> int: 1)
	recOpenX: recOpen(#OpenA)

	// Structural comparisons can reach recursive signatures inside a field
	// or element. An undecided function comparison must not hide a definite
	// mismatch in a later field or element.
	recStruct: (func(v: {f: #RecA}) -> int) & (func(v: {f: #RecB}) -> int: 1)
	recStructX: recStruct({f: #RecA})
	recList: (func(v: [#RecA]) -> int) & (func(v: [#RecB]) -> int: 1)
	recListX: recList([#RecA])
	recStructBad: (func(v: {f: #RecA, x: string}) -> int) & (func(v: {f: #RecB, x: int}) -> int: 1)
	recListBad: (func(v: [#RecA, string]) -> int) & (func(v: [#RecB, int]) -> int: 1)
	recKindBad: (func(v: int) -> int) & (func(v: #RecA) -> int: 1)
	recKindReverseBad: (func(v: #RecA) -> int) & (func(v: int) -> int: 1)
	recStructKindBad: (func(v: {f: int}) -> int) & (func(v: {f: #RecA}) -> int: 1)
	recListKindBad: (func(v: [int]) -> int) & (func(v: [#RecA]) -> int: 1)

	// A signature over any value requires a value accepting any value.
	Any:    func(_) -> _
	anyBad: Any & (func(x: int) -> int: x)
	anyOK:  (Any & (func(x: _) -> _: x))("s")

	// A value without a signature is bound by its own declaration alone.
	direct: func(x: int) -> int: x
	dOK:    direct(1)
	dBad:   direct(1.5)

	// Constraints referring to definitions are compared by their values:
	// int covers an integer bound, while a positive bound does not cover it.
	#Small: int & <10
	S:    func(x: #Small) -> int
	sOK:  (S & (func(x: int) -> int: x))(3)
	sBad: S & (func(x: #Small & >0) -> int: x)

	// A declaration referring to a definition means its final value: with
	// #Res narrowed to int, a value declared to return #Res satisfies an int
	// requirement.
	#Res: number
	#Res: int
	Q:    func(x: int) -> int
	q:    (Q & (func(x: int) -> #Res: x))(2)

	// Compound constraints compare by their evaluated values.
	sp:  func(x: {n: int}) -> {m: int}
	sp:  func(x: {n: int}) -> {m: int}: {m: x.n}
	spX: sp({n: 1})
	lp:  func(x: [int, int]) -> int
	lp:  func(x: [int, int]) -> int: x[0] + x[1]
	lpX: lp([1, 2])

	// A reference to an open list is the same constraint as the literal.
	#L:  [...]
	la:  func(x: int) -> #L
	la:  func(x: int) -> [...]: [x]
	laX: la(1)

	// A union of bounds covers the required domain although no single
	// disjunct does: no witness refutes it. A union of concrete values is
	// refuted by a value it misses.
	dc:  func(x: number) -> int
	dc:  func(x: <=0 | >0) -> int: 1
	dcX: dc(1)
	ec:  func(x: string) -> int
	ec:  func(x: "a" | "b") -> int: 1

	// A constraint referring to a value that a comprehension in the same
	// scope refines is checked against the refined value.
	rf: {
		#R: number
		f:  func(x: int) -> #R: 1
		f:  func(x: int) -> int
		if f(1) == 1 {
			#R: int
		}
		out: f(2)
	}

	// A callback is checked where it is bound, whether or not the callee
	// calls it.
	consume: func(f: func(number) -> int) -> int: 7
	cBad:    consume(cbInt)

	// Validators and regular-expression bounds are decided by witnesses: no
	// candidate value is admitted by these signatures and rejected by their
	// implementations.
	mv:  func(s: strings.MinRunes(1)) -> int
	mv:  func(s: strings.MinRunes(1)) -> int: 1
	mvX: mv("a")
	re:  func(s: =~"^a$") -> int
	re:  func(s: =~"^[a-z]+$") -> int: 1
	reX: re("a")
	// They still reject on kind: an implementation accepting only
	// integers covers neither a validator nor a pattern on strings.
	vk: (func(s: strings.MinRunes(1)) -> int) & (func(s: int) -> int: 1)
	rk: (func(s: =~"a") -> int) & (func(s: int) -> int: 1)
	// A string implementation covers both pattern signatures, and calls
	// still satisfy both: "c" fails each pattern, "ab" matches both.
	#rx:  func(x: =~"a") -> int
	#rx:  func(x: =~"b") -> int
	#rx:  func(x: string) -> int: 1
	rxC:  #rx("c")
	rxAB: #rx("ab")

	// A disjunct that fails admission is eliminated like any other
	// erroneous alternative.
	alt: (((func(x: number) -> int) & (func(x: int) -> int: x)) | *7)

	// A reference to a value that an outer scope refines after a call
	// leaves the check undone rather than rejecting on the provisional
	// value.
	#O: number
	ov: {
		f:   (func(x: int) -> #O: 1) & (func(x: int) -> int)
		out: f(1)
	}
	if ov.out == 1 {
		#O: int
	}

	// Function-valued constraints compare approximately, as structural
	// function subsumption is covariant in parameters; a bound that admits
	// every value of a kind is decided exactly.
	hs:  func(g: func({n: int}) -> int) -> int
	hs:  func(g: func({n: int}) -> int) -> int: g({n: 1})
	hsX: hs(func(v: {n: int}) -> int: v.n)
	hv:  func(x: int) -> (func(int) -> int)
	hv:  func(x: int) -> (func(number) -> int): func(y: number) -> int: x
	hvX: hv(2)(3)
	nn:  func() -> !=null
	nn:  func() -> int: 1
	nnX: nn()
	lsp:  func(x: [...{n: int}]) -> int
	lsp:  func(x: [...{n: int}]) -> int: len(x)
	lspX: lsp([{n: 1}])

	// A pending reference inside a compound constraint is recognized too.
	#P: number
	pc: {
		f:   (func(x: int) -> (#P & number): 1) & (func(x: int) -> int)
		out: f(1)
	}
	if pc.out == 1 {
		#P: int
	}

	// An exhaustive union of concrete values covers a finite kind; a default
	// preference is no obligation; a struct is not null.
	bl:  func(x: bool) -> int
	bl:  func(x: true | false) -> int: 1
	blX: bl(true)
	#A:  *"a" | "b"
	da:  func(x: #A) -> int
	da:  func(x: "a" | "b") -> int: 1
	daX: da("b")
	ns:  func() -> !=null
	ns:  func() -> {}: {}
	nsX: ns()

	// A pending reference inside a struct literal is recognized too.
	#Q: number
	qc: {
		f:   (func() -> {v: #Q}: {v: 1}) & (func() -> {v: int})
		out: f().v
	}
	if qc.out == 1 {
		#Q: int
	}

	// Bounds compare with bytes, with other bounds, and with whole kinds.
	by:  func() -> !='bad'
	by:  func() -> 'ok': 'ok'
	byX: by()
	nb:  func(x: >0) -> int
	nb:  func(x: !=null) -> int: 1
	nbX: nb(1)
	ge:  func(x: string) -> int
	ge:  func(x: >="") -> int: 1
	geX: ge("a")

	// A pending reference inside a pattern constraint is recognized too.
	#W: number
	wc: {
		f:   (func() -> {[string]: #W}: {v: 1}) & (func() -> {[string]: int})
		out: f().v
	}
	if wc.out == 1 {
		#W: int
	}

	// Integers and floats are comparable, and a numeric bound admits only
	// numbers: != 5.0 admits neither every int nor any string.
	ne:  func() -> !=5.0
	ne:  func() -> int: 1
	nes: func() -> !=5.0
	nes: func() -> string: "a"

	// Only a proof rejects: a kind that the implementation excludes, or a
	// value that the signature admits and the implementation does not. So an
	// open struct naming some of a definition's fields covers it, a regular
	// field covers a required one, a field the implementation adds or
	// defaults covers its absence, an enumeration covers a pattern or bounds
	// admitting exactly its values, a value covers a constraint admitting
	// only it, and a constraint covers only the kinds it actually admits.
	#Person: {first: string, last: string, full: "\(first) \(last)"}
	greet:   func(p: #Person) -> string
	greet:   func(p: {first: string, ...}) -> string: "hi \(p.first)"
	greetX:  greet({first: "A", last: "B"})
	pat:     (func(p: {[string]~V: {name: V}}) -> int) & (func(p: {[string]~V: {name: V}}) -> int: 1)
	patX:    pat({})
	req:     (func(x: {a!: int}) -> int) & (func(x: {a: int}) -> int: x.a)
	reqX:    req({a: 2})
	rxe:     (func(x: =~"^[ab]$") -> int) & (func(x: "a" | "b") -> int: 1)
	rxeX:    rxe("b")
	bde:     (func(x: int & >=0 & <=2) -> int) & (func(x: 0 | 1 | 2) -> int: 1)
	bdeX:    bde(2)
	one:     (func(x: =~"^a$") -> int) & (func(x: "a") -> int: 1)
	oneX:    one("a")
	oneN:    (func(x: int & >=1 & <2) -> int) & (func(x: 1) -> int: 1)
	oneNX:   oneN(1)
	cfg:     (func(c: {port?: int}) -> int) & (func(c: {port: *8080 | int}) -> int: c.port)
	cfgX:    cfg({})
	pr:      (func() -> {in: int, ...}) & (func() -> {...}: {in: 1})
	prX:     pr().in
	#ID:     matchN(1, [int, string])
	id:      (func(x: #ID) -> int) & (func(x: int | string) -> int: 1)
	idX:     id(3)
	unit:    (func(x: >0 & <1) -> int) & (func(x: float) -> int: 1)
	unitX:   unit(0.5)
	// The same comparisons reject where the signature admits more.
	rxeBad: (func(x: =~"^[a-z]$") -> int) & (func(x: "a" | "b") -> int: 1)
	bdeBad: (func(x: int & >=0 & <=3) -> int) & (func(x: 0 | 1 | 2) -> int: 1)
	stBad:  (func(p: {n: int}) -> int) & (func(p: {n: string}) -> int: 1)
	idBad:  (func(x: #ID) -> int) & (func(x: bool) -> int: 1)
	tlBad:  (func(x: [...string]) -> int) & (func(x: [...int]) -> int: 1)
	lnBad:  (func(x: [int, int]) -> int) & (func(x: [int]) -> int: 1)

	// A field that another part of the signature's struct refers to may be
	// restricted beyond its own constraint, so a value it admits alone is no
	// witness; fields nothing refers to still are. A constraint that admits
	// no value of a kind it names, as no string is below "", refutes nothing
	// of that kind, and neither does a list no value satisfies.
	corr:    (func(x: {a: int, b: 0 & a}) -> int) & (func(x: {a: 0, b: 0}) -> int: 0)
	corrX:   corr({a: 0})
	corrIf:  (func(x: {a: int, if a > 0 {b: 1}}) -> int) & (func(x: {a: 0, ...}) -> int: 0)
	corrIfX: corrIf({a: 0})
	corrBad: (func(x: {a: int, b: 0 & a, d: string}) -> int) & (func(x: {a: 0, b: 0, d: int}) -> int: 0)
	emp:     (func(x: int | <"") -> int) & (func(x: int) -> int: x)
	empX:    emp(1)
	empL:    (func(x: [...<""]) -> int) & (func(x: []) -> int: 1)
	empLX:   empL([])
	empN:    (func(x: [<""]) -> int) & (func(x: [int, int]) -> int: 1)
	empNX:   len([empN])
	empBad:  (func(x: int | <"b") -> int) & (func(x: int) -> int: x)

	// A value that a comprehension refines is pending behind a call too.
	#PC: number
	getPC: func() -> _: #PC
	pcall: {
		f:   (func() -> getPC(): 1) & (func() -> int)
		out: f()
	}
	if pcall.out == 1 {
		#PC: int
	}

	// Whether a constraint is pending does not depend on the order of
	// fields: a definition that has not been evaluated yet is decided like
	// one that has.
	late:   (func(x: #Late) -> int) & (func(x: string) -> int: 1)
	#Late:  int
	#Early: int
	early:  (func(x: #Early) -> int) & (func(x: string) -> int: 1)

	// A pending reference inside a list comprehension or a let of a struct
	// literal is recognized too.
	#LC: number
	lc: {
		f:   (func() -> [for x in [1] {#LC}]: [1]) & (func() -> [int])
		out: f()[0]
	}
	if lc.out == 1 {
		#LC: int
	}
	#LT: number
	lt: {
		f:   (func() -> {let y = #LT, v: y}: {v: 1}) & (func() -> {v: int})
		out: f().v
	}
	if lt.out == 1 {
		#LT: int
	}
}
// Declared defaults are part of a signature. A default on one side carries
// over to a call; defaults on both sides must unify and conflict when the
// signatures are unified; a defaulted parameter is admitted beyond a closed
// type like an optional one; a partial application keeps the defaults of the
// parameters it leaves unbound.
defaults: {
	T: func(a: int = 2) -> int

	// The type's default fills a value parameter that declares none.
	fill:  T & (func(a: int) -> int: a)
	fillX: fill()
	fillS: fill(5)

	// Order of unification does not matter.
	fillRev:  (func(a: int) -> int: a) & T
	fillRevX: fillRev()

	// Equal defaults agree.
	same:  T & (func(a: int = 2) -> int: a)
	sameX: same()

	// Differing defaults conflict when the signatures are unified.
	differ: T & (func(a: int = 3) -> int: a)
	differRev: (func(a: int = 3) -> int: a) & T

	// Two types with defaults for different parameters: each one-sided
	// default carries over, and a value's own default must agree with the
	// type's for the same parameter.
	A:      func(a: int = 2, ...) -> string
	B:      func(a: int, b: string = "x") -> string
	three:  A & B & (func(a: int, b: string) -> string: "\(a)\(b)")
	threeX: three()
	threeRev:  B & (func(a: int, b: string) -> string: "\(a)\(b)") & A
	threeRevX: threeRev()
	threeBad:  A & (func(a: int = 4, b: string) -> string: "\(a)\(b)") & B

	// A value's extra defaulted parameter is admitted beyond a closed type,
	// as an optional one is: no call through the type ever needs it.
	C:      func(a: int) -> int
	extra:  C & (func(a: int, b: int = 2) -> int: a + b)
	extraX: extra(1)
	extraBad: C & (func(a: int, b: int) -> int: a + b)

	// The reverse: a type's defaulted parameter that the value does not
	// declare is admitted like an optional one.
	D:      func(a: int, b: int = 2) -> int
	lacks:  D & (func(a: int) -> int: a)
	lacksX: lacks(1)

	// A partial application binds arguments, not defaults: bound parameters
	// lose their default, the remaining ones keep it until completion.
	add3: func(a: int, b: int = 10, c: int = 100) -> int: a + b + c
	f:    add3(1, ...)
	all:  f()
	one:  f(2)
	lab:  f(c: 3)
	two:  add3(1, 2, ...)()

	// Agreement does not depend on the operand order, also when a named
	// and a positional-only parameter share a slot.
	Bn:     func(_~x: int = 3) -> int
	orderX: T & Bn
	orderY: Bn & T

	// Admission beyond a closed type depends on the value's own declaration.
	// A default declared only by another attached type does not admit the
	// parameter, so the outcome does not depend on the order in which the
	// signatures are attached: a closed type restricts the value whatever
	// else is attached, as a closed struct restricts its fields.
	v2:      func(a: int, b: int) -> int: a + b
	D2:      func(a: int, b: int = 2) -> int
	C2:      func(a: int) -> int
	orderDC: (v2 & D2) & C2
	orderCD: (v2 & C2) & D2
	orderTV: C2 & D2 & v2

	// The value's own default admits it, in any order, and the two types
	// agree with each other on their own: D2's default admits b beyond C2.
	v3:    func(a: int, b: int = 2) -> int: a + b
	ownDC: ((v3 & D2) & C2)(1)
	ownCD: ((v3 & C2) & D2)(1)
	ownTV: ((C2 & D2) & v3)(1)

	// A default attached by a type carries into a call made as the argument
	// of another call.
	id:           func(x: int) -> int: x
	nestedDirect: fill()
	nestedCall:   id(fill())
}
// A consumer's parameter signature entitles it to call the argument with
// every value the signature admits. A caller clause of the supplied function
// that permits less is rejected where the argument is bound, whether or not
// the consumer makes such a call (the implementation's own declaration is
// checked separately, see admission.hofBad).
entitlement: {
	#Cb:   func(x: int) -> int
	cb:    #Cb & (func(x: number) -> int: 1)
	loud:  func(g: func(number) -> int) -> int: g(1.5)
	quiet: func(g: func(number) -> int) -> int: 7
	bad1:  loud(cb)
	bad2:  quiet(cb)

	// No clause, or a clause as wide as the entitlement, is admitted.
	cbW:  func(x: number) -> int: 1
	#CbN: func(x: number) -> int
	cbN:  #CbN & cbW
	ok1:  loud(cbW)
	ok2:  quiet(cbN)
	ok3:  loud(cbN)

	// An entitlement no wider than the clause is admitted; the clause keeps
	// fencing the consumer's calls.
	narrow: func(g: func(int) -> int) -> int: g(2)
	ok4:    narrow(cb)
	nFrac:  func(g: func(int) -> int) -> int: g(1.5)
	bad3:   nFrac(cb)

	// The signature may be reached through a definition or a conjunction;
	// every signature counts.
	#G:     func(number) -> int
	viaDef: func(g: #G) -> int: 7
	bad4:   viaDef(cb)
	conj:   func(g: #G & func(_) -> int) -> int: 7
	cbAny:  func(x: _) -> int: 1
	bad5:   conj(cbN)
	ok5:    conj(cbAny)
	// The implementation's own declaration is still checked by admission.
	bad5b:  conj(cbW)

	// A signature attached to the consumer constrains its parameters too.
	#Consumer: func(g: func(number) -> int) -> int
	attached:  #Consumer & (func(g: func(_) -> int) -> int: 7)
	bad6:      attached(cb)
	ok6:       attached(cbAny)

	// A supplied builtin is checked through its attached signatures.
	up:    (func(s: string) -> string) & strings.ToUpper
	anyIn: func(g: func(_) -> string) -> string: g("x")
	bad7:  anyIn(up)
	strIn: func(g: func(string) -> string) -> string: g("x")
	ok7:   strIn(up)

	// A partial application binds and checks the argument at once.
	apply2: func(g: func(number) -> int, x: number) -> int: g(x)
	bad8:   apply2(cb, ...)
	ok8:    apply2(cbW, ...)(1.5)
	// A partially applied argument is left to the binding, which cannot
	// tighten it; its clauses still describe the parameter it has bound.
	#Ap:    func(g: func(number) -> int, x: number) -> int
	ap:     #Ap & (func(g: func(number) -> int, x: number) -> int: g(x))
	part:   ap(cbW, ...)
	bad15:  quiet(part)

	// A clause that no witness refutes admits; the call still fences.
	#CbD: func(x: <=0 | >0) -> int
	cbD:  #CbD & cbW
	ok9:  loud(cbD)

	// A labeled entitlement matches the clause's parameter in the slot the
	// label binds.
	#CbL: func(a: int) -> int
	cbL:  #CbL & (func(a: number) -> int: 1)
	lab:  func(g: func(a: number) -> int) -> int: g(a: 1.5)
	bad9: lab(cbL)

	// The supplied function may be reached through an alias or a field.
	alias: cb
	obj: {f: cb}
	bad10: quiet(alias)
	bad11: quiet(obj.f)

	// A default supplies the argument and is checked the same way, whether
	// the function or an attached signature declares it.
	dq:    func(g: func(number) -> int = cb) -> int: 7
	bad12: dq()
	ok10:  dq(cbW)
	#DQ:   func(g: func(number) -> int = cb) -> int
	dq2:   #DQ & (func(g: func(number) -> int) -> int: 7)
	bad13: dq2()

	// A label the consumer's signature introduces binds a clause parameter
	// that matched no slot before.
	cbOpt:  (func(a?: int, ...) -> int) & (func(number) -> int: 1)
	labOpt: func(g: func(a: number) -> int) -> int: g(a: 1.5)
	bad14:  labOpt(cbOpt)

	// Only a literal or a reference is inspected at the binding. An argument
	// or a signature computed by an expression is left to the call, which
	// still enforces the fence; evaluating it at the binding would run ahead
	// of the call's cycle detection (see rec below).
	lim1:   quiet(cb | cb)
	mkSig:  func() -> _: func(number) -> int
	made:   func(g: mkSig()) -> int: 7
	lim2:   made(cb)
	madeL:  func(g: mkSig()) -> int: g(1.5)
	lim3:   madeL(cb)
	rec:    func(g: func() -> int = rec()) -> _: (func() -> int: 1)
	recBad: rec()
	rec2:    func(g: func() -> int = rec2().a) -> _: {a: func() -> int: 1}
	rec2Bad: rec2()
	// A constraint that would call the function is not compared either,
	// whatever form the call takes.
	fcb:      func(g: func(x: fcb(cb)) -> int) -> int: 1
	fcbOut:   fcb(cb)
	cbA:      #Cb & cbAny
	fsl:      func(g: func(x: fsl(cbA)[:]) -> int) -> _: [1]
	fslOut:   fsl(cbA)[0]
	fcomp:    func(g: func(x: [for y in fcomp(cbA) {y}]) -> int) -> _: [1]
	fcompOut: fcomp(cbA)[0]
}

-- out/compile --
--- in.cue
{
  tighten: {
    T: func(a: int, ...) -> number
    f: (〈0;T〉 & func(a: int, b: int) -> int: (〈0;a〉 + 〈0;b〉))
    x: 〈0;f〉(1, 2)
    y: 〈0;f〉(1)
    fRev: (func(a: int, b: int) -> int: (〈0;a〉 + 〈0;b〉) & 〈0;T〉)
    xRev: 〈0;fRev〉(1, 2)
    r: (〈0;T〉 & func(a: int) -> int: 〈0;a〉)(3)
    retConflict: (func(a: int, ...) -> string & func(a: int) -> int: 〈0;a〉)
    retWide: (func(a: int, ...) -> int & func(a: int) -> number: 7)
    s: (〈0;T〉 & func(a: string) -> int: 1)
  }
  closed: {
    U: func(a: int) -> number
    g: (〈0;U〉 & func(a: int) -> int: 〈0;a〉)
    gx: 〈0;g〉(1)
    gN: (〈0;U〉 & func(int) -> int: 〈0;v〉)
    gNx: 〈0;gN〉(1)
    gNByName: 〈0;gN〉(a: 2)
    badName: (〈0;U〉 & func(b: int) -> int: 〈0;b〉)
    bad2: (〈0;U〉 & func(a: int, b: int) -> int: (〈0;a〉 + 〈0;b〉))
    ok3: (〈0;U〉 & func(a: int, b?: int) -> int: 〈0;a〉)
    ok3x: 〈0;ok3〉(1)
  }
  anonymous: {
    A: func(int, ...) -> int
    h: (〈0;A〉 & func(n: int) -> int: (〈0;n〉 + 1))
    hx: 〈0;h〉(1)
    he: 〈0;h〉("x")
    B: func(m: int) -> int
    bOk: (〈0;B〉 & func(int) -> int: 1)
    bx: 〈0;bOk〉(1)
    C: func(int) -> int
    cOk: (〈0;C〉 & func(n: int) -> int: 〈0;n〉)
    cx: 〈0;cOk〉(5)
    D: func((int & <10), ...) -> int
    d: (〈0;D〉 & func(int) -> int: 1)
    dOk: 〈0;d〉(5)
    dOob: 〈0;d〉(15)
    dNarrow: (func(int) -> int & func((int & <10)) -> int: 1)
    f: func(int) -> int: 1
    fOk: 〈0;f〉(1)
    fBad: 〈0;f〉("x")
    few: 〈0;f〉()
    many: 〈0;f〉(1, 2)
  }
  contractLabels: {
    add1: func(int) -> int: (〈0;x〉 + 1)
    add1: func(x: int) -> int
    byLabel: 〈0;add1〉(x: 2)
    byPosition: 〈0;add1〉(2)
    add1: func(x: (int & <10)) -> int
    byRepeatedName: 〈0;add1〉(x: 3)
    Named: func(x: int) -> int
    Unnamed: func(int) -> int
    identity: func(int) -> int: 〈0;v〉
    namedFirst: ((〈0;Named〉 & 〈0;Unnamed〉) & 〈0;identity〉)
    unnamedFirst: ((〈0;Unnamed〉 & 〈0;Named〉) & 〈0;identity〉)
    namedCall: 〈0;namedFirst〉(x: 6)
    reverseCall: 〈0;unnamedFirst〉(x: 7)
    limited: func(int) -> int: 〈0;n〉
    limited: func(input: (int & <10)) -> int
    limitedOK: 〈0;limited〉(input: 5)
    sum: func(int, int) -> int: (〈0;a〉 + 〈0;b〉)
    sum: func(x: int, y: int) -> int
    addLeft: 〈0;sum〉(x: 1)
    partial: 〈0;addLeft〉(y: 2)
  }
  meet: {
    n: (func(a: number, ...) -> number & func(a: int, ...) -> int)
    nc: 〈0;n〉(1)
    v: (〈0;n〉 & func(a: int) -> int: 〈0;a〉)
    vn: (〈0;n〉 & func(a: number) -> int: 1)
    vx: 〈0;vn〉(3)
    w: (〈0;n〉 & func(a: _) -> int: 1)
    wx: 〈0;w〉("x")
    wx2: 〈0;w〉(0.5)
    wr: (〈0;n〉 & func(a: _) -> _: 〈0;a〉)
    badName: (func(a: int) -> int & func(b: int) -> int)
    badNameRev: (func(b: int) -> int & func(a: int) -> int)
    reqNamed: (func(a!: int) -> int & func(a: int, ...) -> int)
    reqNamedV: (〈0;reqNamed〉 & func(a: int) -> int: 〈0;a〉)(2)
    optNamed: (func(a: int) -> int & func(a?: int) -> int)
    optNamedV: (〈0;optNamed〉 & func(a: int) -> int: 〈0;a〉)(a: 3)
    optNamedOmit: (〈0;optNamed〉 & func(a: int) -> int: 〈0;a〉)()
    optReq: (func(a?: int) -> int & func(a!: int) -> int)
    optReqV: (〈0;optReq〉 & func(a?: int) -> int: [
      if (〈1;a〉 != _|_(explicit error (_|_ literal) in source)) {
