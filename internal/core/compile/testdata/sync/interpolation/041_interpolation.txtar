-- in.cue --
a: "\(4)"
b: "one \(a) two \( a+c )"
c: "one"
d: "\(r)"
u: "\(_)" // literal _ can never resolve.
r: _
e: "\([])"

// The error names each value of a non-concrete conjunction.
bounds: >=0 & <=10
f: "\(bounds)"
#D: >=0
split: #D & <=10
g: "\(split)"
fromAnd: and([>=0, <=10])
h: "\(fromAnd)"
-- out/compile --
--- in.cue
{
  a: "\(4)"
  b: "one \(〈0;a〉) two \((〈0;a〉 + 〈0;c〉))"
  c: "one"
  d: "\(〈0;r〉)"
  u: "\(_)"
  r: _
  e: "\([])"
  bounds: (>=0 & <=10)
  f: "\(〈0;bounds〉)"
  #D: >=0
  split: (〈0;#D〉 & <=10)
  g: "\(〈0;split〉)"
  fromAnd: and([
    >=0,
    <=10,
  ])
  h: "\(〈0;fromAnd〉)"
}
