# A trailing ..._|_ closes a list literal: the literal limits the length of
# the list, one level deep, as a list literal without an ellipsis does,
# rather than adding a pattern that further elements fail. The two read the
# same for unification; they differ for observers such as indexing.
-- in.cue --
length: {
	x: [1, ..._|_]
	x: [_, 2]
}

empty: {
	x: [..._|_] & [1]
}

// The literal closes one level: its elements keep their own closedness.
oneLevel: {
	x: [{a: 1}, ..._|_] & [{a: 1, b: 2}]
}

// The literal stays a list literal: it can refer to its own elements and
// keeps the closedness a definition gives its elements.
selfRef: {
	l: [1, l[0] + 1, ..._|_]
}

defElems: {
	#D: [{a: int}, ..._|_]
	err: #D & [{a: 1, b: 2}]
}

// An index past the end of the list is an error, not incomplete.
index: {
	x: [1, ..._|_][3]
}

open: {
	x: [1, ..._|_] & [...int]
	n: len(x)
}
-- out/compile --
--- in.cue
{
  length: {
    x: [
      1,
      ..._|_(explicit error (_|_ literal) in source),
    ]
    x: [
      _,
      2,
    ]
  }
  empty: {
    x: ([
      ..._|_(explicit error (_|_ literal) in source),
    ] & [
      1,
    ])
  }
  oneLevel: {
    x: ([
      {
        a: 1
      },
      ..._|_(explicit error (_|_ literal) in source),
    ] & [
      {
        a: 1
        b: 2
      },
    ])
  }
  selfRef: {
    l: [
      1,
      (〈1;l〉[0] + 1),
      ..._|_(explicit error (_|_ literal) in source),
    ]
  }
  defElems: {
    #D: [
      {
        a: int
      },
      ..._|_(explicit error (_|_ literal) in source),
    ]
    err: (〈0;#D〉 & [
      {
        a: 1
        b: 2
      },
    ])
  }
  index: {
    x: [
      1,
      ..._|_(explicit error (_|_ literal) in source),
    ][3]
  }
  open: {
    x: ([
      1,
      ..._|_(explicit error (_|_ literal) in source),
    ] & [
      ...int,
    ])
    n: len(〈0;x〉)
  }
}
