-- references.cue --
missingField: {
	a: {}
	r: a.b
}

missingFieldClosed: {
	#a: {}
	r: #a.b
}

missingFieldNested: {
	a: {}
	// Must refer to `b` in error
	r: a.b.c
}

missingFieldNestedClosed: {
	#a: {}

	// Must refer to `d` in error
	r: #a.d.c
}

missingFieldNestedInInterpolation: {
	a: {}
	// Must refer to `b` in error
	r1: "\(a.b.c)"
	// Must refer to `d` in error: in case only one error is shown for a
	// a location, ensure it doesn't alphabetically sort and pick `c` instead.
	r2: "\(a.d.c)"
}

// Selecting from a struct with erroneous fields reports all of their errors.
erroneousFields: {
	#a: {b: 1 & 2, c: 3 & 4}
	r: #a.d // The error of field c is missing.
}

// As above, with erroneous fields in a nested struct.
nestedFields: {
	#a: {b: {p: 1 & 2, q: 3 & 4}, c: 5 & 6}
	r: #a.d // The errors of fields b.q and c are missing.
}
-- out/compile --
--- references.cue
{
  missingField: {
    a: {}
    r: 〈0;a〉.b
  }
  missingFieldClosed: {
    #a: {}
    r: 〈0;#a〉.b
  }
  missingFieldNested: {
    a: {}
    r: 〈0;a〉.b.c
  }
  missingFieldNestedClosed: {
    #a: {}
    r: 〈0;#a〉.d.c
  }
  missingFieldNestedInInterpolation: {
    a: {}
    r1: "\(〈0;a〉.b.c)"
    r2: "\(〈0;a〉.d.c)"
  }
  erroneousFields: {
    #a: {
      b: (1 & 2)
      c: (3 & 4)
    }
    r: 〈0;#a〉.d
  }
  nestedFields: {
    #a: {
      b: {
        p: (1 & 2)
        q: (3 & 4)
      }
      c: (5 & 6)
    }
    r: 〈0;#a〉.d
  }
}
