-- in.cue --
// Label aliases

// direct
a: [string]~(X,_): X
a: bar:            _

// in struct
b: [string]~(X,_): {X}
b: bar:            _

// in structs
c: [string]~(X,_): X
c: [string]~(Y,_): {{{Y}}}
c: bar:            _

// in sub field
d: [string]~(X,_): name: X
d: bar: {}

// nested
e: [string]~(X,_): [string]~(Y,_): X + Y
e: foo: bar:                       _

patternField: t1: {
	[string]~(r): {b: r | null}
	a:            {r: 0}
}

patternField: t2: {
	a:            {r: 0}
	[string]~(x): {z: 1, b: x.z}
}

// Field aliases

bar: 3
f1: "foo\(bar)"~(C): {
	name: "xx"
	foo:  C.name
}

// nested
f1: "foo\(bar)"~(D): "foo\(bar)baz"~(E): {
	name: "xx"
	a:    D["foo\(bar)baz"].name
	b:    E.name
}

// Combo

c1: "foo\(bar)"~(C): [string]~(D,_): {
	name: D
	foo:  C.x.name
}
c1: foo3: x: _

emptyLabel: {
	"": 1
	a:  emptyLabel[""]
}

underscore: a: {
	// Issue #1454
	foo: #Foo
	foo: "_":     "bar"
	#Foo: [=~""]: string
}

underscore: c: {
	foo: "_":    "any"
	foo: [=~""]: string
}

underscore: d: {
	bar: "_":       "any"
	#bar: [string]: string
	bar: #bar
}

underscore: e: {
	baz: "_h":     "any"
	#baz: [=~"_"]: string
	baz: #baz
}

valueAliasSelf: {
	pattern: [string]~(_,C): {
		name: "x"
		foo:  C.name
	}
	applied: pattern & {x: _}
}

invalidPattern: {
	[=~"BAD)" & =~"x"]: string
	y:                  123
}
-- out/compile --
--- in.cue
{
  a: {
    [string]: 〈0;-〉
  }
  a: {
    bar: _
  }
  b: {
    [string]: {
      〈1;-〉
    }
  }
  b: {
    bar: _
  }
  c: {
    [string]: 〈0;-〉
  }
  c: {
    [string]: {
      {
        {
          〈3;-〉
        }
      }
    }
  }
  c: {
    bar: _
  }
  d: {
    [string]: {
      name: 〈1;-〉
    }
  }
  d: {
    bar: {}
  }
  e: {
    [string]: {
      [string]: (〈1;-〉 + 〈0;-〉)
    }
  }
  e: {
    foo: {
      bar: _
    }
  }
  patternField: {
    t1: {
      [string]: {
        b: (〈1;(〈0;-〉)〉|null)
      }
      a: {
        r: 0
      }
    }
  }
  patternField: {
    t2: {
      a: {
        r: 0
      }
      [string]: {
        z: 1
        b: 〈1;(〈0;-〉)〉.z
      }
    }
  }
  bar: 3
  f1: {
    "foo\(〈1;bar〉)": {
      name: "xx"
      foo: 〈1;("foo\(〈1;bar〉)")〉.name
    }
  }
  f1: {
    "foo\(〈1;bar〉)": {
      "foo\(〈2;bar〉)baz": {
        name: "xx"
        a: 〈2;("foo\(〈1;bar〉)")〉["foo\(〈3;bar〉)baz"].name
        b: 〈1;("foo\(〈2;bar〉)baz")〉.name
      }
    }
  }
  c1: {
    "foo\(〈1;bar〉)": {
      [string]: {
        name: 〈1;-〉
        foo: 〈2;("foo\(〈1;bar〉)")〉.x.name
      }
    }
  }
  c1: {
    foo3: {
      x: _
    }
  }
  emptyLabel: {
    "": 1
    a: 〈1;emptyLabel〉[""]
  }
  underscore: {
    a: {
      foo: 〈0;#Foo〉
      foo: {
        "_": "bar"
      }
      #Foo: {
        [=~""]: string
      }
    }
  }
  underscore: {
    c: {
      foo: {
        "_": "any"
      }
      foo: {
        [=~""]: string
      }
    }
  }
  underscore: {
    d: {
      bar: {
        "_": "any"
      }
      #bar: {
        [string]: string
      }
      bar: 〈0;#bar〉
    }
  }
  underscore: {
    e: {
      baz: {
        "_h": "any"
      }
      #baz: {
        [=~"_"]: string
      }
      baz: 〈0;#baz〉
    }
  }
  valueAliasSelf: {
    pattern: {
      [string]: {
        name: "x"
        foo: 〈1;(〈0;-〉)〉.name
      }
    }
    applied: (〈0;pattern〉 & {
      x: _
    })
  }
  invalidPattern: {
    [(=~"BAD)" & =~"x")]: string
    y: 123
  }
}
