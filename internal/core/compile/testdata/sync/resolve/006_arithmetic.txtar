# Tests arithmetic operations including division producing floats and
# conflicting types (int & float).
-- in.cue --
v1: 1.0T / 2.0
v2: 2.0 == 2
n1: 1
v5: 2.0 / n1
v6: 1.0 / 1.0
e2: int & 4.0/2.0

// A quotient keeps the decimal places the operation implies. The General
// Decimal Arithmetic specification calls this the ideal exponent, and for
// division it is the dividend's exponent less the divisor's.
// Multiplication already does this: the product of 2.00 and 3 is 6.00.
p1: 2.00 * 3
p2: 6.00 / 3
p3: 2.00 / 4
p4: 1.000 / 8
p5: 1 / 3
// A zero dividend and a negative one keep the decimal places too.
p6: 0.00 / 3
p7: -6.00 / 3
// The ideal exponent applies to exact quotients only. An inexact one keeps
// every digit of the context precision, trailing zeros included, rather than
// being reduced to one digit fewer.
p8: 1 / 33.0
// An exact quotient is reduced towards the ideal exponent only as far as the
// coefficient fits the context precision, so this one has 34 digits, not 42.
p9: 10000000000000000000000000000000000000000.0 / 1.0
// A negative zero keeps its sign.
p10: (0.0 * -1) / 2
// A zero dividend with a positive ideal exponent, +2 here, is a deliberate
// deviation from the specification, which gives 0E+2: the exponent of a zero
// carries no information, and 0.0 reads better.
p11: 0 / 3.00
-- out/compile --
--- in.cue
{
  v1: (1000000000000 / 2.0)
  v2: (2.0 == 2)
  n1: 1
  v5: (2.0 / 〈0;n1〉)
  v6: (1.0 / 1.0)
  e2: (int & (4.0 / 2.0))
  p1: (2.00 * 3)
  p2: (6.00 / 3)
  p3: (2.00 / 4)
  p4: (1.000 / 8)
  p5: (1 / 3)
  p6: (0.00 / 3)
  p7: (-6.00 / 3)
  p8: (1 / 33.0)
  p9: (10000000000000000000000000000000000000000.0 / 1.0)
  p10: ((0.0 * -1) / 2)
  p11: (0 / 3.00)
}
