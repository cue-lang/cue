# Below language version v0.18.0 the prefix alias syntax is the only one
# that parses, so the exporter both accepts and emits it here. The output
# has to be loadable by the module it came from, so it must not reach for
# the postfix form; alias.txtar covers that form at the current version.
-- cue.mod/module.cue --
module: "test.example"
language: version: "v0.17.0"
-- in.cue --
labelAlias: {
	X="a-b": 4
	foo:     X
}

dynamicAlias: {
	key:     "k"
	Y=(key): 1
	bar:     Y
}

patternField: {
	Z=[string]: {n: Z.x, x: 1}
}

patternLabel: {
	[W=string]: m: W
}

valueStruct: {
	v: V={a: 1, b: V.a}
}

valueList: {
	l: L=[1, 2, L[0]]
}

// x refers to the aliased field, which the quoted label does not shadow
// until it is exported unquoted.
shadowedAlias: t1: {
	X=x: "x": x | null
	r: X
}

// c refers to the x declared beside a, which the quoted label does not shadow
// until it is exported unquoted.
shadowedAlias: t2: {
	Y=x: 1
	r: Y
	a: "x": c: x
}
-- out/definition-v3 --
labelAlias: {
	X="a-b": 4
	foo:     X
}
dynamicAlias: {
	key:     "k"
	Y=(key): 1
	bar:     Y
}
patternField: Z=[string]: {
	n: Z.x
	x: 1
}
patternLabel: [W=string]: m: W
valueStruct: v: V_1={
	a: 1
	b: V_1.a
}
valueList: l: L_1=[1, 2, L_1[0]]
shadowedAlias: {

	// x refers to the aliased field, which the quoted label does not shadow
	// until it is exported unquoted.
	t1: {
		let X_1 = X
		X=x: x: X_1 | null
		r: X
	}

	// c refers to the x declared beside a, which the quoted label does not shadow
	// until it is exported unquoted.
	t2: {
		Y=x: 1
		r:   Y
		a: x: c: x
	}
}
-- out/definition-v3-noshare --
labelAlias: {
	X="a-b": 4
	foo:     X
}
dynamicAlias: {
	key:     "k"
	Y=(key): 1
	bar:     Y
}
patternField: Z=[string]: {
	n: Z.x
	x: 1
}
patternLabel: [W=string]: m: W
valueStruct: v: V_1={
	a: 1
	b: V_1.a
}
valueList: l: L_1=[1, 2, L_1[0]]
shadowedAlias: {

	// x refers to the aliased field, which the quoted label does not shadow
	// until it is exported unquoted.
	t1: {
		let X_1 = X
		X=x: x: X_1 | null
		r: X
	}

	// c refers to the x declared beside a, which the quoted label does not shadow
	// until it is exported unquoted.
	t2: {
		Y=x: 1
		r:   Y
		a: x: c: x
	}
}
-- out/doc-v3 --
[]
[labelAlias]
[labelAlias "a-b"]
[labelAlias foo]
[dynamicAlias]
[dynamicAlias key]
[dynamicAlias bar]
[dynamicAlias k]
[patternField]
[patternLabel]
[valueStruct]
[valueStruct v]
[valueStruct v a]
[valueStruct v b]
[valueList]
[valueList l]
[valueList l 0]
[valueList l 1]
[valueList l 2]
[shadowedAlias]
[shadowedAlias t1]
- x refers to the aliased field, which the quoted label does not shadow
until it is exported unquoted.

[shadowedAlias t1 x]
[shadowedAlias t1 x x]
[shadowedAlias t1 r]
[shadowedAlias t1 r x]
[shadowedAlias t2]
- c refers to the x declared beside a, which the quoted label does not shadow
until it is exported unquoted.

[shadowedAlias t2 x]
[shadowedAlias t2 r]
[shadowedAlias t2 a]
[shadowedAlias t2 a x]
[shadowedAlias t2 a x c]
-- out/value-v3 --
== Simplified
{
	labelAlias: {
		"a-b": 4
		foo:   4
	}
	dynamicAlias: {
		key: "k"
		k:   1
		bar: 1
	}
	patternField: {}
	patternLabel: {}
	valueStruct: v: {
		a: 1
		b: 1
	}
	valueList: l: [1, 2, 1]
	shadowedAlias: {

		// x refers to the aliased field, which the quoted label does not shadow
		// until it is exported unquoted.
		t1: {
			x: x: null
			r: x: null
		}

		// c refers to the x declared beside a, which the quoted label does not shadow
		// until it is exported unquoted.
		t2: {
			x: 1
			r: 1
			a: x: c: 1
		}
	}
}
