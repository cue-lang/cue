q:           "q"
q1:          "q1"
r:           "r"
r1:          "r1"
("s-" + q)?: 1
("s-" + r)!: 2
("s-" + q1)?: (r1)!: 3

// The alias of a dynamic field may be reused in a nested struct. The let
// clause is first used, and thus exported, within the nested struct.
nested: {
	k:        "p"
	k2:       "q"
	(k)~(K):  1
	outer:    K
	let L = K
	inner: {
		(k2)~(K): 2
		ref:      K
		viaLet:   L
	}
}
