-- out/definition --
// Test export of else clause in comprehensions
// if-else
ifElse: {
	if false {
		a: 1
	} else {
		b: 2
	}
}

// for-else with empty list
forElse: {
	for x in [] {
		"\(x)": x
	} else {
		empty: true
	}
}

// for-else with outer scope reference
forElseOuter: {
	let val = 10
	for x in [] {
		x
	} else {
		fallback: val
	}
}
