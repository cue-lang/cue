-- a.cue --
@experiment(try)

// Test export of fallback clause in comprehensions

// if-else
ifElse: {
	if false { a: 1 } else { b: 2 }
}

// for-fallback with empty list
forFallback: {
	for x in [] { "\(x)": x } fallback { empty: true }
}

// for-fallback with outer scope reference
forFallbackOuter: {
	let val = 10
	for x in [] { x } fallback { fallbackField: val }
}

// Fallback clauses which only embed a reference.
embedded: {z: 1}
ifElseEmbed: {
	if false { a: 1 } else { embedded }
}
forFallbackEmbed: {
	for x in [] { "\(x)": x } fallback { embedded }
}
tryElseEmbed: {
	try { a: embedded.missing? } else { embedded }
}

// The fallback refers to the outer field, not the shadowing for variable.
forFallbackShadow: {
	for embedded in [] { embedded } otherwise { embedded }
}
-- out/definition-v3-noshare --
@experiment(try)

// Test export of fallback clause in comprehensions

// if-else
ifElse: {
	if false {
		a: 1
	} else {
		b: 2
	}
}

// for-fallback with empty list
forFallback: {
	for x in [] {
		"\(x)": x
	} otherwise {
		empty: true
	}
}

// for-fallback with outer scope reference
forFallbackOuter: {
	let val = 10
	for x in [] {
		x
	} otherwise {
		fallbackField: val
	}
}

// Fallback clauses which only embed a reference.
embedded: z: 1
ifElseEmbed: {
	if false {
		a: 1
	} else {
		embedded
	}
}
forFallbackEmbed: {
	for x in [] {
		"\(x)": x
	} otherwise {
		embedded
	}
}
tryElseEmbed: {
	try {
		a: embedded.missing?
	} else {
		embedded
	}
}

// The fallback refers to the outer field, not the shadowing for variable.
forFallbackShadow: {
	for embedded in [] {
		embedded
	} otherwise {
		embedded
	}
}
