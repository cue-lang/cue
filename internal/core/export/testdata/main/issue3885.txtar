# Lets inside struct literals which are not merged into the enclosing
# struct, such as list elements or call arguments, must not leave behind
# an empty struct in the enclosing scope.
-- in.cue --
list: [{
	let b = 4
	b
}]
listField: [{
	let b = 4
	x: b
}]
call: close({
	let b = 4
	x: b
})
callString: len({
	let b = 4
	x: b
})
disjunction: *{
	let b = 4
	x: b
} | 5
merged: {
	let b = 4
	x: b
} & {
	let c = 5
	y: c
}
// A let in an embedded struct literal is merged into the enclosing scope.
embedded: {
	{
		let c = 5
		y: c
	}
	let b = 4
	x: b
}
-- out/value-v3 --
== Simplified
{
	list:      [4]
	listField: [{x: 4}]
	call: x: 4
	callString:  1
	disjunction: *{x: 4} | 5
	merged: {
		x: 4
		y: 5
	}
	// A let in an embedded struct literal is merged into the enclosing scope.
	embedded: {
		y: 5
		x: 4
	}
}
