[plain u32]
[plain u64]
[plain u128]
[plain f32]
[plain f64]
[plain ub]
[plain ib]
[shadowed]
[shadowed rune]
[shadowed uint8]
[shadowed uint]
[shadowed int]
[shadowed r]
[shadowed u8]
[shadowed ub]
[shadowed ib]
