Simplified exports print the predeclared numeric types by name.
Where a field shadows such a name, the export must use its __-prefixed
form, so that the output still refers to the predeclared type.

TODO: rune prints as uint & <=1114111.

-- in.cue --
plain: {
	r:    rune
	i8:   int8
	i16:  int16
	i32:  int32
	i64:  int64
	i128: int128
	u:    uint
	u8:   uint8
	u16:  uint16
	u32:  uint32
	u64:  uint64
	u128: uint128
	f32:  float32
	f64:  float64
	ub:   uint & <=1000
	ib:   int & >=-1 & <=1000
}

shadowed: {
	rune:  "a"
	uint8: "b"
	uint:  "c"
	int:   "d"

	r:  __rune
	u8: __uint8
	ub: __uint & <=1000
	ib: __int & >=-1 & <=1000
}
-- out/definition --
plain: {
	r:    uint & <=1114111
	i8:   int8
	i16:  int16
	i32:  int32
	i64:  int64
	i128: int128
	u:    uint
	u8:   uint8
	u16:  uint16
	u32:  uint32
	u64:  uint64
	u128: uint128
	f32:  float32
	f64:  float64
	ub:   uint & <=1000
	ib:   int & >=-1 & <=1000
}
shadowed: {
	rune:  "a"
	uint8: "b"
	uint:  "c"
	int:   "d"
	r:     __uint & <=1114111
	u8:    __uint8
	ub:    __uint & <=1000
	ib:    __int & >=-1 & <=1000
}
-- out/doc --
[]
