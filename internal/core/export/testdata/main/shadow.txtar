{
	shadowRef: {
		t1: x: x: null
		t2: x: x: x: null
		t3: x: x: x: x: null
		t4: x: {
			x: null
			y: null
		}
		t5: x: x: null

		// x refers to the aliased field, which the quoted label does not shadow
		// until it is exported unquoted.
		t6: {
			x: x: null
			r: x: null
		}
		e1: x: x: _|_ // shadowRef.e1.x.x: structural cycle
	}
	shadowAlias: {
		t1: {
			y: "outer"
			a: {
				key: "y"
				y:   "inner"
				refs: {
					y:     1
					outer: "outer"
					mid:   "inner"
					inner: 1
				}
			}
		}
		t2: {
			a: {
				key: "y"
				y:   "inner"
				refs: {
					y:     1
					outer: "outer"
					mid:   "inner"
					inner: 1
				}
			}
			y: "outer"
		}
	}
	shadowField: {
		t1: z: {
			b: 0
			d: {
				b: 1
				c: 0
			}
		}
		t2: z: {
			b: 0
			d: {
				b: 1
				c: 0
				A: 1
			}
		}
		t4: merge: z: {
			b: 0
			d: {
				b: 1
				c: 0
				A: 1
			}
		}
		t5: merge: {
			b: 0
			d: {
				b: 1
				c: 0
			}
		}

		// TODO: could be simplified to:
		// 		A=b: 0
		//  	c:   A
		// or even
		// 		b: 0
		//  	c: b
		t6: x: {
			b: 0
			c: 0
		}
		issue2378: a: {
			b: 0
			d: {
				b: 1
				c: A & a.z
			}
		}

		// The structs declaring the alias of a are exported from their arcs,
		// so y must not reference the label a, which b.a shadows.
		recursive: {
			T: {
				a: int
				n?: {
					a: int
					n?: {
						T
						b: {
							a: string
							y: A
						}
					}
					b: {
						a: string
						y: int
					}
				}
			}
			v: {
				a: int
				n: {
					a: int
					n?: {
						a: int
						b: {
							a: string
							y: int
						}
						n?: {
							T
							b: {
								a: string
								y: A
							}
						}
					}
					b: {
						a: string
						y: int
					}
				}
			}
		}

		// Each struct is exported from its declarations, as it holds an aliased
		// field or a comprehension. c refers to the x declared beside a, which the
		// quoted label does not shadow until it is exported unquoted.
		declAlias: {
			x: 1
			r: 1
			a: x: c: 1
		}
		declComprehension: {
			x: 1
			a: x: c: 1
		}

		// a.x is declared in two struct literals, and only the second one is in
		// scope at b, which refers to a.x rather than to the x beside a.
		declTwice: {
			x: 99
			a: {
				x: 1
				b: 1
			}
		}
		declTwiceStruct: {
			x: 99
			a: {
				x: y: 1
				b: y: 1
			}
		}

		// a.b is declared in two struct literals, as the values of two declarations
		// of a, and only the second one is in scope at y.
		declTwiceNested: {
			x: 99
			a: b: {
				x: 1
				y: 1
			}
		}

		// Both struct literals declaring a.x are embedded, and d is in scope of the
		// second one only, where the quoted label shadows a.x.
		declTwiceEmbedded: {
			x: 99
			a: {
				x: 1
				b: 1
				c: x: d: 1
			}
		}

		// The let clause is exported in a, where its quoted label shadows a.x.
		declLet: {
			x: 99
			a: {
				x: 1
				b: x: d: 1
			}
		}

		// The let clause is exported in a, beside the struct literals declaring a.x
		// rather than within either of them, so d is not linked to a.x and refers to
		// the x within N instead, a structural cycle.
		declLetEmbedded: {
			x: 99
			a: {
				x: 1
				b: x: d: 1
			}
		}

		// b refers to x before it is declared, which must not stop the later
		// reference in c from being linked to it too.
		forwardRef: {
			b: 1
			x: 1
			a: x: c: 1
		}

		// a.r shares its value with x, yet a reference to r refers to a.r.
		sharedArc: {
			x: p: 1
			a: {
				r: p: 1
				b: {
					r: 2
					c: p: 1
				}
			}
		}

		// The struct literals declaring x are the value of no field: a disjunct, a
		// list element, and a literal embedded in a struct with a comprehension.
		declDisjunct: t: *{
			x: 1
			b: x: c: 1
		} | {y: 2}
		declListElem: l: [{
			x: 1
			b: x: c: 1
		}]
		declEmbeddedLet: a: {
			x: 1
			b: x: d: 1
		}
	}

	// The let clause is first used, and thus exported, where b is shadowed.
	shadowLet: {
		b: 1
		a: {
			b: 10
			c: {
				b: 20
				d: 10
			}
		}
	}
}
