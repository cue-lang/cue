In this file we test cases where references are shadowed:
- x: x: x
- a newly created dynamic field which ends up shadowing an existing field.

-- in.cue --
shadowRef: t1: {
	x: "x": x | null
}

shadowRef: t2: {
	x: "x": "x": x | null
}

shadowRef: t3: {
	x: "x": x: "x": x | null
}

shadowRef: t4: {
	x~(X): {
		x: X | null
		y: x
	}
}

shadowRef: t5: {
	x~(X): x: X | null
}

shadowRef: e1: {
	x: "x": x // structural error, but should still print ok.
	x: {}
}

shadowAlias: t1: {
	y: "outer"
	a: {
		key:       "y"
		(key)~(X): "inner"

		refs: {
			"y"~(Z): 1
			outer:   y
			mid:     X
			inner:   Z

		}
	}
}

shadowAlias: t2: {
	a: {
		key:       "y"
		(key)~(X): "inner"

		refs: {
			"y"~(Z): 1
			outer:   y
			mid:     X
			inner:   Z

		}
	}
	y: "outer"
}

shadowField: t1: {
	z: {
		b~(A): 0
		d: {
			b: 1
			c: A
		}
	}
}

shadowField: t2: {
	z: {
		b~(A): 0
		d: {
			b: 1
			c: A
		}
	}
	z: d: {A: 1}
}

shadowField: t4: {
	merge: {
		z: {
			b~(A): 0
			d: {
				b: 1
				c: A
			}
		}
	}

	merge: {
		z: {
			b~(A): 0
			d: {
				b: 1
				c: A
			}
		}
		z: d: {A: 1}
	}
}

shadowField: t5: {
	merge: {
		b~(A): 0
		d: {
			b: 1
			c: A
		}
	}
	merge: {
		b: 0
		d: b: 1
	}
}

// TODO: could be simplified to:
// 		A=b: 0
//  	c:   A
// or even
// 		b: 0
//  	c: b
shadowField: t6: {
	x: {
		b~(A): 0
		c:     A
	}
	x: b: 0
}

shadowField: issue2378: {
	a: {
		b~(A): 0
		d: {
			b: 1
			c: A & a.z
		}
	}
}

// The structs declaring the alias of a are exported from their arcs,
// so y must not reference the label a, which b.a shadows.
shadowField: recursive: {
	T: {
		a~(A): int
		n?: {
			T
			b: {
				a: string
				y: A
			}
		}
	}
	v: T & {n: {}}
}

// The let clause is first used, and thus exported, where b is shadowed.
shadowLet: {
	b: 1
	a: {
		b: 10
		let L = b
		c: {
			b: 20
			d: L
		}
	}
}
-- out/definition --
shadowRef: {
	t1: x~(x_9): x: x_9 | null
	t2: x~(x_B): x: x: x_B | null
	t3: x: x: x~(x_6): x: x_6 | null
	t4:
		x~(X): {
			x: X | null
			y: x
		}
	t5:
		x~(X): x: X | null
	e1: x~(x_0): x: x_0
}
shadowAlias: {
	t1: {
		y: "outer"
		a: {
			key:       "y"
			(key)~(X): "inner"
			refs: {
				"y"~(Z): 1
				outer:   y
				mid:     X
				inner:   Z
			}
		}
	}
	t2: {
		a: {
			key:         "y"
			(key)~(X_1): "inner"
			refs: {
				"y"~(Z): 1
				outer:   y
				mid:     X_1
				inner:   Z
			}
		}
		y: "outer"
	}
}
shadowField: {
	t1: z: {
		b~(A): 0
		d: {
			b: 1
			c: A
		}
	}
	t2: z: {
		{
			b~(A): 0
			d: {
				b: 1
				c: A
			}
		}
		d: A: 1
	}
	t4: merge: z: {
		{
			b~(A): 0
			d: {
				b: 1
				c: A
			}
		}
		{
			b~(A): 0
			d: {
				b: 1
				c: A
			}
		}
		d: A: 1
	}
	t5: merge: {
		{
			b~(A): 0
			d: {
				b: 1
				c: A
			}
		}
		b: 0
		d: b: 1
	}

	// TODO: could be simplified to:
	// 		A=b: 0
	//  	c:   A
	// or even
	// 		b: 0
	//  	c: b
	t6: x: {
		{
			b~(A): 0
			c:     A
		}
		b: 0
	}
	issue2378: a: {
		b~(A): 0
		d: {
			b: 1
			c: A & a.z
		}
	}

	// The structs declaring the alias of a are exported from their arcs,
	// so y must not reference the label a, which b.a shadows.
	recursive: {
		T: {
			a~(A): int
			n?: {
				T
				b: {
					a: string
					y: A
				}
			}
		}
		v: T & {n: {}}
	}
}

// The let clause is first used, and thus exported, where b is shadowed.
shadowLet: {
	b: 1
	a: {
		let L = b
		b: 10
		c: {
			b: 20
			d: L
		}
	}
}
