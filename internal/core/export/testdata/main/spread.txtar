-- in.cue --
spread: {
	a: 1
	b: a...
	c: {a...}
	d: close({})...
	e: n: 2
	f: e.n...
	g: [e][0]...
	h: (e | *close({m: 3}))...
	i: __closeAll({e..., q: 4})
	j: __reclose({close({r: 5})..., s: 6})
}
