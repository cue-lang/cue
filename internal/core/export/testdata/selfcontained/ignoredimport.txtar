#path: x

# Exporting a value which only needs the length of an imported struct
# should not evaluate the values of that struct's fields.
# out/evals counts the evaluations of the fields marked with @count()
# up to the export, where only "used" should be evaluated.

-- cue.mod/module.cue --
module: "mod.test/a"
language: version: "v0.9.0"

-- in.cue --
import "mod.test/a/data"

x: {
	n: len(data.items)
	m: data.items.used
}

-- data/data.cue --
@extern(count)

package data

items: {
	used:   _ @count()
	unused: _ @count()
}
-- out/self-v3/default --
import "mod.test/a/data"

n: len(data.items)
m: data.items.used
-- out/self-v3/evals --
unused: 1
used: 2
-- out/self-v3-noshare/default --
import "mod.test/a/data"

n: len(data.items)
m: data.items.used
-- out/self-v3-noshare/evals --
unused: 1
used: 2
