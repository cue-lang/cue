#path: x

# Dependency analysis also finds G.c in the inline vertex of #Game & {c: T.c},
# which is not rooted. Within the hoisted value of #Game, the let bound to self
# still refers to #Game.

-- cue.mod/module.cue --
module: "mod.test/a"
language: version: "v0.18.0"
-- in.cue --
import "mod.test/a/app"

raw: bool
s:   app.code
x: y: [if raw {s.screens}]
-- app/app.cue --
package app

#Game: {
	let G = self
	c:   string
	out: "\(G.c)\(G.c)"
}
#Team: {
	let T = self
	c: string
	p: bool
	out: [if T.p {(#Game & {c: T.c}).out}, ""][0]
}
_cells: (#Team & {c: "p"}).out
code: screens: a: _cells
-- out/self/default --
y: [if RAW {
	a: CELLS.#x
}]

//cue:path: raw
let RAW = bool

//cue:path: _cells
let CELLS = {#x: (TEAM.#x & {c: "p"}).out}

//cue:path: #Team
let TEAM = {
	#x: {
		let T = self
		c: string
		p: bool
		out: [
			if T.p {
				(GAME.#x & {c: T.c}).out
			},
			""
		][0]
	}
}

//cue:path: #Game
let GAME = {
	#x: {
		let G = self
		c:   string
		out: "\(G.c)\(G.c)"
	}
}
