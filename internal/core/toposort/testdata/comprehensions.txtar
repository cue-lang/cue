// A struct nested in a conditional appears in fewer iterations than its
// sibling fields, which keep their iteration order whether they are
// declared in the body itself or in structs embedded in it.
-- in.cue --
fields: {
	for k in ["z", "c", "b"] {
		if k == "z" {"\(k)x": 1}
		"\(k)1": 1
		"\(k)2": 1
	}
}
structs: {
	for k in ["z", "c", "b"] {
		if k == "z" {"\(k)x": 1}
		{"\(k)1": 1}
		{"\(k)2": 1}
	}
}
nested: {
	for k in ["z", "c", "b"] {
		{if k == "z" {"\(k)x": 1}}
		"\(k)1": 1
		"\(k)2": 1
	}
}
