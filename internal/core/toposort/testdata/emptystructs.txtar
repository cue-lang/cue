// Structs without fields pass the field order on without duplicating
// it. The `out: {}` lines keep consecutive `out: {} & {}` lines from
// merging into one batch.
//
// An operand of & which only embeds a struct, also through other
// expressions, is ordered as that struct is: its fields get no order
// against those of the other operand. Structs with fields which it
// embeds keep their order.
-- in.cue --
ref:    _y & {m: 1}
embed:  {_y} & {m: 1}
both:   {_y} & {_m}
nested: {{_y}} & {m: 1}
field:  {_y, z: 1} & {_m}
mixed:  {{_y}, z: 1} & {m: 1}
cond:   {if true {_y}} & {m: 1}
loop:   {for k in ["k"] {_y}} & {m: 1}
disj:   (*{_y} | null) & {m: 1}
disjIn: {*{_y} | null} & {m: 1}
call:   and([{_y}]) & {m: 1}
index:  [{_y}][0] & {m: 1}
fields: {{b: 1}, {a: 2}} & {m: 1}
_y: {y1: 1, y2: 2}
_m: {m: 1}

out: {b: 1}
out: {} & {}
out: {}
out: {} & {}
out: {}
out: {} & {}
out: {}
out: {} & {}
out: {}
out: {} & {}
out: {}
out: {} & {}
out: {}
out: {} & {}
out: {}
out: {} & {}
out: {}
out: {} & {}
out: {}
out: {} & {}
out: {}
out: {} & {}
out: {}
out: {} & {}
out: {}
out: {} & {}
out: {}
out: {} & {}
out: {}
out: {} & {}
out: {}
out: {} & {}
out: {}
out: {} & {}
out: {}
out: {} & {}
out: {}
out: {} & {}
out: {}
out: {} & {}
out: {}
out: {a: 1}
