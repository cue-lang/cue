// Structs reached through one reference keep their declaration order,
// also beyond the 12 roots up to which the sort is an insertion sort.
//
// Structs embedded through further references keep their embedding
// order, which is the reverse of their declaration order here, so
// outRefs.x orders its fields as refs.x does.
-- in.cue --
out: s & {}
s: x: {
	{("p1"): "v"}
	{("p2"): "v"}
	{("p3"): "v"}
	{("p4"): "v"}
	{("p5"): "v"}
	{("p6"): "v"}
	{("p7"): "v"}
	{("p8"): "v"}
	{("p9"): "v"}
	{("q1"): "v"}
	{("q2"): "v"}
	{("q3"): "v"}
	{("q4"): "v"}
	{("q5"): "v"}
	{q6: "v"}
}

outRefs: refs & {}
refs: x: {
	_c
	{("m"): "v"}
	_b
	_a
}
_a: {_inner, ("a1"): "v"}
_inner: {("i1"): "v"}
_b: {("b1"): "v", b2: "v"}
_c: {c1: "v", ("c2"): "v"}
