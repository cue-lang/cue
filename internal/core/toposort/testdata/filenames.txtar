// Field order does not depend on how file names sort, so each pair
// orders its fields alike:
//   - outA and outZ, from sa and sz in a.cue and z.cue, which sort
//     before and after main.cue
//   - outST and outTS, referring to s and t from swapped files
//   - outU and u, embedding _dz from z.cue before _da from a.cue
//
// The first two pairs differ, which is a bug.
-- a.cue --
package p

sa: x: {
	{a1: "v"}
	{_b, _c}
	{"\("d1")": "v", d2: "v"}
	{("d3"): "v"}
	{d4: "v"}
	{_e, _f}
	if true {g1: "v"}
	{"\("h1")": "v", h2: "v"}
}

outST: s
outTS: t

_da: {da1: "v", ("da2"): "v"}
-- main.cue --
package p

outA: sa & {}
outZ: sz & {}
outU: u & {}

s: x: {
	{a1: "v"}
	{_b, _c}
	{"\("d1")": "v", d2: "v"}
	{("d3"): "v"}
	{d4: "v"}
	{_e, _f}
	if true {g1: "v"}
	{"\("h1")": "v", h2: "v"}
}
t: x: {
	{t1: "v"}
	{("t2"): "v"}
	{"\("t3")": "v"}
	{t4: "v"}
}
u: x: {_dz, _da}

_b: {b1: "v"}
_c: {c1: "v"}
_e: {e1: "v"}
_f: {f1: "v"}
-- z.cue --
package p

sz: x: {
	{a1: "v"}
	{_b, _c}
	{"\("d1")": "v", d2: "v"}
	{("d3"): "v"}
	{d4: "v"}
	{_e, _f}
	if true {g1: "v"}
	{"\("h1")": "v", h2: "v"}
}

outST: t
outTS: s

_dz: {("dz1"): "v", dz2: "v"}
