# Test that upgrading a module keeps the modules that its current
# version requires, even when the new version does not require them.
-- versions --
bar.com
-- want --
module: "main.org@v0"
language: version: "v0.8.0"
deps: {
	"bar.com@v0": v: "v0.5.0"
	"baz.org@v0": v: "v0.1.0"
}
-- cue.mod/module.cue --
module: "main.org@v0"
language: version: "v0.8.0"
deps: "bar.com@v0": v: "v0.0.2"
-- main.cue --
package main

-- _registry/bar.com_v0.0.2/cue.mod/module.cue --
module: "bar.com@v0"
language: version: "v0.8.0"
deps: "baz.org@v0": v: "v0.1.0"

-- _registry/bar.com_v0.0.2/bar/x.cue --
package bar

-- _registry/bar.com_v0.5.0/cue.mod/module.cue --
module: "bar.com@v0"
language: version: "v0.8.0"

-- _registry/bar.com_v0.5.0/bar/x.cue --
package bar

-- _registry/baz.org_v0.1.0/cue.mod/module.cue --
module: "baz.org@v0"
language: version: "v0.8.0"

-- _registry/baz.org_v0.1.0/baz.cue --
package baz
