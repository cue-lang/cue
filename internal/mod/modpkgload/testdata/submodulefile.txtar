A file in the main module at the path of a submodule does not hide the
packages of the submodule, even on a file system which does not report
ENOTDIR when the file is read as a directory.

-- test0/initial-requirements --
main.test@v0
main.test/foo@v0.0.1
-- test0/root-packages --
main.test@v0:main
-- test0/default-major-versions --
-- test0/want --
main.test@v0:main
	flags: inAll,isRoot,fromRoot,importsLoaded
	mod: main.test@v0
	external: false
	location: .
	file: main.cue: main
	imports:
		main.test/foo/bar@v0
		main.test/foo@v0
main.test/foo/bar@v0
	flags: inAll,isRoot,fromRoot,importsLoaded
	mod: main.test/foo@v0.0.1
	external: true
	location: _registry/main.test_foo_v0.0.1/bar
	file: _registry/main.test_foo_v0.0.1/bar/bar.cue: bar
main.test/foo@v0
	flags: inAll,isRoot,fromRoot,importsLoaded
	mod: main.test/foo@v0.0.1
	external: true
	location: _registry/main.test_foo_v0.0.1
	file: _registry/main.test_foo_v0.0.1/foo.cue: foo
-- main.cue --
package main
import (
	"main.test/foo@v0"
	"main.test/foo/bar@v0"
)
-- foo --
A file named like the submodule.
-- cue.mod/module.cue --
module: "main.test@v0"
language: version: "v0.12.0"
-- _registry/main.test_foo_v0.0.1/cue.mod/module.cue --
module: "main.test/foo@v0"
language: version: "v0.8.0"
-- _registry/main.test_foo_v0.0.1/foo.cue --
package foo
-- _registry/main.test_foo_v0.0.1/bar/bar.cue --
package bar
