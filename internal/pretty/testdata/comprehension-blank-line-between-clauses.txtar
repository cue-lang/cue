# A blank line between comprehension clauses is kept, also before a
# clause's doc comment.
-- in --
for x in [1]
let y = x

if y == 1 {
	a: y
}

for x in [1]
let y = x

// c
if y == 1 {
	b: y
}
-- out/relpos --
for x in [1]
let y = x

if y == 1 {
	a: y
}

for x in [1]
let y = x

// c
if y == 1 {
	b: y
}
-- out/norelpos --
for x in [1] let y = x if y == 1 {a: y}
for x in [1] let y = x
// c
if y == 1 {b: y}
