# The attributes of a field come before its trailing comment, also when
# its value is a chain whose arms carry comments.
-- in --
x: a | // c1
	b @foo(bar) // c2
y: a. // c1
	b @foo(bar) // c2
-- out/relpos --
x: a | // c1
	b @foo(bar) // c2
y: a. // c1
	b @foo(bar) // c2
-- out/norelpos --
x: a | // c1
	b @foo(bar) // c2
y: a. // c1
	b @foo(bar) // c2
