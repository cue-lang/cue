# Function expressions: parameter attributes render after the parameter
# value, a parameter default renders as " = " after the constraint and
# before the attributes, and a trailing "..." marks an open signature. A
# parameter list with doc comments breaks into a table with the "..." on
# its own row. A call whose argument list ends in "..." is a partial
# application.
-- in --
@experiment(functions)

tagged: func(a: int @tag(x), b: int @foo() @bar()) -> int: a + b

defaults: func(_~n: int = 0, a: int=2, c: int = 3 @tag(y), b!: string = "x") -> int: a
defaultsMulti: func(
	// a default on the first parameter
	a: int = 2,
	b: string = "x",
) -> int: a

// A comment after "=" or ":" trails its parameter; a comment on its own
// line before a default or a constraint leads the parameter. A parameter
// list with a comment closes on its own line, so that a // comment
// cannot swallow the closing parenthesis or a following parameter.
commented: func(a: int = // after the bind token
	2, b: int =
	// before the default
	3, c:
	// before the constraint
	int = 4) -> int: a
trailingLast: func(a: int = 2 // after the last parameter
	) -> int: a
standalone: func(
	a: int = 2,
	// after the last parameter, on its own line
) -> int: a

open:      func(a: int, ...) -> number
openOnly:  func(...) -> int
openMulti: func(
	// first operand
	a: int,
	b?: string,
	...
) -> int

partialLabel: add(a: 1, ...)
partialPos:   add(1, ...)
partialNone:  add(...)
partialMany:  add(1, 2, ...)
-- out/relpos --
@experiment(functions)

tagged: func(a: int @tag(x), b: int @foo() @bar()) -> int: a + b

defaults: func(_~(n): int = 0, a: int = 2, c: int = 3 @tag(y), b!: string = "x") -> int: a
defaultsMulti: func(
	// a default on the first parameter
	a: int = 2,
	b: string = "x",
) -> int: a

// A comment after "=" or ":" trails its parameter; a comment on its own
// line before a default or a constraint leads the parameter. A parameter
// list with a comment closes on its own line, so that a // comment
// cannot swallow the closing parenthesis or a following parameter.
commented: func(a: int = 2, // after the bind token
	// before the default
	b: int = 3,
	// before the constraint
	c: int = 4,
) -> int: a
trailingLast: func(a: int = 2, // after the last parameter
) -> int: a
standalone: func(
	a: int = 2,
	// after the last parameter, on its own line
) -> int: a

open:     func(a: int, ...) -> number
openOnly: func(...) -> int
openMulti: func(
	// first operand
	a: int,
	b?: string,
	...
) -> int

partialLabel: add(a: 1, ...)
partialPos:   add(1, ...)
partialNone:  add(...)
partialMany:  add(1, 2, ...)
-- out/norelpos --
@experiment(functions)
tagged: func(a: int @tag(x), b: int @foo() @bar()) -> int: a + b
defaults:
	func(_~(n): int = 0, a: int = 2, c: int = 3 @tag(y), b!: string = "x") -> int: a
defaultsMulti: func(
	// a default on the first parameter
	a: int = 2,
	b: string = "x",
) -> int: a
// A comment after "=" or ":" trails its parameter; a comment on its own
// line before a default or a constraint leads the parameter. A parameter
// list with a comment closes on its own line, so that a // comment
// cannot swallow the closing parenthesis or a following parameter.
commented: func(
	a: int = 2,
	// after the bind token
	// before the default
	b: int = 3,
	// before the constraint
	c: int = 4,
) -> int: a
trailingLast: func(
	a: int = 2,
	// after the last parameter
) -> int: a
standalone: func(
	a: int = 2,
	// after the last parameter, on its own line
) -> int: a
open:     func(a: int, ...) -> number
openOnly: func(...) -> int
openMulti: func(
	// first operand
	a: int,
	b?: string,
	...
) -> int
partialLabel: add(a: 1, ...)
partialPos:   add(1, ...)
partialNone:  add(...)
partialMany:  add(1, 2, ...)
