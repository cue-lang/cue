# Within a multi-line string body, the formatter must never alter
# the user's leading whitespace - neither *adding* nor *removing*.
#
# Lines that start with the strip prefix are stripped on the way in
# and re-indented at the render depth on the way out.
#
# Lines that *don't* start with the strip prefix - bare empty lines,
# or whitespace shorter than the prefix - are emitted after a bare
# newline with no indentation, followed by the user's literal text,
# so an empty line stays empty and a spaces-only line stays spaces-only.
-- in --
x: """
	first \(name)

	mid

	end
	"""
-- out/relpos --
x: """
	first \(name)

	mid

	end
	"""
-- out/norelpos --
x: """
	first \(name)

	mid

	end
	"""
