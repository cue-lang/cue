# A `// c` written immediately after an opener (`{ // c`, `[ // c`,
# `( // c`) trails the opener on the same line in the source. The
# CUE parser sets the comment's Slash RelPos to Blank (and, as a
# redundant projection, cg.Line=true) and either attaches it as a
# Position=1 prefix on the bracketed node (when there is no body) or
# as a Position=0 doc on the first child (when there is). In both
# shapes the formatter keeps the comment on the opener's line and
# emits a single space between the opener and `//` - the layout the
# user wrote.
#
# In a list element, the parser attaches such a comment as a
# Position=1 prefix on the element whatever its body. The formatter
# moves it after the element, even past its trailing comment.
#
# This is distinct from a `// c` on its own line inside the brackets,
# which has rel != Blank and renders on its own indented line. Tests
# for that shape live in empty-struct-with-comment.txtar.
#
# In the norelpos case stripRelPos clears the layout knobs, so the
# header-on-opener-line shape collapses to the own-line shape.
-- in --
struct_with_content: { // header
	x: _
}

list_with_content: [ // header
	1,
	2,
]

call_with_args: f( // header
	1,
)

list_elems: [
	{ // header
		// doc
		x: _
	},
	[ // header
		1,
	],
	{ // header
		x: _
	}, // trailing
]

hugged_list_elem: [{ // header
	x: _
}]
-- out/relpos --
struct_with_content: { // header
	x: _
}

list_with_content: [ // header
	1,
	2,
]

call_with_args: f( // header
	1,
)

list_elems: [
	{
		// doc
		x: _
	}, // header
	[
		1,
	], // header
	{
		x: _
	}, // trailing
	// header
]

hugged_list_elem: [{
	x: _
} // header
]
-- out/norelpos --
struct_with_content: {
	// header
	x: _
}
list_with_content: [
	// header
	1,
	2,
]
call_with_args: f(
	// header
	1,
)
list_elems: [
	{
		// doc
		x: _
	},
	// header
	[1],
	// header
	{x: _},
	// trailing
	// header
]
hugged_list_elem: [
	{x: _},
	// header
]
