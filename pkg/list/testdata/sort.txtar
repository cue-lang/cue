import "list"

t1: {
	l:   ["c", "b", "a"]
	ls:  ["a", "b", "c"]
	il:  false
	ils: true
}
t2: {
	l:   ["c", "b", "a"]
	il:  false
	ls:  ["a", "b", "c"]
	ils: true
}
t3: {
	L:   ["c", "b", "a", "e", "d"]
	l:   ["c", "b", "a", "e"]
	il:  false
	ls:  ["a", "b", "c", "e"]
	ils: true
	l2:  ["c", "b", "a", "e"]
	l3:  ["a", "b", "c", "e"]
}
// An error in the comparator is an error in the result,
// including a less field which is not a concrete bool.
lessErr: {
	s: list.Sort([
		{a: 2}, {b: 1},
	], {
		x:    _
		y:    _
		less: x.a < y.a
	})
	ss: list.SortStable([
		{a: 2}, {b: 1},
	], {
		x:    _
		y:    _
		less: x.a < y.a
	})
	is: list.IsSorted([
		{a: 2}, {b: 1},
	], {
		x:    _
		y:    _
		less: x.a < y.a
	})
}
lessString: {
	s:  _|_ // lessString.s: error in call to list.Sort: cannot use "foo" (type string) as type bool
	ss: _|_ // lessString.ss: error in call to list.SortStable: cannot use "foo" (type string) as type bool
	is: _|_ // lessString.is: error in call to list.IsSorted: cannot use "foo" (type string) as type bool
	v:  _|_ // lessString.v: invalid value [2,1] (does not satisfy list.IsSorted({x:_,y:_,less:"foo"})): cannot use "foo" (type string) as type bool
}
lessNonConcrete: {
	s: list.Sort([
		2,
		1,
	], {
		x:    _
		y:    _
		less: bool
	})
	is: list.IsSorted([
		2,
		1,
	], {
		x:    _
