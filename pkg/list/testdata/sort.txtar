// Issue #616
-- in.cue --
import "list"

t1: {
	l: ["c", "b", "a"]
	ls:  list.Sort(l, list.Ascending)
	il:  list.IsSorted(l, list.Ascending)
	ils: list.IsSorted(ls, list.Ascending)
}

t2: {
	l: ["c", "b", "a"]
	il: list.IsSorted(l, list.Ascending)

	ls:  list.Sort(l, list.Ascending)
	ils: list.IsSorted(ls, list.Ascending)
}

t3: {
	L: ["c", "b", "a", "e", "d"]
	l:  list.Take(L, 4)
	il: list.IsSorted(l, list.Ascending)

	ls:  list.Sort(l, list.Ascending)
	ils: list.IsSorted(ls, list.Ascending)

	l2: l
	l3: ls
}
// An error in the comparator is an error in the result,
// including a less field which is not a concrete bool.
lessErr: {
	s:  list.Sort([{a: 2}, {b: 1}], {x: _, y: _, less: x.a < y.a})
	ss: list.SortStable([{a: 2}, {b: 1}], {x: _, y: _, less: x.a < y.a})
	is: list.IsSorted([{a: 2}, {b: 1}], {x: _, y: _, less: x.a < y.a})
}
lessString: {
	s:  list.Sort([2, 1], {x: _, y: _, less: "foo"})
	ss: list.SortStable([2, 1], {x: _, y: _, less: "foo"})
	is: list.IsSorted([2, 1], {x: _, y: _, less: "foo"})
	v:  [2, 1] & list.IsSorted({x: _, y: _, less: "foo"})
}
lessNonConcrete: {
	s:  list.Sort([2, 1], {x: _, y: _, less: bool})
	is: list.IsSorted([2, 1], {x: _, y: _, less: bool})
}
lessMissing: {
	s:  list.Sort([2, 1], {x: _, y: _})
	is: list.IsSorted([2, 1], {x: _, y: _})
}
// A less field which is not yet concrete is an incomplete error,
// so that the comparator may still be completed.
lessRef: {
	#S: {
		cond: bool
		s:    list.Sort([2, 1], {x: _, y: _, less: cond})
	}
	v: #S & {cond: true}
}
-- out/list --
Errors:
