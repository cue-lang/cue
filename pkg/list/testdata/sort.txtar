// Issue #616
-- in.cue --
import "list"

t1: {
	l: ["c", "b", "a"]
	ls:  list.Sort(l, list.Ascending)
	il:  list.IsSorted(l, list.Ascending)
	ils: list.IsSorted(ls, list.Ascending)
}

t2: {
	l: ["c", "b", "a"]
	il: list.IsSorted(l, list.Ascending)

	ls:  list.Sort(l, list.Ascending)
	ils: list.IsSorted(ls, list.Ascending)
}

t3: {
	L: ["c", "b", "a", "e", "d"]
	l:  list.Take(L, 4)
	il: list.IsSorted(l, list.Ascending)

	ls:  list.Sort(l, list.Ascending)
	ils: list.IsSorted(ls, list.Ascending)

	l2: l
	l3: ls
}
// An error in the comparator is an error in the result,
// including a less field which is not a concrete bool.
lessErr: {
	s:  list.Sort([{a: 2}, {b: 1}], {x: _, y: _, less: x.a < y.a})
	ss: list.SortStable([{a: 2}, {b: 1}], {x: _, y: _, less: x.a < y.a})
	is: list.IsSorted([{a: 2}, {b: 1}], {x: _, y: _, less: x.a < y.a})
}
lessString: {
	s:  list.Sort([2, 1], {x: _, y: _, less: "foo"})
	ss: list.SortStable([2, 1], {x: _, y: _, less: "foo"})
	is: list.IsSorted([2, 1], {x: _, y: _, less: "foo"})
	v:  [2, 1] & list.IsSorted({x: _, y: _, less: "foo"})
}
lessNonConcrete: {
	s:  list.Sort([2, 1], {x: _, y: _, less: bool})
	is: list.IsSorted([2, 1], {x: _, y: _, less: bool})
}
lessMissing: {
	s:  list.Sort([2, 1], {x: _, y: _})
	is: list.IsSorted([2, 1], {x: _, y: _})
}
// A less field which is not yet concrete is an incomplete error,
// so that the comparator may still be completed.
lessRef: {
	#S: {
		cond: bool
		s:    list.Sort([2, 1], {x: _, y: _, less: cond})
	}
	v: #S & {cond: true}
}
// Wrong: comparator fields from an embedding or a unification cause a panic.
cmpIndirect: {
	embed: list.Sort(["b", "a"], {list.Ascending})
	unify: list.Sort(["b", "a"], list.Ascending & {T: string})
	is:    list.IsSorted(["b", "a"], {list.Descending})
}

// Wrong: a comparator without the fields x and y causes a panic.
cmpMissing: {
	s:   list.Sort([2, 1, 3], {less: true})
	ss:  list.SortStable([2, 1, 3], {less: true})
	is:  list.IsSorted([2, 1], {less: true})
	noX: list.Sort([2, 1], {y: _, less: true})
	noY: list.Sort([2, 1], {x: _, less: true})
}

// A comparator field which is only a constraint is missing too.
// Wrong: an optional or required x or y is treated as a regular field.
cmpConstraint: {
	lessOpt: list.Sort([2, 1], {x: _, y: _, less?: true})
	lessReq: list.IsSorted([2, 1], {x: _, y: _, less!: true})
	xOpt:    list.Sort([2, 1], {x?: _, y: _, less: true})
	yReq:    list.IsSorted([2, 1], {x: _, y!: _, less: true})
}

// A comparator may use x and y outside of less, such as in a comprehension,
// which must see the inputs rather than any defaults.
cmpCond: {
	cmp: {x: *0 | int, y: *0 | int, less: x < y, if x < y {extra: true}}
	s:   list.Sort([3, 1, 2], cmp)
	ss:  list.SortStable([3, 1, 2], cmp)
	is:  list.IsSorted([3, 1, 2], cmp)
}
