}
lessMissing: {
	s:  _|_ // lessMissing.s: error in call to list.Sort: field not found: less
	is: _|_ // lessMissing.is: error in call to list.IsSorted: field not found: less
}
// A less field which is not yet concrete is an incomplete error,
// so that the comparator may still be completed.
lessRef: {
	#S: {
		cond: bool
		s: list.Sort([
			2,
			1,
		], {
			x:    _
			y:    _
			less: cond
		})
	}
	v: {
		cond: true
		s:    [1, 2]
	}
}
