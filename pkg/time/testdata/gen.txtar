	missingZone: time.ToUnix("2019-01-02T15:04:05")
	badSeconds:  time.ToUnix("2019-01-02T15:04:61Z")
	garbage:     time.ToUnixNano("not a time")
}

// An argument outside the range of int64 must be an error rather than saturate.
// Unlike sec, every int64 nsec has a corresponding time.
unixRange: {
	min:       time.Unix(0, -9223372036854775808)
	max:       time.Unix(0, 9223372036854775807)
	underflow: time.Unix(0, -9223372036854775809)
