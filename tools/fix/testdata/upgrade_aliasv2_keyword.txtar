#upgrade:v0.18.0

# An old alias may be named by a keyword such as "in" or "for", which
# the new syntax does not accept as a let or alias name. Such aliases
# and their references are renamed, each to a name which the package
# does not otherwise use, as a let cannot shadow a field.

-- cue.mod/module.cue --
module: "upgrade.test"

language: { version: "v0.17.0" }

-- a.cue --
package foo

f: in={
	a: 1
	b: in.a @test(eq, 1)
}
for=g: {a: 2}
h: for.a @test(eq, 2)
p: [if=string]: {name: if}
p: x: _
px: p.x.name @test(eq, "x")

// Both a label alias and a value alias.
try=q: fallback={
	a: 1
	b: fallback.a @test(eq, 1)
	c: try.a      @test(eq, 1)
}

// A field labeled by a keyword is left alone.
func: 5
s: else={
	a: func   @test(eq, 5)
	b: else.a @test(eq, 5)
}
-- b.cue --
package foo

// The name a keyword alias would take is already used in the file.
in_1: 10
r: in={
	a: 1
	b: in.a @test(eq, 1)
	c: in_1 @test(eq, 10)
	d: {in_1: 3 @test(eq, 3), e: in.a @test(eq, 1)}
}

// An alias of a value which is not a struct is bound in an embedding,
// which then starts with a reference to it.
t: for=for.b & {b: {c: 1}}
tc: t.c @test(eq, 1)
-- out/fixmod --
--- cue.mod/module.cue
module: "upgrade.test"
language: version: "v0.18.0"
--- a.cue
package foo

f: {
	let in_2 = self
	a: 1
	b: in_2.a @test(eq, 1)
}
g~(for_1): {a: 2}
h:         for_1.a @test(eq, 2)
p: [string]~(if_1,_): {name: if_1}
p: x:                 _
px: p.x.name @test(eq, "x")

// Both a label alias and a value alias.
q~(try_1): {
	let fallback_1 = self
	a: 1
	b: fallback_1.a @test(eq, 1)
	c: try_1.a      @test(eq, 1)
}

// A field labeled by a keyword is left alone.
func: 5
s: {
	let else_1 = self
	a: func     @test(eq, 5)
	b: else_1.a @test(eq, 5)
}
--- b.cue
package foo

// The name a keyword alias would take is already used in the file.
in_1: 10
r: {
	let in_2 = self
	a: 1
	b: in_2.a @test(eq, 1)
	c: in_1   @test(eq, 10)
	d: {in_1: 3 @test(eq, 3), e: in_2.a @test(eq, 1)}
}

// An alias of a value which is not a struct is bound in an embedding,
// which then starts with a reference to it.
t:  {let for_1 = self, for_1.b & {b: {c: 1}}}
tc: t.c @test(eq, 1)
