A reference that only resolves once a task has filled its own result must
not change that task's dependencies: its dependencies are settled when it
runs, and b depending on a is not a cycle.

-- in.cue --
root: {
	a: {
		$id: "task"
		stdout?: string
		if stdout != _|_ {
			dep: b.$id
		}
	}
	b: {
		$id:    "task"
		$after: a
	}
}
-- out/run/errors --
-- out/run/t0 --
graph TD
  t0("root.a [Ready]")
  t1("root.b [Waiting]")
  t1-->t0

-- out/run/t1 --
graph TD
  t0("root.a [Terminated]")
  t1("root.b [Ready]")
  t1-->t0

-- out/run/t1/value --
{
	$id:    "task"
	stdout: "foo"
	dep:    "task"
}
-- out/run/t1/stats --
Leaks:  0
Freed:  9
Reused: 0
Allocs: 9
Retain: 0

Unifications: 9
Conjuncts:    15
Disjuncts:    0
ResolveDep:   2

NumCloseIDs: 1
-- out/run/t2 --
graph TD
  t0("root.a [Terminated]")
  t1("root.b [Terminated]")
  t1-->t0

-- out/run/t2/value --
{
	$id: "task"
	$after: {
		$id:    "task"
		stdout: "foo"
		dep:    "task"
	}
	stdout: "foo"
}
-- out/run/t2/stats --
Leaks:  0
Freed:  10
Reused: 9
Allocs: 1
Retain: 0

Unifications: 10
Conjuncts:    19
Disjuncts:    0
ResolveDep:   1

NumCloseIDs: 1
