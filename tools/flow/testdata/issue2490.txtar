#IgnoreConcrete: true
#InferTasks: true
-- in.cue --
package p

import (
	"tool/cli"
	"encoding/json"
)

input: [string]~(name,_): {
	{#in: name, #out: #in}.#out
}
root: foo: {
	cli.Print & {text: json.Marshal(input)}
}
