# A task which only needs the field names of an imported struct
# should not cause the values of those fields to be evaluated.
# The stats below count the evaluation of every one of those values,
# and out/evals counts the evaluations of the fields marked with @count(),
# where only "used" should be evaluated.

-- cue.mod/module.cue --
module: "mod.test/test"
language: version: "v0.9.0"
-- data/data.cue --
@extern(count)

package data

items: {
	used:   _ @count()
	unused: _ @count()
	for i in [1, 2, 3] {
		"item\(i)": {
			id: i
			deep: {x: i + 1, y: z: i * 2}
		}
	}
}
-- in.cue --
import "mod.test/test/data"

root: {
	keys: {
		$id: "valToOut"
		val: "\(len([for k, _ in data.items {k}]))"
		out: string
	}
	count: {
		$after: keys
		$id: "valToOut"
		val: "\(len(data.items))"
		out: string
	}
	used: {
		$after: count
		$id: "valToOut"
		val: "\(data.items.used)"
		out: string
	}
}
-- out/run-v3/errors --
-- out/run-v3/t0 --
graph TD
  t0("root.keys [Ready]")
  t1("root.count [Waiting]")
  t1-->t0
  t2("root.used [Waiting]")
  t2-->t1

-- out/run-v3/t1 --
graph TD
  t0("root.keys [Terminated]")
  t1("root.count [Ready]")
  t1-->t0
  t2("root.used [Waiting]")
  t2-->t1

-- out/run-v3/t1/value --
{
	$id: "valToOut"
	val: "5"
	out: "5"
}
