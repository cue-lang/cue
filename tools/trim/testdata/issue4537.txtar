# A reference in a comprehension clause is compiled inside the scopes of the
# for, let, and try clauses before it, so it must be resolved across them.

-- in.cue --
// The z in the comprehension refers to m.n.z, so m.z is redundant with #D.
// The reference is resolved one scope too far out, to m.z, which is kept.
#D: {
	z: true
	...
}
m: #D & {
	z: true
	n: {
		z: true
		for _ in [1] if z {y: 1}
	}
}
