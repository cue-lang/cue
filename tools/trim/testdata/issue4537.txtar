# A reference in a comprehension clause is compiled inside the scopes of the
# for, let, and try clauses before it, so it must be resolved across them.

-- in.cue --
@experiment(try)

// At the root, the reference to x crosses every clause scope up to the top
// scope.
x: true
for _ in [1] if x {a: 1}
if true let y = 1 if x {b: y}
for _ in [1] let y = 1 if x {c: y}
for _ in [1] for _ in [2] if x {d: 1}
try y = x? if x {e: y}

// The z in the comprehension refers to m.n.z, so m.z is redundant with #D.
#D: {
	z: true
	...
}
m: #D & {
	z: true
	n: {
		z: true
		for _ in [1] if z {y: 1}
	}
}
