# Trimming walks each recursive schema once, even when it is reachable
# along exponentially many paths through its pattern constraints.
#
# Without sharing, every pattern constraint is evaluated as a fresh copy,
# so the walk still takes exponential time.
#skip-v3-noshare

-- in.cue --
package p

#R0: {[=~"^a"]: #R1, [=~"^b"]: #R1, [=~"^c"]: #R1}
#R1: {[=~"^a"]: #R2, [=~"^b"]: #R2, [=~"^c"]: #R2}
#R2: {[=~"^a"]: #R3, [=~"^b"]: #R3, [=~"^c"]: #R3}
#R3: {[=~"^a"]: #R4, [=~"^b"]: #R4, [=~"^c"]: #R4}
#R4: {[=~"^a"]: #R5, [=~"^b"]: #R5, [=~"^c"]: #R5}
#R5: {[=~"^a"]: #R6, [=~"^b"]: #R6, [=~"^c"]: #R6}
#R6: {[=~"^a"]: #R7, [=~"^b"]: #R7, [=~"^c"]: #R7}
#R7: {[=~"^a"]: #R8, [=~"^b"]: #R8, [=~"^c"]: #R8}
#R8: {[=~"^a"]: #R9, [=~"^b"]: #R9, [=~"^c"]: #R9}
#R9: {[=~"^a"]: #R10, [=~"^b"]: #R10, [=~"^c"]: #R10}
#R10: {[=~"^a"]: #R11, [=~"^b"]: #R11, [=~"^c"]: #R11}
#R11: {[=~"^a"]: #R0, [=~"^b"]: #R0, [=~"^c"]: #R0}
r: #R0
r: a: b: c: {}
-- out/trim --
== in.cue
package p

#R0:  {[=~"^a"]: #R1, [=~"^b"]: #R1, [=~"^c"]: #R1}
#R1:  {[=~"^a"]: #R2, [=~"^b"]: #R2, [=~"^c"]: #R2}
#R2:  {[=~"^a"]: #R3, [=~"^b"]: #R3, [=~"^c"]: #R3}
#R3:  {[=~"^a"]: #R4, [=~"^b"]: #R4, [=~"^c"]: #R4}
#R4:  {[=~"^a"]: #R5, [=~"^b"]: #R5, [=~"^c"]: #R5}
#R5:  {[=~"^a"]: #R6, [=~"^b"]: #R6, [=~"^c"]: #R6}
#R6:  {[=~"^a"]: #R7, [=~"^b"]: #R7, [=~"^c"]: #R7}
#R7:  {[=~"^a"]: #R8, [=~"^b"]: #R8, [=~"^c"]: #R8}
#R8:  {[=~"^a"]: #R9, [=~"^b"]: #R9, [=~"^c"]: #R9}
#R9:  {[=~"^a"]: #R10, [=~"^b"]: #R10, [=~"^c"]: #R10}
#R10: {[=~"^a"]: #R11, [=~"^b"]: #R11, [=~"^c"]: #R11}
#R11: {[=~"^a"]: #R0, [=~"^b"]: #R0, [=~"^c"]: #R0}
r:    #R0
r: a: b: c: {}
